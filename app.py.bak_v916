               ps.quantity AS cantidad,
               COALESCE(ps.delivery_date,'') AS fecha_entrega,
               ps.created_at AS cargado_el
        FROM private_sales ps
        JOIN products p ON p.id = ps.product_id
        WHERE COALESCE(ps.is_undone,0)=0
        ORDER BY date(ps.sale_date) DESC, ps.id DESC
        """
    )


def undo_private_sale(sale_id, reason="Deshacer venta particular desde historial"):
    conn = get_conn()
    row = conn.execute("SELECT * FROM private_sales WHERE id = ?", (int(sale_id),)).fetchone()
    if not row:
        conn.close()
        return False, "No se encontró la venta particular."
    if int(row["is_undone"] or 0) == 1:
        conn.close()
        return False, "La venta particular ya estaba anulada."
    now = datetime.now().isoformat(timespec="seconds")
    old_values = dict(row)
    conn.execute(
        "UPDATE private_sales SET is_undone = 1, undone_at = ?, undo_reason = ? WHERE id = ?",
        (now, str(reason or ""), int(sale_id)),
    )
    conn.execute(
        """
        INSERT INTO undo_log(entity_type, entity_id, undone_at, reason, old_values)
        VALUES (?, ?, ?, ?, ?)
        """,
        ("private_sales", int(sale_id), now, str(reason or ""), json.dumps(old_values, ensure_ascii=False)),
    )
    conn.commit()
    conn.close()
    return True, "Línea de venta particular deshecha con éxito."


def undo_private_order(order_number, reason="Deshacer comanda particular completa"):
    order_number = str(order_number or "").strip()
    conn = get_conn()
    rows = conn.execute(
        "SELECT * FROM private_sales WHERE COALESCE(order_number,'') = ? AND COALESCE(is_undone,0)=0",
        (order_number,),
    ).fetchall()
    if not rows:
        conn.close()
        return False, "No se encontraron líneas activas para esa comanda."
    now = datetime.now().isoformat(timespec="seconds")
    for row in rows:
        old_values = dict(row)
        conn.execute(
            "UPDATE private_sales SET is_undone = 1, undone_at = ?, undo_reason = ? WHERE id = ?",
            (now, str(reason or ""), int(row["id"])),
        )
        conn.execute(
            """
            INSERT INTO undo_log(entity_type, entity_id, undone_at, reason, old_values)
            VALUES (?, ?, ?, ?, ?)
            """,
            ("private_sales", int(row["id"]), now, str(reason or ""), json.dumps(old_values, ensure_ascii=False)),
        )
    conn.commit()
    conn.close()
    return True, f"Comanda particular {order_number} deshecha con éxito. Líneas anuladas: {len(rows)}."


def dashboard_df(as_of=None):
    real = current_real_stock(as_of)
    avail = latest_available_stock(as_of)
    pending = pending_tiendanube_sales(as_of)
    pending_private = pending_private_sales(as_of)
    df = real.merge(avail[["id", "deposit", "stock_disponible", "fecha_stock_disponible"]], on=["id", "deposit"], how="left")
    # Mantengo el nombre de columna por compatibilidad interna, pero ya NO representa EcommApp.
    # Desde v8.9 solo trae stock disponible importado desde Manjares; Planta/Tandil quedan en 0.
    df["stock_disponible_ecommapp"] = pd.to_numeric(df["stock_disponible"], errors="coerce").fillna(0)
    df = df.drop(columns=["stock_disponible"])
    df = df.merge(pending, on=["id", "deposit"], how="left")
    df = df.merge(pending_private, on=["id", "deposit"], how="left")
    for col in ["vendido_tn", "despachado_tn", "vendido_pendiente_entrega", "vendido_particular", "despachado_particular", "particular_pendiente_entrega"]:
        df[col] = df[col].fillna(0)
    df["vendido_pendiente_total"] = df["vendido_pendiente_entrega"] + df["particular_pendiente_entrega"]

    # Regla central de stock disponible calculado por depósito:
    # - Buenos Aires / Manjares: fuente oficial = Excel de Manjares, campo Stock Disponible.
    # - Planta Mar del Plata y Tandil: stock real físico - ventas pendientes de despacho.
    # - Stock EcommApp/Tiendanube como foto de stock ya NO se usa.
    def _calc_disponible(row):
        dep = str(row.get("deposit", ""))
        if dep == "Buenos Aires / Manjares":
            return float(row.get("stock_disponible_ecommapp") or 0)
        return float(row.get("stock_real") or 0) - float(row.get("vendido_pendiente_total") or 0)

    df["stock_disponible"] = df.apply(_calc_disponible, axis=1)
    df["origen_stock_disponible_calculado"] = df["deposit"].apply(
        lambda dep: "Excel Manjares / Stock Disponible" if dep == "Buenos Aires / Manjares" else "Stock real - ventas pendientes"
    )
    df["alerta_stock_disponible"] = df["stock_disponible"].apply(lambda x: "NEGATIVO" if x < 0 else "OK")
    df["diferencia_real_vs_disponible"] = df["stock_real"] - df["stock_disponible"]
    df["diferencia_vs_ecommapp"] = df["stock_disponible"] - df["stock_disponible_ecommapp"]
    df["stock_disponible_importado_manjares"] = df["stock_disponible_ecommapp"]
    return df


def movements_df():
    df = read_sql(
        """
        SELECT m.id, m.movement_date AS fecha_movimiento, m.effective_date AS fecha_impacto_stock,
               COALESCE(m.deposit, '') AS deposito,
               p.name AS producto, m.movement_type AS tipo, m.quantity AS cantidad,
               COALESCE(m.numero_comanda, '') AS numero_comanda, COALESCE(m.lote, '') AS lote,
               m.note AS observacion, m.source AS origen, m.created_at AS cargado_el,
               COALESCE(m.is_undone,0) AS anulado, COALESCE(m.undone_at,'') AS anulado_el, COALESCE(m.undo_reason,'') AS motivo_anulacion
        FROM movements m
        JOIN products p ON p.id = m.product_id
        ORDER BY date(m.movement_date) DESC, m.id DESC
        """
    )
    if df.empty:
        return df
    df["signo_stock"] = pd.to_numeric(df["tipo"].apply(product_stock_sign), errors="coerce").fillna(0).astype(float)
    df["impacto_stock"] = df["signo_stock"].apply(stock_impact_label)
    df["cantidad_num"] = pd.to_numeric(df["cantidad"], errors="coerce").fillna(0).astype(float)
    df["cantidad_con_signo"] = df.apply(lambda r: abs(float(r["cantidad_num"] or 0)) * float(r["signo_stock"] or 0) if float(r["signo_stock"] or 0) != 0 else float(r["cantidad_num"] or 0), axis=1)
    preferred = [
        "id", "fecha_movimiento", "fecha_impacto_stock", "deposito", "producto",
        "tipo", "impacto_stock", "cantidad", "cantidad_con_signo", "numero_comanda",
        "lote", "observacion", "origen", "cargado_el", "anulado", "anulado_el", "motivo_anulacion"
    ]
    return df[[c for c in preferred if c in df.columns]]


def available_snapshots_df():
    return read_sql(
        """
        SELECT s.stock_date AS fecha, s.deposit AS deposito, p.name AS producto, s.quantity AS stock_disponible,
               s.note AS observacion, s.updated_at AS actualizado_el
        FROM available_stock_deposit s
        JOIN products p ON p.id = s.product_id
        ORDER BY date(s.stock_date) DESC, s.deposit, p.name
        """
    )


def get_setting(key, default=""):
    conn = get_conn()
    row = conn.execute("SELECT value FROM app_settings WHERE key = ?", (key,)).fetchone()
    conn.close()
    if row is None or row["value"] is None:
        return default
    return row["value"]


def set_setting(key, value):
    conn = get_conn()
    now = datetime.now().isoformat(timespec="seconds")
    conn.execute(
        """
        INSERT INTO app_settings(key, value, updated_at)
        VALUES (?, ?, ?)
        ON CONFLICT(key) DO UPDATE SET value=excluded.value, updated_at=excluded.updated_at
        """,
        (key, str(value or ""), now),
    )
    conn.commit()
    conn.close()



def default_sku_for_product(product_name):
    for sku, name in ECOMM_SKU_PRODUCT_MAP.items():
        if name == product_name:
            return sku
    return ""


def combo_headers_df():
    return read_sql(
        """
        SELECT id, combo_sku, combo_name, active, updated_at
        FROM combo_skus
        ORDER BY combo_name, combo_sku
        """
    )


def combo_components_df(combo_id=None):
    if combo_id:
        return read_sql(
            """
            SELECT cc.id, cc.combo_id, cs.combo_sku, cs.combo_name, cc.product_id,
                   p.name AS producto, cc.component_sku, cc.quantity_per_combo, cc.active
            FROM combo_components cc
            JOIN combo_skus cs ON cs.id = cc.combo_id
            JOIN products p ON p.id = cc.product_id
            WHERE cc.combo_id = ?
            ORDER BY p.name
            """,
            (int(combo_id),),
        )
    return read_sql(
        """
        SELECT cc.id, cc.combo_id, cs.combo_sku, cs.combo_name, cc.product_id,
               p.name AS producto, cc.component_sku, cc.quantity_per_combo, cc.active
        FROM combo_components cc
        JOIN combo_skus cs ON cs.id = cc.combo_id
        JOIN products p ON p.id = cc.product_id
        ORDER BY cs.combo_name, p.name
        """
    )


def save_combo(combo_sku, combo_name, components_df):
    combo_sku = normalize_tn_sku(combo_sku)
    combo_name = str(combo_name or "").strip()
    if not combo_sku or not combo_name:
        return False, "Falta SKU o nombre del combo."
    if components_df is None or components_df.empty:
        return False, "Agregá al menos un producto dentro del combo."
    conn = get_conn()
    now = datetime.now().isoformat(timespec="seconds")
    cur = conn.execute(
        """
        INSERT INTO combo_skus(combo_sku, combo_name, active, created_at, updated_at)
        VALUES (?, ?, 1, ?, ?)
        ON CONFLICT(combo_sku) DO UPDATE SET combo_name=excluded.combo_name, active=1, updated_at=excluded.updated_at
        """,
        (combo_sku, combo_name, now, now),
    )
    combo_id = conn.execute("SELECT id FROM combo_skus WHERE combo_sku = ?", (combo_sku,)).fetchone()[0]
    # Reemplazamos composición completa para que el combo quede exacto.
    conn.execute("DELETE FROM combo_components WHERE combo_id = ?", (combo_id,))
    products_map = product_name_to_id()
    count = 0
    for _, row in components_df.iterrows():
        prod = str(row.get("producto") or "").strip()
        if not prod or prod not in products_map:
            continue
        try:
            qty = float(row.get("cantidad_por_combo") or 0)
        except Exception:
            qty = 0
        if qty <= 0:
            continue
        comp_sku = str(row.get("sku_individual") or "").strip() or default_sku_for_product(prod)
        conn.execute(
            """
            INSERT INTO combo_components(combo_id, product_id, component_sku, quantity_per_combo, active, created_at, updated_at)
            VALUES (?, ?, ?, ?, 1, ?, ?)
            """,
            (combo_id, int(products_map[prod]), comp_sku, qty, now, now),
        )
        count += 1
    conn.commit()
    conn.close()
    if count == 0:
        return False, "No se guardó ningún componente válido. Revisá productos y cantidades."
    return True, f"Combo guardado con éxito. Componentes: {count}."


def set_combo_active(combo_id, active):
    conn = get_conn()
    now = datetime.now().isoformat(timespec="seconds")
    conn.execute("UPDATE combo_skus SET active = ?, updated_at = ? WHERE id = ?", (1 if active else 0, now, int(combo_id)))
    conn.commit()
    conn.close()


def active_combo_map():
    df = read_sql(
        """
        SELECT cs.combo_sku, cs.combo_name, cc.product_id, p.name AS producto,
               cc.component_sku, cc.quantity_per_combo
        FROM combo_skus cs
        JOIN combo_components cc ON cc.combo_id = cs.id
        JOIN products p ON p.id = cc.product_id
        WHERE cs.active = 1 AND cc.active = 1
        ORDER BY cs.combo_sku, p.name
        """
    )
    combo_map = {}
    for _, r in df.iterrows():
        sku = normalize_tn_sku(r["combo_sku"])
        combo_map.setdefault(sku, {"combo_name": r["combo_name"], "components": []})
        combo_map[sku]["components"].append({
            "product_id": int(r["product_id"]),
            "producto": r["producto"],
            "component_sku": r["component_sku"] or default_sku_for_product(r["producto"]),
            "quantity_per_combo": float(r["quantity_per_combo"] or 0),
        })
    return combo_map

def normalize_text(value):
    """Normaliza texto para comparaciones robustas: mayúsculas, sin acentos ni espacios dobles."""
    txt = str(value or "")
    txt = unicodedata.normalize("NFKD", txt)
    txt = "".join(ch for ch in txt if not unicodedata.combining(ch))
    txt = re.sub(r"\s+", " ", txt).strip().upper()
    return txt


def map_tiendanube_distribution_center_to_deposit(value):
    """Mapea el campo Ubicación Tiendanube / Centro de distribución al depósito interno de Rawer Data."""
    txt = normalize_text(value)
    if not txt:
        return ""
    if "MANJARES" in txt or "BUENOS AIRES" in txt or "CABA" in txt or "CAPITAL FEDERAL" in txt:
        return "Buenos Aires / Manjares"
    if "TANDIL" in txt:
        return "Tandil"
    # En Tiendanube, el centro de distribución Rawer equivale a la fábrica/planta.
    if "RAWER" in txt or "FABRICA" in txt or "FABRICA" in txt or "MAR DEL PLATA" in txt or "PLANTA" in txt:
        return "Planta Mar del Plata"
    return ""


def deep_find_distribution_center(obj, path=""):
    """Busca en la orden cualquier campo equivalente a Ubicación Tiendanube / Centro de distribución.
    Devuelve el primer valor encontrado junto con su ruta, para diagnóstico.
    Prioriza el campo que Tiendanube muestra como "Ubicación Tiendanube", que para Rawer equivale al depósito.
    """
    candidate_key_tokens = [
        "ubicacion_tienda_nube", "ubicacion tiendanube", "ubicacion tienda nube",
        "ubicación_tienda_nube", "ubicación tiendanube", "ubicación tienda nube",
        "tienda_nube_location", "tiendanube_location", "store_location",
        "centro_distribucion", "centro de distribucion", "centro distribución",
        "distribution_center", "distribution centre", "fulfillment_center",
        "stock_center", "warehouse", "deposito", "depósito", "punto_venta",
    ]
    if isinstance(obj, dict):
        for k, v in obj.items():
            k_norm = normalize_text(k).lower().replace(" ", "_")
            k_plain = normalize_text(k).lower()
            if any(tok.replace(" ", "_") in k_norm or tok in k_plain for tok in candidate_key_tokens):
                if isinstance(v, (str, int, float)) and str(v).strip():
                    return str(v).strip(), (f"{path}.{k}" if path else str(k))
                if isinstance(v, dict):
                    # Ej: {name: Rawer} o {nombre: Manjares}
                    for nk in ["name", "nombre", "title", "label", "description", "descripcion", "value"]:
                        if v.get(nk) not in (None, ""):
                            return str(v.get(nk)).strip(), (f"{path}.{k}.{nk}" if path else f"{k}.{nk}")
            child_path = f"{path}.{k}" if path else str(k)
            found = deep_find_distribution_center(v, child_path)
            if found:
                return found
    elif isinstance(obj, list):
        for i, v in enumerate(obj):
            found = deep_find_distribution_center(v, f"{path}[{i}]" if path else f"[{i}]")
            if found:
                return found
    return None


def normalize_tn_sku(sku):
    return str(sku or "").strip()


def rawer_product_from_tn_sku(sku):
    sku_norm = normalize_tn_sku(sku)
    product_name = ECOMM_SKU_PRODUCT_MAP.get(sku_norm)
    if product_name:
        return product_name
    return None


def tiendanube_api_headers(access_token):
    return {
        "Authentication": f"bearer {access_token}",
        "Authorization": f"Bearer {access_token}",
        "Content-Type": "application/json",
        "User-Agent": "Rawer Data (operaciones@rawer.com.ar)",
    }


def tiendanube_fetch_orders(store_id, access_token, created_at_min=None, created_at_max=None, status="any", payment_status="paid", max_pages=10, include_custom_fields=True):
    store_id = str(store_id or "").strip()
    access_token = str(access_token or "").strip()
    if not store_id or not access_token:
        raise ValueError("Falta store_id o access token de Tiendanube.")

    base_url = f"https://api.tiendanube.com/v1/{store_id}/orders"
    orders = []
    per_page = 50
    for page in range(1, int(max_pages) + 1):
        params = {
            "page": page,
            "per_page": per_page,
            "status": status or "any",
            "payment_status": payment_status or "any",
        }
        if created_at_min:
            params["created_at_min"] = created_at_min
        if created_at_max:
            params["created_at_max"] = created_at_max
        resp = requests.get(base_url, headers=tiendanube_api_headers(access_token), params=params, timeout=35)
        # Tiendanube puede responder 404 cuando se pide una página mayor a la última,
        # por ejemplo: {"description": "Last page is 2"}. Eso NO es un error
        # de conexión: significa que ya no hay más pedidos para traer. Cortamos la paginación.
        if resp.status_code == 404:
            try:
                last_page_detail = resp.json()
                last_page_text = json.dumps(last_page_detail, ensure_ascii=False)
            except Exception:
                last_page_text = resp.text[:500]
            if "Last page is" in last_page_text or "last page is" in last_page_text.lower():
                break

        # Algunas cuentas/versiones de Tiendanube rechazan ciertos campos en el parámetro fields.
        # Si pasa, reintentamos la misma consulta sin fields para priorizar compatibilidad.
        if resp.status_code >= 400:
            retry_without_fields = False
            try:
                detail_json = resp.json()
                detail_text = json.dumps(detail_json, ensure_ascii=False)
            except Exception:
                detail_json = None
                detail_text = resp.text[:500]
            if resp.status_code in (400, 404) and "Invalid fields" in detail_text:
                retry_without_fields = True
            if retry_without_fields:
                params_no_fields = dict(params)
                params_no_fields.pop("fields", None)
                resp = requests.get(base_url, headers=tiendanube_api_headers(access_token), params=params_no_fields, timeout=35)
                if resp.status_code == 404:
                    try:
                        last_page_detail = resp.json()
                        last_page_text = json.dumps(last_page_detail, ensure_ascii=False)
                    except Exception:
                        last_page_text = resp.text[:500]
                    if "Last page is" in last_page_text or "last page is" in last_page_text.lower():
                        break
            if resp.status_code >= 400:
                try:
                    detail = resp.json()
                except Exception:
                    detail = resp.text[:500]
                raise RuntimeError(f"Error Tiendanube {resp.status_code}: {detail}")
        batch = resp.json()
        if not isinstance(batch, list):
            raise RuntimeError(f"Respuesta inesperada de Tiendanube: {type(batch).__name__}")
        orders.extend(batch)
        if len(batch) < per_page:
            break

    # En algunas cuentas Tiendanube NO incluye los campos personalizados en el listado
    # general de pedidos. Para leer el campo agregado en Detalle de venta
    # (por ejemplo, "Fecha de entrega"), hay que consultar el endpoint específico
    # de campos personalizados de cada orden: /orders/{id}/custom-fields.
    if include_custom_fields:
        for order in orders:
            order_id = order.get("id")
            if not order_id:
                continue
            try:
                custom_fields = tiendanube_fetch_order_custom_fields(store_id, access_token, order_id)
                if custom_fields:
                    order["_rawer_order_custom_fields"] = custom_fields
                    # Guardamos un atajo por si el detector general no encuentra el valor.
                    fecha_val, fecha_path = extract_delivery_from_custom_fields(custom_fields)
                    if fecha_val:
                        order["_rawer_fecha_entrega_custom_field"] = fecha_val
                        order["_rawer_fecha_entrega_custom_field_path"] = fecha_path
            except Exception as exc:
                # No frenamos la importación de ventas si Tiendanube no habilita este endpoint
                # para el token actual. Queda visible en raw_json si se necesita diagnosticar.
                order["_rawer_custom_fields_error"] = str(exc)
    return orders


def tiendanube_fetch_order_custom_fields(store_id, access_token, order_id):
    """Lee los campos personalizados asociados a una orden de Tiendanube.

    Tiendanube documenta GET /orders/{id}/custom-fields para listar los campos
    personalizados asociados a una orden. En Rawer lo usamos para traer
    "Fecha de entrega" cargada en Detalle de venta.
    """
    store_id = str(store_id or "").strip()
    access_token = str(access_token or "").strip()
    order_id = str(order_id or "").strip()
    if not store_id or not access_token or not order_id:
        return []
    url = f"https://api.tiendanube.com/v1/{store_id}/orders/{order_id}/custom-fields"
    resp = requests.get(url, headers=tiendanube_api_headers(access_token), timeout=25)
    if resp.status_code == 404:
        return []
    if resp.status_code >= 400:
        try:
            detail = resp.json()
        except Exception:
            detail = resp.text[:500]
        raise RuntimeError(f"Error campos personalizados Tiendanube {resp.status_code}: {detail}")
    data = resp.json()
    if isinstance(data, list):
        return data
    if isinstance(data, dict):
        return [data]
    return []


def _norm_delivery_label_for_custom_fields(value):
    txt = str(value or "").strip().lower()
    replacements = {
        "á": "a", "é": "e", "í": "i", "ó": "o", "ú": "u", "ü": "u", "ñ": "n",
        "_": " ", "-": " ", ".": " ", ":": " ", "/": " ", "\\": " ",
    }
    for a, b in replacements.items():
        txt = txt.replace(a, b)
    return " ".join(txt.split())


def _looks_like_fecha_entrega_label(value):
    label_n = _norm_delivery_label_for_custom_fields(value)
    return (
        label_n == "fecha de entrega"
        or "fecha entrega" in label_n
        or ("fecha" in label_n and "entrega" in label_n)
        or "delivery date" in label_n
    )


def extract_delivery_from_custom_fields(custom_fields):
    """Devuelve (valor, ruta) para Fecha de entrega desde la respuesta /custom-fields."""
    if not custom_fields:
        return "", ""
    if isinstance(custom_fields, dict):
        iterable = [custom_fields]
    else:
        iterable = list(custom_fields)
    value_keys = ["value", "valor", "answer", "respuesta", "text", "date", "fecha"]
    label_keys = ["name", "label", "title", "key", "field", "field_name", "custom_field", "question", "description"]
    for idx, cf in enumerate(iterable):
        if not isinstance(cf, dict):
            continue
        labels = [cf.get(k) for k in label_keys if k in cf]
        if any(_looks_like_fecha_entrega_label(x) for x in labels):
            for vk in value_keys:
                val = cf.get(vk)
                if val not in (None, "") and str(val).strip():
                    return str(val), f"_rawer_order_custom_fields[{idx}].{vk}"
            # A veces el valor viene como lista/objeto dentro de values.
            vals = cf.get("values")
            if isinstance(vals, list) and vals:
                first = vals[0]
                if first not in (None, "") and not isinstance(first, (dict, list)):
                    return str(first), f"_rawer_order_custom_fields[{idx}].values[0]"
                if isinstance(first, dict):
                    for vk in value_keys:
                        val = first.get(vk)
                        if val not in (None, "") and str(val).strip():
                            return str(val), f"_rawer_order_custom_fields[{idx}].values[0].{vk}"
    return "", ""


def extract_order_delivery_date(order):
    """Devuelve la fecha de entrega informada por Tiendanube.

    Prioridad:
    1) Campo personalizado de la orden llamado "Fecha de entrega".
    2) Campos estándar/anidados de entrega/despacho.
    3) Estimación por shipping_min_days/shipping_max_days si no hay fecha exacta.
    """
    # 0) Atajo: valor obtenido desde GET /orders/{id}/custom-fields.
    if order.get("_rawer_fecha_entrega_custom_field"):
        return str(order.get("_rawer_fecha_entrega_custom_field")), (
            "campo_personalizado_endpoint:" + str(order.get("_rawer_fecha_entrega_custom_field_path") or "orders/{id}/custom-fields")
        )

    def norm_txt(value):
        txt = str(value or "").strip().lower()
        replacements = {
            "á": "a", "é": "e", "í": "i", "ó": "o", "ú": "u", "ü": "u", "ñ": "n",
            "_": " ", "-": " ", ".": " ", ":": " ", "/": " ", "\\": " ",
        }
        for a, b in replacements.items():
            txt = txt.replace(a, b)
        return " ".join(txt.split())

    def looks_like_delivery_label(label):
        label_n = norm_txt(label)
        return (
            label_n == "fecha de entrega"
            or "fecha entrega" in label_n
            or ("entrega" in label_n and "fecha" in label_n)
            or "delivery date" in label_n
            or "delivery_date" in str(label or "").lower()
        )

    def scalar(value):
        return isinstance(value, (str, int, float)) and str(value).strip()

    # 1) Buscar primero campos personalizados de Tiendanube.
    # Tiendanube/apps pueden devolverlos con formatos distintos: custom_fields,
    # extra_fields, note_attributes, attributes, metadata, etc.
    def find_custom_delivery(obj, prefix=""):
        if isinstance(obj, dict):
            # Caso: {"Fecha de entrega": "2026-08-20"}
            for k, v in obj.items():
                path = f"{prefix}.{k}" if prefix else str(k)
                if looks_like_delivery_label(k) and scalar(v):
                    return str(v), path

            # Caso: {"name": "Fecha de entrega", "value": "2026-08-20"}
            label_keys = ["name", "label", "title", "key", "field", "field_name", "custom_field", "question"]
            value_keys = ["value", "valor", "answer", "respuesta", "text", "date", "fecha"]
            labels = [obj.get(k) for k in label_keys if k in obj]
            if any(looks_like_delivery_label(x) for x in labels):
                for vk in value_keys:
                    if scalar(obj.get(vk)):
                        return str(obj.get(vk)), f"{prefix}.{vk}" if prefix else vk

            # Caso: {"type":"date", "label":"Fecha de entrega", "values":[...]}
            if any(looks_like_delivery_label(x) for x in labels):
                for vk in ["values", "options"]:
                    val = obj.get(vk)
                    if isinstance(val, list) and val:
                        first = val[0]
                        if scalar(first):
                            return str(first), f"{prefix}.{vk}[0]" if prefix else f"{vk}[0]"
                        if isinstance(first, dict):
                            for inner_key in value_keys:
                                if scalar(first.get(inner_key)):
                                    return str(first.get(inner_key)), f"{prefix}.{vk}[0].{inner_key}" if prefix else f"{vk}[0].{inner_key}"

            for k, v in obj.items():
                found = find_custom_delivery(v, f"{prefix}.{k}" if prefix else str(k))
                if found:
                    return found
        elif isinstance(obj, list):
            for i, v in enumerate(obj):
                found = find_custom_delivery(v, f"{prefix}[{i}]")
                if found:
                    return found
        return None

    custom_found = find_custom_delivery(order)
    if custom_found:
        return custom_found[0], f"campo_personalizado:{custom_found[1]}"

    # 2) Campos estándar directos.
    direct_keys = [
        "delivered_at", "fulfilled_at", "shipped_at", "shipping_delivered_at",
        "shipping_fulfilled_at", "delivery_date", "estimated_delivery_date",
        "shipping_tracking_date", "tracking_date", "delivery_at",
    ]
    for key in direct_keys:
        val = order.get(key)
        if val:
            return str(val), key

    # 3) Algunos métodos/apps de envío devuelven fechas dentro de objetos anidados.
    def walk(obj, prefix=""):
        if isinstance(obj, dict):
            for k, v in obj.items():
                k_low = str(k).lower()
                path = f"{prefix}.{k}" if prefix else str(k)
                if any(token in k_low for token in ["delivered", "fulfilled", "shipped", "delivery_date", "tracking_date", "estimated_delivery"]):
                    if scalar(v):
                        return str(v), path
                found = walk(v, path)
                if found:
                    return found
        elif isinstance(obj, list):
            for i, v in enumerate(obj):
                found = walk(v, f"{prefix}[{i}]")
                if found:
                    return found
        return None

    nested = walk(order)
    if nested:
        return nested

    # 4) Si Tiendanube no trae fecha exacta, usamos una estimación operativa.
    created_at = str(order.get("created_at") or "")[:10]
    max_days = order.get("shipping_max_days")
    min_days = order.get("shipping_min_days")
    try:
        if created_at and max_days not in (None, ""):
            base = datetime.fromisoformat(created_at).date()
            est = base + timedelta(days=int(float(max_days)))
            if min_days not in (None, "") and int(float(min_days)) != int(float(max_days)):
                est_min = base + timedelta(days=int(float(min_days)))
                return f"{est_min.isoformat()} a {est.isoformat()}", "estimado_shipping_min_max_days"
            return est.isoformat(), "estimado_shipping_max_days"
    except Exception:
        pass
    return "", ""



def tiendanube_location_map_df(active_only=True):
    where = "WHERE active = 1" if active_only else ""
    return read_sql(
        f"""
        SELECT id, tn_location_id, COALESCE(tn_location_name, '') AS tn_location_name,
               rawer_deposit, active, created_at, updated_at
        FROM tiendanube_location_map
        {where}
        ORDER BY tn_location_id
        """
    )


def tiendanube_location_mapping_dict():
    df = tiendanube_location_map_df(True)
    mapping = {}
    if not df.empty:
        for _, r in df.iterrows():
            loc_id = str(r.get("tn_location_id") or "").strip()
            dep = str(r.get("rawer_deposit") or "").strip()
            if loc_id and dep in DEPOSITS:
                mapping[loc_id] = dep
    return mapping


def upsert_tiendanube_location_mapping(tn_location_id, tn_location_name, rawer_deposit):
    tn_location_id = str(tn_location_id or "").strip()
    tn_location_name = str(tn_location_name or "").strip()
    rawer_deposit = str(rawer_deposit or "").strip()
    if not tn_location_id:
        raise ValueError("Falta location_id de Tiendanube.")
    if rawer_deposit not in DEPOSITS:
        raise ValueError("Depósito Rawer inválido.")
    now = datetime.now().isoformat(timespec="seconds")
    conn = get_conn()
    conn.execute(
        """
        INSERT INTO tiendanube_location_map(tn_location_id, tn_location_name, rawer_deposit, active, created_at, updated_at)
        VALUES (?, ?, ?, 1, ?, ?)
        ON CONFLICT(tn_location_id) DO UPDATE SET
            tn_location_name=excluded.tn_location_name,
            rawer_deposit=excluded.rawer_deposit,
            active=1,
            updated_at=excluded.updated_at
        """,
        (tn_location_id, tn_location_name, rawer_deposit, now, now),
    )
    conn.commit()
    conn.close()


def deep_find_tiendanube_locations(obj, path=""):
    """Busca location_id/location_name en cualquier estructura devuelta por Tiendanube.
    Devuelve candidatos únicos para poder mapearlos a depósitos Rawer.
    """
    results = []
    if isinstance(obj, dict):
        loc_id = None
        loc_name = ""
        for key in ["location_id", "stock_location_id", "fulfillment_location_id", "inventory_location_id"]:
            if obj.get(key) not in (None, ""):
                loc_id = obj.get(key)
                break
        for key in ["location_name", "stock_location_name", "fulfillment_location_name", "inventory_location_name", "name"]:
            if obj.get(key) not in (None, ""):
                loc_name = str(obj.get(key))
                break
        if loc_id not in (None, ""):
            results.append({
                "location_id": str(loc_id),
                "location_name": loc_name,
                "path": path or "order",
            })
        for k, v in obj.items():
            child_path = f"{path}.{k}" if path else str(k)
            results.extend(deep_find_tiendanube_locations(v, child_path))
    elif isinstance(obj, list):
        for i, v in enumerate(obj):
            child_path = f"{path}[{i}]" if path else f"[{i}]"
            results.extend(deep_find_tiendanube_locations(v, child_path))

    # Unificar preservando orden.
    unique = []
    seen = set()
    for r in results:
        key = (r["location_id"], r.get("location_name", ""), r.get("path", ""))
        if key not in seen:
            unique.append(r)
            seen.add(key)
    return unique


def infer_tiendanube_deposit(order):
    """Intenta obtener depósito de Tiendanube.
    Prioridad:
    1) Ubicación Tiendanube informada por Tiendanube.
    2) Centro de distribución informado por Tiendanube, si existe.
    3) location_id mapeado.
    4) texto de envío/retiro.
    Si no puede determinarlo con seguridad, devuelve Depósito pendiente.
    """
    distribution_found = deep_find_distribution_center(order)
    distribution_center = distribution_found[0] if distribution_found else ""
    distribution_path = distribution_found[1] if distribution_found else ""
    distribution_deposit = map_tiendanube_distribution_center_to_deposit(distribution_center)
    location_candidates = deep_find_tiendanube_locations(order)
    mapping = tiendanube_location_mapping_dict()
    if distribution_deposit in DEPOSITS:
        first = location_candidates[0] if location_candidates else {}
        return {
            "deposit": distribution_deposit,
            "source": "ubicacion_tienda_nube",
            "location_id": str(first.get("location_id") or ""),
            "location_name": str(first.get("location_name") or ""),
            "distribution_center": str(distribution_center or ""),
            "path": distribution_path,
        }
    for loc in location_candidates:
        dep = mapping.get(str(loc.get("location_id") or ""))
        if dep:
            return {
                "deposit": dep,
                "source": "location_id_mapeado",
                "location_id": str(loc.get("location_id") or ""),
                "location_name": str(loc.get("location_name") or ""),
                "distribution_center": str(distribution_center or ""),
                "path": str(loc.get("path") or ""),
            }

    guessed = guess_deposit_from_order(order)
    if guessed in DEPOSITS:
        first = location_candidates[0] if location_candidates else {}
        return {
            "deposit": guessed,
            "source": "texto_envio",
            "location_id": str(first.get("location_id") or ""),
            "location_name": str(first.get("location_name") or ""),
            "distribution_center": str(distribution_center or ""),
            "path": str(first.get("path") or ""),
        }

    first = location_candidates[0] if location_candidates else {}
    return {
        "deposit": PENDING_DEPOSIT,
        "source": "pendiente_mapeo" if location_candidates else "sin_dato_tiendanube",
        "location_id": str(first.get("location_id") or ""),
        "location_name": str(first.get("location_name") or ""),
        "distribution_center": str(distribution_center or ""),
        "path": str(first.get("path") or ""),
    }

def guess_deposit_from_order(order):
    """Intenta inferir el depósito desde datos de envío/retiro de Tiendanube.
    Si no hay dato confiable, devuelve vacío para usar el depósito por defecto elegido en pantalla.
    """
    try:
        parts = []
        for key in [
            "shipping_option", "shipping_option_code", "shipping_name", "shipping_method",
            "shipping_carrier_name", "shipping_address", "pickup_details", "store_pickup",
            "fulfillment", "fulfillment_status", "shipping_pickup_details"
        ]:
            val = order.get(key)
            if val not in (None, ""):
                parts.append(json.dumps(val, ensure_ascii=False) if isinstance(val, (dict, list)) else str(val))
        # Algunos campos pueden venir anidados en shipping o fulfillments.
        for key in ["shipping", "fulfillments", "fulfillment_orders"]:
            val = order.get(key)
            if val not in (None, ""):
                parts.append(json.dumps(val, ensure_ascii=False) if isinstance(val, (dict, list)) else str(val))
        txt = normalize_text(" ".join(parts))
        if not txt:
            return ""
        if "TANDIL" in txt:
            return "Tandil"
        if "MANJARES" in txt or "BUENOS AIRES" in txt or "CABA" in txt or "CAPITAL FEDERAL" in txt:
            return "Buenos Aires / Manjares"
        if "MAR DEL PLATA" in txt or "FABRICA" in txt or "FABRICA" in txt:
            return "Planta Mar del Plata"
    except Exception:
        return ""
    return ""

def tiendanube_api_shipping_status(order):
    """Obtiene el estado de envío desde la respuesta API de Tiendanube.

    El CSV exportado expone "Estado del envío" de forma directa, mientras que
    distintas respuestas/versiones de la API pueden entregarlo como
    shipping_status, fulfillment_status o dentro de shipping. Rawer Data
    normaliza esos casos para aplicar exactamente la misma regla de stock
    disponible que la importación CSV.
    """
    if not isinstance(order, dict):
        return ""

    candidates = [
        order.get("shipping_status"),
        order.get("fulfillment_status"),
        order.get("shipping_state"),
        order.get("shipment_status"),
    ]
    shipping = order.get("shipping")
    if isinstance(shipping, dict):
        candidates.extend([
            shipping.get("status"),
            shipping.get("shipping_status"),
            shipping.get("fulfillment_status"),
        ])
    elif shipping:
        candidates.append(shipping)

    # Preferimos cualquier valor que ya represente un pendiente según la regla
    # Rawer. Si ninguno coincide, conservamos el primer estado no vacío para
    # que quede visible en historial/diagnóstico.
    first_nonempty = ""
    for value in candidates:
        if value is None:
            continue
        if isinstance(value, (dict, list)):
            try:
                text = json.dumps(value, ensure_ascii=False)
            except Exception:
                text = str(value)
        else:
            text = str(value).strip()
        if not text:
            continue
        if not first_nonempty:
            first_nonempty = text
        if is_tiendanube_shipping_pending(text):
            return text
    return first_nonempty


def tiendanube_orders_to_lines(orders):
    products_df = get_products(False)[["id", "name"]]
    product_ids = dict(zip(products_df["name"], products_df["id"]))
    combo_map = active_combo_map()
    rows = []
    for order in orders:
        order_id = str(order.get("id") or "")
        order_number = str(order.get("number") or "")
        created_at = order.get("created_at") or ""
        payment_status = order.get("payment_status") or ""
        order_status = order.get("status") or ""
        shipping_status = tiendanube_api_shipping_status(order)
        customer_name = order.get("contact_name") or ""
        customer_email = order.get("contact_email") or ""
        if not customer_name and isinstance(order.get("customer"), dict):
            customer_name = order["customer"].get("name") or ""
            customer_email = customer_email or order["customer"].get("email") or ""
        delivery_date_tn, delivery_hint = extract_order_delivery_date(order)
        deposit_info = infer_tiendanube_deposit(order)
        guessed_deposit = deposit_info.get("deposit", PENDING_DEPOSIT)
        tn_location_id = deposit_info.get("location_id", "")
        tn_location_name = deposit_info.get("location_name", "")
        tn_distribution_center = deposit_info.get("distribution_center", "")
        deposit_source = deposit_info.get("source", "")
        for idx, item in enumerate(order.get("products") or []):
            sku = normalize_tn_sku(item.get("sku"))
            item_name = str(item.get("name") or "").strip()
            try:
                qty = float(item.get("quantity") or 0)
            except Exception:
                qty = 0.0

            if sku in combo_map:
                combo = combo_map[sku]
                for comp_idx, comp in enumerate(combo["components"]):
                    comp_qty = qty * float(comp["quantity_per_combo"] or 0)
                    rows.append({
                        "order_id": order_id,
                        "order_number": order_number,
                        "order_created_at": created_at,
                        "sku": comp.get("component_sku") or "",
                        "product_name_tn": f"{item_name} -> {comp['producto']}",
                        "product_id": comp["product_id"],
                        "product_name_rawer": comp["producto"],
                        "quantity": comp_qty,
                        "payment_status": payment_status,
                        "order_status": order_status,
                        "shipping_status": shipping_status,
                        "customer_name": customer_name,
                        "customer_email": customer_email,
                        "delivery_date_tn": delivery_date_tn,
                        "delivery_hint": delivery_hint,
                        "raw_json": json.dumps({"order": order, "item": item, "line_index": idx, "combo_component_index": comp_idx}, ensure_ascii=False),
                        "estado": "OK" if comp_qty > 0 else "Cantidad inválida",
                        "sale_type": "Combo desglosado",
                        "combo_sku": sku,
                        "combo_name": combo["combo_name"],
                        "sale_deposit": guessed_deposit,
                        "tn_location_id": tn_location_id,
                        "tn_location_name": tn_location_name,
                        "tn_distribution_center": tn_distribution_center,
                        "deposit_source": deposit_source,
                        "pendiente_por_estado_envio": is_tiendanube_shipping_pending(shipping_status),
                    })
                continue

            rawer_name = rawer_product_from_tn_sku(sku)
            product_id = product_ids.get(rawer_name) if rawer_name else None
            rows.append({
                "order_id": order_id,
                "order_number": order_number,
                "order_created_at": created_at,
                "sku": sku,
                "product_name_tn": item_name,
                "product_id": product_id,
                "product_name_rawer": rawer_name or "",
                "quantity": qty,
                "payment_status": payment_status,
                "order_status": order_status,
                "shipping_status": shipping_status,
                "customer_name": customer_name,
                "customer_email": customer_email,
                "delivery_date_tn": delivery_date_tn,
                "delivery_hint": delivery_hint,
                "raw_json": json.dumps({"order": order, "item": item, "line_index": idx}, ensure_ascii=False),
                "estado": "OK" if product_id else "SKU no reconocido",
                "sale_type": "Individual",
                "combo_sku": "",
                "combo_name": "",
                "sale_deposit": guessed_deposit,
                "tn_location_id": tn_location_id,
                "tn_location_name": tn_location_name,
                "tn_distribution_center": tn_distribution_center,
                "deposit_source": deposit_source,
                "pendiente_por_estado_envio": is_tiendanube_shipping_pending(shipping_status),
            })
    df = pd.DataFrame(rows)
    if df.empty:
        return df
    # Evita duplicados dentro de la misma importación si Tiendanube repite líneas idénticas.
    df = df.drop_duplicates(["order_id", "sku", "product_name_tn", "sale_type"], keep="last")
    return df


def guess_deposit_from_tiendanube_csv_row(row):
    """Mapea depósito desde la exportación CSV de Tiendanube.

    Si aparece Mar del Plata/Fábrica/Rawer, se considera Planta Mar del Plata.
    Si aparece CABA/Capital/Buenos Aires/Manjares, se considera Buenos Aires / Manjares.
    Si aparece Tandil, se considera Tandil.
    """
    parts = []
    for key in [
        "Medio de envío", "Notas del vendedor", "Notas del comprador", "Ciudad",
        "Localidad", "Provincia o estado", "Sucursal de venta", "Vendedor",
        "Nombre para el envío", "Dirección"
    ]:
        if key in row.index:
            val = row.get(key)
            if pd.notna(val) and str(val).strip():
                parts.append(str(val))
    txt = normalize_text(" ".join(parts))
    if not txt:
        return PENDING_DEPOSIT
    if "TANDIL" in txt:
        return "Tandil"
    if "MAR DEL PLATA" in txt or "MDP" in txt or "FABRICA" in txt or "FABRICA" in txt or "RAWER FABRICA" in txt:
        return "Planta Mar del Plata"
    if "MANJARES" in txt or "CABA" in txt or "CAPITAL FEDERAL" in txt or "BUENOS AIRES" in txt:
        return "Buenos Aires / Manjares"
    return PENDING_DEPOSIT


def _read_tiendanube_sales_csv(uploaded_file):
    """Lee CSV de ventas exportado desde Tiendanube con separador ; y encoding variable."""
    # Streamlit UploadedFile queda consumido después de leer; reseteamos si se puede.
    try:
        uploaded_file.seek(0)
    except Exception:
        pass
    last_error = None
    for enc in ["utf-8-sig", "latin1"]:
        for sep in [";", ","]:
            try:
                try:
                    uploaded_file.seek(0)
                except Exception:
                    pass
                raw = pd.read_csv(uploaded_file, sep=sep, encoding=enc, dtype=str)
                if len(raw.columns) > 3:
                    return raw
            except Exception as e:
                last_error = e
    raise ValueError(f"No pude leer el CSV de Tiendanube: {last_error}")


def parse_tiendanube_sales_csv(uploaded_file, default_deposit=DEFAULT_DEPOSIT):
    """Parsea CSV exportado de Tiendanube para importar ventas minoristas.

    Usa Estado del envío para determinar si la venta queda pendiente de entrega:
    - No está empaquetado
    - Listo para enviar
    """
    try:
        raw = _read_tiendanube_sales_csv(uploaded_file)
    except Exception as e:
        return pd.DataFrame(), str(e)

    required = ["Número de orden", "Nombre del producto", "Cantidad del producto", "SKU"]
    missing = [c for c in required if c not in raw.columns]
    if missing:
        return pd.DataFrame(), "Faltan columnas requeridas: " + ", ".join(missing)

    # En exportaciones Tiendanube, la orden viene en la primera línea y las líneas siguientes
    # del mismo pedido traen muchos campos vacíos. Se completa hacia abajo solo la información
    # de cabecera; producto/SKU/cantidad quedan por línea.
    product_cols = {"Nombre del producto", "Precio del producto", "Cantidad del producto", "SKU", "Producto Físico"}
    header_cols = [c for c in raw.columns if c not in product_cols]
    work = raw.copy()
    work[header_cols] = work[header_cols].ffill()

    products_df = get_products(False)[["id", "name"]]
    product_ids = dict(zip(products_df["name"], products_df["id"]))
    combo_map = active_combo_map()
    imported = imported_tiendanube_keys()
    rows = []
    for idx, row in work.iterrows():
        sku = normalize_tn_sku(row.get("SKU"))
        item_name = str(row.get("Nombre del producto") or "").strip()
        if not sku and not item_name:
            continue
        qty = pd.to_numeric(row.get("Cantidad del producto"), errors="coerce")
        qty = 0.0 if pd.isna(qty) else float(qty)
        order_number = str(row.get("Número de orden") or "").strip()
        order_id = str(row.get("Identificador de la orden") or "").strip() or order_number
        fecha = pd.to_datetime(row.get("Fecha"), dayfirst=True, errors="coerce")
        created_at = fecha.isoformat() if pd.notna(fecha) else str(row.get("Fecha") or "")
        shipping_status = str(row.get("Estado del envío") or "").strip()
        payment_status = str(row.get("Estado del pago") or "").strip()
        order_status = str(row.get("Estado de la orden") or "").strip()
        customer_name = str(row.get("Nombre del comprador") or row.get("Nombre para el envío") or "").strip()
        customer_email = str(row.get("Email") or "").strip()
        deposit = guess_deposit_from_tiendanube_csv_row(row)
        if deposit == PENDING_DEPOSIT and default_deposit in DEPOSITS:
            deposit = default_deposit
        delivery_hint = str(row.get("Notas del vendedor") or "").strip()
        raw_json = json.dumps({"source": "csv_tiendanube", "row": {k: ("" if pd.isna(v) else str(v)) for k, v in row.items()}}, ensure_ascii=False)

        base_reasons = []
        if not order_number:
            base_reasons.append("falta número de orden")
        if qty <= 0:
            base_reasons.append("cantidad inválida")
        if "CANCEL" in normalize_text(order_status):
            base_reasons.append("orden cancelada")
        if deposit not in DEPOSITS:
            base_reasons.append("depósito pendiente")

        def add_line(line_sku, line_name_tn, product_id, rawer_name, quantity, sale_type="Individual", combo_sku="", combo_name=""):
            estado = "OK"
            reasons = list(base_reasons)
            if not product_id:
                reasons.append("SKU no reconocido")
            # Desde v9.4: si la venta ya existe, NO la marcamos como "ya importada".
            # La guardamos con UPSERT para actualizar estado de envío, depósito y cantidad.
            # Esto corrige ventas importadas antes sin Estado del envío: al reimportar el CSV
            # pasan a descontar del stock disponible calculado si están pendientes.
            if reasons:
                estado = "NO IMPORTAR: " + "; ".join(reasons)
            rows.append({
                "order_id": order_id,
                "order_number": order_number,
                "order_created_at": created_at,
                "sku": line_sku,
                "product_name_tn": line_name_tn,
                "product_id": int(product_id) if product_id else None,
                "product_name_rawer": rawer_name or "",
                "quantity": float(quantity or 0),
                "payment_status": payment_status,
                "order_status": order_status,
                "shipping_status": shipping_status,
                "customer_name": customer_name,
                "customer_email": customer_email,
                "delivery_date_tn": "",
                "delivery_hint": delivery_hint,
                "raw_json": raw_json,
                "estado": estado,
                "sale_type": sale_type,
                "combo_sku": combo_sku,
                "combo_name": combo_name,
                "sale_deposit": deposit,
                "tn_location_id": "",
                "tn_location_name": "",
                "tn_distribution_center": str(row.get("Medio de envío") or ""),
                "deposit_source": "csv_tiendanube_medio_envio",
                "pendiente_por_estado_envio": is_tiendanube_shipping_pending(shipping_status),
            })

        if sku in combo_map:
            combo = combo_map[sku]
            for comp in combo["components"]:
                comp_qty = qty * float(comp["quantity_per_combo"] or 0)
                comp_sku = comp.get("component_sku") or ""
                add_line(comp_sku, f"{item_name} -> {comp['producto']}", comp["product_id"], comp["producto"], comp_qty, "Combo desglosado", sku, combo["combo_name"])
        else:
            rawer_name = rawer_product_from_tn_sku(sku)
            product_id = product_ids.get(rawer_name) if rawer_name else None
            add_line(sku, item_name, product_id, rawer_name or "", qty)

    df = pd.DataFrame(rows)
    if df.empty:
        return df, "No se detectaron líneas de producto en el CSV."
    df = df.drop_duplicates(["order_id", "sku", "product_name_tn", "sale_type"], keep="last")
    return df, ""

def imported_tiendanube_keys():
    df = read_sql("SELECT order_id, sku, product_name_tn FROM tiendanube_sales WHERE COALESCE(is_undone,0) = 0")
    if df.empty:
        return set()
    return set(zip(df["order_id"].astype(str), df["sku"].astype(str), df["product_name_tn"].astype(str)))


def save_tiendanube_sales(lines_df, sale_deposit=DEFAULT_DEPOSIT):
    if lines_df is None or lines_df.empty:
        return 0
    conn = get_conn()
    now = datetime.now().isoformat(timespec="seconds")
    count = 0
    for _, row in lines_df.iterrows():
        if row.get("estado") != "OK":
            continue
        if str(row.get("sale_deposit") or sale_deposit) not in DEPOSITS:
            continue
        cur = conn.execute(
            """
            INSERT INTO tiendanube_sales(
                order_id, order_number, order_created_at, imported_at, sku, product_name_tn,
                product_id, product_name_rawer, quantity, payment_status, order_status,
                shipping_status, customer_name, customer_email, raw_json,
                sale_type, combo_sku, combo_name, sale_deposit, delivery_date_tn, delivery_hint,
                tn_location_id, tn_location_name, tn_distribution_center, deposit_source
            ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
            ON CONFLICT(order_id, sku, product_name_tn) DO UPDATE SET
                order_number=excluded.order_number,
                order_created_at=excluded.order_created_at,
                imported_at=excluded.imported_at,
                product_id=excluded.product_id,
                product_name_rawer=excluded.product_name_rawer,
                quantity=excluded.quantity,
                payment_status=excluded.payment_status,
                order_status=excluded.order_status,
                shipping_status=excluded.shipping_status,
                customer_name=excluded.customer_name,
                customer_email=excluded.customer_email,
                raw_json=excluded.raw_json,
                sale_type=excluded.sale_type,
                combo_sku=excluded.combo_sku,
                combo_name=excluded.combo_name,
                sale_deposit=excluded.sale_deposit,
                delivery_date_tn=excluded.delivery_date_tn,
                delivery_hint=excluded.delivery_hint,
                tn_location_id=excluded.tn_location_id,
                tn_location_name=excluded.tn_location_name,
                tn_distribution_center=excluded.tn_distribution_center,
                deposit_source=excluded.deposit_source,
                is_undone=0,
                undone_at=NULL,
                undo_reason=NULL
            """,
            (
                str(row.get("order_id") or ""),
                str(row.get("order_number") or ""),
                str(row.get("order_created_at") or ""),
                now,
                str(row.get("sku") or ""),
                str(row.get("product_name_tn") or ""),
                int(row.get("product_id")) if pd.notna(row.get("product_id")) else None,
                str(row.get("product_name_rawer") or ""),
                float(row.get("quantity") or 0),
                str(row.get("payment_status") or ""),
                str(row.get("order_status") or ""),
                str(row.get("shipping_status") or ""),
                str(row.get("customer_name") or ""),
                str(row.get("customer_email") or ""),
                str(row.get("raw_json") or ""),
                str(row.get("sale_type") or "Individual"),
                str(row.get("combo_sku") or ""),
                str(row.get("combo_name") or ""),
                str(row.get("sale_deposit") or sale_deposit) if str(row.get("sale_deposit") or sale_deposit) in DEPOSITS else PENDING_DEPOSIT,
                str(row.get("delivery_date_tn") or ""),
                str(row.get("delivery_hint") or ""),
                str(row.get("tn_location_id") or ""),
                str(row.get("tn_location_name") or ""),
                str(row.get("tn_distribution_center") or ""),
                str(row.get("deposit_source") or ""),
            ),
        )
        if cur.rowcount and cur.rowcount > 0:
            count += 1
    conn.commit()
    conn.close()
    return count


def _raw_tn_date(value):
    """Convierte fechas guardadas por Tiendanube a date cuando hay un día concreto.

    Si el dato es un rango estimado (por ejemplo 2026-09-18 a 2026-09-20),
    devuelve None para no mostrarlo erróneamente como una entrega exacta del día.
    """
    if value is None:
        return None
    txt = str(value).strip()
    if not txt:
        return None
    # Los rangos de entrega no representan un día de entrega confirmado.
    low = txt.lower()
    if ' a ' in low and len(txt) > 10:
        return None
    # Tiendanube suele guardar ISO, pero admitimos también formatos locales.
    candidates = [txt, txt[:10]]
    for candidate in candidates:
        if not candidate:
            continue
        for dayfirst in (False, True):
            try:
                dt = pd.to_datetime(candidate, errors='coerce', dayfirst=dayfirst)
                if pd.notna(dt):
                    return dt.date()
            except Exception:
                pass
    return None


def tiendanube_today_views(target_date=None, deposit='Todos'):
    """Devuelve entregas previstas y ventas creadas para un día concreto.

    Se basa exclusivamente en ventas Tiendanube ya guardadas en Rawer Data.
    El filtro de depósito se aplica a ambas vistas.
    """
    target_date = target_date or date.today()
    df = tiendanube_sales_df()
    if df is None or df.empty:
        return pd.DataFrame(), pd.DataFrame()
    work = df.copy()
    work['_fecha_venta_d'] = work['fecha_venta'].apply(_raw_tn_date)
    work['_fecha_entrega_d'] = work['fecha_entrega_tiendanube'].apply(_raw_tn_date)
    if deposit and deposit != 'Todos':
        work = work[work['deposito'].astype(str) == str(deposit)].copy()
    ventas = work[work['_fecha_venta_d'] == target_date].copy()
    entregas = work[work['_fecha_entrega_d'] == target_date].copy()
    return entregas, ventas


def tiendanube_sales_df():
    df = read_sql(
        """
        SELECT s.order_created_at AS fecha_venta, s.order_number AS numero_orden, s.order_id,
               COALESCE(s.sale_deposit, '') AS deposito,
               s.sku, s.product_name_tn AS producto_tiendanube, s.product_name_rawer AS producto_rawer,
               s.quantity AS cantidad,
               COALESCE((
                   SELECT SUM(m.quantity)
                   FROM movements m
                   WHERE m.movement_type = 'despacho'
                     AND COALESCE(m.is_undone,0) = 0
                     AND m.product_id = s.product_id
                     AND COALESCE(m.deposit, '') = COALESCE(s.sale_deposit, '')
                     AND TRIM(COALESCE(m.numero_comanda, '')) = TRIM(COALESCE(s.order_number, ''))
               ), 0) AS despachado_rawer,
               (
                   SELECT MIN(m.movement_date)
                   FROM movements m
                   WHERE m.movement_type = 'despacho'
                     AND COALESCE(m.is_undone,0) = 0
                     AND m.product_id = s.product_id
                     AND COALESCE(m.deposit, '') = COALESCE(s.sale_deposit, '')
                     AND TRIM(COALESCE(m.numero_comanda, '')) = TRIM(COALESCE(s.order_number, ''))
               ) AS fecha_despacho_rawer,
               COALESCE(s.delivery_date_tn, '') AS fecha_entrega_tiendanube,
               COALESCE(s.delivery_hint, '') AS dato_entrega_origen,
               COALESCE(s.tn_distribution_center, '') AS ubicacion_tienda_nube,
               COALESCE(s.deposit_source, '') AS origen_deposito,
               COALESCE(s.tn_location_id, '') AS location_id_tn,
               COALESCE(s.tn_location_name, '') AS ubicacion_tn,
               s.payment_status AS pago, s.order_status AS estado_pedido,
               s.shipping_status AS estado_envio, s.customer_name AS cliente, s.customer_email AS email,
               COALESCE(s.sale_type,'Individual') AS tipo_venta, s.combo_sku, s.combo_name AS combo,
               s.imported_at AS importado_el, COALESCE(s.is_undone,0) AS anulado,
               COALESCE(s.undone_at,'') AS anulado_el, COALESCE(s.undo_reason,'') AS motivo_anulacion
        FROM tiendanube_sales s
        WHERE COALESCE(s.is_undone,0) = 0
        ORDER BY datetime(fecha_venta) DESC, numero_orden DESC, sku
        """
    )
    if df.empty:
        return df
    df["cantidad"] = pd.to_numeric(df["cantidad"], errors="coerce").fillna(0.0)
    df["despachado_rawer"] = pd.to_numeric(df["despachado_rawer"], errors="coerce").fillna(0.0)
    df["pendiente_por_estado_envio"] = df["estado_envio"].apply(is_tiendanube_shipping_pending)
    df["pendiente_entrega"] = 0.0
    mask = df["pendiente_por_estado_envio"]
    df.loc[mask, "pendiente_entrega"] = (df.loc[mask, "cantidad"] - df.loc[mask, "despachado_rawer"]).clip(lower=0)
    df["estado_entrega_rawer"] = "No pendiente por estado envío"
    df.loc[df["pendiente_entrega"] > 0, "estado_entrega_rawer"] = "Pendiente"
    df.loc[(df["pendiente_entrega"] > 0) & (df["despachado_rawer"] > 0), "estado_entrega_rawer"] = "Parcial"
    df.loc[(df["pendiente_por_estado_envio"]) & (df["pendiente_entrega"] <= 0), "estado_entrega_rawer"] = "Entregado"
    return df


def tiendanube_dispatch_order_lines(order_number, deposit):
    """Devuelve los renglones pendientes de una comanda Tiendanube para despacho.

    La venta ya importada/sincronizada es la fuente de verdad. Agrupa por SKU Rawer
    (product_id), descuenta despachos previos de la misma comanda y depósito, y nunca
    permite sugerir más que lo pendiente.
    """
    order_number = str(order_number or "").strip()
    deposit = str(deposit or "").strip()
    if not order_number:
        return pd.DataFrame(columns=["product_id", "sku", "producto", "pedido", "despachado", "pendiente", "despachar_ahora", "lote"])
    sales = read_sql(
        """
        SELECT s.product_id, COALESCE(s.sku,'') AS sku,
               COALESCE(NULLIF(s.product_name_rawer,''), s.product_name_tn, '') AS producto,
               SUM(s.quantity) AS pedido
        FROM tiendanube_sales s
        WHERE COALESCE(s.is_undone,0)=0
          AND TRIM(COALESCE(s.order_number,'')) = ?
          AND COALESCE(s.sale_deposit,'') = ?
          AND s.product_id IS NOT NULL
        GROUP BY s.product_id, COALESCE(s.sku,''), COALESCE(NULLIF(s.product_name_rawer,''), s.product_name_tn, '')
        ORDER BY producto
        """,
        (order_number, deposit),
    )
    if sales.empty:
        return pd.DataFrame(columns=["product_id", "sku", "producto", "pedido", "despachado", "pendiente", "despachar_ahora", "lote"])
    disp = read_sql(
        """
        SELECT product_id, SUM(quantity) AS despachado
        FROM movements
        WHERE movement_type='despacho'
          AND COALESCE(is_undone,0)=0
          AND TRIM(COALESCE(numero_comanda,'')) = ?
          AND COALESCE(deposit,'') = ?
        GROUP BY product_id
        """,
        (order_number, deposit),
    )
    sales["pedido"] = pd.to_numeric(sales["pedido"], errors="coerce").fillna(0.0)
    if disp.empty:
        sales["despachado"] = 0.0
    else:
        disp["despachado"] = pd.to_numeric(disp["despachado"], errors="coerce").fillna(0.0)
        sales = sales.merge(disp, on="product_id", how="left")
        sales["despachado"] = sales["despachado"].fillna(0.0)
    sales["pendiente"] = (sales["pedido"] - sales["despachado"]).clip(lower=0.0)
    sales["despachar_ahora"] = sales["pendiente"]
    sales["lote"] = ""
    return sales[["product_id", "sku", "producto", "pedido", "despachado", "pendiente", "despachar_ahora", "lote"]]


def save_tiendanube_dispatch_lines(order_number, movement_date, deposit, edited_df, note=""):
    """Guarda despacho completo/parcial, permitiendo repartir un SKU entre varios lotes."""
    current = tiendanube_dispatch_order_lines(order_number, deposit)
    if current.empty:
        return 0, "No se encontró la comanda o ya no tiene renglones válidos."
    pending_by_pid = {int(r.product_id): float(r.pendiente) for r in current.itertuples()}
    name_by_pid = {int(r.product_id): str(r.producto) for r in current.itertuples()}
    rows = []
    for _, row in edited_df.iterrows():
        try:
            pid = int(row.get('product_id'))
        except Exception:
            continue
        qv = pd.to_numeric(row.get('despachar_ahora'), errors='coerce')
        qty = 0.0 if pd.isna(qv) else float(qv)
        if qty < -1e-9:
            return 0, "La cantidad a despachar no puede ser negativa."
        if qty <= 1e-9:
            continue
        lot = _normalize_dispatch_lot(row.get('lote'))
        rows.append({'product_id': pid, 'qty': qty, 'lote': lot})
    if not rows:
        return 0, "No hay cantidades mayores a cero para despachar."

    req = pd.DataFrame(rows)
    totals = req.groupby('product_id', as_index=False)['qty'].sum()
    for r in totals.itertuples():
        pending = float(pending_by_pid.get(int(r.product_id), 0.0))
        if float(r.qty) > pending + 1e-9:
            pname = name_by_pid.get(int(r.product_id), str(r.product_id))
            return 0, f"{pname}: intentás despachar {float(r.qty):g} en total y quedan {pending:g} pendiente(s)."

    # Validación de stock por lote justo antes de grabar.
    rec = lot_stock_reconciliation_df(movement_date)
    for (pid, lot), grp in req.groupby(['product_id','lote'], dropna=False):
        requested = float(grp['qty'].sum())
        pname = name_by_pid.get(int(pid), str(pid))
        if lot:
            lot_df = stock_by_lot_df(as_of=movement_date, product_id=int(pid), deposit=deposit)
            match = lot_df[lot_df['lote'].astype(str).str.strip() == str(lot).strip()] if not lot_df.empty else lot_df
            available = float(match['stock_lote'].sum()) if not match.empty else 0.0
            if requested > available + 1e-9:
                return 0, f"{pname} · lote {lot}: querés despachar {requested:g} y hay {available:g} disponibles en ese lote."
        else:
            rr = rec[(rec['product_id'] == int(pid)) & (rec['deposito'] == deposit)]
            available = max(float(rr['diferencia_sin_lote'].iloc[0]), 0.0) if not rr.empty else 0.0
            if requested > available + 1e-9:
                return 0, f"{pname}: querés despachar {requested:g} sin lote y solo hay {available:g} unidades de stock no trazable."

    for r in rows:
        add_movement(movement_date, r['product_id'], 'despacho', r['qty'], movement_date, note, 'tiendanube_comanda', str(order_number).strip(), r['lote'], deposit)
    return len(rows), "OK"

def dispatch_movements_df():
    return read_sql(
        """
        SELECT m.id, m.movement_date AS fecha, COALESCE(m.deposit, '') AS deposito,
               m.product_id, p.name AS producto, m.quantity AS cantidad,
               COALESCE(m.numero_comanda, '') AS numero_comanda,
               COALESCE(m.lote, '') AS lote,
               COALESCE(m.note, '') AS observacion,
               m.created_at AS cargado_el
        FROM movements m
        JOIN products p ON p.id = m.product_id
        WHERE m.movement_type = 'despacho' AND COALESCE(m.is_undone,0) = 0
        ORDER BY date(m.movement_date) DESC, m.id DESC
        """
    )


