def seed_supplier_tables():
    """Carga proveedores/precios base sin pisar modificaciones existentes."""
    conn = get_conn()
    now = datetime.now().isoformat(timespec="seconds")
    cur = conn.cursor()
    supplier_names = set()
    for provider, _, _ in PLANNING_GENERAL_SUPPLIERS.values():
        if provider:
            supplier_names.add(str(provider))
    for provider, _ in PLANNING_SUPPLIER_PRICES.keys():
        if provider:
            supplier_names.add(str(provider))
    for rule in PLANNING_SPECIAL_RULES:
        supplier_names.add(rule.get("proveedor", ""))
    for name in sorted(n for n in supplier_names if n):
        cur.execute(
            """
            INSERT OR IGNORE INTO suppliers(name, notes, active, created_at, updated_at)
            VALUES (?, ?, 1, ?, ?)
            """,
            (name, "Proveedor base Rawer", now, now),
        )
    conn.commit()
    supplies = pd.read_sql_query("SELECT id, name FROM supplies", conn)
    suppliers = pd.read_sql_query("SELECT id, name FROM suppliers", conn)
    supply_map = {str(r["name"]): int(r["id"]) for _, r in supplies.iterrows()}
    supplier_map = {str(r["name"]): int(r["id"]) for _, r in suppliers.iterrows()}
    for insumo, (provider, entry_day, note) in PLANNING_GENERAL_SUPPLIERS.items():
        if provider not in supplier_map or insumo not in supply_map:
            continue
        cur.execute(
            """
            INSERT OR IGNORE INTO supplier_supply_prices
            (supplier_id, supply_id, price_unit, entry_day, note, active, created_at, updated_at)
            VALUES (?, ?, 0, ?, ?, 1, ?, ?)
            """,
            (supplier_map[provider], supply_map[insumo], entry_day, note, now, now),
        )
    for (provider, insumo), price in PLANNING_SUPPLIER_PRICES.items():
        if provider not in supplier_map or insumo not in supply_map:
            continue
        cur.execute(
            """
            INSERT INTO supplier_supply_prices
            (supplier_id, supply_id, price_unit, entry_day, note, active, created_at, updated_at)
            VALUES (?, ?, ?, ?, ?, 1, ?, ?)
            ON CONFLICT(supplier_id, supply_id) DO UPDATE SET
                price_unit=CASE WHEN supplier_supply_prices.price_unit IS NULL OR supplier_supply_prices.price_unit=0 THEN excluded.price_unit ELSE supplier_supply_prices.price_unit END,
                updated_at=supplier_supply_prices.updated_at
            """,
            (supplier_map[provider], supply_map[insumo], float(price or 0), PLANNING_GENERAL_SUPPLIERS.get(insumo, (provider, "Compra semanal", ""))[1], PLANNING_GENERAL_SUPPLIERS.get(insumo, (provider, "", ""))[2], now, now),
        )
    conn.commit()
    conn.close()


def provider_supply_prices_df(active_only=True):
    where = "WHERE sp.active = 1 AND sup.active = 1" if active_only else ""
    return read_sql(
        f"""
        SELECT sp.id, sup.name AS proveedor, s.name AS insumo, s.category AS categoria, s.unit AS unidad,
               sp.price_unit AS precio_unitario, COALESCE(sp.entry_day,'') AS dia_ingreso,
               COALESCE(sp.note,'') AS observacion, sp.active AS activo, sp.updated_at AS actualizado_el
        FROM supplier_supply_prices sp
        JOIN suppliers sup ON sup.id = sp.supplier_id
        JOIN supplies s ON s.id = sp.supply_id
        {where}
        ORDER BY sup.name, s.category, s.name
        """
    )


def supplier_names(active_only=True):
    where = "WHERE active = 1" if active_only else ""
    df = read_sql(f"SELECT name FROM suppliers {where} ORDER BY name")
    return df["name"].tolist() if not df.empty else []


def planning_supplier_price(provider, insumo):
    provider = str(provider)
    insumo = str(insumo)
    try:
        df = read_sql(
            """
            SELECT sp.price_unit
            FROM supplier_supply_prices sp
            JOIN suppliers sup ON sup.id = sp.supplier_id
            JOIN supplies s ON s.id = sp.supply_id
            WHERE sup.name = ? AND s.name = ? AND sp.active = 1 AND sup.active = 1
            LIMIT 1
            """,
            (provider, insumo),
        )
        if not df.empty:
            return float(df.iloc[0]["price_unit"] or 0.0)
    except Exception:
        pass
    return float(PLANNING_SUPPLIER_PRICES.get((provider, insumo), 0.0) or 0.0)


def planning_general_supplier(insumo):
    insumo = str(insumo).strip().upper()
    try:
        df = read_sql(
            """
            SELECT sup.name AS proveedor, COALESCE(sp.entry_day,'Compra semanal') AS dia_ingreso,
                   COALESCE(sp.note,'') AS observacion, sp.price_unit
            FROM supplier_supply_prices sp
            JOIN suppliers sup ON sup.id = sp.supplier_id
            JOIN supplies s ON s.id = sp.supply_id
            WHERE UPPER(TRIM(s.name)) = ? AND sp.active = 1 AND sup.active = 1
            ORDER BY CASE WHEN sp.price_unit > 0 THEN 0 ELSE 1 END, sp.id
            LIMIT 1
            """,
            (insumo,),
        )
        if not df.empty:
            r = df.iloc[0]
            return str(r["proveedor"]), str(r["dia_ingreso"] or "Compra semanal"), str(r["observacion"] or "")
    except Exception:
        pass

    # Fallback seguro: no llamar a esta misma función porque genera recursión infinita
    provider, entry_day, note = PLANNING_GENERAL_SUPPLIERS.get(
        insumo,
        ("Proveedor pendiente", "Revisar", "Insumo sin proveedor asignado"),
    )
    return provider, entry_day, note


def is_packaging_category(category):
    c = str(category or "").lower()
    return ("bolsa" in c) or ("etiqueta" in c) or ("packaging" in c)


def build_weekly_plan_from_matrix(matrix_df):
    """Convierte la matriz producto x dias en filas dia/producto/batchs."""
    rows = []
    if matrix_df is None or matrix_df.empty:
        return pd.DataFrame(columns=["dia", "product_id", "producto", "batchs"])
    for _, row in matrix_df.iterrows():
        product_id = int(row.get("id"))
        producto = str(row.get("producto") or "")
        for day in PLANNING_WEEK_DAYS:
            batchs = pd.to_numeric(row.get(day, 0), errors="coerce")
            if pd.notna(batchs) and float(batchs) > 0:
                rows.append({"dia": day, "product_id": product_id, "producto": producto, "batchs": float(batchs)})
    return pd.DataFrame(rows)


def calculate_weekly_planning(plan_rows):
    """Calcula necesidades diarias y pedido sugerido por proveedor desde una planificación semanal."""
    if plan_rows is None or plan_rows.empty:
        return pd.DataFrame(), pd.DataFrame(), pd.DataFrame(), pd.DataFrame()
    conn = get_conn()
    recipes = pd.read_sql_query(
        """
        SELECT r.product_id, s.id AS supply_id, s.name AS insumo, s.category AS categoria, s.unit AS unidad,
               r.quantity_per_batch, COALESCE(ss.quantity,0) AS stock_actual
        FROM product_recipes r
        JOIN supplies s ON s.id = r.supply_id
        LEFT JOIN supply_stock ss ON ss.supply_id = s.id
        WHERE s.active = 1
        """,
        conn,
    )
    conn.close()
    if recipes.empty:
        return pd.DataFrame(), pd.DataFrame(), pd.DataFrame(), pd.DataFrame()
    merged = recipes.merge(plan_rows, on="product_id", how="inner")
    if merged.empty:
        return pd.DataFrame(), pd.DataFrame(), pd.DataFrame(), pd.DataFrame()
    merged["necesario_base"] = merged["quantity_per_batch"] * merged["batchs"]
    detail = merged[["dia", "producto", "batchs", "insumo", "categoria", "unidad", "quantity_per_batch", "necesario_base", "stock_actual"]].copy()
    daily = detail.groupby(["dia", "insumo", "categoria", "unidad"], as_index=False).agg(
        necesario_base=("necesario_base", "sum"),
        stock_actual=("stock_actual", "max"),
    )
    daily["orden_dia"] = daily["dia"].map(PLANNING_DAY_ORDER).fillna(99)
    daily["extra_5"] = daily["necesario_base"] * 0.05
    daily["necesario_total"] = daily["necesario_base"] + daily["extra_5"]
    daily["faltante_vs_stock"] = (daily["necesario_total"] - daily["stock_actual"]).clip(lower=0)
    daily = daily.sort_values(["orden_dia", "categoria", "insumo"]).drop(columns=["orden_dia"])

    weekly = daily.groupby(["insumo", "categoria", "unidad"], as_index=False).agg(
        necesario_base=("necesario_base", "sum"),
        stock_actual=("stock_actual", "max"),
    )
    weekly["extra_5"] = weekly["necesario_base"] * 0.05
    weekly["necesario_total"] = weekly["necesario_base"] + weekly["extra_5"]
    weekly["comprar_vs_stock"] = (weekly["necesario_total"] - weekly["stock_actual"]).clip(lower=0)
    weekly["estado"] = weekly["comprar_vs_stock"].apply(lambda x: "OK" if x <= 0 else "Comprar")
    weekly = weekly.sort_values(["estado", "categoria", "insumo"], ascending=[False, True, True])

    provider_rows = []
    for _, row in daily.iterrows():
        insumo = str(row["insumo"])
        dia = str(row["dia"])
        assigned = False

        # Insumos congelados: se piden un día antes del día de uso.
        # Esto evita planificarlos como compra semanal y permite prever descongelado.
        if insumo in PLANNING_FROZEN_ONE_DAY_BEFORE:
            provider, _, obs = planning_general_supplier(insumo)
            ingreso = planning_entry_day_for_frozen(dia)
            provider_rows.append({
                "proveedor": provider,
                "dia_ingreso": ingreso,
                "para_usar": dia,
                "dia_produccion": dia,
                "insumo": insumo,
                "categoria": row["categoria"],
                "unidad": row["unidad"],
                "necesario_base": row["necesario_base"],
                "extra_5": row["extra_5"],
                "necesario_total": row["necesario_total"],
                "stock_actual": row["stock_actual"],
                "observacion": "Congelado: pedir un día antes para descongelar",
            })
            continue

        for rule in PLANNING_SPECIAL_RULES:
            if dia in rule["dias_uso"] and insumo in rule["insumos"]:
                provider_rows.append({
                    "proveedor": rule["proveedor"],
                    "dia_ingreso": rule["dia_ingreso"],
                    "para_usar": rule["para_usar"],
                    "dia_produccion": dia,
                    "insumo": insumo,
                    "categoria": row["categoria"],
                    "unidad": row["unidad"],
                    "necesario_base": row["necesario_base"],
                    "extra_5": row["extra_5"],
                    "necesario_total": row["necesario_total"],
                    "stock_actual": row["stock_actual"],
                    "observacion": "Regla fija de abastecimiento semanal",
                })
                assigned = True
                break
        if assigned:
            continue
        provider, ingreso, obs = planning_general_supplier(insumo)
        provider_rows.append({
            "proveedor": provider,
            "dia_ingreso": ingreso,
            "para_usar": "Semana completa",
            "dia_produccion": dia,
            "insumo": insumo,
            "categoria": row["categoria"],
            "unidad": row["unidad"],
            "necesario_base": row["necesario_base"],
            "extra_5": row["extra_5"],
            "necesario_total": row["necesario_total"],
            "stock_actual": row["stock_actual"],
            "observacion": obs,
        })
    provider_detail = pd.DataFrame(provider_rows)
    if provider_detail.empty:
        provider_order = pd.DataFrame()
    else:
        provider_order = provider_detail.groupby(["proveedor", "dia_ingreso", "para_usar", "insumo", "categoria", "unidad", "observacion"], as_index=False).agg(
            necesario_base=("necesario_base", "sum"),
            extra_5=("extra_5", "sum"),
            necesario_total=("necesario_total", "sum"),
            stock_actual=("stock_actual", "max"),
        )
        # La compra por proveedor se muestra bruta por proveedor. El control contra stock semanal queda en Resumen semanal.
        provider_order["cantidad_a_pedir"] = provider_order["necesario_total"]
        provider_order["costo_unitario_proveedor"] = provider_order.apply(
            lambda r: planning_supplier_price(r["proveedor"], r["insumo"]), axis=1
        )
        provider_order["costo_estimado"] = provider_order["cantidad_a_pedir"] * provider_order["costo_unitario_proveedor"]
        provider_order["estado_costo"] = provider_order["costo_unitario_proveedor"].apply(lambda x: "OK" if x > 0 else "Sin precio")
        provider_order = provider_order.sort_values(["dia_ingreso", "proveedor", "insumo"])
    return detail, daily, weekly, provider_order




def build_weekly_dehydrator_plan_from_matrix(matrix_df):
    """Convierte matriz producto deshidratado x días en filas día/producto/paquetes."""
    rows = []
    if matrix_df is None or matrix_df.empty:
        return pd.DataFrame(columns=["dia", "producto", "paquetes"])
    for _, row in matrix_df.iterrows():
        producto = str(row.get("producto") or "")
        for day in PLANNING_WEEK_DAYS:
            qty = pd.to_numeric(row.get(day, 0), errors="coerce")
            if pd.notna(qty) and float(qty) > 0:
                rows.append({"dia": day, "producto": producto, "paquetes": float(qty)})
    return pd.DataFrame(rows)


def dehydrator_packaging_for_product(producto):
    """Packaging estimado para planificación de deshidratadores por paquete terminado."""
    p = str(producto or "").upper().strip()
    label_map = {
        "JERKY HIGADO": "ETIQUETA JERKY HIGADO",
        "JERKY CORAZON": "ETIQUETA JERKY CORAZON",
        "JERKY PECHUGA": "ETIQUETA JERKY PECHUGA",
        "JERKY PULMON": "ETIQUETA JERKY PULMON",
        "JERKY CORNALITO": "ETIQUETA JERKY CORNALITO",
        "JERKY MIX": "ETIQUETA JERKY MIX",
        "JERKY MERLUZA": "ETIQUETA JERKY MERLUZA",
        "JERKY BEEF 110GR": "ETIQUETA JERKY BEEF",
        "JERKY FARM": "ETIQUETA JERKY FARM",
        "JERKY OCEAN": "ETIQUETA JERKY OCEAN",
    }
    pack = {}
    if p in label_map:
        pack[label_map[p]] = 1.0
        if p in ["JERKY HIGADO", "JERKY CORAZON", "JERKY CORNALITO"]:
            pack["DOYPACK 12X18"] = 1.0
        else:
            pack["DOYPACK 16X24"] = 1.0
    elif p == "TRAQUEAS X 6U":
        pack["ETIQUETA TRAQUEAS X6"] = 1.0
    elif p == "OREJAS X 6U":
        pack["ETIQUETA OREJAS X6"] = 1.0
    return pack


def _planning_rows_to_provider_order(daily_df):
    """Asigna proveedor/costo a una necesidad diaria de insumos/packaging."""
    provider_rows = []
    if daily_df is None or daily_df.empty:
        return pd.DataFrame()
    for _, row in daily_df.iterrows():
        insumo = str(row["insumo"])
        dia = str(row["dia"])
        assigned = False
        if insumo in PLANNING_FROZEN_ONE_DAY_BEFORE:
            provider, _, obs = planning_general_supplier(insumo)
            ingreso = planning_entry_day_for_frozen(dia)
            provider_rows.append({
                "proveedor": provider,
                "dia_ingreso": ingreso,
                "para_usar": dia,
                "dia_produccion": dia,
                "insumo": insumo,
                "categoria": row["categoria"],
                "unidad": row["unidad"],
                "necesario_base": row["necesario_base"],
                "extra_5": row["extra_5"],
                "necesario_total": row["necesario_total"],
                "stock_actual": row["stock_actual"],
                "observacion": "Congelado: pedir un día antes para descongelar",
            })
            continue
        for rule in PLANNING_SPECIAL_RULES:
            if dia in rule["dias_uso"] and insumo in rule["insumos"]:
                provider_rows.append({
                    "proveedor": rule["proveedor"],
                    "dia_ingreso": rule["dia_ingreso"],
                    "para_usar": rule["para_usar"],
                    "dia_produccion": dia,
                    "insumo": insumo,
                    "categoria": row["categoria"],
                    "unidad": row["unidad"],
                    "necesario_base": row["necesario_base"],
                    "extra_5": row["extra_5"],
                    "necesario_total": row["necesario_total"],
                    "stock_actual": row["stock_actual"],
                    "observacion": "Regla fija de abastecimiento semanal",
                })
                assigned = True
                break
        if assigned:
            continue
        provider, ingreso, obs = planning_general_supplier(insumo)
        provider_rows.append({
            "proveedor": provider,
            "dia_ingreso": ingreso,
            "para_usar": "Semana completa" if ingreso == "Compra semanal" else dia,
            "dia_produccion": dia,
            "insumo": insumo,
            "categoria": row["categoria"],
            "unidad": row["unidad"],
            "necesario_base": row["necesario_base"],
            "extra_5": row["extra_5"],
            "necesario_total": row["necesario_total"],
            "stock_actual": row["stock_actual"],
            "observacion": obs,
        })
    provider_detail = pd.DataFrame(provider_rows)
    if provider_detail.empty:
        return pd.DataFrame()
    provider_order = provider_detail.groupby(["proveedor", "dia_ingreso", "para_usar", "insumo", "categoria", "unidad", "observacion"], as_index=False).agg(
        necesario_base=("necesario_base", "sum"),
        extra_5=("extra_5", "sum"),
        necesario_total=("necesario_total", "sum"),
        stock_actual=("stock_actual", "max"),
    )
    provider_order["cantidad_a_pedir"] = provider_order["necesario_total"]
    provider_order["costo_unitario_proveedor"] = provider_order.apply(lambda r: planning_supplier_price(r["proveedor"], r["insumo"]), axis=1)
    provider_order["costo_estimado"] = provider_order["cantidad_a_pedir"] * provider_order["costo_unitario_proveedor"]
    provider_order["estado_costo"] = provider_order["costo_unitario_proveedor"].apply(lambda x: "OK" if x > 0 else "Sin precio")
    return provider_order.sort_values(["dia_ingreso", "proveedor", "insumo"])


def calculate_weekly_dehydrator_planning(dehyd_rows):
    """Calcula necesidades semanales de deshidratadores por paquetes, incluyendo packaging y costos."""
    empty = pd.DataFrame()
    if dehyd_rows is None or dehyd_rows.empty:
        return empty, empty, empty, empty
    stock = current_supply_stock()
    stock_map = {str(r["name"]): float(r["stock_actual"] or 0) for _, r in stock.iterrows()}
    unit_map = {str(r["name"]): str(r["unit"]) for _, r in stock.iterrows()}
    cat_map = {str(r["name"]): str(r["category"]) for _, r in stock.iterrows()}
    rows = []
    for _, row in dehyd_rows.iterrows():
        dia = str(row.get("dia") or "")
        producto = str(row.get("producto") or "")
        paquetes = float(row.get("paquetes") or 0)
        info = DESHIDRATADOR_YIELDS.get(producto, {})
        componentes = info.get("componentes")
        if componentes:
            for comp in componentes:
                insumo = comp.get("insumo")
                por_paquete = float(comp.get("carga") or 0)
                rows.append({
                    "dia": dia, "producto": producto, "paquetes": paquetes,
                    "insumo": insumo, "categoria": cat_map.get(insumo, "Materia prima"),
                    "unidad": unit_map.get(insumo, comp.get("unidad_insumo", "")),
                    "cantidad_por_paquete": por_paquete,
                    "necesario_base": por_paquete * paquetes,
                    "stock_actual": stock_map.get(insumo, 0.0),
                    "tipo": "Materia prima",
                })
        else:
            insumo = info.get("insumo")
            carga = float(info.get("carga") or 0)
            paquetes_tanda = float(info.get("paquetes_estimados") or 0)
            por_paquete = (carga / paquetes_tanda) if paquetes_tanda else 0.0
            rows.append({
                "dia": dia, "producto": producto, "paquetes": paquetes,
                "insumo": insumo, "categoria": cat_map.get(insumo, "Materia prima"),
                "unidad": unit_map.get(insumo, info.get("unidad_insumo", "")),
                "cantidad_por_paquete": por_paquete,
                "necesario_base": por_paquete * paquetes,
                "stock_actual": stock_map.get(insumo, 0.0),
                "tipo": "Materia prima",
            })
        # Packaging y etiquetas por paquete terminado.
        for pack_insumo, pack_qty in dehydrator_packaging_for_product(producto).items():
            rows.append({
                "dia": dia, "producto": producto, "paquetes": paquetes,
                "insumo": pack_insumo, "categoria": cat_map.get(pack_insumo, "Packaging"),
                "unidad": unit_map.get(pack_insumo, "unidad"),
                "cantidad_por_paquete": float(pack_qty),
                "necesario_base": float(pack_qty) * paquetes,
                "stock_actual": stock_map.get(pack_insumo, 0.0),
                "tipo": "Packaging",
            })
    detail = pd.DataFrame(rows)
    if detail.empty:
        return empty, empty, empty, empty
    daily = detail.groupby(["dia", "insumo", "categoria", "unidad"], as_index=False).agg(
        necesario_base=("necesario_base", "sum"),
        stock_actual=("stock_actual", "max"),
    )
    daily["orden_dia"] = daily["dia"].map(PLANNING_DAY_ORDER).fillna(99)
    daily["extra_5"] = daily["necesario_base"] * 0.05
    daily["necesario_total"] = daily["necesario_base"] + daily["extra_5"]
    daily["faltante_vs_stock"] = (daily["necesario_total"] - daily["stock_actual"]).clip(lower=0)
    daily = daily.sort_values(["orden_dia", "categoria", "insumo"]).drop(columns=["orden_dia"])
    weekly = daily.groupby(["insumo", "categoria", "unidad"], as_index=False).agg(
        necesario_base=("necesario_base", "sum"),
        stock_actual=("stock_actual", "max"),
    )
    weekly["extra_5"] = weekly["necesario_base"] * 0.05
    weekly["necesario_total"] = weekly["necesario_base"] + weekly["extra_5"]
    weekly["comprar_vs_stock"] = (weekly["necesario_total"] - weekly["stock_actual"]).clip(lower=0)
    weekly["estado"] = weekly["comprar_vs_stock"].apply(lambda x: "OK" if x <= 0 else "Comprar")
    weekly = weekly.sort_values(["estado", "categoria", "insumo"], ascending=[False, True, True])
    provider_order = _planning_rows_to_provider_order(daily)
    if not provider_order.empty:
        provider_order["origen"] = "Deshidratadores"
    return detail, daily, weekly, provider_order

def weekly_planning_excel_bytes(plan_rows, detail, daily, weekly, provider_order, dehyd_rows=None, dehyd_detail=None, dehyd_daily=None, dehyd_weekly=None, combined_provider_order=None):
    sheets = {
        "Planificacion semanal": plan_rows.rename(columns={"dia":"Día", "producto":"Producto", "batchs":"Batchs"}) if plan_rows is not None else pd.DataFrame(),
        "Detalle por producto": detail.rename(columns={"dia":"Día", "producto":"Producto", "batchs":"Batchs", "insumo":"Insumo", "categoria":"Categoría", "unidad":"Unidad", "quantity_per_batch":"Cantidad por batch", "necesario_base":"Necesario base", "stock_actual":"Stock actual"}) if detail is not None else pd.DataFrame(),
        "Necesidad diaria": daily.rename(columns={"dia":"Día", "insumo":"Insumo", "categoria":"Categoría", "unidad":"Unidad", "necesario_base":"Necesario base", "extra_5":"Extra 5%", "necesario_total":"Necesario total", "stock_actual":"Stock actual", "faltante_vs_stock":"Faltante vs stock"}) if daily is not None else pd.DataFrame(),
        "Resumen semanal": weekly.rename(columns={"insumo":"Insumo", "categoria":"Categoría", "unidad":"Unidad", "necesario_base":"Necesario base", "extra_5":"Extra 5%", "necesario_total":"Necesario total", "stock_actual":"Stock actual", "comprar_vs_stock":"Comprar vs stock", "estado":"Estado"}) if weekly is not None else pd.DataFrame(),
        "Pedido por proveedor": (combined_provider_order if combined_provider_order is not None else provider_order).rename(columns={"proveedor":"Proveedor", "dia_ingreso":"Día ingreso", "para_usar":"Para usar", "insumo":"Insumo", "categoria":"Categoría", "unidad":"Unidad", "necesario_base":"Necesario base", "extra_5":"Extra 5%", "necesario_total":"Necesario total", "stock_actual":"Stock actual", "cantidad_a_pedir":"Cantidad a pedir", "costo_unitario_proveedor":"Costo unitario proveedor", "costo_estimado":"Costo estimado", "estado_costo":"Estado costo", "observacion":"Observación", "origen":"Origen"}) if (combined_provider_order is not None or provider_order is not None) else pd.DataFrame(),
        "Plan deshidratadores": dehyd_rows.rename(columns={"dia":"Día", "producto":"Producto", "paquetes":"Paquetes"}) if dehyd_rows is not None else pd.DataFrame(),
        "Detalle deshidratadores": dehyd_detail.rename(columns={"dia":"Día", "producto":"Producto", "paquetes":"Paquetes", "insumo":"Insumo", "categoria":"Categoría", "unidad":"Unidad", "cantidad_por_paquete":"Cantidad por paquete", "necesario_base":"Necesario base", "stock_actual":"Stock actual", "tipo":"Tipo"}) if dehyd_detail is not None else pd.DataFrame(),
        "Resumen deshidratadores": dehyd_weekly.rename(columns={"insumo":"Insumo", "categoria":"Categoría", "unidad":"Unidad", "necesario_base":"Necesario base", "extra_5":"Extra 5%", "necesario_total":"Necesario total", "stock_actual":"Stock actual", "comprar_vs_stock":"Comprar vs stock", "estado":"Estado"}) if dehyd_weekly is not None else pd.DataFrame(),
        "Packaging semanal": provider_order[provider_order["categoria"].apply(is_packaging_category)].rename(columns={"proveedor":"Proveedor", "dia_ingreso":"Día ingreso", "para_usar":"Para usar", "insumo":"Insumo", "categoria":"Categoría", "unidad":"Unidad", "necesario_base":"Necesario base", "extra_5":"Extra 5%", "necesario_total":"Necesario total", "stock_actual":"Stock actual", "cantidad_a_pedir":"Cantidad a pedir", "costo_unitario_proveedor":"Costo unitario proveedor", "costo_estimado":"Costo estimado", "estado_costo":"Estado costo", "observacion":"Observación"}) if provider_order is not None and not provider_order.empty and "categoria" in provider_order.columns else pd.DataFrame(),
    }
    export_provider_order = combined_provider_order if combined_provider_order is not None else provider_order
    if export_provider_order is not None and not export_provider_order.empty:
        for prov in export_provider_order["proveedor"].dropna().unique():
            dfp = export_provider_order[export_provider_order["proveedor"] == prov].copy()
            safe = re.sub(r"[^A-Za-z0-9 ]+", "", str(prov)).strip()[:25] or "Proveedor"
            sheets[f"Pedido {safe}"] = dfp.rename(columns={"proveedor":"Proveedor", "dia_ingreso":"Día ingreso", "para_usar":"Para usar", "insumo":"Insumo", "categoria":"Categoría", "unidad":"Unidad", "necesario_base":"Necesario base", "extra_5":"Extra 5%", "necesario_total":"Necesario total", "stock_actual":"Stock actual", "cantidad_a_pedir":"Cantidad a pedir", "costo_unitario_proveedor":"Costo unitario proveedor", "costo_estimado":"Costo estimado", "estado_costo":"Estado costo", "observacion":"Observación"})
    return df_to_excel_bytes(sheets)




# ==============================
# Planificador de batchs por ventas
# ==============================
BATCH_YIELDS_UNITS = {
    "PERRO VACA 333": 102.0,
    "PERRO VACA 500": 68.0,
    "PERRO POLLO 333": 100.0,
    "PERRO POLLO 500": 66.0,
    "PERRO PESCADO 500": 68.0,
    "GATO VACA": 131.0,
    "GATO POLLO": 131.0,
    "GATO PESCADO": 131.0,
    "TRANSICION": 140.0,
}


def batch_yield_units(product_name):
    """Unidades esperadas por batch/tanda para pasar necesidad a batchs."""
    name = str(product_name or "").strip().upper()
    if name in BATCH_YIELDS_UNITS:
        return float(BATCH_YIELDS_UNITS[name])
    # Respaldo por nombre, por si el usuario renombra parcialmente.
    if "VACA" in name and "333" in name:
        return 102.0
    if "VACA" in name and "500" in name:
        return 68.0
    if "POLLO" in name and "333" in name:
        return 100.0
    if "POLLO" in name and "500" in name:
        return 66.0
    if "PESCADO" in name and "500" in name and "PERRO" in name:
        return 68.0
    if "GATO" in name:
        return 131.0
    if "TRANSIC" in name:
        return 140.0
    return 0.0


def _ceil_to_half(value):
    """Redondea hacia arriba a medios batchs para permitir 0,5 si hiciera falta."""
    v = pd.to_numeric(value, errors="coerce")
    if pd.isna(v) or float(v) <= 0:
        return 0.0
    return float(int(float(v) * 2 + 0.999999) / 2)


def _sales_last_n_weeks_by_product(end_date, weeks):
    """Devuelve ventas por producto/canal en bloques móviles de 7 días, terminando en end_date."""
    if weeks < 1:
        weeks = 1
    start_date = end_date - timedelta(days=7 * weeks - 1)
    tn = read_sql(
        """
        SELECT product_id, COALESCE(product_name_rawer, product_name_tn, sku, 'Producto sin identificar') AS producto,
               quantity AS unidades, 'Minorista' AS canal,
               date(substr(COALESCE(NULLIF(order_created_at,''), NULLIF(delivery_date_tn,''), imported_at), 1, 10)) AS fecha
        FROM tiendanube_sales
        WHERE COALESCE(is_undone,0) = 0
          AND product_id IS NOT NULL
          AND date(substr(COALESCE(NULLIF(order_created_at,''), NULLIF(delivery_date_tn,''), imported_at), 1, 10)) BETWEEN date(?) AND date(?)
        """,
        (start_date.isoformat(), end_date.isoformat()),
    )
    pv = read_sql(
        """
        SELECT product_id, COALESCE(product_name, 'Producto sin identificar') AS producto,
               quantity AS unidades, 'Mayorista' AS canal,
               date(sale_date) AS fecha
        FROM private_sales
        WHERE COALESCE(is_undone,0) = 0
          AND product_id IS NOT NULL
          AND date(sale_date) BETWEEN date(?) AND date(?)
        """,
        (start_date.isoformat(), end_date.isoformat()),
    )
    df = pd.concat([tn, pv], ignore_index=True)
    if df.empty:
        return pd.DataFrame(columns=["product_id", "producto", "canal", "semana_idx", "unidades"])
    df["unidades"] = pd.to_numeric(df["unidades"], errors="coerce").fillna(0.0)
    df["fecha"] = pd.to_datetime(df["fecha"], errors="coerce").dt.date
    df = df[df["fecha"].notna()]
    if df.empty:
        return pd.DataFrame(columns=["product_id", "producto", "canal", "semana_idx", "unidades"])
    # semana_idx 1 = última semana; 2 = semana anterior; etc.
    df["dias_atras"] = df["fecha"].apply(lambda d: (end_date - d).days)
    df["semana_idx"] = (df["dias_atras"] // 7 + 1).astype(int)
    df = df[(df["semana_idx"] >= 1) & (df["semana_idx"] <= weeks)]
    grouped = df.groupby(["product_id", "producto", "canal", "semana_idx"], as_index=False)["unidades"].sum()
    return grouped


def build_sales_batch_planning(end_date, avg_weeks=4, peak_weeks=4, peak_factor=1.0, target_weeks=2.0, safety_pct=0.0):
    """Arma la tabla de planificación desde ventas TN + particulares y stock real de Planta MDP."""
    avg_weeks = max(1, int(avg_weeks or 4))
    peak_weeks = max(1, int(peak_weeks or avg_weeks))
    weeks = max(avg_weeks, peak_weeks)
    sales = _sales_last_n_weeks_by_product(end_date, weeks)
    products = recipe_products().rename(columns={"id": "product_id", "name": "producto"})
    if products.empty:
        return pd.DataFrame()
    products["rendimiento_batch"] = products["producto"].apply(batch_yield_units)
    products = products[products["rendimiento_batch"] > 0].copy()
    if products.empty:
        return pd.DataFrame()

    # Base con semanas en cero para que productos sin venta también aparezcan.
    base_rows = []
    for _, pr in products.iterrows():
        for w in range(1, weeks + 1):
            base_rows.append({"product_id": int(pr["product_id"]), "producto": pr["producto"], "semana_idx": w})
    base = pd.DataFrame(base_rows)
    weekly_total = sales.groupby(["product_id", "semana_idx"], as_index=False)["unidades"].sum() if not sales.empty else pd.DataFrame(columns=["product_id", "semana_idx", "unidades"])
    base = base.merge(weekly_total, on=["product_id", "semana_idx"], how="left")
    base["unidades"] = pd.to_numeric(base["unidades"], errors="coerce").fillna(0.0)

    last_week = base[base["semana_idx"] == 1].groupby("product_id", as_index=False)["unidades"].sum().rename(columns={"unidades": "venta_ultima_semana"})
    avg4 = base[base["semana_idx"] <= avg_weeks].groupby("product_id", as_index=False)["unidades"].mean().rename(columns={"unidades": "promedio_semanal"})
    peak = base[base["semana_idx"] <= peak_weeks].groupby("product_id", as_index=False)["unidades"].max().rename(columns={"unidades": "pico_semanal"})

    if sales.empty:
        channel_last = pd.DataFrame(columns=["product_id", "minorista_ultima_semana", "mayorista_ultima_semana"])
    else:
        ch = sales[sales["semana_idx"] == 1].pivot_table(index="product_id", columns="canal", values="unidades", aggfunc="sum", fill_value=0).reset_index()
        ch = ch.rename(columns={"Minorista": "minorista_ultima_semana", "Mayorista": "mayorista_ultima_semana"})
        for col in ["minorista_ultima_semana", "mayorista_ultima_semana"]:
            if col not in ch.columns:
                ch[col] = 0.0
        channel_last = ch[["product_id", "minorista_ultima_semana", "mayorista_ultima_semana"]]

    stock = current_real_stock(end_date)
    stock = stock[stock["deposit"] == DEFAULT_DEPOSIT][["id", "stock_real", "produccion_pendiente"]].rename(columns={"id": "product_id", "stock_real": "stock_planta", "produccion_pendiente": "produccion_pendiente"})

    out = products.merge(last_week, on="product_id", how="left").merge(avg4, on="product_id", how="left").merge(peak, on="product_id", how="left").merge(channel_last, on="product_id", how="left").merge(stock, on="product_id", how="left")
    for col in ["venta_ultima_semana", "promedio_semanal", "pico_semanal", "minorista_ultima_semana", "mayorista_ultima_semana", "stock_planta", "produccion_pendiente"]:
        out[col] = pd.to_numeric(out[col], errors="coerce").fillna(0.0)
    out["demanda_referencia"] = out[["venta_ultima_semana", "promedio_semanal"]].max(axis=1)
    out["demanda_referencia"] = out[["demanda_referencia", "pico_semanal"]].max(axis=1)
    out["demanda_referencia"] = out["demanda_referencia"] * float(peak_factor or 1.0)
    out["demanda_con_colchon"] = out["demanda_referencia"] * (1 + float(safety_pct or 0) / 100.0)
    out["salidas_grandes_planificadas"] = 0.0
    out["venta_pendiente_hasta_lunes"] = 0.0
    out["stock_lunes_estimado"] = out["stock_planta"] + out["produccion_pendiente"] - out["venta_pendiente_hasta_lunes"] - out["salidas_grandes_planificadas"]
    out["semanas_stock_vs_ultima"] = out.apply(lambda r: (r["stock_lunes_estimado"] / r["venta_ultima_semana"]) if r["venta_ultima_semana"] > 0 else 0.0, axis=1)
    out["semanas_stock_vs_promedio"] = out.apply(lambda r: (r["stock_lunes_estimado"] / r["promedio_semanal"]) if r["promedio_semanal"] > 0 else 0.0, axis=1)
    out["semanas_stock_vs_pico"] = out.apply(lambda r: (r["stock_lunes_estimado"] / r["pico_semanal"]) if r["pico_semanal"] > 0 else 0.0, axis=1)
    out["stock_objetivo"] = out["demanda_con_colchon"] * float(target_weeks or 0)
    out["necesidad_unidades"] = (out["stock_objetivo"] - out["stock_lunes_estimado"]).clip(lower=0)
    out["tandas_sugeridas"] = out.apply(lambda r: _ceil_to_half(r["necesidad_unidades"] / r["rendimiento_batch"]) if r["rendimiento_batch"] > 0 else 0.0, axis=1)
    out["tandas_confirmadas"] = out["tandas_sugeridas"]
    out["dia_produccion"] = "Lunes"
    out["unidades_planificadas"] = out["tandas_confirmadas"] * out["rendimiento_batch"]
    out["stock_final_planificado"] = out["stock_lunes_estimado"] + out["unidades_planificadas"]
    out["sem_stock_final_vs_pico"] = out.apply(lambda r: (r["stock_final_planificado"] / r["pico_semanal"]) if r["pico_semanal"] > 0 else 0.0, axis=1)
    out["sem_stock_final_vs_promedio"] = out.apply(lambda r: (r["stock_final_planificado"] / r["promedio_semanal"]) if r["promedio_semanal"] > 0 else 0.0, axis=1)
    out["sem_stock_final_vs_ultima"] = out.apply(lambda r: (r["stock_final_planificado"] / r["venta_ultima_semana"]) if r["venta_ultima_semana"] > 0 else 0.0, axis=1)
    return out.sort_values("producto")


def sales_planning_rows_from_editor(edited_df):
    if edited_df is None or edited_df.empty:
        return pd.DataFrame(columns=["dia", "product_id", "producto", "batchs"])
    rows = []
    for _, row in edited_df.iterrows():
        batchs = pd.to_numeric(row.get("tandas_confirmadas", 0), errors="coerce")
        if pd.isna(batchs) or float(batchs) <= 0:
            continue
        product_id = row.get("product_id")
        try:
            product_id = int(product_id)
        except Exception:
            continue
        dia = str(row.get("dia_produccion") or "Lunes").strip()
        if dia not in PLANNING_WEEK_DAYS:
            dia = "Lunes"
        rows.append({"dia": dia, "product_id": product_id, "producto": str(row.get("producto") or ""), "batchs": float(batchs)})
    return pd.DataFrame(rows)


def sales_batch_planning_excel_bytes(planning_df, plan_rows, detail, daily, weekly, provider_order):
    sheets = {
        "Planificacion por ventas": planning_df.rename(columns={
            "producto": "Producto", "minorista_ultima_semana": "Minorista ultima semana", "mayorista_ultima_semana": "Mayorista ultima semana",
            "venta_ultima_semana": "Total ultima semana", "promedio_semanal": "Promedio semanal", "pico_semanal": "Pico semanal",
            "stock_planta": "Stock planta MDP", "produccion_pendiente": "Produccion pendiente", "venta_pendiente_hasta_lunes": "Venta pendiente hasta lunes",
            "salidas_grandes_planificadas": "Salidas grandes", "stock_lunes_estimado": "Stock lunes estimado", "demanda_referencia": "Demanda referencia",
            "demanda_con_colchon": "Demanda con colchon", "rendimiento_batch": "Rendimiento batch", "necesidad_unidades": "Necesidad unidades",
            "tandas_sugeridas": "Tandas sugeridas", "tandas_confirmadas": "Tandas confirmadas", "dia_produccion": "Dia produccion",
            "unidades_planificadas": "Unidades planificadas", "stock_final_planificado": "Stock final planificado",
            "semanas_stock_vs_ultima": "Sem stock vs ultima", "semanas_stock_vs_promedio": "Sem stock vs promedio", "semanas_stock_vs_pico": "Sem stock vs pico",
            "sem_stock_final_vs_ultima": "Sem stock final vs ultima", "sem_stock_final_vs_promedio": "Sem stock final vs promedio", "sem_stock_final_vs_pico": "Sem stock final vs pico",
        }) if planning_df is not None else pd.DataFrame(),
        "Batchs confirmados": plan_rows.rename(columns={"dia":"Dia", "producto":"Producto", "batchs":"Batchs"}) if plan_rows is not None else pd.DataFrame(),
        "Detalle insumos": detail.rename(columns={"dia":"Dia", "producto":"Producto", "batchs":"Batchs", "insumo":"Insumo", "categoria":"Categoria", "unidad":"Unidad", "quantity_per_batch":"Cantidad por batch", "necesario_base":"Necesario base", "stock_actual":"Stock actual"}) if detail is not None else pd.DataFrame(),
        "Resumen semanal insumos": weekly.rename(columns={"insumo":"Insumo", "categoria":"Categoria", "unidad":"Unidad", "necesario_base":"Necesario base", "extra_5":"Extra 5%", "necesario_total":"Necesario total", "stock_actual":"Stock actual", "comprar_vs_stock":"Comprar vs stock", "estado":"Estado"}) if weekly is not None else pd.DataFrame(),
        "Pedido proveedor": provider_order.rename(columns={"proveedor":"Proveedor", "dia_ingreso":"Dia ingreso", "para_usar":"Para usar", "insumo":"Insumo", "categoria":"Categoria", "unidad":"Unidad", "necesario_base":"Necesario base", "extra_5":"Extra 5%", "necesario_total":"Necesario total", "stock_actual":"Stock actual", "cantidad_a_pedir":"Cantidad a pedir", "costo_unitario_proveedor":"Costo unitario proveedor", "costo_estimado":"Costo estimado", "estado_costo":"Estado costo", "observacion":"Observacion"}) if provider_order is not None else pd.DataFrame(),
    }
    return df_to_excel_bytes(sheets)


def page_sales_batch_planning():
    hero("Planificación por ventas", "Calcula batchs sugeridos desde ventas Tiendanube + ventas particulares, usando solo stock real de Planta Mar del Plata.")
    st.info("Pensado para planificar los miércoles: la demanda sale de ventas minoristas y mayoristas; el stock base es Planta Mar del Plata, porque es el único lugar que fabrica.")

    c1, c2, c3, c4 = st.columns(4)
    with c1:
        end_date = st.date_input("Fecha de cierre", value=date.today(), key="sales_plan_end")
    with c2:
        avg_weeks = st.number_input("Promedio semanas", min_value=1, max_value=12, value=4, step=1, key="sales_plan_avg_weeks")
    with c3:
        peak_weeks = st.number_input("Pico máximo semanas", min_value=1, max_value=16, value=4, step=1, key="sales_plan_peak_weeks")
    with c4:
        target_weeks = st.number_input("Cobertura objetivo", min_value=0.0, max_value=8.0, value=2.0, step=0.25, key="sales_plan_target_weeks")

    c5, c6 = st.columns(2)
    with c5:
        safety_pct = st.number_input("Colchón %", min_value=0.0, max_value=50.0, value=0.0, step=1.0, key="sales_plan_safety")
    with c6:
        peak_factor_pct = st.number_input("Usar % del pico máximo", min_value=0.0, max_value=150.0, value=100.0, step=5.0, key="sales_plan_peak_factor")

    planning = build_sales_batch_planning(end_date, avg_weeks=avg_weeks, peak_weeks=peak_weeks, peak_factor=float(peak_factor_pct)/100.0, target_weeks=target_weeks, safety_pct=safety_pct)
    if planning.empty:
        st.warning("No hay productos con receta/rendimiento para planificar o todavía no hay ventas importadas.")
        return

    st.markdown("### 1. Revisión y confirmación de tandas")
    st.caption("Podés modificar salidas grandes, venta pendiente hasta lunes, tandas confirmadas y día de producción antes de calcular compras.")
    cols = [
        "product_id", "producto", "minorista_ultima_semana", "mayorista_ultima_semana", "venta_ultima_semana", "promedio_semanal", "pico_semanal",
        "stock_planta", "produccion_pendiente", "venta_pendiente_hasta_lunes", "salidas_grandes_planificadas", "stock_lunes_estimado",
        "semanas_stock_vs_pico", "semanas_stock_vs_ultima", "semanas_stock_vs_promedio", "rendimiento_batch", "necesidad_unidades", "tandas_sugeridas", "tandas_confirmadas", "dia_produccion",
        "unidades_planificadas", "stock_final_planificado", "sem_stock_final_vs_pico", "sem_stock_final_vs_ultima", "sem_stock_final_vs_promedio",
    ]
    editor_df = planning[cols].copy()
    edited = st.data_editor(
        editor_df,
        use_container_width=True,
        hide_index=True,
        column_config={
            "product_id": None,
            "producto": st.column_config.TextColumn("Producto", disabled=True),
            "minorista_ultima_semana": st.column_config.NumberColumn("Minorista última sem.", disabled=True, format="%.0f"),
            "mayorista_ultima_semana": st.column_config.NumberColumn("Mayorista última sem.", disabled=True, format="%.0f"),
            "venta_ultima_semana": st.column_config.NumberColumn("Total última sem.", disabled=True, format="%.0f"),
            "promedio_semanal": st.column_config.NumberColumn("Prom. sem.", disabled=True, format="%.1f"),
            "pico_semanal": st.column_config.NumberColumn("Pico sem.", disabled=True, format="%.0f"),
            "stock_planta": st.column_config.NumberColumn("Stock Planta", disabled=True, format="%.0f"),
            "produccion_pendiente": st.column_config.NumberColumn("Prod. pendiente", disabled=True, format="%.0f"),
            "venta_pendiente_hasta_lunes": st.column_config.NumberColumn("Venta pend. hasta lunes", min_value=0.0, step=1.0, format="%.0f"),
            "salidas_grandes_planificadas": st.column_config.NumberColumn("Salidas grandes", min_value=0.0, step=1.0, format="%.0f"),
            "stock_lunes_estimado": st.column_config.NumberColumn("Stock lunes est.", disabled=True, format="%.0f"),
            "semanas_stock_vs_pico": st.column_config.NumberColumn("Sem stock vs pico", disabled=True, format="%.1f"),
            "semanas_stock_vs_ultima": st.column_config.NumberColumn("Sem stock vs última", disabled=True, format="%.1f"),
            "semanas_stock_vs_promedio": st.column_config.NumberColumn("Sem stock vs prom.", disabled=True, format="%.1f"),
            "rendimiento_batch": st.column_config.NumberColumn("Unid/batch", disabled=True, format="%.0f"),
            "necesidad_unidades": st.column_config.NumberColumn("Necesidad", disabled=True, format="%.0f"),
            "tandas_sugeridas": st.column_config.NumberColumn("Tandas sugeridas", disabled=True, format="%.1f"),
            "tandas_confirmadas": st.column_config.NumberColumn("Tandas confirmadas", min_value=0.0, step=0.5, format="%.1f"),
            "dia_produccion": st.column_config.SelectboxColumn("Día producción", options=PLANNING_WEEK_DAYS),
            "unidades_planificadas": st.column_config.NumberColumn("Unid. planif.", disabled=True, format="%.0f"),
            "stock_final_planificado": st.column_config.NumberColumn("Stock final", disabled=True, format="%.0f"),
            "sem_stock_final_vs_pico": st.column_config.NumberColumn("Final vs pico", disabled=True, format="%.1f"),
            "sem_stock_final_vs_ultima": st.column_config.NumberColumn("Final vs última", disabled=True, format="%.1f"),
            "sem_stock_final_vs_promedio": st.column_config.NumberColumn("Final vs prom.", disabled=True, format="%.1f"),
        },
        key="sales_batch_planning_editor_v91",
    )

    # Recalcular las columnas dependientes de los campos editables.
    edited = edited.copy()
    for col in ["venta_pendiente_hasta_lunes", "salidas_grandes_planificadas", "tandas_confirmadas", "rendimiento_batch", "stock_planta", "produccion_pendiente", "venta_ultima_semana", "promedio_semanal", "pico_semanal"]:
        edited[col] = pd.to_numeric(edited.get(col, 0), errors="coerce").fillna(0.0)
    edited["stock_lunes_estimado"] = edited["stock_planta"] + edited["produccion_pendiente"] - edited["venta_pendiente_hasta_lunes"] - edited["salidas_grandes_planificadas"]
    edited["unidades_planificadas"] = edited["tandas_confirmadas"] * edited["rendimiento_batch"]
    edited["stock_final_planificado"] = edited["stock_lunes_estimado"] + edited["unidades_planificadas"]
    edited["semanas_stock_vs_pico"] = edited.apply(lambda r: (r["stock_lunes_estimado"] / r["pico_semanal"]) if r["pico_semanal"] > 0 else 0.0, axis=1)
    edited["semanas_stock_vs_ultima"] = edited.apply(lambda r: (r["stock_lunes_estimado"] / r["venta_ultima_semana"]) if r["venta_ultima_semana"] > 0 else 0.0, axis=1)
    edited["semanas_stock_vs_promedio"] = edited.apply(lambda r: (r["stock_lunes_estimado"] / r["promedio_semanal"]) if r["promedio_semanal"] > 0 else 0.0, axis=1)
    edited["sem_stock_final_vs_pico"] = edited.apply(lambda r: (r["stock_final_planificado"] / r["pico_semanal"]) if r["pico_semanal"] > 0 else 0.0, axis=1)
    edited["sem_stock_final_vs_ultima"] = edited.apply(lambda r: (r["stock_final_planificado"] / r["venta_ultima_semana"]) if r["venta_ultima_semana"] > 0 else 0.0, axis=1)
    edited["sem_stock_final_vs_promedio"] = edited.apply(lambda r: (r["stock_final_planificado"] / r["promedio_semanal"]) if r["promedio_semanal"] > 0 else 0.0, axis=1)

    plan_rows = sales_planning_rows_from_editor(edited)
    detail, daily, weekly, provider_order = calculate_weekly_planning(plan_rows) if not plan_rows.empty else (pd.DataFrame(), pd.DataFrame(), pd.DataFrame(), pd.DataFrame())

    c1, c2, c3, c4 = st.columns(4)
    with c1:
        metric_card("Tandas confirmadas", f"{edited['tandas_confirmadas'].sum():,.1f}".replace(",", "."))
    with c2:
        metric_card("Unidades planificadas", f"{edited['unidades_planificadas'].sum():,.0f}".replace(",", "."))
    with c3:
        metric_card("Productos a producir", str(int((edited["tandas_confirmadas"] > 0).sum())))
    with c4:
        total_cost = provider_order["costo_estimado"].sum() if not provider_order.empty and "costo_estimado" in provider_order.columns else 0
        metric_card("Compra estimada", format_currency(total_cost))

    tabs = st.tabs(["Resumen final", "Insumos", "Pedido por proveedor", "Exportar"])
    with tabs[0]:
        final_view = edited[["producto", "venta_ultima_semana", "promedio_semanal", "pico_semanal", "stock_lunes_estimado", "tandas_confirmadas", "dia_produccion", "stock_final_planificado", "sem_stock_final_vs_pico", "sem_stock_final_vs_promedio"]].rename(columns={
            "producto":"Producto", "venta_ultima_semana":"Última semana", "promedio_semanal":"Prom. 4 sem.", "pico_semanal":"Pico", "stock_lunes_estimado":"Stock lunes estimado", "tandas_confirmadas":"Tandas confirmadas", "dia_produccion":"Día producción", "stock_final_planificado":"Stock final", "sem_stock_final_vs_pico":"Sem. final vs pico", "sem_stock_final_vs_promedio":"Sem. final vs prom."
        })
        st.dataframe(final_view, use_container_width=True, hide_index=True)
    with tabs[1]:
        if weekly.empty:
            st.info("Sin batchs confirmados para calcular insumos.")
        else:
            view = weekly.rename(columns={"insumo":"Insumo", "categoria":"Categoría", "unidad":"Unidad", "necesario_base":"Necesario base", "extra_5":"Extra 5%", "necesario_total":"Necesario total", "stock_actual":"Stock actual", "comprar_vs_stock":"Comprar vs stock", "estado":"Estado"})
            st.dataframe(view, use_container_width=True, hide_index=True)
    with tabs[2]:
        if provider_order.empty:
            st.info("Sin pedido sugerido.")
        else:
            view = provider_order.rename(columns={"proveedor":"Proveedor", "dia_ingreso":"Día ingreso", "para_usar":"Para usar", "insumo":"Insumo", "categoria":"Categoría", "unidad":"Unidad", "necesario_base":"Necesario base", "extra_5":"Extra 5%", "necesario_total":"Necesario total", "stock_actual":"Stock actual", "cantidad_a_pedir":"Cantidad a pedir", "costo_unitario_proveedor":"Costo unitario proveedor", "costo_estimado":"Costo estimado", "estado_costo":"Estado costo", "observacion":"Observación"})
            st.dataframe(view, use_container_width=True, hide_index=True)
    with tabs[3]:
        xlsx = sales_batch_planning_excel_bytes(edited, plan_rows, detail, daily, weekly, provider_order)
        st.download_button(
            "Descargar planificación por ventas Excel",
            data=xlsx,
            file_name=f"Rawer_planificacion_por_ventas_{date.today().isoformat()}.xlsx",
            mime="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
        )

def save_weekly_planning_snapshot(week_start, note, plan_rows, dehyd_rows, provider_order):
    """Guarda una versión inmutable de la planificación semanal."""
    now = datetime.now().isoformat(timespec="seconds")
    planning_date = date.today().isoformat()
    diets = [] if plan_rows is None or plan_rows.empty else plan_rows.to_dict(orient="records")
    dehyd = [] if dehyd_rows is None or dehyd_rows.empty else dehyd_rows.to_dict(orient="records")
    providers = [] if provider_order is None or provider_order.empty else provider_order.to_dict(orient="records")
    total_diet = float(pd.to_numeric(plan_rows.get("batchs", pd.Series(dtype=float)), errors="coerce").fillna(0).sum()) if plan_rows is not None and not plan_rows.empty else 0.0
    total_dehyd = float(pd.to_numeric(dehyd_rows.get("paquetes", pd.Series(dtype=float)), errors="coerce").fillna(0).sum()) if dehyd_rows is not None and not dehyd_rows.empty else 0.0
    total_cost = float(pd.to_numeric(provider_order.get("costo_estimado", pd.Series(dtype=float)), errors="coerce").fillna(0).sum()) if provider_order is not None and not provider_order.empty else 0.0
    conn = get_conn()
    conn.execute(
        """INSERT INTO weekly_planning_history(
               planning_date, week_start, note, diet_plan_json, dehydrator_plan_json, provider_order_json,
               total_diet_batches, total_dehydrator_units, estimated_purchase_cost, created_at
           ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?)""",
        (planning_date, week_start.isoformat() if hasattr(week_start, "isoformat") else str(week_start or ""),
         str(note or "").strip(), json.dumps(diets, ensure_ascii=False, default=str),
         json.dumps(dehyd, ensure_ascii=False, default=str), json.dumps(providers, ensure_ascii=False, default=str),
         total_diet, total_dehyd, total_cost, now),
    )
    conn.commit()
    conn.close()


def weekly_planning_history_df():
    return read_sql(
        """SELECT id, planning_date, week_start, note, total_diet_batches, total_dehydrator_units,
                  estimated_purchase_cost, created_at
           FROM weekly_planning_history
           ORDER BY COALESCE(NULLIF(week_start,''), planning_date) DESC, id DESC"""
    )


def weekly_planning_snapshot_details(history_id):
    df = read_sql(
        "SELECT * FROM weekly_planning_history WHERE id=?",
        (int(history_id),),
    )
    if df.empty:
        return None, pd.DataFrame(), pd.DataFrame(), pd.DataFrame()
    row = df.iloc[0].to_dict()
    def _loads(value):
        try:
            data = json.loads(value or "[]")
            return pd.DataFrame(data if isinstance(data, list) else [])
        except Exception:
            return pd.DataFrame()
    return row, _loads(row.get("diet_plan_json")), _loads(row.get("dehydrator_plan_json")), _loads(row.get("provider_order_json"))


def render_weekly_planning_history():
    st.markdown("### Historial de planificaciones")
    hist = weekly_planning_history_df()
    if hist.empty:
        st.caption("Todavía no hay planificaciones semanales guardadas.")
        return
    view = hist.copy()
    view["estimated_purchase_cost"] = pd.to_numeric(view["estimated_purchase_cost"], errors="coerce").fillna(0)
    st.dataframe(
        view.rename(columns={
            "id":"ID", "planning_date":"Fecha planificación", "week_start":"Semana desde",
            "note":"Observación", "total_diet_batches":"Batchs dietas",
            "total_dehydrator_units":"Paquetes deshidratados",
            "estimated_purchase_cost":"Costo compra estimado", "created_at":"Guardado"
        }),
        use_container_width=True, hide_index=True,
    )
    options = hist["id"].astype(int).tolist()
    selected = st.selectbox(
        "Ver detalle de una planificación guardada",
        options,
        format_func=lambda x: f"#{x} · semana {hist.loc[hist['id'].astype(int)==int(x), 'week_start'].iloc[0] or hist.loc[hist['id'].astype(int)==int(x), 'planning_date'].iloc[0]}",
        key="weekly_planning_history_select_v915",
    )
    row, diets, dehyd, providers = weekly_planning_snapshot_details(selected)
    if row:
        st.caption(f"Guardada: {row.get('created_at','')} · {row.get('note','') or 'Sin observación'}")
        ht = st.tabs(["Dietas", "Deshidratadores", "Pedido por proveedor"])
        with ht[0]:
            st.dataframe(diets, use_container_width=True, hide_index=True) if not diets.empty else st.info("Sin dietas en esta planificación.")
        with ht[1]:
            st.dataframe(dehyd, use_container_width=True, hide_index=True) if not dehyd.empty else st.info("Sin deshidratadores en esta planificación.")
        with ht[2]:
            st.dataframe(providers, use_container_width=True, hide_index=True) if not providers.empty else st.info("Sin pedido por proveedor guardado.")


def page_weekly_planning():
    hero("Planificación semanal", "Cargá batchs de dietas y paquetes de deshidratadores por día. Rawer Data calcula materia prima, packaging, costos y pedido sugerido por proveedor.")
    st.info("La planificación usa recetas vigentes, stock actual de insumos, 5% extra de cobertura y reglas de abastecimiento por proveedor.")
    st.warning("Insumos congelados: suprema picada, recorte pechuga, merluza y cornalitos se planifican un día antes para descongelar antes de usar.")

    today = date.today()
    default_monday = today - timedelta(days=today.weekday())
    hc1, hc2 = st.columns([1, 2])
    with hc1:
        planning_week_start = st.date_input("Semana a planificar (lunes)", value=default_monday, key="weekly_planning_week_start_v915")
    with hc2:
        planning_note = st.text_input("Observación de la planificación", placeholder="Ej.: semana 39, refuerzo PV500", key="weekly_planning_note_v915")

    rules_df = pd.DataFrame([
        {"Día ingreso":"Lunes AM", "Proveedor":"Tournedo", "Insumos":"Hígado, corazón, bofe, mondongo, pajarilla", "Se usa para":"Producción lunes"},
        {"Día ingreso":"Lunes PM", "Proveedor":"Rey de Reyes", "Insumos":"Hígado, corazón, bofe, mondongo, pajarilla", "Se usa para":"Producción martes"},
        {"Día ingreso":"Lunes PM", "Proveedor":"Rey de Reyes", "Insumos":"Pajarilla, bofe, mondongo", "Se usa para":"Producción miércoles"},
        {"Día ingreso":"Martes PM", "Proveedor":"Mirasur", "Insumos":"Corazón e hígado", "Se usa para":"Producción miércoles a viernes"},
        {"Día ingreso":"Miércoles PM", "Proveedor":"Rey de Reyes", "Insumos":"Pajarilla, bofe, mondongo", "Se usa para":"Producción jueves y viernes"},
        {"Día ingreso":"Un día antes", "Proveedor":"Butaco", "Insumos":"Suprema picada y recorte pechuga", "Se usa para":"El día siguiente, por venir congelado"},
        {"Día ingreso":"Un día antes", "Proveedor":"Muzzio/Mare Pronto", "Insumos":"Merluza y cornalitos", "Se usa para":"El día siguiente, por venir congelado"},
        {"Día ingreso":"Compra semanal", "Proveedor":"Su Mayorista", "Insumos":"Carcasa y piel de pollo", "Se usa para":"Semana completa"},
        {"Día ingreso":"Compra semanal", "Proveedor":"A3 / Eduardo / Mercado Libre", "Insumos":"Etiquetas, bolsas y doypacks", "Se usa para":"Semana completa"},
    ])
    st.dataframe(rules_df, use_container_width=True, hide_index=True)

    st.markdown("### 1. Producción de dietas / batchs")
    products = recipe_products().rename(columns={"name":"producto"})
    if products.empty:
        st.warning("Todavía no hay recetas cargadas para planificar dietas.")
        products = pd.DataFrame(columns=["id", "producto"])
    for d in PLANNING_WEEK_DAYS:
        products[d] = 0.0
    edited = st.data_editor(
        products,
        hide_index=True,
        use_container_width=True,
        column_config={
            "id": None,
            "producto": st.column_config.TextColumn("Producto", disabled=True),
            "Lunes": st.column_config.NumberColumn("Lunes", min_value=0.0, step=0.5),
            "Martes": st.column_config.NumberColumn("Martes", min_value=0.0, step=0.5),
            "Miércoles": st.column_config.NumberColumn("Miércoles", min_value=0.0, step=0.5),
            "Jueves": st.column_config.NumberColumn("Jueves", min_value=0.0, step=0.5),
            "Viernes": st.column_config.NumberColumn("Viernes", min_value=0.0, step=0.5),
        },
        key="weekly_planning_matrix_v77",
    )
    plan_rows = build_weekly_plan_from_matrix(edited)

    st.markdown("### 2. Deshidratadores / jerkys")
    st.caption("Cargá cuántos paquetes querés armar cada día. La app calcula materia prima, etiquetas, doypacks, 5% extra y costo estimado.")
    dehyd_matrix = pd.DataFrame({"producto": list(DESHIDRATADOR_YIELDS.keys())})
    for d in PLANNING_WEEK_DAYS:
        dehyd_matrix[d] = 0.0
    edited_dehyd = st.data_editor(
        dehyd_matrix,
        hide_index=True,
        use_container_width=True,
        column_config={
            "producto": st.column_config.TextColumn("Producto", disabled=True),
            "Lunes": st.column_config.NumberColumn("Lunes", min_value=0.0, step=1.0),
            "Martes": st.column_config.NumberColumn("Martes", min_value=0.0, step=1.0),
            "Miércoles": st.column_config.NumberColumn("Miércoles", min_value=0.0, step=1.0),
            "Jueves": st.column_config.NumberColumn("Jueves", min_value=0.0, step=1.0),
            "Viernes": st.column_config.NumberColumn("Viernes", min_value=0.0, step=1.0),
        },
        key="weekly_dehydrator_matrix_v77",
    )
    dehyd_rows = build_weekly_dehydrator_plan_from_matrix(edited_dehyd)

    if plan_rows.empty and dehyd_rows.empty:
        st.info("Cargá batchs o paquetes de deshidratadores para calcular la planificación semanal.")
        render_weekly_planning_history()
        return

    detail, daily, weekly, provider_order = calculate_weekly_planning(plan_rows) if not plan_rows.empty else (pd.DataFrame(), pd.DataFrame(), pd.DataFrame(), pd.DataFrame())
    dehyd_detail, dehyd_daily, dehyd_weekly, dehyd_provider = calculate_weekly_dehydrator_planning(dehyd_rows) if not dehyd_rows.empty else (pd.DataFrame(), pd.DataFrame(), pd.DataFrame(), pd.DataFrame())
    if not provider_order.empty:
        provider_order["origen"] = "Dietas/producción"
    combined_provider = pd.concat([provider_order, dehyd_provider], ignore_index=True) if not provider_order.empty or not dehyd_provider.empty else pd.DataFrame()

    c1, c2, c3, c4 = st.columns(4)
    with c1:
        metric_card("Batchs dietas", f"{plan_rows['batchs'].sum():,.1f}".replace(",", ".") if not plan_rows.empty else "0")
    with c2:
        metric_card("Paquetes deshidratados", f"{dehyd_rows['paquetes'].sum():,.0f}".replace(",", ".") if not dehyd_rows.empty else "0")
    with c3:
        n_ins = 0
        if not weekly.empty: n_ins += weekly["insumo"].nunique()
        if not dehyd_weekly.empty: n_ins += dehyd_weekly["insumo"].nunique()
        metric_card("Insumos calculados", str(n_ins))
    with c4:
        total_cost = combined_provider["costo_estimado"].sum() if not combined_provider.empty and "costo_estimado" in combined_provider.columns else 0
        metric_card("Costo compra estimado", format_currency(total_cost))

    tabs = st.tabs(["Plan dietas", "Plan deshidratadores", "Necesidad diaria", "Resumen semanal", "Packaging", "Pedido por proveedor", "Costos deshidratadores"])
    with tabs[0]:
        if plan_rows.empty:
            st.info("Sin batchs de dietas cargados.")
        else:
            st.dataframe(plan_rows.rename(columns={"dia":"Día", "producto":"Producto", "batchs":"Batchs"})[["Día", "Producto", "Batchs"]], use_container_width=True, hide_index=True)
    with tabs[1]:
        if dehyd_rows.empty:
            st.info("Sin paquetes de deshidratadores cargados.")
        else:
            st.dataframe(dehyd_rows.rename(columns={"dia":"Día", "producto":"Producto", "paquetes":"Paquetes"}), use_container_width=True, hide_index=True)
            st.markdown("#### Detalle de insumos y packaging por deshidratador")
            dd = dehyd_detail.rename(columns={"dia":"Día", "producto":"Producto", "paquetes":"Paquetes", "insumo":"Insumo", "categoria":"Categoría", "unidad":"Unidad", "cantidad_por_paquete":"Cantidad por paquete", "necesario_base":"Necesario base", "stock_actual":"Stock actual", "tipo":"Tipo"})
            st.dataframe(dd, use_container_width=True, hide_index=True)
    with tabs[2]:
        combined_daily = pd.concat([daily.assign(origen="Dietas/producción") if not daily.empty else pd.DataFrame(), dehyd_daily.assign(origen="Deshidratadores") if not dehyd_daily.empty else pd.DataFrame()], ignore_index=True)
        if combined_daily.empty:
            st.info("Sin datos.")
        else:
            view = combined_daily.rename(columns={"origen":"Origen", "dia":"Día", "insumo":"Insumo", "categoria":"Categoría", "unidad":"Unidad", "necesario_base":"Necesario base", "extra_5":"Extra 5%", "necesario_total":"Necesario total", "stock_actual":"Stock actual", "faltante_vs_stock":"Faltante vs stock"})
            st.dataframe(view, use_container_width=True, hide_index=True)
    with tabs[3]:
        combined_weekly = pd.concat([weekly.assign(origen="Dietas/producción") if not weekly.empty else pd.DataFrame(), dehyd_weekly.assign(origen="Deshidratadores") if not dehyd_weekly.empty else pd.DataFrame()], ignore_index=True)
        if combined_weekly.empty:
            st.info("Sin datos.")
        else:
            view = combined_weekly.rename(columns={"origen":"Origen", "insumo":"Insumo", "categoria":"Categoría", "unidad":"Unidad", "necesario_base":"Necesario base", "extra_5":"Extra 5%", "necesario_total":"Necesario total", "stock_actual":"Stock actual", "comprar_vs_stock":"Comprar vs stock", "estado":"Estado"})
            st.dataframe(view, use_container_width=True, hide_index=True)
    with tabs[4]:
        if combined_provider.empty or "categoria" not in combined_provider.columns:
            st.info("Sin datos de packaging.")
        else:
            pack = combined_provider[combined_provider["categoria"].apply(is_packaging_category)].copy()
            if pack.empty:
                st.info("No se detectaron bolsas, etiquetas o doypacks en la planificación cargada.")
            else:
                pc1, pc2, pc3 = st.columns(3)
                with pc1: metric_card("Items packaging", str(pack["insumo"].nunique()))
                with pc2: metric_card("Costo packaging", format_currency(pack["costo_estimado"].sum()))
                with pc3: metric_card("Sin precio", str(int((pack["estado_costo"] == "Sin precio").sum())) if "estado_costo" in pack.columns else "0")
                pack_view = pack.rename(columns={"origen":"Origen", "proveedor":"Proveedor", "dia_ingreso":"Día ingreso", "para_usar":"Para usar", "insumo":"Insumo", "categoria":"Categoría", "unidad":"Unidad", "necesario_base":"Necesario base", "extra_5":"Extra 5%", "necesario_total":"Necesario total", "stock_actual":"Stock actual", "cantidad_a_pedir":"Cantidad a pedir", "costo_unitario_proveedor":"Costo unitario proveedor", "costo_estimado":"Costo estimado", "estado_costo":"Estado costo", "observacion":"Observación"})
                st.dataframe(pack_view, use_container_width=True, hide_index=True)
    with tabs[5]:
        if combined_provider.empty:
            st.info("Sin datos.")
        else:
            view = combined_provider.rename(columns={"origen":"Origen", "proveedor":"Proveedor", "dia_ingreso":"Día ingreso", "para_usar":"Para usar", "insumo":"Insumo", "categoria":"Categoría", "unidad":"Unidad", "necesario_base":"Necesario base", "extra_5":"Extra 5%", "necesario_total":"Necesario total", "stock_actual":"Stock actual", "cantidad_a_pedir":"Cantidad a pedir", "costo_unitario_proveedor":"Costo unitario proveedor", "costo_estimado":"Costo estimado", "estado_costo":"Estado costo", "observacion":"Observación"})
            st.dataframe(view, use_container_width=True, hide_index=True)
    with tabs[6]:
        if dehyd_provider.empty:
            st.info("Sin costos de deshidratadores calculados.")
        else:
            dcost = dehyd_provider.copy()
            cmat = dcost[~dcost["categoria"].apply(is_packaging_category)]["costo_estimado"].sum() if "categoria" in dcost.columns else 0
            cpack = dcost[dcost["categoria"].apply(is_packaging_category)]["costo_estimado"].sum() if "categoria" in dcost.columns else 0
            c1, c2, c3 = st.columns(3)
            with c1: metric_card("Costo MP deshidratadores", format_currency(cmat))
            with c2: metric_card("Costo packaging", format_currency(cpack))
            with c3: metric_card("Costo total", format_currency(cmat + cpack))
            st.dataframe(dcost.rename(columns={"proveedor":"Proveedor", "dia_ingreso":"Día ingreso", "para_usar":"Para usar", "insumo":"Insumo", "categoria":"Categoría", "unidad":"Unidad", "necesario_base":"Necesario base", "extra_5":"Extra 5%", "necesario_total":"Necesario total", "cantidad_a_pedir":"Cantidad a pedir", "costo_unitario_proveedor":"Costo unitario proveedor", "costo_estimado":"Costo estimado", "estado_costo":"Estado costo", "observacion":"Observación"}), use_container_width=True, hide_index=True)

    xlsx = weekly_planning_excel_bytes(plan_rows, detail, daily, weekly, provider_order, dehyd_rows, dehyd_detail, dehyd_daily, dehyd_weekly, combined_provider)
    st.download_button(
        "Descargar planificación semanal Excel",
        data=xlsx,
        file_name=f"Rawer_planificacion_semanal_{date.today().isoformat()}.xlsx",
        mime="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
    )

    st.markdown("### Guardar planificación")
    st.caption("Cada guardado crea una versión nueva. No se pisa el historial anterior, aunque sea la misma semana.")
    if st.button("Guardar planificación de esta semana", type="primary", key="save_weekly_planning_v915"):
        save_weekly_planning_snapshot(planning_week_start, planning_note, plan_rows, dehyd_rows, combined_provider)
        st.success(f"Planificación de la semana {planning_week_start.isoformat()} guardada en el historial.")

    render_weekly_planning_history()

def page_batch_calculator():
    hero("Calculadora de producción", "Elegí qué batchs vas a producir y la app calcula insumos con un 5% extra de cobertura para estar siempre cubiertos.")
    products = recipe_products().rename(columns={"name":"producto"})
    if products.empty:
        st.warning("Todavía no hay recetas cargadas para calcular compras.")
        return
    products["batchs"] = 0.0
    edited = st.data_editor(
        products,
        hide_index=True,
        use_container_width=True,
        column_config={
            "id": None,
            "producto": st.column_config.TextColumn("Producto", disabled=True),
            "batchs": st.column_config.NumberColumn("Batchs a producir", min_value=0.0, step=0.5),
        },
    )
    selected_plan, purchase = calculate_purchase_plan(edited)
    if selected_plan.empty:
        st.info("Cargá la cantidad de batchs a producir para ver necesidades de compra.")
        return
    st.markdown("### Resumen")
    total_items = len(purchase)
    to_buy = purchase[purchase["comprar"] > 0]
    c1, c2, c3 = st.columns(3)
    with c1:
        metric_card("Batchs planificados", f"{selected_plan['batchs'].sum():,.1f}".replace(",", "."))
    with c2:
        metric_card("Insumos evaluados", str(total_items))
    with c3:
        metric_card("Insumos a comprar", str(len(to_buy)))

    st.markdown("### Resultado por insumo")
    view = purchase.rename(columns={
        "insumo": "Insumo",
        "categoria": "Categoría",
        "unidad": "Unidad",
        "necesario_base": "Necesario base",
        "extra_5": "Extra 5%",
        "necesario_total": "Necesario total",
        "stock_actual": "Stock actual",
        "comprar": "Comprar",
        "estado": "Estado",
    })
    st.dataframe(view, use_container_width=True, hide_index=True)

    if not to_buy.empty:
        st.markdown("### Pedido de compra sugerido")
        buy_view = to_buy[["insumo", "categoria", "unidad", "necesario_total", "stock_actual", "comprar"]].rename(columns={
            "insumo":"Insumo", "categoria":"Categoría", "unidad":"Unidad", "necesario_total":"Necesario con 5%", "stock_actual":"Stock actual", "comprar":"Cantidad a comprar"
        })
        st.dataframe(buy_view, use_container_width=True, hide_index=True)
    else:
        st.success("Con el stock de insumos cargado, no haría falta comprar para este plan incluyendo el 5% extra.")

    xlsx = purchase_plan_excel_bytes(selected_plan, purchase)
    st.download_button(
        "Descargar planilla de compra con 5% extra",
        data=xlsx,
        file_name=f"Rawer_pedido_compra_{date.today().isoformat()}.xlsx",
        mime="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
    )



def _analysis_period_col(df, date_col, granularity):
    """Devuelve etiquetas de periodo para dia, semana o mes."""
    s = pd.to_datetime(df[date_col], errors="coerce")
    if granularity == "Día":
        return s.dt.strftime("%Y-%m-%d")
    if granularity == "Semana":
        # Semana ISO: ano-semana
        iso = s.dt.isocalendar()
        return iso["year"].astype(str) + "-S" + iso["week"].astype(str).str.zfill(2)
    return s.dt.strftime("%Y-%m")


def _date_range_list(start_date, end_date):
    if start_date > end_date:
        start_date, end_date = end_date, start_date
    days = (end_date - start_date).days
    # Evitamos consultas excesivas si el rango es muy largo.
    if days > 730:
        start_date = end_date - timedelta(days=730)
        days = 730
    return [start_date + timedelta(days=i) for i in range(days + 1)]


def analysis_stock_series(start_date, end_date, granularity, deposits, product_names):
    rows = []
    for d in _date_range_list(start_date, end_date):
        snap = dashboard_df(d)
        if deposits:
            snap = snap[snap["deposit"].isin(deposits)]
        if product_names:
            snap = snap[snap["name"].isin(product_names)]
        if snap.empty:
            continue
        grouped = snap.groupby("deposit", as_index=False).agg(
            stock_real=("stock_real", "sum"),
            stock_disponible=("stock_disponible", "sum"),
            stock_ecommapp=("stock_disponible_ecommapp", "sum"),
            vendido_pendiente=("vendido_pendiente_total", "sum"),
            produccion_pendiente=("produccion_pendiente", "sum"),
        )
        grouped["fecha"] = d
        rows.append(grouped)
    if not rows:
        return pd.DataFrame()
    out = pd.concat(rows, ignore_index=True)
    out["periodo"] = _analysis_period_col(out, "fecha", granularity)
    if granularity == "Día":
        return out.sort_values(["fecha", "deposit"])
    # Para niveles de stock por semana/mes, usamos el último valor del periodo.
    out = out.sort_values("fecha").groupby(["periodo", "deposit"], as_index=False).tail(1)
    return out.sort_values(["periodo", "deposit"])


def analysis_production_series(start_date, end_date, granularity, deposits, product_names):
    df = read_sql(
        """
        SELECT m.movement_date AS fecha, COALESCE(m.deposit, ?) AS deposito, p.name AS producto,
               m.quantity AS unidades, m.effective_date AS fecha_impacto_stock
        FROM movements m
        JOIN products p ON p.id = m.product_id
        WHERE m.movement_type = 'produccion'
          AND COALESCE(m.is_undone,0) = 0
          AND date(m.movement_date) BETWEEN date(?) AND date(?)
        """,
        (DEFAULT_DEPOSIT, start_date.isoformat(), end_date.isoformat()),
    )
    if df.empty:
        return df
    if deposits:
        df = df[df["deposito"].isin(deposits)]
    if product_names:
        df = df[df["producto"].isin(product_names)]
    if df.empty:
        return df
    df["periodo"] = _analysis_period_col(df, "fecha", granularity)
    return df.groupby(["periodo", "deposito", "producto"], as_index=False)["unidades"].sum().sort_values(["periodo", "deposito", "producto"])


def analysis_sales_series(start_date, end_date, granularity, deposits, product_names):
    """Ventas comerciales para Analisis.

    Reglas Rawer:
    - Ventas importadas de Tiendanube = canal Minorista.
    - Ventas particulares / petshops = canal Mayorista.
    - Siempre se respetan deposito/ubicacion y productos desconocidos para poder auditarlos.
    """
    # Importante: NO filtramos product_id IS NOT NULL, porque los SKU desconocidos
    # suelen ser combos pendientes de configurar y tambien deben aparecer en Analisis.
    tn = read_sql(
        """
        SELECT COALESCE(NULLIF(order_created_at,''), NULLIF(delivery_date_tn,''), imported_at) AS fecha,
               COALESCE(NULLIF(sale_deposit,''), ?) AS deposito,
               COALESCE(NULLIF(product_name_rawer,''), NULLIF(product_name_tn,''), NULLIF(sku,''), 'SKU sin identificar') AS producto,
               quantity AS unidades, 'Minorista' AS canal,
               COALESCE(NULLIF(order_number,''), NULLIF(order_id,''), '') AS orden
        FROM tiendanube_sales
        WHERE COALESCE(is_undone,0) = 0
          AND date(substr(COALESCE(NULLIF(order_created_at,''), NULLIF(delivery_date_tn,''), imported_at), 1, 10)) BETWEEN date(?) AND date(?)
        """,
        (PENDING_DEPOSIT, start_date.isoformat(), end_date.isoformat()),
    )
    pv = read_sql(
        """
        SELECT COALESCE(NULLIF(sale_date,''), created_at) AS fecha,
               COALESCE(NULLIF(sale_deposit,''), ?) AS deposito,
               COALESCE(NULLIF(product_name,''), 'Producto sin identificar') AS producto,
               quantity AS unidades, 'Mayorista' AS canal,
               COALESCE(NULLIF(order_number,''), '') AS orden
        FROM private_sales
        WHERE COALESCE(is_undone,0) = 0
          AND date(substr(COALESCE(NULLIF(sale_date,''), created_at), 1, 10)) BETWEEN date(?) AND date(?)
        """,
        (PENDING_DEPOSIT, start_date.isoformat(), end_date.isoformat()),
    )
    df = pd.concat([tn, pv], ignore_index=True)
    if df.empty:
        return df
    df["unidades"] = pd.to_numeric(df["unidades"], errors="coerce").fillna(0)
    if deposits:
        df = df[df["deposito"].isin(deposits)]
    if product_names:
        df = df[df["producto"].isin(product_names)]
    if df.empty:
        return df
    df["periodo"] = _analysis_period_col(df, "fecha", granularity)
    grouped = df.groupby(["periodo", "deposito", "producto", "canal"], as_index=False)["unidades"].sum()
    return grouped.sort_values(["periodo", "deposito", "producto", "canal"])



def analysis_report_data(start_date, end_date, granularity, deposits=None, product_names=None):
    """Arma las tablas base del reporte operativo descargable.

    Incluye producción, ventas, ingresos de insumos y movimientos de costos valorizados.
    Los ingresos de insumos se mantienen por unidad de medida para no sumar kg con unidades.
    """
    deposits = deposits or []
    product_names = product_names or []

    prod = analysis_production_series(start_date, end_date, granularity, deposits, product_names)
    sales = analysis_sales_series(start_date, end_date, granularity, deposits, product_names)

    # Ingresos de insumos: solo entradas reales activas.
    sup = costed_supply_movements_df(start_date, end_date)
    if sup.empty:
        ingresos = pd.DataFrame()
        costos = pd.DataFrame()
        costos_resumen = pd.DataFrame()
    else:
        sup = sup.copy()
        sup["cantidad"] = pd.to_numeric(sup.get("cantidad", 0), errors="coerce").fillna(0.0)
        sup["costo_unitario"] = pd.to_numeric(sup.get("costo_unitario", 0), errors="coerce").fillna(0.0)
        sup["costo_total"] = pd.to_numeric(sup.get("costo_total", 0), errors="coerce").fillna(0.0)
        sup["grupo_costo"] = sup["tipo"].apply(classify_cost_movement)
        sup["periodo"] = _analysis_period_col(sup, "fecha", granularity)

        ingresos = sup[sup["tipo"].astype(str).str.lower().isin(["ingreso", "ingreso_insumos"])].copy()
        if not ingresos.empty:
            ingresos = ingresos.sort_values(["periodo", "categoria", "insumo"])

        # Costos: todos los movimientos valorizados, separados por naturaleza.
        costos = sup.copy().sort_values(["periodo", "grupo_costo", "categoria", "insumo"])
        costos_resumen = costos.groupby(["periodo", "grupo_costo"], as_index=False).agg(
            costo_total=("costo_total", "sum")
        ).sort_values(["periodo", "grupo_costo"])

    # Resumen operativo por período. Cantidades de insumos no se suman entre unidades distintas.
    periodos = set()
    if not prod.empty:
        periodos.update(prod["periodo"].astype(str).tolist())
    if not sales.empty:
        periodos.update(sales["periodo"].astype(str).tolist())
    if not costos_resumen.empty:
        periodos.update(costos_resumen["periodo"].astype(str).tolist())

    resumen = pd.DataFrame({"periodo": sorted(periodos)}) if periodos else pd.DataFrame(columns=["periodo"])
    if not resumen.empty:
        if not prod.empty:
            x = prod.groupby("periodo", as_index=False)["unidades"].sum().rename(columns={"unidades":"produccion_unidades"})
            resumen = resumen.merge(x, on="periodo", how="left")
        else:
            resumen["produccion_unidades"] = 0.0
        if not sales.empty:
            x = sales.groupby("periodo", as_index=False)["unidades"].sum().rename(columns={"unidades":"ventas_unidades"})
            resumen = resumen.merge(x, on="periodo", how="left")
        else:
            resumen["ventas_unidades"] = 0.0

        # Costos por grupo en columnas.
        if not costos_resumen.empty:
            pivot = costos_resumen.pivot_table(index="periodo", columns="grupo_costo", values="costo_total", aggfunc="sum", fill_value=0).reset_index()
            rename = {
                "Ingresos / compras": "costo_ingresos_compras",
                "Consumo productivo": "costo_consumo_productivo",
                "Pérdidas / ajustes negativos": "costo_perdidas_ajustes",
                "Ajustes positivos": "costo_ajustes_positivos",
                "Otros": "costo_otros",
            }
            pivot = pivot.rename(columns=rename)
            resumen = resumen.merge(pivot, on="periodo", how="left")

        for c in ["produccion_unidades","ventas_unidades","costo_ingresos_compras","costo_consumo_productivo","costo_perdidas_ajustes","costo_ajustes_positivos","costo_otros"]:
            if c not in resumen.columns:
                resumen[c] = 0.0
            resumen[c] = pd.to_numeric(resumen[c], errors="coerce").fillna(0.0)
        resumen["produccion_menos_ventas"] = resumen["produccion_unidades"] - resumen["ventas_unidades"]

    costos_vigentes = latest_supply_costs_df().copy()
    return {
        "resumen": resumen,
        "produccion": prod,
        "ventas": sales,
        "ingresos_insumos": ingresos,
        "costos_movimientos": costos,
        "costos_resumen": costos_resumen,
        "costos_vigentes": costos_vigentes,
    }

def add_variation_columns(df, value_col="unidades", group_cols=None):
    """Agrega variacion absoluta y porcentual contra periodo anterior."""
    if df.empty:
        return df
    out = df.copy()
    group_cols = group_cols or []
    sort_cols = group_cols + ["periodo"]
    out = out.sort_values(sort_cols)
    if group_cols:
        out["periodo_anterior"] = out.groupby(group_cols)[value_col].shift(1)
    else:
        out["periodo_anterior"] = out[value_col].shift(1)
    out["variacion"] = out[value_col] - out["periodo_anterior"].fillna(0)
    out["variacion_%"] = out.apply(
        lambda r: None if pd.isna(r["periodo_anterior"]) or float(r["periodo_anterior"] or 0) == 0 else (float(r[value_col]) - float(r["periodo_anterior"])) / float(r["periodo_anterior"]) * 100,
        axis=1,
    )
    return out



def page_suppliers():
    st.title("🏢 Proveedores")
    st.caption("Administrá proveedores, insumos comprados, precios y reglas de ingreso para planificación semanal.")
    seed_supplier_tables()
    tab1, tab2, tab3 = st.tabs(["Proveedores", "Insumos y precios", "Resumen"])

    with tab1:
        st.subheader("Alta de proveedor")
        with st.form("form_add_supplier"):
            c1, c2 = st.columns([2, 3])
            new_name = c1.text_input("Nombre del proveedor")
            new_notes = c2.text_input("Observación")
            submitted = st.form_submit_button("Agregar proveedor")
            if submitted:
                name = (new_name or "").strip()
                if not name:
                    st.error("Ingresá un nombre de proveedor.")
                else:
                    conn = get_conn(); now = datetime.now().isoformat(timespec="seconds")
                    try:
                        conn.execute(
                            "INSERT OR IGNORE INTO suppliers(name, notes, active, created_at, updated_at) VALUES (?, ?, 1, ?, ?)",
                            (name, new_notes, now, now),
                        )
                        conn.commit()
                        st.success("Proveedor agregado/cargado con éxito.")
                        st.rerun()
                    finally:
                        conn.close()
        suppliers_df = read_sql("SELECT id, name AS proveedor, COALESCE(notes,'') AS observacion, active AS activo, updated_at AS actualizado_el FROM suppliers ORDER BY name")
        if suppliers_df.empty:
            st.info("No hay proveedores cargados.")
        else:
            edited = st.data_editor(
                suppliers_df,
                hide_index=True,
                use_container_width=True,
                disabled=["id", "actualizado_el"],
                column_config={"activo": st.column_config.CheckboxColumn("Activo")},
                key="edit_suppliers_table",
            )
            if st.button("Guardar cambios de proveedores"):
                conn = get_conn(); now = datetime.now().isoformat(timespec="seconds")
                for _, r in edited.iterrows():
                    conn.execute(
                        "UPDATE suppliers SET name=?, notes=?, active=?, updated_at=? WHERE id=?",
                        (str(r["proveedor"]).strip(), str(r.get("observacion", "") or ""), 1 if bool(r.get("activo")) else 0, now, int(r["id"])),
                    )
                conn.commit(); conn.close()
                st.success("Proveedores actualizados con éxito.")
                st.rerun()

    with tab2:
        st.subheader("Agregar insumo/precio a proveedor")
        supplies_df = get_supplies(True)
        suppliers = supplier_names(True)
        if not suppliers or supplies_df.empty:
            st.warning("Primero cargá proveedores e insumos activos.")
        else:
            with st.form("form_add_supplier_supply"):
                c1, c2, c3 = st.columns([2, 3, 1])
                prov = c1.selectbox("Proveedor", suppliers)
                supply_label = c2.selectbox("Insumo", supplies_df["name"].tolist())
                price = c3.number_input("Precio unitario", min_value=0.0, value=0.0, step=1.0)
                c4, c5 = st.columns([2, 3])
                entry_day = c4.text_input("Día/regla ingreso", value="Compra semanal")
                note = c5.text_input("Observación", value="")
                add = st.form_submit_button("Guardar insumo/precio")
                if add:
                    conn = get_conn(); now = datetime.now().isoformat(timespec="seconds")
                    sup_id = int(pd.read_sql_query("SELECT id FROM suppliers WHERE name=?", conn, params=(prov,)).iloc[0]["id"])
                    sid = int(supplies_df[supplies_df["name"] == supply_label].iloc[0]["id"])
                    conn.execute(
                        """
                        INSERT INTO supplier_supply_prices(supplier_id, supply_id, price_unit, entry_day, note, active, created_at, updated_at)
                        VALUES (?, ?, ?, ?, ?, 1, ?, ?)
                        ON CONFLICT(supplier_id, supply_id) DO UPDATE SET
                            price_unit=excluded.price_unit,
                            entry_day=excluded.entry_day,
                            note=excluded.note,
                            active=1,
                            updated_at=excluded.updated_at
                        """,
                        (sup_id, sid, float(price), entry_day, note, now, now),
                    )
                    # También registra el costo actual del insumo para que Costos use el último precio.
                    conn.execute(
                        """
                        INSERT INTO supply_costs(supply_id, cost_date, cost_unit, includes_tax, supplier, note, created_at)
                        VALUES (?, ?, ?, 1, ?, ?, ?)
                        """,
                        (sid, date.today().isoformat(), float(price), prov, note, now),
                    )
                    conn.commit(); conn.close()
                    st.success("Insumo/precio guardado con éxito.")
                    st.rerun()

        st.subheader("Precios por proveedor")
        df = provider_supply_prices_df(active_only=False)
        if df.empty:
            st.info("No hay precios por proveedor cargados.")
        else:
            f1, f2, f3 = st.columns([2, 2, 2])
            prov_filter = f1.multiselect("Filtrar proveedor", sorted(df["proveedor"].unique().tolist()))
            cat_filter = f2.multiselect("Filtrar categoría", sorted(df["categoria"].unique().tolist()))
            text_filter = f3.text_input("Buscar insumo")
            view = df.copy()
            if prov_filter:
                view = view[view["proveedor"].isin(prov_filter)]
            if cat_filter:
                view = view[view["categoria"].isin(cat_filter)]
            if text_filter:
                view = view[view["insumo"].str.contains(text_filter, case=False, na=False)]
            edited = st.data_editor(
                view,
                hide_index=True,
                use_container_width=True,
                disabled=["id", "proveedor", "insumo", "categoria", "unidad", "actualizado_el"],
                column_config={
                    "precio_unitario": st.column_config.NumberColumn("Precio unitario", min_value=0.0, step=1.0),
                    "activo": st.column_config.CheckboxColumn("Activo"),
                },
                key="supplier_price_editor",
            )
            if st.button("Guardar cambios de precios"):
                conn = get_conn(); now = datetime.now().isoformat(timespec="seconds")
                for _, r in edited.iterrows():
                    conn.execute(
                        "UPDATE supplier_supply_prices SET price_unit=?, entry_day=?, note=?, active=?, updated_at=? WHERE id=?",
                        (float(r.get("precio_unitario") or 0), str(r.get("dia_ingreso", "") or ""), str(r.get("observacion", "") or ""), 1 if bool(r.get("activo")) else 0, now, int(r["id"])),
                    )
                    # Registrar historial de costo del insumo asociado al proveedor.
                    sid_df = pd.read_sql_query(
                        """
                        SELECT supply_id, sup.name AS proveedor FROM supplier_supply_prices sp
                        JOIN suppliers sup ON sup.id = sp.supplier_id
                        WHERE sp.id=?
                        """,
                        conn,
                        params=(int(r["id"]),),
                    )
                    if not sid_df.empty:
                        conn.execute(
                            """
                            INSERT INTO supply_costs(supply_id, cost_date, cost_unit, includes_tax, supplier, note, created_at)
                            VALUES (?, ?, ?, 1, ?, ?, ?)
                            """,
                            (int(sid_df.iloc[0]["supply_id"]), date.today().isoformat(), float(r.get("precio_unitario") or 0), str(sid_df.iloc[0]["proveedor"]), str(r.get("observacion", "") or ""), now),
                        )
                conn.commit(); conn.close()
                st.success("Precios actualizados con éxito.")
                st.rerun()

    with tab3:
        st.subheader("Resumen proveedor × insumo")
        df = provider_supply_prices_df(active_only=True)
        if df.empty:
            st.info("No hay datos para mostrar.")
        else:
            st.dataframe(df, hide_index=True, use_container_width=True)
            xlsx = df_to_excel_bytes({"Proveedores insumos": df})
            st.download_button("Descargar proveedores a Excel", xlsx, file_name="Rawer_Data_proveedores_insumos.xlsx", mime="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet")


def page_costs():
    hero("Costos", "Cargá costos de insumos y analizá cuánto se consume por día, semana o mes.")
    today = date.today()
    tab_costs, tab_analysis, tab_product = st.tabs(["Costos de insumos", "Análisis de costos", "Costo por batch"])

    with tab_costs:
        st.markdown("### Costos actuales de insumos")
        st.caption("Cada cambio queda guardado como historial de precio. La calculadora y los análisis toman el último costo cargado, o el costo vigente a la fecha del movimiento cuando exista historial.")
        cost_date = st.date_input("Fecha del costo", value=today, key="costos_fecha_costo")
        df = latest_supply_costs_df()
        if df.empty:
            st.info("Todavía no hay insumos cargados.")
        else:
            col1, col2 = st.columns([1, 2])
            with col1:
                cats = sorted(df["category"].dropna().unique().tolist())
                cat_filter = st.multiselect("Categoría", cats, default=[])
            with col2:
                search = st.text_input("Buscar insumo", key="buscar_costo_insumo")
            view = df.copy()
            if cat_filter:
                view = view[view["category"].isin(cat_filter)]
            if search:
                view = view[view["name"].str.contains(search, case=False, na=False)]
            edited = st.data_editor(
                view.rename(columns={
                    "name": "insumo", "category": "categoria", "unit": "unidad", "stock_actual": "stock_actual",
                    "costo_unitario": "costo_unitario", "iva_incluido": "iva_incluido", "proveedor": "proveedor",
                    "fecha_costo": "fecha_costo", "observacion_costo": "observacion_costo",
                }),
                hide_index=True,
                use_container_width=True,
                column_config={
                    "id": st.column_config.NumberColumn("ID", disabled=True),
                    "insumo": st.column_config.TextColumn("Insumo", disabled=True),
                    "categoria": st.column_config.TextColumn("Categoría", disabled=True),
                    "unidad": st.column_config.TextColumn("Unidad", disabled=True),
                    "stock_actual": st.column_config.NumberColumn("Stock actual", disabled=True),
                    "costo_unitario": st.column_config.NumberColumn("Costo unitario", min_value=0.0, step=1.0, format="%.2f"),
                    "iva_incluido": st.column_config.CheckboxColumn("IVA incluido"),
                    "proveedor": st.column_config.TextColumn("Proveedor"),
                    "fecha_costo": st.column_config.TextColumn("Última fecha", disabled=True),
                    "observacion_costo": st.column_config.TextColumn("Observación"),
                },
                key="costos_insumos_editor",
            )
            if st.button("Guardar costos de insumos", type="primary"):
                to_save = edited.rename(columns={"insumo":"name", "categoria":"category", "unidad":"unit"})
                saved = save_supply_costs(to_save, cost_date)
                if saved:
                    st.success(f"Costos guardados con éxito. Cambios registrados: {saved}.")
                    st.rerun()
                else:
                    st.info("No se detectaron cambios para guardar.")
        hist = supply_cost_history_df()
        with st.expander("Historial de costos", expanded=False):
            st.dataframe(hist.rename(columns={
                "fecha":"Fecha", "insumo":"Insumo", "categoria":"Categoría", "unidad":"Unidad", "costo_unitario":"Costo unitario", "iva_incluido":"IVA incluido", "proveedor":"Proveedor", "observacion":"Observación", "cargado_el":"Cargado el"
            }), use_container_width=True, hide_index=True)

    with tab_analysis:
        st.markdown("### Consumos e ingresos valorizados")
        c1, c2, c3 = st.columns([1, 1, 1])
        with c1:
            start_date = st.date_input("Desde", value=today - timedelta(days=30), key="cost_analysis_start")
        with c2:
            end_date = st.date_input("Hasta", value=today, key="cost_analysis_end")
        with c3:
            granularity = st.selectbox("Agrupar por", ["Día", "Semana", "Mes"], key="cost_analysis_granularity")
        df = costed_supply_movements_df(start_date, end_date)
        if df.empty:
            st.info("No hay movimientos de insumos para el período seleccionado.")
        else:
            df["grupo_costo"] = df["tipo"].apply(classify_cost_movement)
            f1, f2 = st.columns([1, 1])
            with f1:
                cats = sorted(df["categoria"].dropna().unique().tolist())
                cat_filter = st.multiselect("Categorías", cats, default=[], key="cost_analysis_cats")
            with f2:
                groups = sorted(df["grupo_costo"].dropna().unique().tolist())
                default_groups = [g for g in ["Consumo productivo", "Pérdidas / ajustes negativos"] if g in groups]
                group_filter = st.multiselect("Tipo de costo", groups, default=default_groups, key="cost_analysis_groups")
            view = df.copy()
            if cat_filter:
                view = view[view["categoria"].isin(cat_filter)]
            if group_filter:
                view = view[view["grupo_costo"].isin(group_filter)]
            if view.empty:
                st.info("No hay movimientos para esos filtros.")
            else:
                total_cost = float(view["costo_total"].sum())
                total_qty_rows = int(len(view))
                missing_cost = int((view["costo_unitario"] <= 0).sum())
                m1, m2, m3 = st.columns(3)
                with m1:
                    metric_card("Costo total", f"${total_cost:,.0f}".replace(",", "."))
                with m2:
                    metric_card("Movimientos", str(total_qty_rows))
                with m3:
                    metric_card("Sin costo cargado", str(missing_cost))
                view["periodo"] = _analysis_period_col(view, "fecha", granularity)
                by_period = view.groupby("periodo", as_index=False)["costo_total"].sum()
                st.markdown("#### Evolución de costos")
                st.bar_chart(by_period.set_index("periodo"), use_container_width=True)
                by_cat = view.groupby("categoria", as_index=False)["costo_total"].sum().sort_values("costo_total", ascending=False)
                st.markdown("#### Costo por categoría")
                st.dataframe(by_cat.rename(columns={"categoria":"Categoría", "costo_total":"Costo total"}), use_container_width=True, hide_index=True)
                by_supply = view.groupby(["insumo", "unidad"], as_index=False).agg(cantidad=("cantidad", "sum"), costo_total=("costo_total", "sum")).sort_values("costo_total", ascending=False)
                st.markdown("#### Insumos con mayor impacto")
                st.dataframe(by_supply.rename(columns={"insumo":"Insumo", "unidad":"Unidad", "cantidad":"Cantidad", "costo_total":"Costo total"}), use_container_width=True, hide_index=True)
                st.markdown("#### Detalle valorizado")
                st.dataframe(view.rename(columns={
                    "fecha":"Fecha", "insumo":"Insumo", "categoria":"Categoría", "unidad":"Unidad", "tipo":"Movimiento",
                    "cantidad":"Cantidad", "costo_unitario":"Costo unitario", "costo_total":"Costo total", "grupo_costo":"Grupo", "observacion":"Observación"
                })[["Fecha", "Grupo", "Movimiento", "Insumo", "Categoría", "Unidad", "Cantidad", "Costo unitario", "Costo total", "Observación"]], use_container_width=True, hide_index=True)
                xlsx = df_to_excel_bytes({
                    "Detalle costos": view,
                    "Por periodo": by_period,
                    "Por categoria": by_cat,
                    "Por insumo": by_supply,
                })
                st.download_button(
                    "Descargar análisis de costos Excel",
                    data=xlsx,
                    file_name=f"Rawer_Data_costos_{start_date}_{end_date}.xlsx",
                    mime="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
                )

    with tab_product:
        st.markdown("### Costo teórico por batch")
        st.caption("Calculado con la receta vigente y el último costo cargado de cada insumo. Sirve para controlar costos antes de producir.")
        details = product_recipe_costs_df()
        if details.empty:
            st.info("No hay recetas cargadas.")
        else:
            prods = sorted(details["producto"].unique().tolist())
            selected_products = st.multiselect("Productos", prods, default=[])
            view = details.copy()
            if selected_products:
                view = view[view["producto"].isin(selected_products)]
            summary = view.groupby("producto", as_index=False).agg(costo_batch=("costo_total", "sum"), insumos=("insumo", "count")).sort_values("producto")
            st.dataframe(summary.rename(columns={"producto":"Producto", "costo_batch":"Costo por batch", "insumos":"Insumos en receta"}), use_container_width=True, hide_index=True)
            with st.expander("Detalle por insumo", expanded=False):
                st.dataframe(view.rename(columns={
                    "producto":"Producto", "insumo":"Insumo", "categoria":"Categoría", "unidad":"Unidad", "cantidad_por_batch":"Cantidad por batch", "costo_unitario":"Costo unitario", "costo_total":"Costo total"
                })[["Producto", "Insumo", "Categoría", "Unidad", "Cantidad por batch", "Costo unitario", "Costo total"]], use_container_width=True, hide_index=True)
            st.download_button(
                "Descargar costo por batch Excel",
                data=df_to_excel_bytes({"Costo por batch": summary, "Detalle recetas valorizadas": view}),
                file_name=f"Rawer_Data_costo_batch_{date.today().isoformat()}.xlsx",
                mime="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
            )

def page_analysis():
    hero("Análisis", "Evolución de stock, producción y ventas por depósito, producto y período.")
    today = date.today()
    default_start = today - timedelta(days=30)
    c1, c2, c3 = st.columns([1, 1, 1])
    with c1:
        start_date = st.date_input("Desde", value=default_start, key="analysis_start")
    with c2:
        end_date = st.date_input("Hasta", value=today, key="analysis_end")
    with c3:
        granularity = st.selectbox("Agrupar por", ["Día", "Semana", "Mes"], index=0)

    products_df = get_products(True)
    product_names = products_df["name"].tolist() if not products_df.empty else []
    f1, f2 = st.columns([1, 2])
    with f1:
        deposits = st.multiselect("Depósitos", DEPOSIT_OPTIONS_WITH_PENDING, default=[])
    with f2:
        product_filter = st.multiselect("Productos", product_names, default=[])
    st.caption("Si no elegís depósitos o productos, el análisis toma todos. Las ventas con depósito pendiente también se muestran para revisar.")

    tab_stock, tab_prod, tab_sales, tab_reports = st.tabs(["Stock", "Producción", "Ventas", "Reportes descargables"])

    with tab_stock:
        st.markdown("### Variación de stock por depósito")
        stock = analysis_stock_series(start_date, end_date, granularity, deposits, product_filter)
        if stock.empty:
            st.info("No hay datos de stock para los filtros seleccionados.")
        else:
            total_stock = stock.groupby("periodo", as_index=False).agg(
                stock_real=("stock_real", "sum"),
                stock_disponible=("stock_disponible", "sum"),
                stock_ecommapp=("stock_ecommapp", "sum"),
                vendido_pendiente=("vendido_pendiente", "sum"),
            )
            st.line_chart(total_stock.set_index("periodo")[["stock_real", "stock_disponible", "stock_ecommapp"]], use_container_width=True)
            by_dep = stock.pivot_table(index="periodo", columns="deposit", values="stock_real", aggfunc="sum", fill_value=0)
            st.markdown("#### Stock real por depósito")
            st.line_chart(by_dep, use_container_width=True)
            view = stock.rename(columns={
                "periodo":"Período", "deposit":"Depósito", "stock_real":"Stock real", "stock_disponible":"Stock disponible calculado",
                "stock_ecommapp":"Stock cargado/importado", "vendido_pendiente":"Vendido pendiente", "produccion_pendiente":"Producción pendiente"
            })
            st.dataframe(view[["Período", "Depósito", "Stock real", "Stock disponible calculado", "Stock cargado/importado", "Vendido pendiente", "Producción pendiente"]], use_container_width=True, hide_index=True)

    with tab_prod:
        st.markdown("### Variación de producción")
        prod = analysis_production_series(start_date, end_date, granularity, deposits, product_filter)
        if prod.empty:
            st.info("No hay producción registrada para los filtros seleccionados.")
        else:
            total_prod = prod.groupby("periodo", as_index=False)["unidades"].sum()
            st.bar_chart(total_prod.set_index("periodo"), use_container_width=True)
            prod_dep = prod.groupby(["periodo", "deposito"], as_index=False)["unidades"].sum().pivot_table(index="periodo", columns="deposito", values="unidades", aggfunc="sum", fill_value=0)
            st.markdown("#### Producción por depósito")
            st.line_chart(prod_dep, use_container_width=True)
            top_prod = prod.groupby("producto", as_index=False)["unidades"].sum().sort_values("unidades", ascending=False).head(20)
            st.markdown("#### Productos más producidos")
            st.dataframe(top_prod.rename(columns={"producto":"Producto", "unidades":"Unidades producidas"}), use_container_width=True, hide_index=True)
            st.markdown("#### Detalle")
            st.dataframe(prod.rename(columns={"periodo":"Período", "deposito":"Depósito", "producto":"Producto", "unidades":"Unidades"}), use_container_width=True, hide_index=True)

    with tab_sales:
        st.markdown("### Análisis completo de ventas")
        sales = analysis_sales_series(start_date, end_date, granularity, deposits, product_filter)
        if sales.empty:
            st.info("No hay ventas registradas para los filtros seleccionados.")
        else:
            total_units = float(sales["unidades"].sum())
            periods_count = sales["periodo"].nunique()
            deposits_count = sales["deposito"].nunique()
            products_count = sales["producto"].nunique()
            m1, m2, m3, m4 = st.columns(4)
            m1.metric("Unidades vendidas", f"{total_units:,.0f}".replace(",", "."))
            m2.metric("Períodos", periods_count)
            m3.metric("Depósitos con ventas", deposits_count)
            m4.metric("Productos vendidos", products_count)

            total_sales = sales.groupby("periodo", as_index=False)["unidades"].sum()
            total_sales_var = add_variation_columns(total_sales, "unidades")
            st.markdown("#### Variación total de ventas")
            st.bar_chart(total_sales.set_index("periodo"), use_container_width=True)
            total_view = total_sales_var.rename(columns={
                "periodo":"Período", "unidades":"Unidades", "periodo_anterior":"Período anterior",
                "variacion":"Variación", "variacion_%":"Variación %"
            })
            st.dataframe(total_view, use_container_width=True, hide_index=True)

            st.markdown("#### Ventas por depósito")
            sales_dep_base = sales.groupby(["periodo", "deposito"], as_index=False)["unidades"].sum()
            sales_dep = sales_dep_base.pivot_table(index="periodo", columns="deposito", values="unidades", aggfunc="sum", fill_value=0)
            st.line_chart(sales_dep, use_container_width=True)
            sales_dep_var = add_variation_columns(sales_dep_base, "unidades", ["deposito"])
            st.dataframe(
                sales_dep_var.rename(columns={
                    "periodo":"Período", "deposito":"Depósito", "unidades":"Unidades",
                    "periodo_anterior":"Período anterior", "variacion":"Variación", "variacion_%":"Variación %"
                }),
                use_container_width=True, hide_index=True
            )

            st.markdown("#### Ventas por canal")
            st.caption("Regla: Tiendanube = Minorista. Ventas particulares / Petshops = Mayorista.")
            sales_channel_base = sales.groupby(["periodo", "canal"], as_index=False)["unidades"].sum()
            sales_channel = sales_channel_base.pivot_table(index="periodo", columns="canal", values="unidades", aggfunc="sum", fill_value=0)
            st.line_chart(sales_channel, use_container_width=True)
            st.dataframe(
                add_variation_columns(sales_channel_base, "unidades", ["canal"]).rename(columns={
                    "periodo":"Período", "canal":"Canal", "unidades":"Unidades",
                    "periodo_anterior":"Período anterior", "variacion":"Variación", "variacion_%":"Variación %"
                }),
                use_container_width=True, hide_index=True
            )

            st.markdown("#### Productos más vendidos")
            top_sales = sales.groupby("producto", as_index=False)["unidades"].sum().sort_values("unidades", ascending=False).head(30)
            st.bar_chart(top_sales.set_index("producto"), use_container_width=True)
            st.dataframe(top_sales.rename(columns={"producto":"Producto", "unidades":"Unidades vendidas"}), use_container_width=True, hide_index=True)

            st.markdown("#### Productos más vendidos por depósito")
            top_by_dep = sales.groupby(["deposito", "producto"], as_index=False)["unidades"].sum().sort_values(["deposito", "unidades"], ascending=[True, False])
            top_by_dep = top_by_dep.groupby("deposito", as_index=False).head(10)
            st.dataframe(top_by_dep.rename(columns={"deposito":"Depósito", "producto":"Producto", "unidades":"Unidades vendidas"}), use_container_width=True, hide_index=True)

            st.markdown("#### Detalle completo")
            detail = sales.rename(columns={"periodo":"Período", "deposito":"Depósito", "producto":"Producto", "canal":"Canal", "unidades":"Unidades"})
            st.dataframe(detail[["Período", "Depósito", "Canal", "Producto", "Unidades"]], use_container_width=True, hide_index=True)

            sales_export = {
                "Ventas detalle": detail,
                "Ventas por periodo": total_sales_var,
                "Ventas por deposito": sales_dep_var,
                "Ventas por canal": add_variation_columns(sales_channel_base, "unidades", ["canal"]),
                "Top productos": top_sales,
                "Top por deposito": top_by_dep,
            }
            st.download_button(
                "Descargar análisis de ventas Excel",
                data=df_to_excel_bytes(sales_export),
                file_name=f"Rawer_Data_analisis_ventas_{start_date}_{end_date}.xlsx",
                mime="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
            )


    with tab_reports:
        st.markdown("### Reporte operativo descargable")
        st.caption("Incluye producción, ventas, ingresos de insumos y costos valorizados para el período y agrupación seleccionados arriba.")
        report = analysis_report_data(start_date, end_date, granularity, deposits, product_filter)
        resumen = report["resumen"]

        if resumen.empty:
            st.info("No hay movimientos para armar el reporte con los filtros seleccionados.")
        else:
            total_prod = float(resumen["produccion_unidades"].sum())
            total_sales = float(resumen["ventas_unidades"].sum())
            total_purchases = float(resumen["costo_ingresos_compras"].sum())
            total_consumption = float(resumen["costo_consumo_productivo"].sum())
            r1, r2, r3, r4 = st.columns(4)
            r1.metric("Producción", f"{total_prod:,.0f}".replace(",", ".") + " u")
            r2.metric("Ventas", f"{total_sales:,.0f}".replace(",", ".") + " u")
            r3.metric("Ingresos / compras", "$ " + f"{total_purchases:,.0f}".replace(",", "."))
            r4.metric("Consumo productivo", "$ " + f"{total_consumption:,.0f}".replace(",", "."))

            st.markdown("#### Resumen por período")
            resumen_view = resumen.rename(columns={
                "periodo":"Período",
                "produccion_unidades":"Producción (u)",
                "ventas_unidades":"Ventas (u)",
                "produccion_menos_ventas":"Producción - ventas (u)",
                "costo_ingresos_compras":"Costo ingresos / compras",
                "costo_consumo_productivo":"Costo consumo productivo",
                "costo_perdidas_ajustes":"Costo pérdidas / ajustes",
                "costo_ajustes_positivos":"Costo ajustes positivos",
                "costo_otros":"Otros costos",
            })
            st.dataframe(resumen_view, use_container_width=True, hide_index=True)

            if not report["ingresos_insumos"].empty:
                st.markdown("#### Ingresos de insumos")
                ingresos_view = report["ingresos_insumos"].rename(columns={
                    "periodo":"Período", "fecha":"Fecha", "insumo":"Insumo", "categoria":"Categoría",
                    "unidad":"Unidad", "cantidad":"Cantidad", "proveedor":"Proveedor", "lote_materia_prima":"Lote MP",
                    "costo_unitario":"Costo unitario", "costo_total":"Costo total", "observacion":"Observación"
                })
                show_cols = [c for c in ["Período","Fecha","Insumo","Categoría","Unidad","Cantidad","Proveedor","Lote MP","Costo unitario","Costo total","Observación"] if c in ingresos_view.columns]
                st.dataframe(ingresos_view[show_cols], use_container_width=True, hide_index=True)
            else:
                st.caption("No hay ingresos de insumos registrados en este período.")

            # Export Excel integral.
            export_tables = {
                "Resumen": resumen_view,
                "Produccion": report["produccion"].rename(columns={"periodo":"Período","deposito":"Depósito","producto":"Producto","unidades":"Unidades"}),
                "Ventas": report["ventas"].rename(columns={"periodo":"Período","deposito":"Depósito","producto":"Producto","canal":"Canal","unidades":"Unidades"}),
                "Ingresos insumos": report["ingresos_insumos"].rename(columns={"periodo":"Período","fecha":"Fecha","insumo":"Insumo","categoria":"Categoría","unidad":"Unidad","cantidad":"Cantidad","proveedor":"Proveedor","lote_materia_prima":"Lote MP","costo_unitario":"Costo unitario","costo_total":"Costo total","observacion":"Observación"}),
                "Costos movimientos": report["costos_movimientos"].rename(columns={"periodo":"Período","fecha":"Fecha","grupo_costo":"Grupo costo","insumo":"Insumo","categoria":"Categoría","unidad":"Unidad","tipo":"Tipo","cantidad":"Cantidad","costo_unitario":"Costo unitario","costo_total":"Costo total","proveedor_costo":"Proveedor costo","fecha_costo":"Fecha costo"}),
                "Costos por periodo": report["costos_resumen"].rename(columns={"periodo":"Período","grupo_costo":"Grupo costo","costo_total":"Costo total"}),
                "Costos vigentes": report["costos_vigentes"],
            }
            gran_label = {"Día":"diario", "Semana":"semanal", "Mes":"mensual"}.get(granularity, "reporte")
            st.download_button(
                f"Descargar reporte {gran_label} Excel",
                data=df_to_excel_bytes(export_tables),
                file_name=f"Rawer_Data_reporte_{gran_label}_{start_date}_{end_date}.xlsx",
                mime="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
                type="primary",
            )


def page_products():
    hero("Productos", "Alta de productos y días que tardan en sumarse al stock después de producirse.")
    with st.expander("Agregar producto", expanded=True):
        c1, c2 = st.columns([3, 1])
        with c1:
            name = st.text_input("Nombre del producto")
        with c2:
            days = st.number_input("Días para stock", min_value=0, max_value=30, value=0, step=1)
        if st.button("Agregar / reactivar producto"):
            ok, msg = add_product(name, days)
            if ok:
                st.success(msg)
                st.rerun()
            else:
                st.error(msg)
    df = get_products(False).rename(columns={"name": "producto"})
    edited = st.data_editor(
        df,
        hide_index=True,
        use_container_width=True,
        column_config={
            "id": st.column_config.NumberColumn("ID", disabled=True),
            "producto": st.column_config.TextColumn("Producto", disabled=True),
            "days_to_stock": st.column_config.NumberColumn("Días para sumarse al stock", min_value=0, max_value=30, step=1),
            "active": st.column_config.CheckboxColumn("Activo"),
        },
    )
    if st.button("Guardar configuración de productos"):
        update_product_settings(edited.rename(columns={"producto": "name"}))
        st.success("Productos actualizados.")
        st.rerun()


def page_config_backup():
    hero("Configuración y backup", "Ubicación de la base local, carpeta de Drive y copias de seguridad.")
    st.warning("Usar Rawer Data desde una sola computadora a la vez. SQLite en Drive puede generar conflictos si dos equipos escriben al mismo tiempo.")

    c1, c2 = st.columns(2)
    with c1:
        st.metric("Ubicación actual", str(BASE_DIR))
        st.caption(f"Base de datos: {DB_PATH}")
    with c2:
        st.metric("Backups", str(BACKUP_DIR))
        st.caption(f"Config local: {CONFIG_FILE}")

    st.divider()
    st.subheader("Mover base a carpeta de Drive")
    st.caption(r"Pegá la ruta de una carpeta sincronizada de Google Drive. Ejemplo: C:\Users\Usuario\Google Drive\Rawer OS\Rawer Data")
    new_path = st.text_input("Carpeta base de Rawer Data", value=str(BASE_DIR), key="config_base_dir")
    if st.button("Guardar ubicación y copiar base actual", type="primary"):
        try:
            dest = migrate_database_to_base_dir(new_path)
            st.success(f"Base copiada/configurada en: {dest}")
            st.info("Cerrá y volvé a abrir Rawer Data para usar la nueva ubicación.")
        except Exception as e:
            st.error(f"No se pudo migrar la base: {e}")

    st.divider()
    st.subheader("Backups")
    c1, c2 = st.columns(2)
    with c1:
        if st.button("Crear backup ahora"):
            try:
                dest = backup_db("manual")
                if dest:
                    st.success(f"Backup creado: {dest}")
                else:
                    st.warning("Todavía no existe una base de datos para respaldar.")
            except Exception as e:
                st.error(f"No se pudo crear el backup: {e}")
    with c2:
        st.caption("La app crea automáticamente un backup diario al abrirse.")

    backups = sorted(BACKUP_DIR.glob("rawer_data_backup_*.db"), reverse=True) if BACKUP_DIR.exists() else []
    if backups:
        st.write("Backups disponibles")
        st.dataframe(pd.DataFrame([{
            "archivo": b.name,
            "fecha_modificacion": datetime.fromtimestamp(b.stat().st_mtime).strftime("%Y-%m-%d %H:%M:%S"),
            "tamaño_mb": round(b.stat().st_size / 1024 / 1024, 2),
            "ruta": str(b),
        } for b in backups]), use_container_width=True, hide_index=True)
        st.subheader("Restaurar backup")
        st.caption("Antes de restaurar, Rawer Data genera una copia de seguridad del estado actual.")
        selected = st.selectbox("Elegir backup", [b.name for b in backups], key="restore_backup_select")
        confirm = st.checkbox("Confirmo que quiero restaurar este backup", key="restore_backup_confirm")
        if st.button("Restaurar backup seleccionado", disabled=not confirm):
            try:
                backup_db("before_restore")
                source = next(b for b in backups if b.name == selected)
                shutil.copy2(source, DB_PATH)
                st.success("Backup restaurado. Cerrá y volvé a abrir Rawer Data para recargar la base.")
            except Exception as e:
                st.error(f"No se pudo restaurar: {e}")
    else:
        st.info("Todavía no hay backups en esta ubicación.")


def page_export():
    hero("Exportar", "Descargá un Excel con stock, movimientos, productos y stock disponible.")
    data = export_excel_bytes()
    st.download_button(
        "Descargar Excel completo",
        data=data,
        file_name=f"Rawer_Data_export_{date.today().isoformat()}.xlsx",
        mime="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
    )


def main():
    style_app()
    init_db()
    automatic_daily_backup()
    seed_supplier_tables()
    st.sidebar.markdown(
        """
        <div class='sidebar-brand'>
            <div class='brand-row'>
                <div class='brand-icon'>🐾</div>
                <div>
                    <div class='brand-title'>Rawer</div>
                    <div class='brand-subtitle'>Data</div>
                </div>
            </div>
        </div>
        <div class='sidebar-caption'>Panel de control</div>
        """,
        unsafe_allow_html=True,
    )
    page = st.sidebar.radio(
        "Menú",
        [
            "📊 Dashboard",
            "📈 Análisis",
            "📦 Stock inicial",
            "🏬 Stock real",
            "🧊 Stock por lote",
            "🏭 Producción",
            "📝 Carga diaria",
            "🟢 Stock disponible",
            "🛒 Ventas Tiendanube",
            "🧾 Ventas particulares",
            "🧩 Combos Tiendanube",
            "⏳ Producción pendiente",
            "📅 Historial",
            "🔎 Trazabilidad",
            "📋 Stock insumos",
            "🥩 Insumos",
            "💰 Costos",
            "🏢 Proveedores",
            "🧾 Batchs y recetas",
            "🗓️ Planificación semanal",
            "📐 Planificación por ventas",
            "🔥 Deshidratadores",
