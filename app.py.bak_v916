        fmovs = filter_dataframe(movs, text_cols=["insumo", "categoria", "observacion", "origen"], date_col="fecha", type_col="tipo")
        st.dataframe(fmovs, use_container_width=True, hide_index=True)

    with st.expander("Ver recetas cargadas por batch"):
        rec = recipes_df().rename(columns={
            "producto":"Producto", "insumo":"Insumo", "categoria":"Categoría", "unidad":"Unidad", "cantidad_por_batch":"Cantidad por batch"
        })
        st.dataframe(filter_dataframe(rec, text_cols=["Producto", "Insumo", "Categoría"]), use_container_width=True, hide_index=True)


def page_batch_recipes():
    hero("Batchs y recetas", "Agregá nuevos batchs/productos y modificá, agregá o eliminá composiciones de recetas.")
    st.info("Las cantidades se cargan por 1 batch. Carga diaria > Batchs MP descuenta materia prima con estas recetas. La Calculadora de producción usa la misma composición contra el stock de insumos.")

    tab1, tab2, tab3, tab4 = st.tabs(["Modificar receta", "Agregar componente", "Eliminar", "Ver recetas"])

    products = get_products(True)
    if products.empty:
        st.warning("Todavía no hay productos cargados.")
        return
    product_options = dict(zip(products["name"], products["id"]))

    with tab1:
        st.markdown("### Modificar composición completa")
        selected_name = st.selectbox("Producto / batch", list(product_options.keys()), key="recipe_edit_product_v61")
        selected_id = product_options[selected_name]
        detail = recipe_detail_df(selected_id)
        cat_filter = st.multiselect("Filtrar insumos por categoría", sorted(detail["categoria"].dropna().unique().tolist()), key="recipe_cat_filter_v61")
        edit_view = detail.copy()
        if cat_filter:
            edit_view = edit_view[edit_view["categoria"].isin(cat_filter)]
        edited = st.data_editor(
            edit_view,
            hide_index=True,
            use_container_width=True,
            key=f"recipe_editor_v61_{selected_id}",
            column_config={
                "supply_id": None,
                "insumo": st.column_config.TextColumn("Insumo", disabled=True),
                "categoria": st.column_config.TextColumn("Categoría", disabled=True),
                "unidad": st.column_config.TextColumn("Unidad", disabled=True),
                "cantidad_por_batch": st.column_config.NumberColumn("Cantidad por batch", min_value=0.0, step=0.01),
            },
        )
        st.caption("Para eliminar un insumo de la receta, poné cantidad 0 y guardá. Si usás filtro, solo se actualiza lo visible; el resto queda igual.")
        if st.button("Guardar cambios de receta", type="primary", key="save_recipe_existing_v61"):
            if cat_filter:
                full = recipe_detail_df(selected_id)
                full = full[~full["categoria"].isin(cat_filter)]
                combined = pd.concat([full, edited], ignore_index=True)
                saved = save_product_recipe(selected_id, combined)
            else:
                saved = save_product_recipe(selected_id, edited)
            set_flash(f"Receta guardada con éxito para {selected_name}. Insumos activos: {saved}.")
            st.rerun()

    with tab2:
        st.markdown("### Agregar o actualizar un insumo en una receta")
        selected_name_add = st.selectbox("Producto / batch", list(product_options.keys()), key="recipe_add_product_v61")
        selected_id_add = product_options[selected_name_add]
        supplies = get_supplies(True)
        supply_options = {f"{r['name']} ({r['unit']})": int(r['id']) for _, r in supplies.iterrows()}
        c1, c2 = st.columns([3, 1])
        with c1:
            supply_label = st.selectbox("Insumo a agregar/actualizar", list(supply_options.keys()), key="recipe_add_supply_v61")
        with c2:
            qty = st.number_input("Cantidad por batch", min_value=0.0, step=0.01, key="recipe_add_qty_v61")
        if st.button("Agregar / actualizar insumo en receta", key="add_recipe_component_v61"):
            ok, msg = add_or_update_recipe_component(selected_id_add, supply_options[supply_label], qty)
            if ok:
                set_flash(f"{msg} Producto: {selected_name_add}.")
                st.rerun()
            else:
                st.error(msg)

        st.markdown("### Crear producto/batch nuevo")
        c3, c4 = st.columns([3, 1])
        with c3:
            new_product_name = st.text_input("Nombre del nuevo producto / batch", placeholder="Ejemplo: NUEVA DIETA 500", key="new_batch_name_v61")
        with c4:
            new_days = st.number_input("Días para entrar a stock", min_value=0, max_value=30, value=0, step=1, key="new_batch_days_v61")
        if st.button("Crear producto/batch", key="create_new_batch_v61"):
            ok, msg = add_product(new_product_name, int(new_days))
            if ok:
                set_flash(msg + " Luego agregá los insumos de su composición.")
                st.rerun()
            else:
                st.error(msg)

    with tab3:
        st.markdown("### Eliminar insumo de una receta")
        selected_name_del = st.selectbox("Producto / batch", list(product_options.keys()), key="recipe_delete_product_v61")
        selected_id_del = product_options[selected_name_del]
        current = recipes_df()
        current = current[current["producto"] == selected_name_del]
        if current.empty:
            st.caption("Ese producto no tiene insumos cargados en receta.")
        else:
            supply_del_options = {f"{r['insumo']} ({r['cantidad_por_batch']} {r['unidad']})": r['insumo'] for _, r in current.iterrows()}
            supply_to_delete = st.selectbox("Insumo a eliminar", list(supply_del_options.keys()), key="recipe_component_delete_v61")
            supplies_all = get_supplies(False)
            sid_rows = supplies_all[supplies_all["name"] == supply_del_options[supply_to_delete]]
            if st.button("Eliminar insumo seleccionado", key="delete_recipe_component_v61"):
                if sid_rows.empty:
                    st.error("No se encontró el insumo.")
                else:
                    ok, msg = delete_recipe_component(selected_id_del, int(sid_rows.iloc[0]["id"]))
                    if ok:
                        set_flash(msg)
                        st.rerun()
                    else:
                        st.error(msg)

        st.markdown("### Vaciar receta completa o desactivar batch")
        st.warning("Vaciar receta elimina la composición del batch, pero no borra historial. Desactivar batch lo oculta de las cargas futuras.")
        c1, c2 = st.columns(2)
        with c1:
            if st.button("Vaciar receta completa", key="clear_recipe_v61"):
                deleted = clear_product_recipe(selected_id_del)
                set_flash(f"Receta vaciada. Componentes eliminados: {deleted}.")
                st.rerun()
        with c2:
            if st.button("Desactivar batch/producto", key="deactivate_product_v61"):
                ok, msg = deactivate_product(selected_id_del)
                set_flash(msg)
                st.rerun()

    with tab4:
        rec = recipes_df().rename(columns={
            "producto":"Producto", "insumo":"Insumo", "categoria":"Categoría", "unidad":"Unidad", "cantidad_por_batch":"Cantidad por batch"
        })
        if rec.empty:
            st.caption("Todavía no hay recetas cargadas.")
        else:
            f = filter_dataframe(rec, text_cols=["Producto", "Insumo", "Categoría"])
            st.dataframe(f, use_container_width=True, hide_index=True)
            xlsx = df_to_excel_bytes({"Recetas batchs": rec})
            st.download_button(
                "Descargar recetas a Excel",
                data=xlsx,
                file_name=f"Rawer_recetas_batchs_{date.today().isoformat()}.xlsx",
                mime="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
            )


def calculate_dehydrator_purchase_plan(plan_df):
    """Calcula materia prima necesaria para deshidratados en base a paquetes a armar.

    Antes esta calculadora trabajaba por equipos/tandas para algunos productos. Desde v6.6
    todos los productos se planifican por cantidad de paquetes terminados. Para productos
    con rendimiento por equipo, convierte automáticamente:
        materia prima por paquete = carga por equipo / paquetes estimados por equipo
    Para productos mixtos, usa los componentes ya definidos por paquete.
    """
    COVERAGE_EXTRA = 0.05
    plan_df = plan_df.copy()
    if plan_df.empty:
        return pd.DataFrame(), pd.DataFrame()
    plan_df["cantidad"] = pd.to_numeric(plan_df.get("cantidad", 0), errors="coerce").fillna(0)
    selected = plan_df[plan_df["cantidad"] > 0].copy()
    if selected.empty:
        return pd.DataFrame(), pd.DataFrame()
    stock = current_supply_stock()
    stock_map = {str(r["name"]): float(r["stock_actual"] or 0) for _, r in stock.iterrows()}
    unit_map = {str(r["name"]): str(r["unit"]) for _, r in stock.iterrows()}
    rows = []
    for _, row in selected.iterrows():
        producto = row["producto"]
        paquetes = float(row["cantidad"] or 0)
        info = DESHIDRATADOR_YIELDS.get(producto, {})
        componentes = info.get("componentes")
        if componentes:
            for comp in componentes:
                insumo = comp.get("insumo")
                carga_por_paquete = float(comp.get("carga") or 0)
                necesario = carga_por_paquete * paquetes
                rows.append({
                    "producto": producto,
                    "insumo": insumo,
                    "categoria": "Materia prima",
                    "unidad": unit_map.get(insumo, comp.get("unidad_insumo", "")),
                    "cantidad_planificada": paquetes,
                    "modo": "paquetes",
                    "carga_por_paquete": carga_por_paquete,
                    "paquetes_estimados": paquetes,
                    "tiempo_horas": info.get("tiempo_horas", ""),
                    "necesario_base": necesario,
                    "stock_actual": stock_map.get(insumo, 0.0),
                })
        else:
            insumo = info.get("insumo")
            carga_tanda = float(info.get("carga") or 0)
            paquetes_tanda = float(info.get("paquetes_estimados") or 0)
            carga_por_paquete = (carga_tanda / paquetes_tanda) if paquetes_tanda else 0.0
            necesario = carga_por_paquete * paquetes
            rows.append({
                "producto": producto,
                "insumo": insumo,
                "categoria": "Materia prima",
                "unidad": unit_map.get(insumo, info.get("unidad_insumo", "")),
                "cantidad_planificada": paquetes,
                "modo": "paquetes",
                "carga_por_paquete": carga_por_paquete,
                "paquetes_estimados": paquetes,
                "tiempo_horas": info.get("tiempo_horas", ""),
                "necesario_base": necesario,
                "stock_actual": stock_map.get(insumo, 0.0),
            })
    result = pd.DataFrame(rows)
    if result.empty:
        return selected, result
    grouped = result.groupby(["insumo", "categoria", "unidad"], as_index=False).agg(
        necesario_base=("necesario_base", "sum"),
        stock_actual=("stock_actual", "max"),
    )
    grouped["extra_5"] = grouped["necesario_base"] * COVERAGE_EXTRA
    grouped["necesario_total"] = grouped["necesario_base"] + grouped["extra_5"]
    grouped["comprar"] = (grouped["necesario_total"] - grouped["stock_actual"]).clip(lower=0)
    grouped["estado"] = grouped["comprar"].apply(lambda x: "OK" if x <= 0 else "Comprar")
    grouped = grouped[["insumo", "categoria", "unidad", "necesario_base", "extra_5", "necesario_total", "stock_actual", "comprar", "estado"]].sort_values(["estado", "insumo"], ascending=[False, True])
    return selected, grouped


def dehydrator_plan_excel_bytes(selected_plan, purchase_df, detail_df):
    wb = Workbook()
    ws = wb.active
    ws.title = "Pedido deshidratadores"
    out = purchase_df[purchase_df["comprar"] > 0].copy()
    if out.empty:
        out = purchase_df.copy()
    write_df(ws, out)
    ws2 = wb.create_sheet("Plan deshidratadores")
    write_df(ws2, selected_plan)
    ws3 = wb.create_sheet("Detalle por producto")
    write_df(ws3, detail_df)
    bio = BytesIO()
    wb.save(bio)
    return bio.getvalue()


def page_dehydrators():
    hero("Deshidratadores", "Cargá cuántos paquetes querés armar y la app calcula cuánta materia prima necesitás.")
    st.info("Ahora la calculadora trabaja por paquetes terminados. Para cada producto usa el rendimiento promedio para calcular materia prima necesaria y suma 5% extra para estar cubiertos.")

    yield_rows = []
    for product, info in DESHIDRATADOR_YIELDS.items():
        if info.get("componentes"):
            insumos = " + ".join([f"{c['insumo']} ({float(c['carga']):.3f} {c.get('unidad_insumo','')}/paquete)" for c in info["componentes"]])
            base_txt = "Composición por paquete"
            unidad_txt = "paquetes"
        else:
            insumos = info.get("insumo", "")
            carga_tanda = float(info.get("carga") or 0)
            paquetes_tanda = float(info.get("paquetes_estimados") or 0)
            carga_paquete = (carga_tanda / paquetes_tanda) if paquetes_tanda else 0.0
            base_txt = f"{carga_paquete:.3f} {info.get('unidad_insumo','')}/paquete"
            unidad_txt = info.get("unidad_insumo", "")
        yield_rows.append({
            "Producto": product,
            "Modo cálculo": "Por paquete",
            "Insumos descontados": insumos,
            "Materia prima por paquete": base_txt,
            "Unidad": unidad_txt,
            "Rendimiento base": f"{info.get('carga','')} {info.get('unidad_insumo','')} → {info.get('paquetes_estimados','')} paquetes" if not info.get("componentes") else "Composición fija por paquete",
            "Tiempo": f"{info['tiempo_horas']} hs",
            "Detalle": info.get("detalle", ""),
        })
    yields_df = pd.DataFrame(yield_rows)
    st.markdown("### Rendimientos cargados")
    st.dataframe(yields_df, use_container_width=True, hide_index=True)

    st.markdown("### Calculadora por paquetes")
    plan = pd.DataFrame({
        "producto": list(DESHIDRATADOR_YIELDS.keys()),
        "cantidad": [0.0] * len(DESHIDRATADOR_YIELDS),
    })
    edited = st.data_editor(
        plan,
        hide_index=True,
        use_container_width=True,
        column_config={
            "producto": st.column_config.TextColumn("Producto", disabled=True),
            "cantidad": st.column_config.NumberColumn("Paquetes a armar", min_value=0.0, step=1.0),
        },
        key="dehydrator_plan_editor_v66",
    )
    selected, purchase = calculate_dehydrator_purchase_plan(edited)
    if selected.empty:
        st.info("Cargá cuántos paquetes querés armar para calcular materia prima y compra necesaria.")
        return

    detail_rows = []
    for _, row in selected.iterrows():
        product = row["producto"]
        paquetes = float(row["cantidad"] or 0)
        info = DESHIDRATADOR_YIELDS[product]
        componentes = info.get("componentes")
        if componentes:
            for comp in componentes:
                carga_por_paquete = float(comp["carga"])
                detail_rows.append({
                    "Producto": product,
                    "Paquetes a armar": paquetes,
                    "Insumo": comp["insumo"],
                    "Materia prima por paquete": carga_por_paquete,
                    "Necesario base": carga_por_paquete * paquetes,
                    "Unidad": comp.get("unidad_insumo", ""),
                    "Tiempo": f"{info['tiempo_horas']} hs",
                    "Detalle": info.get("detalle", ""),
                })
        else:
            carga_tanda = float(info.get("carga") or 0)
            paquetes_tanda = float(info.get("paquetes_estimados") or 0)
            carga_por_paquete = (carga_tanda / paquetes_tanda) if paquetes_tanda else 0.0
            detail_rows.append({
                "Producto": product,
                "Paquetes a armar": paquetes,
                "Insumo": info["insumo"],
                "Materia prima por paquete": carga_por_paquete,
                "Necesario base": carga_por_paquete * paquetes,
                "Unidad": info["unidad_insumo"],
                "Tiempo": f"{info['tiempo_horas']} hs",
                "Detalle": info.get("detalle", ""),
            })
    detail_df = pd.DataFrame(detail_rows)

    c1, c2, c3 = st.columns(3)
    with c1:
        metric_card("Paquetes planificados", f"{selected['cantidad'].sum():,.0f}".replace(",", "."))
    with c2:
        metric_card("Productos planificados", str(len(selected)))
    with c3:
        metric_card("Insumos a comprar", str(len(purchase[purchase["comprar"] > 0])))

    st.markdown("### Detalle por producto")
    st.dataframe(detail_df, use_container_width=True, hide_index=True)

    st.markdown("### Resultado por insumo")
    view = purchase.rename(columns={
        "insumo": "Insumo",
        "categoria": "Categoría",
        "unidad": "Unidad",
        "necesario_base": "Necesario base",
        "extra_5": "Extra 5%",
        "necesario_total": "Necesario total",
        "stock_actual": "Stock actual",
        "comprar": "Comprar",
        "estado": "Estado",
    })
    st.dataframe(view, use_container_width=True, hide_index=True)

    xlsx = dehydrator_plan_excel_bytes(selected, purchase, detail_df)
    st.download_button(
        "Descargar pedido deshidratadores",
        data=xlsx,
        file_name=f"Rawer_pedido_deshidratadores_{date.today().isoformat()}.xlsx",
        mime="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
    )



