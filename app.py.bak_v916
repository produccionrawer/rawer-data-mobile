        """
    )



def update_dispatch_movement(movement_id, movement_date, deposit, product_id, quantity, numero_comanda, lote, note, edit_reason="Corrección manual de despacho"):
    movement_id = int(movement_id)
    quantity = float(quantity or 0)
    if quantity <= 0:
        return False, "La cantidad debe ser mayor a cero."
    if deposit not in DEPOSITS:
        return False, "Depósito no válido."
    conn = get_conn()
    row = conn.execute(
        """
        SELECT id, movement_date, effective_date, deposit, product_id, quantity, numero_comanda, lote, note
        FROM movements
        WHERE id = ? AND movement_type = 'despacho' AND COALESCE(is_undone,0)=0
        """,
        (movement_id,),
    ).fetchone()
    if row is None:
        conn.close()
        return False, "No se encontró el despacho activo para modificar."
    old_values = dict(row)
    movement_date_s = movement_date.isoformat() if hasattr(movement_date, "isoformat") else str(movement_date)
    new_values = {
        "movement_date": movement_date_s,
        "effective_date": movement_date_s,
        "deposit": deposit,
        "product_id": int(product_id),
        "quantity": quantity,
        "numero_comanda": str(numero_comanda or "").strip(),
        "lote": str(lote or "").strip(),
        "note": str(note or "").strip(),
    }
    now = datetime.now().isoformat(timespec="seconds")
    conn.execute(
        """
        UPDATE movements
        SET movement_date = ?, effective_date = ?, deposit = ?, product_id = ?, quantity = ?,
            numero_comanda = ?, lote = ?, note = ?
        WHERE id = ? AND movement_type = 'despacho'
        """,
        (
            new_values["movement_date"], new_values["effective_date"], new_values["deposit"],
            new_values["product_id"], new_values["quantity"], new_values["numero_comanda"],
            new_values["lote"], new_values["note"], movement_id,
        ),
    )
    conn.execute(
        """
        INSERT INTO dispatch_edit_log(movement_id, edited_at, edit_reason, old_values, new_values)
        VALUES (?, ?, ?, ?, ?)
        """,
        (movement_id, now, str(edit_reason or ""), json.dumps(old_values, ensure_ascii=False), json.dumps(new_values, ensure_ascii=False)),
    )
    conn.commit()
    conn.close()
    return True, "Despacho modificado con éxito."


def undo_product_movement(movement_id, reason="Deshacer movimiento desde historial"):
    conn = get_conn()
    now = datetime.now().isoformat(timespec="seconds")
    row = conn.execute("SELECT * FROM movements WHERE id = ?", (int(movement_id),)).fetchone()
    if row is None:
        conn.close()
        return False, "No se encontró el movimiento."
    if int(row["is_undone"] or 0) == 1:
        conn.close()
        return False, "Ese movimiento ya estaba deshecho."
    old_values = dict(row)
    conn.execute(
        "UPDATE movements SET is_undone = 1, undone_at = ?, undo_reason = ? WHERE id = ?",
        (now, str(reason or ""), int(movement_id)),
    )
    conn.execute(
        """
        INSERT INTO undo_log(table_name, record_id, undone_at, reason, old_values)
        VALUES (?, ?, ?, ?, ?)
        """,
        ("movements", int(movement_id), now, str(reason or ""), json.dumps(old_values, ensure_ascii=False)),
    )
    conn.commit()
    conn.close()
    return True, "Movimiento de producto terminado deshecho con éxito."


def undo_supply_movement(movement_id, reason="Deshacer movimiento desde historial"):
    conn = get_conn()
    now = datetime.now().isoformat(timespec="seconds")
    row = conn.execute("SELECT * FROM supply_movements WHERE id = ?", (int(movement_id),)).fetchone()
    if row is None:
        conn.close()
        return False, "No se encontró el movimiento de insumo."
    if int(row["is_undone"] or 0) == 1:
        conn.close()
        return False, "Ese movimiento de insumo ya estaba deshecho."
    old_values = dict(row)
    movement_type = str(row["movement_type"] or "")
    qty = float(row["quantity"] or 0)
    # Revertir efecto sobre stock de insumos.
    # ingreso y ajuste_positivo habían sumado; consumo/ajuste_negativo habían restado.
    original_sign = 1 if movement_type in ("ingreso", "ajuste_positivo") else -1
    reverse_delta = -original_sign * qty
    conn.execute(
        """
        INSERT INTO supply_stock(supply_id, quantity, updated_at)
        VALUES (?, ?, ?)
        ON CONFLICT(supply_id) DO UPDATE SET
            quantity = supply_stock.quantity + excluded.quantity,
            updated_at = excluded.updated_at
        """,
        (int(row["supply_id"]), reverse_delta, now),
    )
    conn.execute(
        "UPDATE supply_movements SET is_undone = 1, undone_at = ?, undo_reason = ? WHERE id = ?",
        (now, str(reason or ""), int(movement_id)),
    )
    conn.execute(
        """
        INSERT INTO undo_log(table_name, record_id, undone_at, reason, old_values)
        VALUES (?, ?, ?, ?, ?)
        """,
        ("supply_movements", int(movement_id), now, str(reason or ""), json.dumps(old_values, ensure_ascii=False)),
    )
    conn.commit()
    conn.close()
    return True, "Movimiento de insumo deshecho con éxito y stock de insumos corregido."


def undo_tiendanube_sale(sale_id, reason="Deshacer venta Tiendanube desde historial"):
    conn = get_conn()
    now = datetime.now().isoformat(timespec="seconds")
    row = conn.execute("SELECT * FROM tiendanube_sales WHERE id = ?", (int(sale_id),)).fetchone()
    if row is None:
        conn.close()
        return False, "No se encontró la venta de Tiendanube."
    if int(row["is_undone"] or 0) == 1:
        conn.close()
        return False, "Esa venta ya estaba deshecha."
    old_values = dict(row)
    conn.execute(
        "UPDATE tiendanube_sales SET is_undone = 1, undone_at = ?, undo_reason = ? WHERE id = ?",
        (now, str(reason or ""), int(sale_id)),
    )
    conn.execute(
        """
        INSERT INTO undo_log(table_name, record_id, undone_at, reason, old_values)
        VALUES (?, ?, ?, ?, ?)
        """,
        ("tiendanube_sales", int(sale_id), now, str(reason or ""), json.dumps(old_values, ensure_ascii=False)),
    )
    conn.commit()
    conn.close()
    return True, "Línea de venta Tiendanube deshecha con éxito."


def undo_tiendanube_order(order_number, reason="Deshacer orden Tiendanube completa desde historial"):
    conn = get_conn()
    now = datetime.now().isoformat(timespec="seconds")
    rows = conn.execute(
        "SELECT * FROM tiendanube_sales WHERE TRIM(COALESCE(order_number,'')) = TRIM(?) AND COALESCE(is_undone,0)=0",
        (str(order_number or ""),),
    ).fetchall()
    if not rows:
        conn.close()
        return False, "No se encontraron líneas activas para esa orden."
    for row in rows:
        old_values = dict(row)
        conn.execute(
            "UPDATE tiendanube_sales SET is_undone = 1, undone_at = ?, undo_reason = ? WHERE id = ?",
            (now, str(reason or ""), int(row["id"])),
        )
        conn.execute(
            "INSERT INTO undo_log(table_name, record_id, undone_at, reason, old_values) VALUES (?, ?, ?, ?, ?)",
            ("tiendanube_sales", int(row["id"]), now, str(reason or ""), json.dumps(old_values, ensure_ascii=False)),
        )
    conn.commit()
    conn.close()
    return True, f"Orden Tiendanube {order_number} deshecha con éxito. Líneas anuladas: {len(rows)}."


