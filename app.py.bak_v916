def clean_manjares_sku(value):
    """Normaliza códigos de Manjares. Muchos vienen con sufijo UNID."""
    raw = str(value or "").strip().upper()
    raw = re.sub(r"\s+", "", raw)
    if raw.endswith("UNID"):
        raw = raw[:-4]
    return raw


def infer_manjares_product_from_description(description):
    """Devuelve nombre de producto Rawer Data a partir de la descripción de Manjares.

    Se usa como respaldo cuando Manjares usa un SKU distinto al de Rawer Data.
    """
    d = normalize_key(description)
    if not d:
        return None

    # Dietas perro
    if "DIETA PERRO" in d:
        if "CARNE" in d or "VACA" in d:
            if "333" in d:
                return "PERRO VACA 333"
            if "500" in d:
                return "PERRO VACA 500"
            if "715" in d or "751" in d:
                return "PERRO VACA 715"
        if "POLLO" in d:
            if "333" in d:
                return "PERRO POLLO 333"
            if "500" in d:
                return "PERRO POLLO 500"
            if "715" in d:
                return "PERRO POLLO 715"
        if "PESCADO" in d:
            if "333" in d:
                return "PERRO PESCADO 333"
            if "500" in d:
                return "PERRO PESCADO 500"
            if "715" in d:
                return "PERRO PESCADO 715"

    # Dietas gato y transición
    if "GATO" in d and ("VACA" in d or "CARNE" in d):
        return "GATO VACA"
    if "GATO" in d and "POLLO" in d:
        return "GATO POLLO"
    if "GATO" in d and "PESCADO" in d:
        return "GATO PESCADO"
    if "TRANSICION" in d:
        return "TRANSICION"

    # Congelados / snacks / otros
    if "CALDO" in d:
        return "CALDO X 30U"
    if "CORNALITO" in d and "CONGEL" in d:
        return "CORNALITO CONGELADO 250"
    if "OREJA" in d:
        return "OREJAS X 6U"
    if "TRAQUEA" in d and "RELLENA" in d:
        return "TRAQUEA RELLENA X 2U"
    if "TRAQUEA" in d:
        return "TRAQUEAS X 6U"
    if "HUESO" in d:
        return "HUESO RECREATIVO"
    if "REGALO" in d:
        return "REGALO PRIMER CLIENTE"
    if "RUFFITO" in d:
        return "RUFFITOS"
    if "CANNABIS" in d or "CANNACEI" in d:
        return "ACEITE CANNABIS"
    if "PULMON" in d and ("DESHIDRAT" in d or "GRANEL" in d):
        return "JERKY PULMON"
    if "PECHUGA" in d and ("DESHIDRAT" in d or "GRANEL" in d):
        return "JERKY PECHUGA"
    if "HIGADO" in d and ("DESHIDRAT" in d or "GRANEL" in d):
        return "JERKY HIGADO"
    if "CORAZON" in d and ("DESHIDRAT" in d or "GRANEL" in d):
        return "JERKY CORAZON"
    if "MERLUZA" in d and ("DESHIDRAT" in d or "GRANEL" in d):
        return "JERKY MERLUZA"
    if "CORNALITO" in d and ("DESHIDRAT" in d or "GRANEL" in d):
        return "JERKY CORNALITO"

    # Jerkys
    if "JERKY" in d:
        if "BEEF" in d:
            return "JERKY BEEF 110GR"
        if "FARM" in d:
            return "JERKY FARM"
        if "OCEAN" in d:
            return "JERKY OCEAN"
        if "HIGADO" in d:
            return "JERKY HIGADO"
        if "CORAZON" in d:
            return "JERKY CORAZON"
        if "PECHUGA" in d:
            return "JERKY PECHUGA"
        if "PULMON" in d or "BOFE" in d:
            return "JERKY PULMON"
        if "CORNALITO" in d:
            return "JERKY CORNALITO"
        if "MERLUZA" in d:
            return "JERKY MERLUZA"
        if "MIX" in d:
            return "JERKY MIX"
    return None


def manjares_product_name_from_code_or_description(code, description=""):
    """Mapea códigos/descripciones de Manjares al nombre de producto interno."""
    cleaned = clean_manjares_sku(code)
    if cleaned in MANJARES_SKU_PRODUCT_MAP:
        return MANJARES_SKU_PRODUCT_MAP[cleaned]
    # Intentar también sin prefijos/sufijos raros normalizados.
    normalized_code = normalize_key(cleaned).replace(" ", "")
    for k, v in MANJARES_SKU_PRODUCT_MAP.items():
        if normalize_key(k).replace(" ", "") == normalized_code:
            return v
    return infer_manjares_product_from_description(description)


