def metric_card(label, value):
    st.markdown(f"<div class='metric-card'><div class='label'>{label}</div><div class='value'>{value}</div></div>", unsafe_allow_html=True)


def format_currency(value):
    try:
        if value is None:
            value = 0
        value = float(value)
    except Exception:
        value = 0
    return f"${value:,.0f}".replace(",", ".")


def set_flash(message):
    st.session_state["flash_success"] = message


def show_flash():
    message = st.session_state.pop("flash_success", None)
    if message:
        st.success(message)


def product_quantity_editor(key, quantity_col="cantidad", include_traceability=False, include_lote=False):
    products = get_products(True)[["id", "name"]].copy()
    products[quantity_col] = 0.0
    if include_traceability:
        products["numero_comanda"] = ""
        products["lote"] = ""
    elif include_lote:
        products["lote"] = ""
    products = products.rename(columns={"name": "producto"})
    column_config = {
        "id": None,
        "producto": st.column_config.TextColumn("Producto", disabled=True),
        quantity_col: st.column_config.NumberColumn("Cantidad", min_value=0.0, step=1.0),
    }
    if include_traceability:
        column_config["numero_comanda"] = st.column_config.TextColumn("N° comanda")
        column_config["lote"] = st.column_config.TextColumn("Lote despachado")
    elif include_lote:
        column_config["lote"] = st.column_config.TextColumn("Lote producido")
    edited = st.data_editor(
        products,
        key=key,
        hide_index=True,
        use_container_width=True,
        column_config=column_config,
    )
    return edited




def normalize_key(value):
    """Normaliza textos para comparar nombres de hojas, columnas, productos y SKUs."""
    txt = str(value or "").strip().upper()
    txt = unicodedata.normalize("NFKD", txt).encode("ascii", "ignore").decode("ascii")
    txt = re.sub(r"[^A-Z0-9]+", " ", txt)
    return re.sub(r"\s+", " ", txt).strip()


def dispatch_sheet_candidates(target_date):
    if not isinstance(target_date, (datetime, date)):
        target_date = pd.to_datetime(target_date).date()
    d = target_date.day
    m = target_date.month
    y = target_date.year
    raw = [
        f"{d:02d}-{m:02d}", f"{d}-{m}", f"{d:02d}-{m:02d}-{y}", f"{d}-{m}-{y}",
        f"{d:02d}.{m:02d}", f"{d}.{m}", f"{d:02d}.{m:02d}.{y}",
        f"{d:02d}/{m:02d}", f"{d}/{m}", f"{d:02d}/{m:02d}/{y}",
        f"{y}-{m:02d}-{d:02d}", f"{d:02d}{m:02d}{y}",
        f"{d:02d}_{m:02d}", f"{d:02d}_{m:02d}_{y}",
    ]
    return set(normalize_key(x) for x in raw)


def find_dispatch_sheet(excel_file, target_date):
    xls = pd.ExcelFile(excel_file)
    candidates = dispatch_sheet_candidates(target_date)
    # Match exact normalized sheet name first.
    for sh in xls.sheet_names:
        if normalize_key(sh) in candidates:
            return sh, xls.sheet_names
    # Match if the normalized date appears inside the sheet name.
    for sh in xls.sheet_names:
        nsh = normalize_key(sh)
        if any(c and c in nsh for c in candidates):
            return sh, xls.sheet_names
    return None, xls.sheet_names


def dispatch_product_aliases():
    aliases = {}
    # Product names.
    for _, r in get_products(False).iterrows():
        name = str(r["name"])
        aliases[normalize_key(name)] = int(r["id"])
    # Tiendanube/EcommApp SKU map.
    name_map = product_name_to_id()
    for sku, product_name in ECOMM_SKU_PRODUCT_MAP.items():
        pid = name_map.get(product_name)
        if pid:
            aliases[normalize_key(sku)] = int(pid)
    # Common short names used in planta / despachos.
    short = {
        "PV333": "PERRO VACA 333", "PV500": "PERRO VACA 500", "PV715": "PERRO VACA 715",
        "PP333": "PERRO POLLO 333", "PPO333": "PERRO POLLO 333",
        "PP500": "PERRO POLLO 500", "PPO500": "PERRO POLLO 500",
        "PP715": "PERRO POLLO 715", "PPO715": "PERRO POLLO 715",
        "PES500": "PERRO PESCADO 500", "PPES500": "PERRO PESCADO 500",
        "PES715": "PERRO PESCADO 715", "PPES715": "PERRO PESCADO 715",
        "GV": "GATO VACA", "GC": "GATO VACA", "GATO CARNE": "GATO VACA", "GATO VACA": "GATO VACA",
        "GPO": "GATO POLLO", "GPOLLO": "GATO POLLO", "GATO POLLO": "GATO POLLO",
        "GPES": "GATO PESCADO", "GPESCADO": "GATO PESCADO", "GATO PESCADO": "GATO PESCADO",
        "TRAN": "TRANSICION", "TRANSICION": "TRANSICION",
        "OREJAS": "OREJAS X 6U", "OREJAS X6": "OREJAS X 6U", "OREJAS X 6": "OREJAS X 6U",
        "TRAQUEAS": "TRAQUEAS X 6U", "TRAQUEAS X6": "TRAQUEAS X 6U", "TRAQUEAS X 6": "TRAQUEAS X 6U",
        "CALDO": "CALDO X 30U", "CALDO X30": "CALDO X 30U", "CALDO X 30": "CALDO X 30U",
        "CORNALITO CONGELADO": "CORNALITO CONGELADO 250", "CORNALITO 250": "CORNALITO CONGELADO 250",
        "HUESO RECREATIVO": "HUESO RECREATIVO", "TRAQUEA RELLENA": "TRAQUEA RELLENA X 2U",
        "JERKY HIGADO": "JERKY HIGADO", "HIGADO JERKY": "JERKY HIGADO",
        "JERKY CORAZON": "JERKY CORAZON", "CORAZON JERKY": "JERKY CORAZON",
        "JERKY PECHUGA": "JERKY PECHUGA", "PECHUGA JERKY": "JERKY PECHUGA",
        "JERKY PULMON": "JERKY PULMON", "JERKY BOFE": "JERKY PULMON", "PULMON JERKY": "JERKY PULMON",
        "JERKY CORNALITO": "JERKY CORNALITO", "CORNALITO JERKY": "JERKY CORNALITO",
        "JERKY MIX": "JERKY MIX", "MIX": "JERKY MIX",
        "JERKY MERLUZA": "JERKY MERLUZA", "MERLUZA JERKY": "JERKY MERLUZA",
        "JERKY BEEF": "JERKY BEEF 110GR", "BEEF": "JERKY BEEF 110GR", "JERKY BEEF 110": "JERKY BEEF 110GR",
        "JERKY FARM": "JERKY FARM", "FARM": "JERKY FARM",
        "JERKY OCEAN": "JERKY OCEAN", "OCEAN": "JERKY OCEAN",
        "RUFFITOS": "RUFFITOS", "ACEITE CANNABIS": "ACEITE CANNABIS",
    }
    for alias, product_name in short.items():
        pid = name_map.get(product_name)
        if pid:
            aliases[normalize_key(alias)] = int(pid)
    return aliases


def normalize_dispatch_deposit(value, default_deposit=DEFAULT_DEPOSIT):
    raw = str(value or "").strip()
    if not raw:
        return default_deposit
    key = normalize_key(raw)
    for dep in DEPOSITS:
        if normalize_key(dep) == key:
            return dep
    if key in ECOMM_DEPOSIT_MAP:
        return ECOMM_DEPOSIT_MAP[key]
    if "MANJARES" in key or "BUENOS AIRES" in key:
        return "Buenos Aires / Manjares"
    if "TANDIL" in key:
        return "Tandil"
    if "FABRICA" in key or "PLANTA" in key or "MAR DEL PLATA" in key:
        return "Planta Mar del Plata"
    return default_deposit


def find_dispatch_column(columns, options):
    normalized = {normalize_key(c): c for c in columns}
    for opt in options:
        nopt = normalize_key(opt)
        if nopt in normalized:
            return normalized[nopt]
    # Partial match as fallback.
    for ncol, original in normalized.items():
        for opt in options:
            if normalize_key(opt) and normalize_key(opt) in ncol:
                return original
    return None


def parse_dispatch_excel(uploaded_file, target_date, default_deposit=DEFAULT_DEPOSIT):
    sheet_name, all_sheets = find_dispatch_sheet(uploaded_file, target_date)
    if not sheet_name:
        return pd.DataFrame(), pd.DataFrame([{"Error": "No se encontró una hoja que coincida con la fecha seleccionada.", "Hojas encontradas": ", ".join(all_sheets)}]), None, all_sheets

    raw = pd.read_excel(uploaded_file, sheet_name=sheet_name)
    raw = raw.dropna(how="all")
    if raw.empty:
        return pd.DataFrame(), pd.DataFrame([{"Error": f"La hoja {sheet_name} está vacía."}]), sheet_name, all_sheets

    # Sacar columnas totalmente vacías y normalizar encabezados.
    raw = raw.dropna(axis=1, how="all")
    raw.columns = [str(c).strip() for c in raw.columns]

    comanda_col = find_dispatch_column(raw.columns, ["N° Comanda", "Nro Comanda", "Numero Comanda", "N Comanda", "Comanda", "Orden", "Pedido", "Numero Orden", "Nro Orden", "Order"])
    product_col = find_dispatch_column(raw.columns, ["Producto", "SKU", "SKU individual", "Producto / SKU", "Item", "Articulo", "Artículo"])
    qty_col = find_dispatch_column(raw.columns, ["Cantidad", "Unidades", "Cant", "Qty"])
    lote_col = find_dispatch_column(raw.columns, ["Lote", "Lote despachado"])
    deposit_col = find_dispatch_column(raw.columns, ["Deposito", "Depósito", "Sucursal", "Ubicacion", "Ubicación"])
    note_col = find_dispatch_column(raw.columns, ["Observacion", "Observación", "Nota", "Comentario"])

    # Fallback por posición si la hoja no tiene encabezados reconocibles.
    cols = list(raw.columns)
    if product_col is None and len(cols) >= 2:
        comanda_col = comanda_col or cols[0]
        product_col = cols[1]
    if qty_col is None and len(cols) >= 3:
        qty_col = cols[2]
    if lote_col is None and len(cols) >= 4:
        lote_col = cols[3]
    if deposit_col is None and len(cols) >= 5:
        deposit_col = cols[4]
    if note_col is None and len(cols) >= 6:
        note_col = cols[5]

    errors = []
    if not product_col or not qty_col:
        errors.append({"Error": "No se pudieron detectar columnas de producto/SKU y cantidad.", "Columnas encontradas": ", ".join(cols)})
        return pd.DataFrame(), pd.DataFrame(errors), sheet_name, all_sheets

    aliases = dispatch_product_aliases()
    product_df = get_products(False).set_index("id")
    parsed_rows = []
    for idx, row in raw.iterrows():
        prod_raw = row.get(product_col, "")
        qty_raw = row.get(qty_col, 0)
        if pd.isna(prod_raw) or str(prod_raw).strip() == "":
            continue
        qty = pd.to_numeric(qty_raw, errors="coerce")
        if pd.isna(qty) or float(qty) <= 0:
            continue
        prod_key = normalize_key(prod_raw)
        pid = aliases.get(prod_key)
        # Sometimes the cell contains SKU + product text; try token-level SKU/product detection.
        if pid is None:
            for alias_key, alias_pid in aliases.items():
                if alias_key and alias_key in prod_key:
                    pid = alias_pid
                    break
        if pid is None:
            errors.append({"Fila Excel": int(idx) + 2, "Producto/SKU": str(prod_raw), "Error": "Producto no reconocido"})
            continue
        comanda = str(row.get(comanda_col, "") if comanda_col else "").strip()
        # Avoid decimal-looking order numbers from Excel numeric cells.
        if comanda.endswith(".0"):
            comanda = comanda[:-2]
        lote = str(row.get(lote_col, "") if lote_col else "").strip()
        if lote.lower() == "nan":
            lote = ""
        dep = normalize_dispatch_deposit(row.get(deposit_col, "") if deposit_col else "", default_deposit)
        obs = str(row.get(note_col, "") if note_col else "").strip()
        if obs.lower() == "nan":
            obs = ""
        parsed_rows.append({
            "fecha": target_date.isoformat() if hasattr(target_date, "isoformat") else str(target_date),
            "deposito": dep,
            "product_id": int(pid),
            "producto": str(product_df.loc[int(pid), "name"]),
            "cantidad": float(qty),
            "numero_comanda": comanda,
            "lote": lote,
            "observacion": obs,
            "hoja": sheet_name,
            "fila_excel": int(idx) + 2,
        })
    parsed = pd.DataFrame(parsed_rows)
    errs = pd.DataFrame(errors)
    if not parsed.empty:
        parsed["duplicado"] = mark_existing_dispatch_duplicates(parsed)
    return parsed, errs, sheet_name, all_sheets


def mark_existing_dispatch_duplicates(parsed):
    if parsed.empty:
        return []
    conn = get_conn()
    existing = pd.read_sql_query(
        """
        SELECT movement_date, COALESCE(deposit,'') AS deposito, product_id, quantity,
               COALESCE(numero_comanda,'') AS numero_comanda, COALESCE(lote,'') AS lote
        FROM movements
        WHERE movement_type='despacho'
        """,
        conn,
    )
    conn.close()
    if existing.empty:
        return [False] * len(parsed)
    def key_df(df):
        return set(
            (
                str(r.get("movement_date", r.get("fecha", "")))[:10],
                str(r.get("deposito", "")),
                int(r.get("product_id")),
                round(float(r.get("quantity", r.get("cantidad", 0)) or 0), 6),
                str(r.get("numero_comanda", "") or "").strip(),
                str(r.get("lote", "") or "").strip(),
            )
            for _, r in df.iterrows()
        )
    existing_keys = key_df(existing)
    flags = []
    for _, r in parsed.iterrows():
        k = (
            str(r.get("fecha", ""))[:10],
            str(r.get("deposito", "")),
            int(r.get("product_id")),
            round(float(r.get("cantidad", 0) or 0), 6),
            str(r.get("numero_comanda", "") or "").strip(),
            str(r.get("lote", "") or "").strip(),
        )
        flags.append(k in existing_keys)
    return flags


def save_imported_dispatches(parsed, omit_duplicates=True):
    if parsed is None or parsed.empty:
        return 0, 0
    saved = 0
    skipped = 0
    for _, r in parsed.iterrows():
        if omit_duplicates and bool(r.get("duplicado", False)):
            skipped += 1
            continue
        note = str(r.get("observacion", "") or "").strip()
        extra = f"Importado desde Excel hoja {r.get('hoja','')} fila {r.get('fila_excel','')}"
        note = f"{note} | {extra}" if note else extra
        add_movement(
            pd.to_datetime(r["fecha"]).date(),
            int(r["product_id"]),
            "despacho",
            float(r["cantidad"]),
            pd.to_datetime(r["fecha"]).date(),
            note,
            "excel_despachos",
            str(r.get("numero_comanda", "") or ""),
            str(r.get("lote", "") or ""),
            str(r.get("deposito", DEFAULT_DEPOSIT) or DEFAULT_DEPOSIT),
        )
        saved += 1
    return saved, skipped


def find_csv_column(columns, options):
    norm_map = {normalize_text(c): c for c in columns}
    for opt in options:
        no = normalize_text(opt)
        if no in norm_map:
            return norm_map[no]
    for c in columns:
        nc = normalize_text(c)
        for opt in options:
            if normalize_text(opt) in nc:
                return c
    return None


def parse_manjares_dispatch_csv(uploaded_file):
    """Parsea CSV de pedidos/despachos Manjares.
    Usa SenasaPedidos.orden_de_compra como número de orden/comanda Tiendanube.
    El despacho impacta siempre en Buenos Aires / Manjares.
    """
    try:
        raw = pd.read_csv(uploaded_file, sep=",", encoding="utf-8-sig")
    except Exception:
        uploaded_file.seek(0)
        raw = pd.read_csv(uploaded_file, sep=",", encoding="latin1")
    errors = []
    if raw.empty:
        return pd.DataFrame(), pd.DataFrame([{"error": "El CSV está vacío."}])

    fecha_col = find_csv_column(raw.columns, ["SenasaPedidos.fecha_entrega", "fecha_entrega", "Fecha Entrega", "Fecha"])
    pedido_id_col = find_csv_column(raw.columns, ["SenasaPedidos.id", "id", "Pedido", "Numero Pedido", "Nro Pedido"])
    orden_col = find_csv_column(raw.columns, ["SenasaPedidos.orden_de_compra", "orden_de_compra", "Orden de compra", "OC", "Orden Compra"])
    estado_col = find_csv_column(raw.columns, ["PedidosSeguimiento.estado", "SenasaPedidos.estado", "estado", "Estado"])
    deposito_col = find_csv_column(raw.columns, ["Depositos.descripcion", "Deposito", "Depósito"])
    sku_col = find_csv_column(raw.columns, ["Producto Comercial", "Codigo", "Código", "SKU", "Producto"])
    desc_col = find_csv_column(raw.columns, ["Descripcion Del Producto Comercial", "Descripcion", "Descripción", "Producto Nombre"])
    qty_col = find_csv_column(raw.columns, ["Cantidades", "Cantidad", "Unidades", "Cant"])

    required = [(fecha_col, "fecha_entrega"), (sku_col, "SKU / Producto Comercial"), (qty_col, "Cantidades")]
    missing = [name for col, name in required if col is None]
    if missing:
        return pd.DataFrame(), pd.DataFrame([{"error": "Faltan columnas obligatorias: " + ", ".join(missing)}])

    aliases = dispatch_product_aliases()
    rows = []
    for idx, row in raw.iterrows():
        qty = pd.to_numeric(row.get(qty_col, 0), errors="coerce")
        if pd.isna(qty) or float(qty) <= 0:
            continue
        sku_raw = str(row.get(sku_col, "") or "").strip()
        desc_raw = str(row.get(desc_col, "") or "").strip() if desc_col else ""
        if not sku_raw and not desc_raw:
            errors.append({"fila_csv": idx + 2, "error": "SKU / descripción Manjares vacío"})
            continue

        product_id = None
        product_name = manjares_product_name_from_code_or_description(sku_raw, desc_raw)
        if product_name:
            product_id = product_name_to_id().get(product_name)

        if product_id is None and sku_raw:
            # Respaldo: alias por SKU/código limpio.
            product_id = aliases.get(normalize_key(clean_manjares_sku(sku_raw))) or aliases.get(normalize_text(sku_raw))
        if product_id is None and desc_raw:
            # Respaldo: alias por descripción completa o inferencia por palabras clave.
            inferred = infer_manjares_product_from_description(desc_raw)
            if inferred:
                product_id = product_name_to_id().get(inferred)
                product_name = inferred
            if product_id is None:
                product_id = aliases.get(normalize_key(desc_raw)) or aliases.get(normalize_text(desc_raw))

        if product_id is None:
            errors.append({
                "fila_csv": idx + 2,
                "error": "Producto/SKU Manjares no reconocido",
                "sku": sku_raw,
                "descripcion": desc_raw,
            })
            continue
        prod_row = read_sql("SELECT name FROM products WHERE id = ?", (int(product_id),))
        if not prod_row.empty:
            product_name = prod_row.iloc[0]["name"]
        f = pd.to_datetime(row.get(fecha_col), errors="coerce", dayfirst=False)
        if pd.isna(f):
            f = pd.to_datetime(row.get(fecha_col), errors="coerce", dayfirst=True)
        if pd.isna(f):
            errors.append({"fila_csv": idx + 2, "error": "Fecha de entrega inválida", "valor": str(row.get(fecha_col))})
            continue
        orden = str(row.get(orden_col, "") or "").strip() if orden_col else ""
        pedido_id = str(row.get(pedido_id_col, "") or "").strip() if pedido_id_col else ""
        estado = str(row.get(estado_col, "") or "").strip() if estado_col else ""
        dep_manjares = str(row.get(deposito_col, "") or "").strip() if deposito_col else ""
        rows.append({
            "fecha": f.date().isoformat(),
            "deposito": "Buenos Aires / Manjares",
            "numero_comanda": orden,
            "pedido_manjares_id": pedido_id,
            "sku_manjares": sku_raw,
            "descripcion_manjares": str(row.get(desc_col, "") or "") if desc_col else "",
            "product_id": int(product_id),
            "producto": product_name,
            "cantidad": float(qty),
            "lote": "",
            "estado_manjares": estado,
            "deposito_manjares": dep_manjares,
            "observacion": f"Importado CSV Manjares. Pedido Manjares: {pedido_id}. Estado: {estado}. Depósito origen: {dep_manjares}.",
            "fila_csv": idx + 2,
        })
    parsed = pd.DataFrame(rows)
    if not parsed.empty:
        parsed["duplicado"] = mark_existing_manjares_dispatch_duplicates(parsed)
        parsed["orden_tn_asociada"] = parsed["numero_comanda"].astype(str).str.strip().ne("")
    return parsed, pd.DataFrame(errors)


def mark_existing_manjares_dispatch_duplicates(parsed):
    if parsed is None or parsed.empty:
        return []
    conn = get_conn()
    flags = []
    for _, r in parsed.iterrows():
        pattern = f"%Pedido Manjares: {str(r.get('pedido_manjares_id','')).strip()}%" if str(r.get('pedido_manjares_id','')).strip() else None
        if pattern:
            row = conn.execute(
                """
                SELECT COUNT(*) FROM movements
                WHERE movement_type = 'despacho'
                  AND COALESCE(is_undone,0)=0
                  AND source = 'csv_manjares'
                  AND movement_date = ?
                  AND product_id = ?
                  AND COALESCE(deposit,'') = ?
                  AND COALESCE(numero_comanda,'') = ?
                  AND ABS(quantity - ?) < 0.00001
                  AND COALESCE(note,'') LIKE ?
                """,
                (str(r.get("fecha")), int(r.get("product_id")), "Buenos Aires / Manjares", str(r.get("numero_comanda", "") or ""), float(r.get("cantidad") or 0), pattern),
            ).fetchone()
        else:
            row = conn.execute(
                """
                SELECT COUNT(*) FROM movements
                WHERE movement_type = 'despacho'
                  AND COALESCE(is_undone,0)=0
                  AND source = 'csv_manjares'
                  AND movement_date = ?
                  AND product_id = ?
                  AND COALESCE(deposit,'') = ?
                  AND COALESCE(numero_comanda,'') = ?
                  AND ABS(quantity - ?) < 0.00001
                """,
                (str(r.get("fecha")), int(r.get("product_id")), "Buenos Aires / Manjares", str(r.get("numero_comanda", "") or ""), float(r.get("cantidad") or 0)),
            ).fetchone()
        flags.append((row[0] if row else 0) > 0)
    conn.close()
    return flags


def save_imported_manjares_dispatches(parsed, omit_duplicates=True):
    if parsed is None or parsed.empty:
        return 0, 0
    saved = 0
    skipped = 0
    for _, r in parsed.iterrows():
        if omit_duplicates and bool(r.get("duplicado", False)):
            skipped += 1
            continue
        add_movement(
            pd.to_datetime(r["fecha"]).date(),
            int(r["product_id"]),
            "despacho",
            float(r["cantidad"]),
            pd.to_datetime(r["fecha"]).date(),
            str(r.get("observacion", "") or ""),
            "csv_manjares",
            str(r.get("numero_comanda", "") or ""),
            str(r.get("lote", "") or ""),
            "Buenos Aires / Manjares",
        )
        saved += 1
    return saved, skipped


def dispatch_cart_key():
    return "despacho_items_v33"


def get_dispatch_cart():
    key = dispatch_cart_key()
    if key not in st.session_state:
        st.session_state[key] = []
    return st.session_state[key]


def clear_dispatch_form():
    st.session_state[dispatch_cart_key()] = []
    for k in ["desp_comanda", "desp_lote", "desp_qty", "desp_note", "desp_product_search"]:
        if k in st.session_state:
            del st.session_state[k]


def save_dispatch_cart(movement_date, deposit, note):
    cart = get_dispatch_cart()
    if not cart:
        return 0
    for item in cart:
        add_movement(
            movement_date,
            int(item["product_id"]),
            "despacho",
            float(item["cantidad"]),
            movement_date,
            note,
            "manual",
            item.get("numero_comanda", ""),
            item.get("lote", ""),
            deposit,
        )
    return len(cart)


def tiendanube_order_delivery_summary(order_number, deposit):
    order_number = str(order_number or "").strip()
    if not order_number:
        return None
    df = tiendanube_sales_df()
    if df.empty or "numero_orden" not in df.columns:
        return None
    rows = df[(df["numero_orden"].astype(str).str.strip() == order_number) & (df["deposito"].astype(str) == str(deposit))]
    if rows.empty:
        return None
    vendido = float(rows["cantidad"].fillna(0).sum())
    despachado = float(rows["despachado_rawer"].fillna(0).sum())
    pendiente = float(rows["pendiente_entrega"].fillna(0).sum())
    if pendiente <= 0:
        estado = "Entregado"
    elif despachado > 0:
        estado = "Parcial"
    else:
        estado = "Pendiente"
    return {"estado": estado, "vendido": vendido, "despachado": despachado, "pendiente": pendiente}


def supply_quantity_editor(key):
    supplies = get_supplies(True)[["id", "name", "category", "unit"]].copy()
    supplies["cantidad"] = 0.0
    supplies["proveedor"] = ""
    supplies = supplies.rename(columns={"name": "insumo", "category": "categoria", "unit": "unidad"})
    categories = sorted(supplies["categoria"].dropna().unique().tolist())
    selected_categories = st.multiselect("Filtrar categoría de insumo", categories, default=[])
    search = st.text_input("Buscar insumo", key=f"{key}_search")
    view = supplies.copy()
    if selected_categories:
        view = view[view["categoria"].isin(selected_categories)]
    if search:
        view = view[view["insumo"].str.contains(search, case=False, na=False)]
    edited = st.data_editor(
        view,
        key=key,
        hide_index=True,
        use_container_width=True,
        column_config={
            "id": None,
            "insumo": st.column_config.TextColumn("Insumo", disabled=True),
            "categoria": st.column_config.TextColumn("Categoría", disabled=True),
            "unidad": st.column_config.TextColumn("Unidad", disabled=True),
            "cantidad": st.column_config.NumberColumn("Cantidad ingresada", min_value=0.0, step=1.0),
            "proveedor": st.column_config.TextColumn("Proveedor"),
        },
    )
    return edited



def filter_dataframe(df, text_cols=None, date_col=None, type_col=None, deposit_col=None):
    if df.empty:
        return df
    f = df.copy()
    with st.expander("Filtros", expanded=False):
        cols = st.columns(4)
        with cols[0]:
            search = st.text_input("Buscar", key=f"filter_search_{hash(tuple(df.columns))}")
        with cols[1]:
            if type_col and type_col in f.columns:
                types = sorted(f[type_col].dropna().astype(str).unique().tolist())
                selected_types = st.multiselect("Tipo", types, default=[])
            else:
                selected_types = []
        with cols[2]:
            if deposit_col and deposit_col in f.columns:
                deposits = sorted(f[deposit_col].dropna().astype(str).unique().tolist())
                selected_deposits = st.multiselect("Depósito", deposits, default=[])
            else:
                selected_deposits = []
        with cols[3]:
            if date_col and date_col in f.columns:
                dates = pd.to_datetime(f[date_col], errors="coerce").dropna()
                if not dates.empty:
                    start = st.date_input("Desde", value=dates.min().date(), key=f"filter_start_{date_col}_{hash(tuple(df.columns))}")
                    end = st.date_input("Hasta", value=dates.max().date(), key=f"filter_end_{date_col}_{hash(tuple(df.columns))}")
                else:
                    start = end = None
            else:
                start = end = None
    if search:
        if text_cols is None:
            text_cols = [c for c in f.columns if f[c].dtype == object]
        mask = pd.Series(False, index=f.index)
        for c in text_cols:
            if c in f.columns:
                mask |= f[c].astype(str).str.contains(search, case=False, na=False)
        f = f[mask]
    if type_col and type_col in f.columns and selected_types:
        f = f[f[type_col].astype(str).isin(selected_types)]
    if deposit_col and deposit_col in f.columns and selected_deposits:
        f = f[f[deposit_col].astype(str).isin(selected_deposits)]
    if date_col and date_col in f.columns and start and end:
        dates = pd.to_datetime(f[date_col], errors="coerce").dt.date
        f = f[(dates >= start) & (dates <= end)]
    return f



def dashboard_today_activity(today=None):
    """Resumen operativo diario para el dashboard: stock, producción y despachos."""
    if today is None:
        today = date.today()
    day = today.isoformat() if hasattr(today, "isoformat") else str(today)

    stock = dashboard_df(today).copy()
    if stock.empty:
        stock = pd.DataFrame(columns=["id", "deposit", "name", "stock_real", "stock_disponible"])

    daily = read_sql(
        """
        SELECT m.product_id AS id,
               COALESCE(m.deposit, ?) AS deposit,
               SUM(CASE WHEN m.movement_type='produccion' THEN ABS(CAST(m.quantity AS REAL)) ELSE 0 END) AS produccion_hoy,
               SUM(CASE WHEN m.movement_type='despacho' THEN ABS(CAST(m.quantity AS REAL)) ELSE 0 END) AS despachos_hoy
        FROM movements m
        WHERE COALESCE(m.is_undone,0)=0
          AND date(m.movement_date)=date(?)
          AND m.movement_type IN ('produccion','despacho')
        GROUP BY m.product_id, COALESCE(m.deposit, ?)
        """,
        (DEFAULT_DEPOSIT, day, DEFAULT_DEPOSIT),
    )

    keep = [c for c in ["id", "deposit", "name", "stock_real", "stock_disponible"] if c in stock.columns]
    view = stock[keep].copy()
    if "name" not in view.columns:
        view["name"] = ""
    if daily.empty:
        view["produccion_hoy"] = 0.0
        view["despachos_hoy"] = 0.0
    else:
        view = view.merge(daily, on=["id", "deposit"], how="outer")
        missing_names = view["name"].isna() | (view["name"].astype(str).str.strip() == "")
        if missing_names.any():
            names = get_products(True)[["id", "name"]].drop_duplicates("id")
            view = view.merge(names.rename(columns={"name":"_name_lookup"}), on="id", how="left")
            view.loc[missing_names, "name"] = view.loc[missing_names, "_name_lookup"]
            view = view.drop(columns=["_name_lookup"])

    for col in ["stock_real", "stock_disponible", "produccion_hoy", "despachos_hoy"]:
        if col not in view.columns:
            view[col] = 0.0
        view[col] = pd.to_numeric(view[col], errors="coerce").fillna(0.0)
    view["variacion_dia"] = view["produccion_hoy"] - view["despachos_hoy"]
    view["deposit"] = view["deposit"].fillna(DEFAULT_DEPOSIT)
    view["name"] = view["name"].fillna("")
    return view

def page_dashboard():
    hero("Rawer Data", "Control diario de stock por deposito, producción, despachos e insumos.")

    # Resumen operativo del día actual. Producción y despachos se toman por fecha de movimiento;
    # el stock respeta la fecha de impacto configurada de cada producción.
    today = date.today()
    today_view = dashboard_today_activity(today)
    st.markdown(f"### Hoy · {today.strftime('%d/%m/%Y')}")
    t1, t2, t3, t4 = st.columns(4)
    with t1:
        metric_card("Stock real hoy", f"{today_view['stock_real'].sum():,.0f}".replace(",", "."))
    with t2:
        metric_card("Producción de hoy", f"{today_view['produccion_hoy'].sum():,.0f}".replace(",", "."))
    with t3:
        metric_card("Despachos de hoy", f"{today_view['despachos_hoy'].sum():,.0f}".replace(",", "."))
    with t4:
        metric_card("Producción - despachos", f"{today_view['variacion_dia'].sum():,.0f}".replace(",", "."))

    today_deps = st.multiselect("Depósito · resumen de hoy", DEPOSITS, default=DEPOSITS, key="dashboard_today_deps")
    today_table = today_view[today_view["deposit"].isin(today_deps)] if today_deps else today_view.copy()
    today_table = today_table[["deposit", "name", "stock_real", "stock_disponible", "produccion_hoy", "despachos_hoy", "variacion_dia"]].rename(columns={
        "deposit": "Depósito",
        "name": "Producto",
        "stock_real": "Stock real hoy",
        "stock_disponible": "Stock disponible hoy",
        "produccion_hoy": "Producción hoy",
        "despachos_hoy": "Despachos hoy",
        "variacion_dia": "Prod. - despachos",
    })
    st.dataframe(today_table, use_container_width=True, hide_index=True)
    st.caption("La producción de hoy se muestra aunque todavía esté pendiente de impactar stock por los días de espera configurados. El stock real solo incorpora lo que ya corresponde por fecha de impacto.")

    st.markdown("---")
    as_of = st.date_input("Ver stock al día", value=date.today())
    df = dashboard_df(as_of)
    c1, c2, c3, c4 = st.columns(4)
    with c1:
        metric_card("Stock real total", f"{df['stock_real'].sum():,.0f}".replace(",", "."))
    with c2:
        metric_card("Stock disponible calculado", f"{df['stock_disponible'].sum():,.0f}".replace(",", "."))
    with c3:
        metric_card("Producción pendiente", f"{df['produccion_pendiente'].sum():,.0f}".replace(",", "."))
    with c4:
        metric_card("Vendido pendiente entrega", f"{df['vendido_pendiente_total'].sum():,.0f}".replace(",", "."))

    st.markdown("### Resumen por depósito")
    by_dep = df.groupby("deposit", as_index=False).agg(
        stock_real=("stock_real", "sum"),
        stock_disponible=("stock_disponible", "sum"),
        vendido_pendiente=("vendido_pendiente_total", "sum"),
        stock_ecommapp=("stock_disponible_ecommapp", "sum"),
        diferencia_ecommapp=("diferencia_vs_ecommapp", "sum"),
        produccion_pendiente=("produccion_pendiente", "sum"),
    ).rename(columns={"deposit": "Depósito", "stock_real": "Stock real", "stock_disponible": "Stock disponible calculado", "vendido_pendiente": "Vendido pendiente entrega", "stock_ecommapp": "Stock disponible importado Manjares", "diferencia_ecommapp": "Dif. calculado vs importado", "produccion_pendiente": "Producción pendiente"})
    st.dataframe(by_dep, use_container_width=True, hide_index=True)

    st.markdown("### Stock real vs disponible por depósito")
    st.caption("Regla actual: el stock de EcommApp/Tiendanube ya no se usa. Manjares toma Stock Real y Stock Disponible del Excel de Manjares. Planta/Tandil calculan disponible como stock real menos ventas pendientes de entrega.")
    dep_filter = st.multiselect("Filtrar depósito", DEPOSITS, default=DEPOSITS)
    view_df = df[df["deposit"].isin(dep_filter)] if dep_filter else df
    view = view_df[[
        "deposit", "name", "stock_real", "vendido_pendiente_entrega", "particular_pendiente_entrega", "vendido_pendiente_total", "stock_disponible", "stock_disponible_ecommapp", "diferencia_vs_ecommapp",
        "produccion_pendiente", "fecha_stock_disponible"
    ]].rename(columns={
        "deposit": "Depósito",
        "name": "Producto",
        "stock_real": "Stock real",
        "vendido_pendiente_entrega": "Pendiente TN",
        "particular_pendiente_entrega": "Pendiente particulares",
        "vendido_pendiente_total": "Vendido pendiente total",
        "stock_disponible": "Stock disponible calculado",
        "stock_disponible_ecommapp": "Stock cargado/importado",
        "diferencia_vs_ecommapp": "Dif. calc. vs EcommApp",
        "produccion_pendiente": "Producción pendiente",
        "fecha_stock_disponible": "Fecha stock disponible",
    })
    st.dataframe(view, use_container_width=True, hide_index=True)

    st.markdown("### Últimos movimientos")
    mov = movements_df().head(20)
    st.dataframe(mov, use_container_width=True, hide_index=True)


def page_initial_stock():
    hero("Stock inicial por depósito", "Cargá el punto de partida del stock real en Planta, Manjares y Tandil.")
    st.info("Para Manjares y Tandil podés cargar el stock real manualmente acá. Luego, si querés corregir diferencias, usá Ajustes en Carga diaria eligiendo el depósito.")
    products = get_products(True)[["id", "name"]]
    current = read_sql("SELECT product_id AS id, deposit, quantity FROM initial_stock_deposit")
    wide = products.copy().rename(columns={"name": "producto"})
    for dep in DEPOSITS:
        dep_df = current[current["deposit"] == dep][["id", "quantity"]].rename(columns={"quantity": dep}) if not current.empty else pd.DataFrame(columns=["id", dep])
        wide = wide.merge(dep_df, on="id", how="left")
        wide[dep] = wide[dep].fillna(0)
    edited = st.data_editor(
        wide,
        hide_index=True,
        use_container_width=True,
        column_config={
            "id": None,
            "producto": st.column_config.TextColumn("Producto", disabled=True),
            **{dep: st.column_config.NumberColumn(dep, min_value=0.0, step=1.0) for dep in DEPOSITS},
        },
    )
    if st.button("Guardar stock inicial por depósito"):
        set_initial_stock(edited)
        st.success("Stock inicial por depósito guardado.")
        st.rerun()


def page_daily_load():
    hero("Carga diaria", "Registrá producción, batchs, despachos, transferencias, ingresos de insumos y ajustes por depósito.")
    show_flash()
    mov_date = st.date_input("Fecha de carga", value=date.today())
    deposit = st.selectbox("Depósito", DEPOSITS, index=0, help="Producción, despachos y ajustes impactan el stock real de este depósito.")

    # Usamos un selector persistente en lugar de tabs nativos.
    # Así, después de guardar una comanda y resetear el formulario, la pantalla queda en Despachos
    # y no vuelve al inicio de Carga diaria.
    section_options = ["Producción", "Batchs MP", "Despachos", "Transferencias", "Ingresos insumos", "Ajustes"]
    if "daily_section" not in st.session_state or st.session_state["daily_section"] not in section_options:
        st.session_state["daily_section"] = "Producción"
    section = st.radio("Sección", section_options, horizontal=True, key="daily_section")

    if section == "Producción":
        st.info("La fecha de impacto de cada producto se calcula con los días configurados en Productos. Además, si existe un Batch MP pendiente del mismo producto y fecha, Rawer Data lo propone para vincular la trazabilidad.")
        edited = product_quantity_editor("prod_editor", include_lote=True)
        note = st.text_input("Observación producción", key="prod_note")
        batch_link_map = {}
        produced_rows = edited[pd.to_numeric(edited["cantidad"], errors="coerce").fillna(0) > 0]
        if not produced_rows.empty:
            st.markdown("### Vinculación con Batch MP")
            st.caption("La asociación nunca se hace en silencio: Rawer Data sugiere los Batch MP pendientes del mismo producto y día, y vos confirmás cuál corresponde.")
            for _, prow in produced_rows.iterrows():
                pid=int(prow["id"]); pname=str(prow["producto"])
                candidates=pending_batch_runs_df(mov_date,pid)
                if candidates.empty:
                    st.warning(f"{pname}: no hay Batch MP pendiente para {mov_date.strftime('%d/%m/%Y')}.")
                    continue
                options=[f"{r.code} | {r.batch_count:g} batch" for r in candidates.itertuples()]
                choice=st.selectbox(f"Batch MP para {pname}", ["No vincular"]+options, index=1 if len(options)==1 else 0, key=f"prod_batch_choice_{pid}")
                confirm=st.checkbox(f"Confirmo vínculo de {pname}", value=(len(options)==1), key=f"prod_batch_confirm_{pid}")
                if choice != "No vincular" and confirm:
                    code=choice.split(" | ",1)[0]
                    batch_link_map[pid]=int(candidates.loc[candidates["code"]==code,"id"].iloc[0])
        if st.button("Guardar producción"):
            missing_lot = produced_rows[produced_rows["lote"].astype(str).str.strip()==""] if not produced_rows.empty else pd.DataFrame()
            if not missing_lot.empty:
                st.warning("Hay producción sin lote terminado. Para trazabilidad completa cargá el lote producido antes de guardar.")
            else:
                prod_count, supply_count = save_daily_production_with_supplies(mov_date, edited.rename(columns={"cantidad": "cantidad"}), note, deposit, batch_link_map)
                set_flash(f"Producción cargada con éxito en {deposit}. Movimientos de producto: {prod_count}. Insumos descontados: {supply_count}. Vínculos Batch MP confirmados: {len(batch_link_map)}.")
                st.rerun()

    elif section == "Batchs MP":
        st.info("Cargá los batchs elaborados del día. Esto descuenta solamente materia prima del stock de insumos. Bolsas, etiquetas y otros insumos se descuentan desde la producción diaria.")
        products = recipe_products().rename(columns={"name": "producto"})
        if products.empty:
            st.warning("Todavía no hay recetas cargadas para descontar materia prima por batch.")
        else:
            products["batchs"] = 0.0
            batch_plan = st.data_editor(
                products,
                key="daily_batch_mp_editor",
                hide_index=True,
                use_container_width=True,
                column_config={
                    "id": None,
                    "producto": st.column_config.TextColumn("Producto", disabled=True),
                    "batchs": st.column_config.NumberColumn("Batchs elaborados", min_value=0.0, step=0.5),
                },
            )
            selected_plan, consumption = calculate_batch_materia_prima_consumption(batch_plan)
            note = st.text_input("Observación batchs / materia prima", key="batch_mp_note")
            if selected_plan.empty:
                st.caption("Cargá batchs para ver el consumo estimado de materia prima.")
            else:
                st.markdown("### Materia prima a descontar")
                view = consumption.rename(columns={
                    "insumo": "Insumo",
                    "categoria": "Categoría",
                    "unidad": "Unidad",
                    "cantidad_a_descontar": "Cantidad a descontar",
                    "stock_actual": "Stock actual",
                    "stock_estimado_despues": "Stock estimado después",
                    "estado": "Estado",
                })
                rec_trace = read_sql(
                    """SELECT r.product_id, p.name AS producto, s.id AS supply_id, s.name AS insumo, s.unit AS unidad, r.quantity_per_batch
                       FROM product_recipes r JOIN products p ON p.id=r.product_id JOIN supplies s ON s.id=r.supply_id
                       WHERE s.category='Materia prima'"""
                )
                lotes_base = rec_trace.merge(selected_plan[["id","batchs"]], left_on="product_id", right_on="id", how="inner")
                lotes_base["cantidad_a_descontar"] = lotes_base["quantity_per_batch"] * lotes_base["batchs"]
                lotes_base = lotes_base[["product_id","producto","supply_id","insumo","unidad","cantidad_a_descontar"]]
                lotes_base["lote_materia_prima"] = ""
                lotes_edit = st.data_editor(
                    lotes_base,
                    key="daily_batch_mp_lotes_editor",
                    hide_index=True,
                    use_container_width=True,
                    column_config={
                        "product_id": None,
                        "supply_id": None,
                        "producto": st.column_config.TextColumn("Producto / batch", disabled=True),
                        "insumo": st.column_config.TextColumn("Materia prima", disabled=True),
                        "unidad": st.column_config.TextColumn("Unidad", disabled=True),
                        "cantidad_a_descontar": st.column_config.NumberColumn("Cantidad a descontar", disabled=True),
                        "lote_materia_prima": st.column_config.TextColumn("Lote materia prima usado"),
                    },
                )
                st.dataframe(view, use_container_width=True, hide_index=True)
                faltantes = consumption[consumption["stock_estimado_despues"] < 0]
                if not faltantes.empty:
                    st.warning("Hay materia prima que quedaría en negativo. Podés guardar igual si corresponde, pero conviene revisar stock/ingresos.")
            lotes_to_save = locals().get("lotes_edit", pd.DataFrame())
            if st.button("Guardar batchs y descontar materia prima"):
                saved = save_batch_materia_prima_consumption(mov_date, batch_plan, note, lotes_to_save)
                if saved > 0:
                    set_flash(f"Batchs cargados con éxito. Se descontaron {saved} insumos de materia prima.")
                else:
                    set_flash("No había batchs cargados para descontar.")
                st.rerun()

    elif section == "Despachos":
        st.info("Podés importar despachos desde Excel o cargar una comanda manual. La importación lee únicamente la hoja que coincida con la fecha seleccionada arriba.")

        with st.expander("Importar despachos Manjares desde CSV", expanded=True):
            st.caption("Subí el CSV exportado desde Manjares. La app toma N° orden de compra como N° comanda/orden Tiendanube y descuenta stock real de Buenos Aires / Manjares.")
            manjares_file = st.file_uploader("CSV de pedidos/despachos Manjares", type=["csv"], key="manjares_dispatch_csv_import")
            omit_manjares_dups = st.checkbox("Omitir duplicados Manjares ya cargados", value=True, key="manjares_dispatch_omit_dups")
            if manjares_file is not None:
                parsed_m, errors_m = parse_manjares_dispatch_csv(manjares_file)
                if not errors_m.empty:
                    st.warning("Hay filas del CSV de Manjares para revisar. Las filas con error no se importan.")
                    st.dataframe(errors_m, use_container_width=True, hide_index=True)
                if not parsed_m.empty:
                    preview_m = parsed_m.copy()
                    preview_m["estado_importacion"] = preview_m["duplicado"].map({True: "Duplicado: se omite", False: "Nuevo"})
                    preview_m["orden_tn"] = preview_m["numero_comanda"].apply(lambda x: "Sin orden TN asociada" if str(x).strip()=="" else str(x))
                    st.markdown("#### Vista previa Manjares")
                    st.dataframe(
                        preview_m[["fecha", "deposito", "orden_tn", "pedido_manjares_id", "producto", "sku_manjares", "cantidad", "estado_manjares", "estado_importacion"]].rename(columns={
                            "fecha": "Fecha entrega", "deposito": "Depósito Rawer", "orden_tn": "Orden TN / comanda",
                            "pedido_manjares_id": "Pedido Manjares", "producto": "Producto Rawer", "sku_manjares": "SKU Manjares",
                            "cantidad": "Cantidad", "estado_manjares": "Estado Manjares", "estado_importacion": "Estado importación",
                        }),
                        use_container_width=True,
                        hide_index=True,
                    )
                    st.caption(f"Renglones detectados: {len(parsed_m)} | Duplicados: {int(parsed_m['duplicado'].sum())} | Sin orden TN asociada: {int((parsed_m['numero_comanda'].astype(str).str.strip()=='').sum())}")
                    if st.button("Confirmar importación de despachos Manjares", type="primary", key="confirm_manjares_csv_dispatches"):
                        saved, skipped = save_imported_manjares_dispatches(parsed_m, omit_duplicates=omit_manjares_dups)
                        set_flash(f"Despachos Manjares importados con éxito. Cargados: {saved}. Omitidos por duplicado: {skipped}.")
                        st.rerun()
                elif errors_m.empty:
                    st.info("No se detectaron renglones de despacho con cantidad mayor a cero en el CSV de Manjares.")

        with st.expander("Importar despachos desde Excel", expanded=False):
            st.caption("La app busca una hoja con nombre igual a la fecha seleccionada, por ejemplo 18-08, 18-08-2026, 2026-08-18 o 18.08.")
            dispatch_file = st.file_uploader("Excel de despachos", type=["xlsx", "xls"], key="dispatch_excel_import")
            omit_dups = st.checkbox("Omitir duplicados ya cargados", value=True, key="dispatch_import_omit_dups")
            if dispatch_file is not None:
                parsed, errors, sheet_name, sheets = parse_dispatch_excel(dispatch_file, mov_date, deposit)
                if sheet_name:
                    st.success(f"Hoja detectada para {mov_date.strftime('%d/%m/%Y')}: {sheet_name}")
                else:
                    st.warning("No se encontró una hoja para la fecha seleccionada.")
                    st.caption("Hojas encontradas: " + ", ".join(sheets))
                if not errors.empty:
                    st.warning("Hay filas/columnas para revisar antes de importar.")
                    st.dataframe(errors, use_container_width=True, hide_index=True)
                if not parsed.empty:
                    preview = parsed.copy()
                    preview["estado"] = preview["duplicado"].map({True: "Duplicado: se omite", False: "Nuevo"})
                    st.markdown("#### Vista previa")
                    st.dataframe(
                        preview[["fecha", "deposito", "numero_comanda", "producto", "cantidad", "lote", "observacion", "estado"]].rename(columns={
                            "fecha": "Fecha", "deposito": "Depósito", "numero_comanda": "N° comanda / orden",
                            "producto": "Producto", "cantidad": "Cantidad", "lote": "Lote", "observacion": "Observación", "estado": "Estado",
                        }),
                        use_container_width=True,
                        hide_index=True,
                    )
                    st.caption(f"Renglones detectados: {len(parsed)} | Duplicados: {int(parsed['duplicado'].sum())}")
                    if st.button("Confirmar importación de despachos", type="primary"):
                        saved, skipped = save_imported_dispatches(parsed, omit_duplicates=omit_dups)
                        set_flash(f"Despachos importados con éxito. Cargados: {saved}. Omitidos por duplicado: {skipped}.")
                        st.rerun()
                elif sheet_name and errors.empty:
                    st.info("La hoja fue encontrada, pero no se detectaron renglones de despacho con cantidad mayor a cero.")

        st.markdown("---")
        st.markdown("### Despachar desde comanda Tiendanube")
        st.caption("Ingresá el N° de comanda. Rawer Data trae automáticamente los productos vendidos y te deja despachar todo o solo una parte.")

        c1, c2 = st.columns([1, 2])
        with c1:
            tn_dispatch_order = st.text_input("N° de comanda Tiendanube", key="tn_dispatch_order", placeholder="Ejemplo: 1842")
        with c2:
            tn_dispatch_note = st.text_input("Observación", key="tn_dispatch_note", placeholder="Opcional")

        if st.button("Buscar comanda", key="btn_buscar_comanda_tn"):
            order = str(tn_dispatch_order or "").strip()
            if not order:
                st.warning("Ingresá un número de comanda.")
            else:
                found = tiendanube_dispatch_order_lines(order, deposit)
                st.session_state["tn_dispatch_loaded_order"] = order
                st.session_state["tn_dispatch_loaded_deposit"] = deposit
                st.session_state["tn_dispatch_lines"] = found.to_dict("records")
                st.rerun()

        loaded_order = str(st.session_state.get("tn_dispatch_loaded_order", "") or "")
        loaded_deposit = str(st.session_state.get("tn_dispatch_loaded_deposit", "") or "")
        if loaded_order and loaded_deposit == deposit:
            # Se refresca contra la base en cada render para reflejar despachos parciales previos.
            live = tiendanube_dispatch_order_lines(loaded_order, deposit)
            if live.empty:
                st.warning(f"No se encontró la comanda {loaded_order} en Tiendanube para el depósito {deposit}, o no tiene productos reconocidos.")
            else:
                total_pedido = float(live["pedido"].sum())
                total_desp = float(live["despachado"].sum())
                total_pend = float(live["pendiente"].sum())
                if total_pend <= 0:
                    st.success(f"Comanda {loaded_order}: ya fue despachada completa. Pedido {total_pedido:g} u. | Despachado {total_desp:g} u.")
                else:
                    estado = "PARCIAL" if total_desp > 0 else "PENDIENTE"
                    st.info(f"Comanda {loaded_order} · {estado} · Pedido: {total_pedido:g} u. · Ya despachado: {total_desp:g} u. · Pendiente: {total_pend:g} u.")

                    edit = tiendanube_dispatch_order_lot_lines(loaded_order, deposit, mov_date)
                    if edit.empty:
                        edit = live.copy()
                    editor = st.data_editor(
                        edit,
                        use_container_width=True,
                        hide_index=True,
                        key=f"tn_dispatch_editor_{loaded_order}_{deposit}",
                        disabled=["product_id", "sku", "producto", "pedido", "despachado", "pendiente", "fecha_produccion", "stock_lote", "trazabilidad"],
                        column_config={
                            "product_id": None,
                            "sku": st.column_config.TextColumn("SKU", disabled=True),
                            "producto": st.column_config.TextColumn("Producto", disabled=True),
                            "pedido": st.column_config.NumberColumn("Pedido", disabled=True),
                            "despachado": st.column_config.NumberColumn("Ya despachado", disabled=True),
                            "pendiente": st.column_config.NumberColumn("Pendiente total", disabled=True),
                            "fecha_produccion": st.column_config.TextColumn("Fecha producción", disabled=True),
                            "lote": st.column_config.TextColumn("Lote PT", help="FIFO se carga automáticamente. Podés reemplazarlo por otro lote disponible del mismo producto antes de confirmar el despacho."),
                            "stock_lote": st.column_config.NumberColumn("Stock lote", disabled=True, format="%.0f"),
                            "trazabilidad": st.column_config.TextColumn("Trazabilidad", disabled=True),
                            "despachar_ahora": st.column_config.NumberColumn("Despachar ahora", min_value=0.0, step=1.0, required=True),
                        },
                    )
                    st.caption("Rawer Data asigna FIFO automáticamente, pero podés editar la columna 'Lote PT' antes de confirmar. La app valida que el lote pertenezca al producto y tenga stock suficiente. Para una entrega parcial, editá también 'Despachar ahora'.")
                    if (edit.get("trazabilidad", pd.Series(dtype=str)) == "Stock anterior/sin lote").any():
                        st.warning("Parte de esta comanda usa stock anterior/sin lote. Se puede despachar, pero quedará marcado como no trazable hasta regularizar ese stock.")

                    b1, b2, b3 = st.columns([1, 1, 1])
                    with b1:
                        if st.button("Completar todo lo pendiente", key=f"tn_full_{loaded_order}"):
                            reset_key = f"tn_dispatch_editor_{loaded_order}_{deposit}"
                            if reset_key in st.session_state:
                                del st.session_state[reset_key]
                            st.rerun()
                    with b2:
                        if st.button("Confirmar despacho", type="primary", key=f"tn_save_{loaded_order}"):
                            saved, msg = save_tiendanube_dispatch_lines(loaded_order, mov_date, deposit, editor, tn_dispatch_note)
                            if saved:
                                summary = tiendanube_order_delivery_summary(loaded_order, deposit)
                                if summary and summary["estado"] == "Entregado":
                                    set_flash(f"Comanda {loaded_order} despachada COMPLETA. Renglones registrados: {saved}.")
                                elif summary:
                                    set_flash(f"Comanda {loaded_order} despachada PARCIALMENTE. Quedan {summary['pendiente']:,.0f} unidad(es) pendientes.".replace(",", "."))
                                else:
                                    set_flash(f"Despacho de comanda {loaded_order} registrado. Renglones: {saved}.")
                                st.rerun()
                            else:
                                st.error(msg)
                    with b3:
                        if st.button("Cerrar comanda", key=f"tn_close_{loaded_order}"):
                            for k in ["tn_dispatch_loaded_order", "tn_dispatch_loaded_deposit", "tn_dispatch_lines", f"tn_dispatch_editor_{loaded_order}_{deposit}"]:
                                st.session_state.pop(k, None)
                            st.rerun()

        st.markdown("---")
        with st.expander("Despacho manual / excepcional", expanded=False):
            st.caption("Usalo solo cuando el despacho no proviene de una comanda Tiendanube o necesitás registrar una excepción.")
            products_df = get_products(True)[["id", "name"]].copy().sort_values("name")
            product_names = products_df["name"].tolist()
            cart = get_dispatch_cart()

            c1, c2 = st.columns([1, 1])
            with c1:
                numero_comanda = st.text_input("N° de comanda", key="desp_comanda", placeholder="Ejemplo: 1842")
            with c2:
                note = st.text_input("Observación despacho manual", key="desp_note", placeholder="Opcional")

            p1, p2, p3 = st.columns([2.5, 1, 1.5])
            with p1:
                selected_product = st.selectbox("Buscar producto", [""] + product_names, key="desp_product_search")
            with p2:
                qty = st.number_input("Cantidad", min_value=0.0, step=1.0, key="desp_qty")
            with p3:
                lote = st.text_input("Lote despachado", key="desp_lote", placeholder="Ej: L250810")

            if st.button("Agregar producto al despacho manual"):
                if not str(numero_comanda).strip():
                    st.warning("Cargá el número de comanda antes de agregar productos.")
                elif not selected_product:
                    st.warning("Seleccioná un producto.")
                elif float(qty or 0) <= 0:
                    st.warning("La cantidad tiene que ser mayor a cero.")
                else:
                    product_id = int(products_df.loc[products_df["name"] == selected_product, "id"].iloc[0])
                    cart.append({"numero_comanda": str(numero_comanda).strip(), "product_id": product_id, "producto": selected_product, "cantidad": float(qty), "lote": str(lote or "").strip()})
                    st.success("Producto agregado al despacho manual.")

            if cart:
                cart_df = pd.DataFrame(cart)[["numero_comanda", "producto", "cantidad", "lote"]].rename(columns={"numero_comanda": "N° comanda", "producto": "Producto", "cantidad": "Cantidad", "lote": "Lote despachado"})
                cart_df["Eliminar"] = False
                cart_edit = st.data_editor(cart_df, use_container_width=True, hide_index=True, key="dispatch_cart_editor", column_config={
                    "N° comanda": st.column_config.TextColumn("N° comanda", disabled=True),
                    "Producto": st.column_config.SelectboxColumn("Producto", options=product_names, required=True),
                    "Cantidad": st.column_config.NumberColumn("Cantidad", min_value=0.0, step=1.0, required=True),
                    "Lote despachado": st.column_config.TextColumn("Lote despachado"),
                    "Eliminar": st.column_config.CheckboxColumn("Eliminar"),
                })
                b0, b1, b2 = st.columns([1, 1, 1])
                with b0:
                    if st.button("Aplicar cambios manuales"):
                        updated=[]
                        for _, er in cart_edit.iterrows():
                            if bool(er.get("Eliminar", False)):
                                continue
                            pname=str(er.get("Producto") or "").strip(); q=float(er.get("Cantidad") or 0)
                            if not pname or q<=0:
                                continue
                            pid=int(products_df.loc[products_df["name"]==pname,"id"].iloc[0])
                            updated.append({"numero_comanda":str(er.get("N° comanda") or "").strip(),"product_id":pid,"producto":pname,"cantidad":q,"lote":str(er.get("Lote despachado") or "").strip()})
                        st.session_state[dispatch_cart_key()] = updated
                        st.rerun()
                with b1:
                    if st.button("Guardar despacho manual", type="primary"):
                        current_order = str(numero_comanda or "").strip()
                        saved = save_dispatch_cart(mov_date, deposit, note)
                        clear_dispatch_form()
                        set_flash(f"Despacho manual guardado. Renglones: {saved}.")
                        st.rerun()
                with b2:
                    if st.button("Limpiar despacho manual"):
                        clear_dispatch_form(); st.rerun()

    elif section == "Transferencias":
        st.info("Mové producto terminado entre depósitos. Esto resta stock real del depósito origen y suma stock real al depósito destino. No modifica el stock de insumos ni el stock disponible cargado/importado.")
        products_df = get_products(True)[["id", "name"]].copy().sort_values("name")
        if products_df.empty:
            st.warning("No hay productos activos cargados.")
        else:
            c1, c2 = st.columns(2)
            with c1:
                origin = st.selectbox("Depósito origen", DEPOSITS, index=0, key="transfer_origin")
            with c2:
                dest_options = [d for d in DEPOSITS if d != origin]
                destination = st.selectbox("Depósito destino", dest_options, index=0, key="transfer_destination")

            p1, p2, p3 = st.columns([2.5, 1, 1.5])
            with p1:
                product = st.selectbox("Buscar producto terminado", products_df["name"].tolist(), key="transfer_product")
            with p2:
                qty = st.number_input("Cantidad a transferir", min_value=0.0, step=1.0, key="transfer_qty")
            with p3:
                lote = st.text_input("Lote / referencia", key="transfer_lote", placeholder="Opcional")
            note = st.text_input("Observación transferencia", key="transfer_note", placeholder="Ej: Envío reposición Manjares")

            if product:
                pid = int(products_df.loc[products_df["name"] == product, "id"].iloc[0])
                stock_now = current_real_stock(mov_date)
                current_origin = stock_now[(stock_now["id"] == pid) & (stock_now["deposit"] == origin)]["stock_real"]
                current_origin = float(current_origin.iloc[0]) if not current_origin.empty else 0.0
                st.caption(f"Stock real actual en {origin}: {current_origin:,.0f}".replace(",", "."))
                if float(qty or 0) > current_origin:
                    st.warning("La transferencia supera el stock real del depósito origen. Podés guardar igual si corresponde, pero conviene revisar.")

            if st.button("Guardar transferencia", type="primary"):
                if not product:
                    st.warning("Seleccioná un producto.")
                elif float(qty or 0) <= 0:
                    st.warning("La cantidad tiene que ser mayor a cero.")
                elif origin == destination:
                    st.warning("El depósito origen y destino no pueden ser iguales.")
                else:
                    pid = int(products_df.loc[products_df["name"] == product, "id"].iloc[0])
                    ref = save_stock_transfer(mov_date, pid, qty, origin, destination, lote, note)
                    if ref:
                        set_flash(f"Transferencia guardada con éxito: {product} x {qty:,.0f} de {origin} a {destination}. Ref: {ref}".replace(",", "."))
                        st.rerun()
                    else:
                        st.warning("No se pudo guardar la transferencia. Revisá los datos.")

    elif section == "Ingresos insumos":
        st.info("Cargá acá entradas diarias de materia prima, bolsas, etiquetas y suplementos. Estos ingresos se suman al stock de insumos.")
        edited = supply_quantity_editor("daily_supply_entries")
        note = st.text_input("Observación ingreso insumos", key="supply_entry_note")
        if st.button("Guardar ingresos de insumos"):
            save_supply_entries(mov_date, edited, note)
            set_flash("Ingresos de insumos guardados/cargados con éxito y sumados al stock de insumos.")
            st.rerun()

    elif section == "Ajustes":
        products = get_products(True)
        product = st.selectbox("Producto", products["name"].tolist())
        qty = st.number_input("Cantidad", min_value=0.0, step=1.0)
        tipo = st.radio("Tipo de ajuste", ["Ajuste positivo", "Ajuste negativo"], horizontal=True)
        note = st.text_input("Motivo / observación")
        if st.button("Guardar ajuste"):
            pid = int(products.loc[products["name"] == product, "id"].iloc[0])
            mt = "ajuste_positivo" if tipo == "Ajuste positivo" else "ajuste_negativo"
            add_movement(mov_date, pid, mt, qty, mov_date, note, "manual", deposit=deposit)
            set_flash(f"Ajuste guardado/cargado con éxito en {deposit}.")
            st.rerun()

def set_real_stock_with_adjustments(as_of, edited_df, note="Ajuste manual desde Stock real"):
    """Ajusta stock real por producto y depósito creando movimientos de ajuste por diferencia."""
    as_of_s = as_of.isoformat() if hasattr(as_of, "isoformat") else str(as_of)
    current = current_real_stock(as_of)
    current_map = {
        (int(r["id"]), r["deposit"]): float(r["stock_real"] or 0)
        for _, r in current.iterrows()
    }
    changed = 0
    for _, row in edited_df.iterrows():
        product_id = int(row["id"])
        for dep in DEPOSITS:
            new_qty = float(row.get(dep) or 0)
            old_qty = current_map.get((product_id, dep), 0.0)
            diff = new_qty - old_qty
            if abs(diff) <= 0.000001:
                continue
            movement_type = "ajuste_positivo" if diff > 0 else "ajuste_negativo"
            add_movement(as_of, product_id, movement_type, abs(diff), as_of, note, "stock_real_manual", deposit=dep)
            changed += 1
    return changed


def set_lot_stock_targets(as_of, edited_df, note="Regularizacion manual de stock por lote"):
    """Regulariza el stock trazable por lote sin modificar el stock real total.

    Por cada diferencia crea un ajuste en el lote y el movimiento inverso SIN LOTE.
    De esta manera se reasigna stock historico no trazable hacia/desde un lote,
    manteniendo intacto el stock real del producto y deposito.
    """
    if edited_df is None or edited_df.empty:
        return 0, "No hay lotes para ajustar."

    as_of_date = as_of
    current_lots = lot_stock_detail_df(as_of_date)
    current_real = current_real_stock(as_of_date)
    real_map = {
        (int(r['id']), str(r['deposit'])): float(r['stock_real'] or 0)
        for _, r in current_real.iterrows()
    }
    cur_map = {
        (int(r['product_id']), str(r['deposito']), str(r['lote'])): float(r['stock_actual'] or 0)
        for _, r in current_lots.iterrows()
    }

    work = edited_df.copy()
    work['stock_objetivo'] = pd.to_numeric(work['stock_objetivo'], errors='coerce')

    # Durante la regularizacion inicial puede haber lotes calculados en negativo por
    # producciones/despachos historicos cargados sin lote. Un lote negativo existente
    # no debe bloquear la edicion de los demas. Solo se valida el valor NUEVO cuando
    # realmente se modifica esa fila. El stock fisico objetivo se mantiene >= 0.
    for _, r in work.iterrows():
        pid = int(r['product_id'])
        dep = str(r['deposito'])
        lot = str(r['lote']).strip()
        if not lot:
            return 0, "Hay un lote vacio."
        target_raw = r.get('stock_objetivo')
        if pd.isna(target_raw):
            continue
        target = float(target_raw)
        old = float(cur_map.get((pid, dep, lot), 0.0))
        if abs(target - old) > 0.000001 and target < -0.000001:
            return 0, "El stock fisico corregido de un lote no puede ser negativo. Si el calculado esta en negativo, corregilo a 0 o al recuento fisico real."

    # No bloqueamos si la suma de lotes supera momentaneamente el stock real.
    # En la etapa de migracion esto puede ocurrir porque hay movimientos historicos
    # sin lote. La contrapartida SIN LOTE absorbe la diferencia (incluso negativa)
    # para mantener intacto el stock real total y dejar trazabilidad del desfasaje.

    changed = 0
    note = (note or "Regularizacion manual de stock por lote").strip()
    stamp = datetime.now().isoformat(timespec='seconds')
    movement_date_s = as_of_date.isoformat() if hasattr(as_of_date, 'isoformat') else str(as_of_date)
    pending = []
    for _, r in work.iterrows():
        pid = int(r['product_id'])
        dep = str(r['deposito'])
        lot = str(r['lote']).strip()
        target_raw = r.get('stock_objetivo')
        if pd.isna(target_raw):
            continue
        target = float(target_raw)
        old = float(cur_map.get((pid, dep, lot), 0.0))
        diff = target - old
        if abs(diff) <= 0.000001:
            continue
        pair_note = f"{note}. Lote {lot}: {old:g} -> {target:g}. Reasignacion contra stock SIN LOTE. Ref {stamp}."
        if diff > 0:
            pending.append((pid, 'ajuste_positivo', abs(diff), pair_note, 'stock_lote_manual', lot, dep))
            pending.append((pid, 'ajuste_negativo', abs(diff), pair_note, 'stock_lote_manual_balance', '', dep))
        else:
            pending.append((pid, 'ajuste_negativo', abs(diff), pair_note, 'stock_lote_manual', lot, dep))
            pending.append((pid, 'ajuste_positivo', abs(diff), pair_note, 'stock_lote_manual_balance', '', dep))
        changed += 1

    if not pending:
        return 0, "OK"

    # Guardado atomico: el ajuste del lote y su contrapartida SIN LOTE se confirman juntos.
    conn = get_conn()
    try:
        now = datetime.now().isoformat(timespec='seconds')
        for pid, movement_type, qty, pair_note, source, lot, dep in pending:
            conn.execute(
                """INSERT INTO movements(movement_date, product_id, movement_type, quantity, effective_date, note, source, numero_comanda, lote, deposit, created_at, batch_mp_run_id)
                   VALUES (?, ?, ?, ?, ?, ?, ?, '', ?, ?, ?, NULL)""",
                (movement_date_s, int(pid), movement_type, float(qty), movement_date_s, pair_note, source, lot, dep, now),
            )
        conn.commit()
    except Exception:
        conn.rollback()
        raise
    finally:
        conn.close()
    return changed, "OK"


def set_single_lot_stock_target(as_of, product_id, deposit, lote, target_stock, note="Regularizacion manual de stock por lote"):
    """Crea o regulariza un lote puntual usando la misma regla de balance SIN LOTE."""
    lote = str(lote or '').strip()
    if not lote:
        return 0, "Ingresá un lote."
    target_stock = float(target_stock or 0)
    row = pd.DataFrame([{
        'product_id': int(product_id),
        'deposito': str(deposit),
        'lote': lote,
        'stock_objetivo': target_stock,
    }])
    return set_lot_stock_targets(as_of, row, note)



def production_history_df():
    """Historial completo de produccion terminada, incluyendo registros sin lote.

    La tabla products no tiene una columna SKU: Rawer Data mantiene la relacion
    SKU -> producto en ECOMM_SKU_PRODUCT_MAP. Por eso el SKU se deriva despues
    de leer el nombre del producto, igual que en el resto de las vistas.
    """
    df = read_sql(
        """SELECT m.id AS movement_id, m.movement_date AS fecha,
                  COALESCE(m.effective_date,m.movement_date) AS fecha_impacto,
                  p.name AS producto, m.product_id,
                  m.quantity AS cantidad, COALESCE(m.deposit, ?) AS deposito,
                  TRIM(COALESCE(m.lote,'')) AS lote,
                  COALESCE(b.code,'') AS batch_mp, COALESCE(m.note,'') AS observacion
           FROM movements m
           JOIN products p ON p.id=m.product_id
           LEFT JOIN batch_mp_runs b ON b.id=m.batch_mp_run_id
           WHERE COALESCE(m.is_undone,0)=0 AND m.movement_type='produccion'
           ORDER BY date(m.movement_date) DESC, m.id DESC""",
        (DEFAULT_DEPOSIT,),
    )
    if 'sku' not in df.columns:
        df.insert(3, 'sku', df['producto'].apply(default_sku_for_product) if not df.empty else pd.Series(dtype='object'))
    return df


def save_production_lot_assignments(edited_df, reason='Asignacion/regularizacion retroactiva de lote de produccion'):
    """Asigna o corrige lote en movimientos historicos de produccion dejando auditoria."""
    if edited_df is None or edited_df.empty:
        return 0, 'No hay producciones para actualizar.'
    conn = get_conn()
    try:
        conn.execute(
            """CREATE TABLE IF NOT EXISTS production_lot_audit (
                   id INTEGER PRIMARY KEY AUTOINCREMENT,
                   movement_id INTEGER NOT NULL,
                   old_lot TEXT, new_lot TEXT NOT NULL, reason TEXT, changed_at TEXT NOT NULL
               )"""
        )
        ids=[int(x) for x in edited_df['movement_id'].tolist()]
        current={}
        if ids:
            ph=','.join(['?']*len(ids))
            rows=conn.execute(f"SELECT id, TRIM(COALESCE(lote,'')) FROM movements WHERE id IN ({ph}) AND movement_type='produccion'", tuple(ids)).fetchall()
            current={int(r[0]):str(r[1] or '').strip() for r in rows}
        changed=0
        stamp=datetime.now().isoformat(timespec='seconds')
        for _,r in edited_df.iterrows():
            mid=int(r['movement_id'])
            old=current.get(mid,'')
            new=str(r.get('lote','') or '').strip()
            if new==old:
                continue
            if not new:
                return 0, 'No se permite borrar un lote ya asignado. Podés reemplazarlo por el lote correcto.'
            conn.execute("UPDATE movements SET lote=? WHERE id=? AND movement_type='produccion'", (new,mid))
            conn.execute("INSERT INTO production_lot_audit(movement_id,old_lot,new_lot,reason,changed_at) VALUES (?,?,?,?,?)", (mid,old,new,str(reason or '').strip(),stamp))
            changed+=1
        conn.commit()
        return changed, 'OK'
    except Exception:
        conn.rollback()
        raise
    finally:
        conn.close()


def page_production_history():
    hero('Producción', 'Revisá todo lo producido, asigná lotes faltantes y acomodá el stock físico actual de cada lote.')
    st.info('Esta pestaña sirve para regularizar el arranque de trazabilidad. Asignar un lote a una producción histórica no cambia el stock real total. Luego podés indicar cuánto stock físico queda hoy de cada lote; la diferencia se balancea contra stock SIN LOTE.')

    df=production_history_df()
    if df.empty:
        st.warning('Todavía no hay movimientos de producción cargados.')
        return

    c1,c2,c3=st.columns([1.2,1.2,1.6])
    with c1:
        dep=st.multiselect('Depósito', DEPOSITS, default=[], key='prod_hist_dep')
    with c2:
        only_missing=st.checkbox('Solo producciones sin lote', value=False, key='prod_hist_missing')
    with c3:
        search=st.text_input('Buscar producto / SKU / lote', key='prod_hist_search')

    view=df.copy()
    if dep:
        view=view[view['deposito'].isin(dep)]
    if only_missing:
        view=view[view['lote'].astype(str).str.strip()=='']
    if search:
        q=str(search).strip()
        mask=(view['producto'].astype(str).str.contains(q,case=False,na=False) | view['sku'].astype(str).str.contains(q,case=False,na=False) | view['lote'].astype(str).str.contains(q,case=False,na=False))
        view=view[mask]

    total_prod=float(pd.to_numeric(view['cantidad'],errors='coerce').fillna(0).sum())
    missing_count=int((view['lote'].astype(str).str.strip()=='').sum())
    a,b,c=st.columns(3)
    a.metric('Registros de producción', f'{len(view):,}'.replace(',','.'))
    b.metric('Unidades producidas', f'{total_prod:,.0f}'.replace(',','.'))
    c.metric('Producciones sin lote', f'{missing_count:,}'.replace(',','.'))

    st.markdown('### Historial de producción y asignación de lote')
    editor=view[['movement_id','fecha','sku','producto','cantidad','deposito','lote','batch_mp','observacion']].copy()
    edited=st.data_editor(
        editor, hide_index=True, use_container_width=True, key='production_history_lot_editor',
        column_config={
            'movement_id': None,
            'fecha': st.column_config.TextColumn('Fecha', disabled=True),
            'sku': st.column_config.TextColumn('SKU', disabled=True),
            'producto': st.column_config.TextColumn('Producto', disabled=True),
            'cantidad': st.column_config.NumberColumn('Producido', disabled=True),
            'deposito': st.column_config.TextColumn('Depósito', disabled=True),
            'lote': st.column_config.TextColumn('Lote PT'),
            'batch_mp': st.column_config.TextColumn('Batch MP', disabled=True),
            'observacion': st.column_config.TextColumn('Observación', disabled=True),
        },
    )
    reason=st.text_input('Motivo de asignación/corrección de lote', value='Regularización inicial de trazabilidad según registros físicos', key='prod_lot_reason')
    if st.button('Guardar lotes de producción', type='primary', key='save_production_lots'):
        changed,msg=save_production_lot_assignments(edited,reason)
        if msg=='OK':
            st.success(f'Lotes actualizados: {changed}. El stock real total no fue modificado.')
            st.rerun()
        else:
            st.error(msg)

    st.markdown('### Stock físico de cada lote al día de hoy')
    st.caption('Después de asignar los lotes arriba, indicá cuánto queda físicamente de cada uno hoy. Rawer Data conserva el stock real total y mueve la diferencia contra SIN LOTE.')
    lots=lot_stock_detail_df(date.today())
    if dep and not lots.empty:
        lots=lots[lots['deposito'].isin(dep)]
    if search and not lots.empty:
        q=str(search).strip()
        lots=lots[(lots['producto'].astype(str).str.contains(q,case=False,na=False) | lots['sku'].astype(str).str.contains(q,case=False,na=False) | lots['lote'].astype(str).str.contains(q,case=False,na=False))]
    if lots.empty:
        st.caption('No hay lotes asignados para los filtros actuales. Asigná un lote a una producción y guardá para que aparezca acá.')
    else:
        lot_edit=lots[['product_id','sku','producto','deposito','lote','fecha_produccion','produccion_inicial','stock_actual']].copy()
        lot_edit['stock_objetivo']=pd.to_numeric(lot_edit['stock_actual'],errors='coerce').fillna(0.0)
        lot_edited=st.data_editor(
            lot_edit, hide_index=True, use_container_width=True, key='production_current_lot_stock_editor',
            column_config={
                'product_id': None,
                'sku': st.column_config.TextColumn('SKU', disabled=True),
                'producto': st.column_config.TextColumn('Producto', disabled=True),
                'deposito': st.column_config.TextColumn('Depósito', disabled=True),
                'lote': st.column_config.TextColumn('Lote PT', disabled=True),
                'fecha_produccion': st.column_config.TextColumn('Fecha producción', disabled=True),
                'produccion_inicial': st.column_config.NumberColumn('Producido', disabled=True),
                'stock_actual': st.column_config.NumberColumn('Stock calculado', disabled=True),
                'stock_objetivo': st.column_config.NumberColumn('Stock físico hoy', min_value=0.0, step=1.0),
            },
        )
        stock_reason=st.text_input('Motivo del ajuste de stock por lote', value='Regularización inicial según recuento físico de planta', key='prod_stock_lot_reason')
        if st.button('Guardar stock físico de lotes', type='primary', key='save_production_lot_stock'):
            changed,msg=set_lot_stock_targets(date.today(),lot_edited[['product_id','deposito','lote','stock_objetivo']],stock_reason)
            if msg=='OK':
                st.success(f'Stock por lote actualizado. Lotes ajustados: {changed}. El stock real total se mantuvo sin cambios.')
                st.rerun()
            else:
                st.error(msg)

    conn_audit=get_conn()
    try:
        conn_audit.execute(
            """CREATE TABLE IF NOT EXISTS production_lot_audit (
                   id INTEGER PRIMARY KEY AUTOINCREMENT, movement_id INTEGER NOT NULL,
                   old_lot TEXT, new_lot TEXT NOT NULL, reason TEXT, changed_at TEXT NOT NULL
               )"""
        )
        conn_audit.commit()
    finally:
        conn_audit.close()
    audit=read_sql(
        """SELECT a.changed_at AS fecha_cambio, p.name AS producto, m.movement_date AS fecha_produccion,
                  a.old_lot AS lote_anterior, a.new_lot AS lote_nuevo, a.reason AS motivo
           FROM production_lot_audit a
           JOIN movements m ON m.id=a.movement_id
           JOIN products p ON p.id=m.product_id
           ORDER BY a.id DESC LIMIT 100"""
    )
    if not audit.empty:
        with st.expander('Historial de asignaciones/correcciones de lote', expanded=False):
            st.dataframe(audit.rename(columns={'fecha_cambio':'Fecha cambio','producto':'Producto','fecha_produccion':'Fecha producción','lote_anterior':'Lote anterior','lote_nuevo':'Lote nuevo','motivo':'Motivo'}), use_container_width=True, hide_index=True)

def page_real_stock():
    hero("Stock real", "Visualizá y corregí el stock físico real por producto y depósito.")
    st.info("Esta pestaña no edita movimientos anteriores. Si modificás un valor, la app crea un ajuste positivo o negativo para dejar trazabilidad.")
    as_of = st.date_input("Fecha del stock real", value=date.today())
    df = current_real_stock(as_of)
    products = get_products(True)[["id", "name"]].rename(columns={"name": "producto"})
    wide = products.copy()
    for dep in DEPOSITS:
        dep_df = df[df["deposit"] == dep][["id", "stock_real"]].rename(columns={"stock_real": dep})
        wide = wide.merge(dep_df, on="id", how="left")
        wide[dep] = wide[dep].fillna(0)
    search = st.text_input("Buscar producto", key="real_stock_search")
    view = wide.copy()
    if search:
        view = view[view["producto"].astype(str).str.contains(search, case=False, na=False)]
    edited = st.data_editor(
        view,
        hide_index=True,
        use_container_width=True,
        column_config={
            "id": None,
            "producto": st.column_config.TextColumn("Producto", disabled=True),
            **{dep: st.column_config.NumberColumn(dep, min_value=0.0, step=1.0) for dep in DEPOSITS},
        },
    )
    note = st.text_input("Observación del ajuste", value="Corrección manual de stock real")
    if st.button("Guardar ajustes de stock real", type="primary"):
        changed = set_real_stock_with_adjustments(as_of, edited, note)
        st.success(f"Stock real actualizado. Ajustes registrados: {changed}.")
        st.rerun()

    st.markdown("### Detalle calculado")
    detail = df[["deposit", "name", "stock_inicial", "produccion_disponible", "despachos", "transferencias_entrada", "transferencias_salida", "ajuste_positivo", "ajuste_negativo", "produccion_pendiente", "stock_real"]].rename(columns={
        "deposit": "Depósito",
        "name": "Producto",
        "stock_inicial": "Stock inicial",
        "produccion_disponible": "Producción disponible",
        "despachos": "Despachos",
        "transferencias_entrada": "Transferencias +",
        "transferencias_salida": "Transferencias -",
        "ajuste_positivo": "Ajustes +",
        "ajuste_negativo": "Ajustes -",
        "produccion_pendiente": "Producción pendiente",
        "stock_real": "Stock real",
    })
    st.dataframe(filter_dataframe(detail, text_cols=["Depósito", "Producto"], deposit_col="Depósito"), use_container_width=True, hide_index=True)



def page_stock_by_lot():
    hero("Stock por lote", "Visualizá y regularizá stock terminado por lote, controlá FIFO y seguí la trazabilidad hasta la comanda y la materia prima.")
    st.info("El stock por lote se calcula desde movimientos trazables. El stock real general sigue siendo la referencia física; si ambos no coinciden, Rawer Data muestra la diferencia como stock sin lote o inconsistencia a revisar.")

    f1, f2, f3 = st.columns([1, 1.4, 1.4])
    with f1:
        as_of = st.date_input("Stock al", value=date.today(), key="lot_stock_asof")
    with f2:
        dep_filter = st.multiselect("Depósito", DEPOSITS, default=[], key="lot_stock_dep")
    with f3:
        prod_search = st.text_input("Buscar producto / SKU / lote", key="lot_stock_search")

    detail = lot_stock_detail_df(as_of)
    rec = lot_stock_reconciliation_df(as_of)
    if dep_filter:
        detail = detail[detail['deposito'].isin(dep_filter)]
        rec = rec[rec['deposito'].isin(dep_filter)]
    if prod_search:
        q = str(prod_search).strip()
        mask = (
            detail['producto'].astype(str).str.contains(q, case=False, na=False) |
            detail['sku'].astype(str).str.contains(q, case=False, na=False) |
            detail['lote'].astype(str).str.contains(q, case=False, na=False)
        ) if not detail.empty else pd.Series(dtype=bool)
        detail = detail[mask] if not detail.empty else detail

    traceable_units = float(pd.to_numeric(detail.get('stock_actual', 0), errors='coerce').fillna(0).sum()) if not detail.empty else 0.0
    active_lots = int((pd.to_numeric(detail.get('stock_actual', 0), errors='coerce').fillna(0) > 0).sum()) if not detail.empty else 0
    real_total = float(pd.to_numeric(rec.get('stock_real', 0), errors='coerce').fillna(0).sum()) if not rec.empty else 0.0
    untraced_total = float(pd.to_numeric(rec.get('diferencia_sin_lote', 0), errors='coerce').fillna(0).sum()) if not rec.empty else 0.0
    m1, m2, m3, m4 = st.columns(4)
    m1.metric("Lotes con stock", f"{active_lots}")
    m2.metric("Unidades trazables", f"{traceable_units:,.0f}".replace(',', '.'))
    m3.metric("Stock real", f"{real_total:,.0f}".replace(',', '.'))
    m4.metric("Diferencia sin lote", f"{untraced_total:,.0f}".replace(',', '.'))

    st.markdown("### Stock terminado por lote")
    if detail.empty:
        st.warning("Todavía no hay movimientos de producto terminado con lote para los filtros seleccionados.")
    else:
        view = detail.rename(columns={
            'sku':'SKU','producto':'Producto','deposito':'Depósito','lote':'Lote PT','fecha_produccion':'Fecha producción',
            'produccion_inicial':'Producción inicial','entradas_lote':'Entradas al depósito','despachado':'Despachado',
            'transferencias_salida':'Transferencias salida','otras_salidas':'Otras salidas','stock_actual':'Stock actual',
            'batch_mp':'Batch MP','estado':'Estado'
        })
        st.dataframe(view[['SKU','Producto','Lote PT','Fecha producción','Producción inicial','Stock actual','Depósito','Estado','Batch MP']], use_container_width=True, hide_index=True)

        available = detail[pd.to_numeric(detail['stock_actual'], errors='coerce').fillna(0) > 0].copy()
        if not available.empty:
            st.markdown("### Orden sugerido de salida (FIFO)")
            fifo = available.sort_values(['producto','fecha_produccion','lote'])[['sku','producto','lote','fecha_produccion','stock_actual','deposito']]
            fifo = fifo.rename(columns={'sku':'SKU','producto':'Producto','lote':'Lote PT','fecha_produccion':'Fecha producción','stock_actual':'Stock disponible','deposito':'Depósito'})
            st.dataframe(fifo, use_container_width=True, hide_index=True)

    st.markdown("### Control stock real vs. lotes")
    rec_view = rec.copy()
    if not rec_view.empty:
        if prod_search:
            rec_view = rec_view[rec_view['producto'].astype(str).str.contains(str(prod_search), case=False, na=False)]
        rec_view = rec_view.rename(columns={'producto':'Producto','deposito':'Depósito','stock_real':'Stock real','stock_trazable_lotes':'Stock por lotes','diferencia_sin_lote':'Diferencia / sin lote','estado':'Estado'})
        diffs = rec_view[rec_view['Estado'] != 'OK']
        if not diffs.empty:
            st.warning(f"Hay {len(diffs)} combinación(es) producto/depósito donde el stock real no coincide con la suma de lotes. Puede ser stock histórico anterior a la trazabilidad o un movimiento cargado sin lote.")
        st.dataframe(rec_view[['Producto','Depósito','Stock real','Stock por lotes','Diferencia / sin lote','Estado']], use_container_width=True, hide_index=True)

    st.markdown("### Regularizar stock por lote")
    st.info("Usá esta sección para acomodar el stock histórico que quedó sin lote. Podés corregir el stock actual de cada lote según el recuento físico, incluso si hoy el cálculo del lote aparece en negativo. El stock físico corregido debe ser 0 o mayor. Rawer Data no modifica el stock real total: crea movimientos auditables y compensa la diferencia contra 'SIN LOTE'.")

    reg_detail = lot_stock_detail_df(as_of)
    if dep_filter:
        reg_detail = reg_detail[reg_detail['deposito'].isin(dep_filter)]
    if prod_search and not reg_detail.empty:
        qreg = str(prod_search).strip()
        reg_detail = reg_detail[
            reg_detail['producto'].astype(str).str.contains(qreg, case=False, na=False) |
            reg_detail['sku'].astype(str).str.contains(qreg, case=False, na=False) |
            reg_detail['lote'].astype(str).str.contains(qreg, case=False, na=False)
        ]

    if not reg_detail.empty:
        reg_edit = reg_detail[['product_id','sku','producto','deposito','lote','stock_actual']].copy()
        reg_edit['stock_objetivo'] = pd.to_numeric(reg_edit['stock_actual'], errors='coerce').fillna(0.0)
        edited_lots = st.data_editor(
            reg_edit,
            key='lot_stock_adjust_editor',
            hide_index=True,
            use_container_width=True,
            disabled=['product_id','sku','producto','deposito','lote','stock_actual'],
            column_config={
                'product_id': None,
                'sku': st.column_config.TextColumn('SKU', disabled=True),
                'producto': st.column_config.TextColumn('Producto', disabled=True),
                'deposito': st.column_config.TextColumn('Depósito', disabled=True),
                'lote': st.column_config.TextColumn('Lote PT', disabled=True),
                'stock_actual': st.column_config.NumberColumn('Stock actual calculado', disabled=True, format='%.0f'),
                'stock_objetivo': st.column_config.NumberColumn('Stock actual corregido', min_value=0.0, step=1.0, format='%.0f', help='Ingresá el stock físico que realmente queda hoy en este lote. Si el calculado está negativo, podés corregirlo a 0 o al valor real.'),
            },
        )
        reg_note = st.text_input('Motivo del ajuste de lotes', value='Regularización inicial de stock por lote según recuento físico', key='lot_stock_adjust_note')
        if st.button('Guardar ajustes de lotes', type='primary', key='save_lot_stock_adjustments'):
            changed, msg = set_lot_stock_targets(as_of, edited_lots, reg_note)
            if msg == 'OK':
                st.success(f'Stock por lote regularizado. Lotes ajustados: {changed}. El stock real total no fue modificado; cualquier diferencia quedó compensada en SIN LOTE.')
                st.rerun()
            else:
                st.error(msg)
    else:
        st.caption('No hay lotes existentes para editar con los filtros actuales. Podés crear/regularizar uno abajo.')

    with st.expander('Agregar o regularizar un lote que todavía no figura', expanded=False):
        products_lot = get_products(True)[['id','name']].copy()
        if products_lot.empty:
            st.caption('No hay productos activos.')
        else:
            c1, c2 = st.columns(2)
            with c1:
                new_lot_product = st.selectbox('Producto', products_lot['name'].tolist(), key='new_lot_product')
            with c2:
                new_lot_dep = st.selectbox('Depósito', DEPOSITS, index=0, key='new_lot_dep')
            c3, c4 = st.columns(2)
            with c3:
                new_lot_code = st.text_input('Lote PT', key='new_lot_code', placeholder='Ej.: PT-PV500-150926-01')
            with c4:
                new_lot_qty = st.number_input('Stock físico del lote', min_value=0.0, step=1.0, value=0.0, key='new_lot_qty')
            new_lot_note = st.text_input('Motivo', value='Regularización inicial de lote según recuento físico', key='new_lot_note')

            pid_new = int(products_lot.loc[products_lot['name'] == new_lot_product, 'id'].iloc[0])
            rec_now = lot_stock_reconciliation_df(as_of)
            rr = rec_now[(rec_now['product_id'] == pid_new) & (rec_now['deposito'] == new_lot_dep)] if not rec_now.empty else pd.DataFrame()
            if not rr.empty:
                real_v = float(rr.iloc[0]['stock_real'] or 0)
                traced_v = float(rr.iloc[0]['stock_trazable_lotes'] or 0)
                free_v = float(rr.iloc[0]['diferencia_sin_lote'] or 0)
                st.caption(f'Stock real: {real_v:,.0f} · Ya asignado a lotes: {traced_v:,.0f} · Disponible para asignar desde SIN LOTE: {free_v:,.0f}'.replace(',', '.'))
            if st.button('Guardar / regularizar este lote', key='save_single_lot_target'):
                changed, msg = set_single_lot_stock_target(as_of, pid_new, new_lot_dep, new_lot_code, new_lot_qty, new_lot_note)
                if msg == 'OK':
                    st.success('Lote regularizado. El stock real total se mantuvo sin cambios.')
                    st.rerun()
                else:
                    st.error(msg)

    history_lot = read_sql(
        """SELECT m.movement_date AS fecha, p.name AS producto, COALESCE(m.deposit,'') AS deposito,
                  COALESCE(m.lote,'') AS lote, m.movement_type AS tipo, m.quantity AS cantidad,
                  COALESCE(m.note,'') AS motivo, COALESCE(m.source,'') AS origen
           FROM movements m JOIN products p ON p.id=m.product_id
           WHERE COALESCE(m.is_undone,0)=0 AND m.source IN ('stock_lote_manual','stock_lote_manual_balance')
           ORDER BY m.id DESC LIMIT 100"""
    )
    if not history_lot.empty:
        with st.expander('Historial de regularizaciones por lote', expanded=False):
            st.dataframe(history_lot.rename(columns={'fecha':'Fecha','producto':'Producto','deposito':'Depósito','lote':'Lote PT','tipo':'Tipo','cantidad':'Cantidad','motivo':'Motivo','origen':'Origen'}), use_container_width=True, hide_index=True)

    st.markdown("### Ficha de trazabilidad de lote")
    all_detail = lot_stock_detail_df(as_of)
    if all_detail.empty:
        st.caption("No hay lotes para consultar.")
        return
    choices = all_detail[['product_id','producto','lote']].drop_duplicates().sort_values(['producto','lote'])
    choices['label'] = choices.apply(lambda r: f"{r['producto']} · {r['lote']}", axis=1)
    selected = st.selectbox("Seleccionar lote", [''] + choices['label'].tolist(), key='lot_stock_trace_choice')
    if not selected:
        return
    sel = choices[choices['label'] == selected].iloc[0]
    pid = int(sel['product_id']); lot = str(sel['lote'])
    lot_rows = all_detail[(all_detail['product_id'] == pid) & (all_detail['lote'] == lot)]
    st.dataframe(lot_rows.rename(columns={'producto':'Producto','deposito':'Depósito','lote':'Lote PT','fecha_produccion':'Fecha producción','produccion_inicial':'Producción inicial','stock_actual':'Stock actual','batch_mp':'Batch MP','estado':'Estado'})[['Producto','Lote PT','Fecha producción','Producción inicial','Depósito','Stock actual','Estado','Batch MP']], use_container_width=True, hide_index=True)

    prod_moves = read_sql(
        """SELECT m.id, m.movement_date AS fecha_produccion, m.quantity AS cantidad_producida,
                  COALESCE(m.deposit,'') AS deposito, COALESCE(b.code,'') AS batch_mp, m.batch_mp_run_id
           FROM movements m LEFT JOIN batch_mp_runs b ON b.id=m.batch_mp_run_id
           WHERE COALESCE(m.is_undone,0)=0 AND m.movement_type='produccion'
             AND m.product_id=? AND TRIM(COALESCE(m.lote,''))=?
           ORDER BY m.movement_date, m.id""", (pid, lot)
    )
    batch_ids = []
    if not prod_moves.empty:
        st.markdown("#### Producción de origen")
        st.dataframe(prod_moves[['fecha_produccion','cantidad_producida','deposito','batch_mp']], use_container_width=True, hide_index=True)
        batch_ids = [int(x) for x in prod_moves['batch_mp_run_id'].dropna().tolist() if str(x).strip() not in ('','nan')]
    if batch_ids:
        placeholders = ','.join(['?'] * len(batch_ids))
        mp = read_sql(
            f"""SELECT b.code AS batch_mp, s.name AS materia_prima, i.quantity AS cantidad,
                       s.unit AS unidad, COALESCE(i.lote_materia_prima,'') AS lote_materia_prima
                FROM batch_mp_run_items i
                JOIN batch_mp_runs b ON b.id=i.batch_mp_run_id
                JOIN supplies s ON s.id=i.supply_id
                WHERE i.batch_mp_run_id IN ({placeholders})
                ORDER BY b.code, s.name""", tuple(batch_ids)
        )
        if not mp.empty:
            st.markdown("#### Materias primas y lotes usados")
            st.dataframe(mp.rename(columns={'batch_mp':'Batch MP','materia_prima':'Materia prima','cantidad':'Cantidad','unidad':'Unidad','lote_materia_prima':'Lote MP'}), use_container_width=True, hide_index=True)

    desp = read_sql(
        """SELECT m.movement_date AS fecha_despacho, COALESCE(m.deposit,'') AS deposito,
                  COALESCE(m.numero_comanda,'') AS numero_comanda, m.quantity AS cantidad,
                  COALESCE(m.note,'') AS observacion
           FROM movements m
           WHERE COALESCE(m.is_undone,0)=0 AND m.movement_type='despacho'
             AND m.product_id=? AND TRIM(COALESCE(m.lote,''))=?
           ORDER BY m.movement_date DESC, m.id DESC""", (pid, lot)
    )
    st.markdown("#### Comandas / despachos de este lote")
    if desp.empty:
        st.caption("Todavía no hay despachos registrados para este lote.")
    else:
        st.dataframe(desp.rename(columns={'fecha_despacho':'Fecha','deposito':'Depósito','numero_comanda':'Comanda','cantidad':'Cantidad','observacion':'Observación'}), use_container_width=True, hide_index=True)


def normalize_ecomm_deposit(value):
    raw = str(value or "").strip()
    key = raw.upper()
    return ECOMM_DEPOSIT_MAP.get(key, raw if raw in DEPOSITS else None)


def extract_ecomm_variant_sku(value):
    text = str(value or "").strip()
    marker = "SKU de variante:"
    if marker in text:
        after = text.split(marker, 1)[1]
        return after.split("||", 1)[0].strip()
    if "||" in text:
        return text.split("||", 1)[0].strip()
    return text.strip()


def find_ecomm_column(columns, wanted):
    normalized = {str(c).strip().lower(): c for c in columns}
    if wanted in normalized:
        return normalized[wanted]
    for c in columns:
        cl = str(c).strip().lower()
        if wanted in cl:
            return c
    return None


def parse_ecomm_available_stock_excel(uploaded_file, stock_offset=10000):
    raw = pd.read_excel(uploaded_file)
    if raw.empty:
        return pd.DataFrame(), pd.DataFrame(), "El Excel no tiene filas."

    sku_col = find_ecomm_column(raw.columns, "sku")
    dep_col = find_ecomm_column(raw.columns, "nombre")
    stock_col = find_ecomm_column(raw.columns, "stock")
    missing = []
    if sku_col is None:
        missing.append("SKU")
    if dep_col is None:
        missing.append("nombre")
    if stock_col is None:
        missing.append("stock")
    if missing:
        return pd.DataFrame(), pd.DataFrame(), "Faltan columnas en el Excel: " + ", ".join(missing)

    df = raw[[sku_col, dep_col, stock_col]].copy()
    df.columns = ["sku_original", "deposito_original", "stock_original"]
    df["sku_ecomm"] = df["sku_original"].apply(extract_ecomm_variant_sku)
    df["deposito"] = df["deposito_original"].apply(normalize_ecomm_deposit)
    df["producto"] = df["sku_ecomm"].map(ECOMM_SKU_PRODUCT_MAP)
    df["stock_original"] = pd.to_numeric(df["stock_original"], errors="coerce").fillna(0)
    offset = float(stock_offset or 0)
    df["stock_app"] = (df["stock_original"] - offset).clip(lower=0)
    df["estado"] = "OK"
    df.loc[df["producto"].isna(), "estado"] = "SKU no reconocido"
    df.loc[df["deposito"].isna(), "estado"] = "Depósito no reconocido"

    valid = df[(df["producto"].notna()) & (df["deposito"].notna())].copy()
    if valid.empty:
        return df, pd.DataFrame(), "No se encontraron filas válidas para importar. Revisar SKUs y depósitos."

    valid = valid.sort_index().drop_duplicates(["producto", "deposito"], keep="last")
    valid = valid.groupby(["producto", "deposito"], as_index=False)["stock_app"].sum()
    products = get_products(True)[["id", "name"]].rename(columns={"name": "producto"})
    wide = products.copy()
    for dep in DEPOSITS:
        dep_df = valid[valid["deposito"] == dep][["producto", "stock_app"]].rename(columns={"stock_app": dep})
        wide = wide.merge(dep_df, on="producto", how="left")
        wide[dep] = wide[dep].fillna(0)
    return df, wide, ""


def parse_manjares_stock_excel(uploaded_file):
    raw = pd.read_excel(uploaded_file)
    if raw.empty:
        return pd.DataFrame(), pd.DataFrame(), "El Excel de Manjares no tiene filas."

    code_col = find_ecomm_column(raw.columns, "codigo")
    desc_col = find_ecomm_column(raw.columns, "descripcion interna") or find_ecomm_column(raw.columns, "descripcion")
    real_col = find_ecomm_column(raw.columns, "stock real")
    disp_col = find_ecomm_column(raw.columns, "stock disponible")
    missing = []
    if code_col is None:
        missing.append("Codigo")
    if real_col is None:
        missing.append("Stock Real")
    if disp_col is None:
        missing.append("Stock Disponible")
    if missing:
        return pd.DataFrame(), pd.DataFrame(), "Faltan columnas en el Excel de Manjares: " + ", ".join(missing)

    cols = [code_col, real_col, disp_col]
    names = ["codigo", "stock_real_manjares", "stock_disponible_manjares"]
    if desc_col is not None:
        cols.insert(1, desc_col)
        names.insert(1, "descripcion")
    df = raw[cols].copy()
    df.columns = names
    if "descripcion" not in df.columns:
        df["descripcion"] = ""
    df["codigo"] = df["codigo"].astype(str).str.strip().str.upper()
    # Manjares puede usar SKU distinto al de Rawer Data. Primero intentamos por código
    # y, si no coincide, usamos la descripción interna como respaldo.
    desc_source_col = None
    for c in df.columns:
        if normalize_text(c) in ["DESCRIPCION INTERNA", "DESCRIPCION", "DESCRIPCION DEL PRODUCTO COMERCIAL"]:
            desc_source_col = c
            break
    if desc_source_col:
        df["producto"] = df.apply(lambda r: manjares_product_name_from_code_or_description(r.get("codigo"), r.get(desc_source_col)), axis=1)
    else:
        df["producto"] = df["codigo"].apply(lambda x: manjares_product_name_from_code_or_description(x, ""))
    df["stock_real_manjares"] = pd.to_numeric(df["stock_real_manjares"], errors="coerce").fillna(0)
    df["stock_disponible_manjares"] = pd.to_numeric(df["stock_disponible_manjares"], errors="coerce").fillna(0)
    df["deposito"] = "Buenos Aires / Manjares"
    df["estado"] = "OK"
    df.loc[df["producto"].isna(), "estado"] = "Código no vinculado a producto Rawer Data"

    valid = df[df["producto"].notna()].copy()
    if valid.empty:
        return df, pd.DataFrame(), "No se encontraron productos reconocidos para importar desde Manjares."

    valid = valid.groupby(["producto", "deposito"], as_index=False).agg(
        stock_real_manjares=("stock_real_manjares", "sum"),
        stock_disponible_manjares=("stock_disponible_manjares", "sum"),
    )
    products = get_products(True)[["id", "name"]].rename(columns={"name": "producto"})
    wide = products.merge(valid[["producto", "stock_real_manjares", "stock_disponible_manjares"]], on="producto", how="left")
    wide["stock_real_manjares"] = wide["stock_real_manjares"].fillna(0)
    wide["stock_disponible_manjares"] = wide["stock_disponible_manjares"].fillna(0)
    return df, wide, ""


def save_manjares_stock_snapshot(stock_date, manjares_wide, note="Importación Excel Manjares"):
    """Actualiza stock disponible y stock real de Manjares al valor exacto del Excel.

    Modo reemplazo:
    - Stock disponible: guarda/actualiza la foto diaria de Manjares.
    - Stock real: compara el stock real actual de Manjares contra el Excel y crea
      un ajuste por la diferencia para que el resultado final quede igual al Excel.
    - Si se vuelve a importar el mismo día, vuelve a comparar y corrige solo la diferencia.
    """
    conn = get_conn()
    now = datetime.now().isoformat(timespec="seconds")
    dep = "Buenos Aires / Manjares"
    for _, row in manjares_wide.iterrows():
        product_id = int(row["id"])
        qty_disp = float(row.get("stock_disponible_manjares") or 0)
        conn.execute(
            """
            INSERT INTO available_stock_deposit(stock_date, product_id, deposit, quantity, note, created_at, updated_at)
            VALUES (?, ?, ?, ?, ?, ?, ?)
            ON CONFLICT(stock_date, product_id, deposit) DO UPDATE SET
                quantity=excluded.quantity,
                note=excluded.note,
                updated_at=excluded.updated_at
            """,
            (stock_date.isoformat() if hasattr(stock_date, "isoformat") else str(stock_date), product_id, dep, qty_disp, note, now, now),
        )
    conn.commit()
    conn.close()

    # Ajusta stock real de Manjares creando movimientos de ajuste por diferencia.
    current = current_real_stock(stock_date)
    current_map = {
        int(r["id"]): float(r["stock_real"] or 0)
        for _, r in current[current["deposit"] == dep].iterrows()
    }
    changed = 0
    for _, row in manjares_wide.iterrows():
        product_id = int(row["id"])
        new_qty = float(row.get("stock_real_manjares") or 0)
        old_qty = current_map.get(product_id, 0.0)
        diff = new_qty - old_qty
        if abs(diff) <= 0.000001:
            continue
        movement_type = "ajuste_positivo" if diff > 0 else "ajuste_negativo"
        add_movement(stock_date, product_id, movement_type, abs(diff), stock_date, note, "manjares_excel", deposit=dep)
        changed += 1
    return changed


def page_combos_tiendanube():
    hero("Combos Tiendanube", "Cargá la composición de los SKU combo para que las ventas se desglosen automáticamente en SKU individuales.")
    st.info("Cuando Tiendanube devuelva una venta con un SKU cargado acá como combo, Rawer Data no guarda el combo como producto terminado: lo convierte a los productos individuales de su composición.")

    products = get_products(True)["name"].tolist()
    with st.expander("Agregar o actualizar combo", expanded=True):
        c1, c2 = st.columns([1, 2])
        with c1:
            combo_sku = st.text_input("SKU combo Tiendanube")
        with c2:
            combo_name = st.text_input("Nombre del combo")
        st.caption("Agregá una fila por cada producto individual incluido dentro del combo.")
        if "combo_editor_rows" not in st.session_state:
            st.session_state["combo_editor_rows"] = pd.DataFrame([
                {"producto": products[0] if products else "", "sku_individual": default_sku_for_product(products[0]) if products else "", "cantidad_por_combo": 1.0}
            ])
        comp_df = st.data_editor(
            st.session_state["combo_editor_rows"],
            num_rows="dynamic",
            use_container_width=True,
            hide_index=True,
            column_config={
                "producto": st.column_config.SelectboxColumn("Producto individual", options=products, required=True),
                "sku_individual": st.column_config.TextColumn("SKU individual"),
                "cantidad_por_combo": st.column_config.NumberColumn("Cantidad por combo", min_value=0.0, step=1.0),
            },
            key="combo_components_editor",
        )
        if st.button("Guardar combo", type="primary"):
            ok, msg = save_combo(combo_sku, combo_name, comp_df)
            if ok:
                st.success(msg)
                st.session_state["combo_editor_rows"] = pd.DataFrame([
                    {"producto": products[0] if products else "", "sku_individual": default_sku_for_product(products[0]) if products else "", "cantidad_por_combo": 1.0}
                ])
                st.rerun()
            else:
                st.error(msg)

    st.markdown("### Combos cargados")
    combos = combo_headers_df()
    if combos.empty:
        st.caption("Todavía no hay combos cargados.")
        return
    show_combos = combos.rename(columns={"combo_sku": "SKU combo", "combo_name": "Combo", "active": "Activo", "updated_at": "Actualizado"})
    edited = st.data_editor(
        show_combos,
        hide_index=True,
        use_container_width=True,
        column_config={
            "id": st.column_config.NumberColumn("ID", disabled=True),
            "SKU combo": st.column_config.TextColumn("SKU combo", disabled=True),
            "Combo": st.column_config.TextColumn("Combo", disabled=True),
            "Activo": st.column_config.CheckboxColumn("Activo"),
            "Actualizado": st.column_config.TextColumn("Actualizado", disabled=True),
        },
        key="combos_status_editor",
    )
    if st.button("Guardar activos/inactivos"):
        for _, row in edited.iterrows():
            set_combo_active(int(row["id"]), bool(row["Activo"]))
        st.success("Combos actualizados.")
        st.rerun()

    selected_name = st.selectbox("Ver composición de", combos["combo_name"].tolist())
    selected_id = int(combos.loc[combos["combo_name"] == selected_name, "id"].iloc[0])
    comp = combo_components_df(selected_id)
    if not comp.empty:
        comp_show = comp[["component_sku", "producto", "quantity_per_combo", "active"]].rename(columns={
            "component_sku": "SKU individual",
            "producto": "Producto individual",
            "quantity_per_combo": "Cantidad por combo",
            "active": "Activo",
        })
        st.dataframe(comp_show, use_container_width=True, hide_index=True)

def page_tiendanube_sales():
    hero("Ventas Tiendanube", "Actualización manual de ventas. Las ventas impactan el stock disponible calculado como mercadería pendiente de despacho.")
    st.info("Etapa 1: la actualización es manual. Las ventas importadas no tocan el stock real físico. Reducen el stock disponible calculado del depósito correspondiente hasta que cargues el despacho con la misma comanda/número de orden.")
    st.warning("La app toma el depósito desde el campo Ubicación Tiendanube. Si no viene o no se reconoce, usa location_id como respaldo; si tampoco puede determinarlo, queda como Depósito pendiente y no se guarda hasta que elijas un depósito.")

    # Resumen operativo del día: separar ventas creadas hoy de entregas previstas hoy.
    st.markdown("### Hoy · ventas y entregas")
    today_deposit = st.selectbox(
        "Depósito",
        ["Todos"] + DEPOSITS,
        index=0,
        key="tn_today_deposit_filter",
        help="Filtra tanto las entregas de hoy como las ventas realizadas hoy.",
    )
    entregas_hoy, ventas_hoy = tiendanube_today_views(date.today(), today_deposit)

    pedidos_entrega = int(entregas_hoy['numero_orden'].astype(str).nunique()) if not entregas_hoy.empty else 0
    unidades_entrega = float(pd.to_numeric(entregas_hoy.get('cantidad', pd.Series(dtype=float)), errors='coerce').fillna(0).sum()) if not entregas_hoy.empty else 0.0
    pendiente_entrega_hoy = float(pd.to_numeric(entregas_hoy.get('pendiente_entrega', pd.Series(dtype=float)), errors='coerce').fillna(0).sum()) if not entregas_hoy.empty else 0.0
    pedidos_venta = int(ventas_hoy['numero_orden'].astype(str).nunique()) if not ventas_hoy.empty else 0
    unidades_venta = float(pd.to_numeric(ventas_hoy.get('cantidad', pd.Series(dtype=float)), errors='coerce').fillna(0).sum()) if not ventas_hoy.empty else 0.0

    tc1, tc2, tc3, tc4 = st.columns(4)
    tc1.metric("Comandas a entregar hoy", pedidos_entrega)
    tc2.metric("Unidades pendientes hoy", f"{pendiente_entrega_hoy:g}")
    tc3.metric("Ventas de hoy", pedidos_venta)
    tc4.metric("Unidades vendidas hoy", f"{unidades_venta:g}")

    tab_entregas_hoy, tab_ventas_hoy = st.tabs(["🚚 Entregas de hoy", "🛒 Ventas de hoy"])
    with tab_entregas_hoy:
        if entregas_hoy.empty:
            st.caption("No hay comandas con fecha de entrega exacta para hoy en el depósito seleccionado.")
        else:
            eh = entregas_hoy.copy()
            eh['pendiente_entrega'] = pd.to_numeric(eh.get('pendiente_entrega', 0), errors='coerce').fillna(0)
            show_eh = [c for c in [
                'numero_orden', 'cliente', 'deposito', 'sku', 'producto_rawer', 'cantidad',
                'despachado_rawer', 'pendiente_entrega', 'estado_entrega_rawer',
                'estado_envio', 'fecha_entrega_tiendanube'
            ] if c in eh.columns]
            eh_show = eh[show_eh].rename(columns={
                'numero_orden': 'Comanda', 'cliente': 'Cliente', 'deposito': 'Depósito',
                'sku': 'SKU', 'producto_rawer': 'Producto', 'cantidad': 'Pedido',
                'despachado_rawer': 'Ya despachado', 'pendiente_entrega': 'Pendiente',
                'estado_entrega_rawer': 'Estado Rawer', 'estado_envio': 'Estado envío TN',
                'fecha_entrega_tiendanube': 'Fecha entrega',
            })
            st.dataframe(eh_show, use_container_width=True, hide_index=True)
            if pendiente_entrega_hoy <= 0:
                st.success("Las comandas con entrega prevista para hoy ya no tienen unidades pendientes en Rawer Data.")

    with tab_ventas_hoy:
        if ventas_hoy.empty:
            st.caption("Todavía no hay ventas de Tiendanube registradas hoy para el depósito seleccionado.")
        else:
            vh = ventas_hoy.copy()
            show_vh = [c for c in [
                'fecha_venta', 'numero_orden', 'cliente', 'deposito', 'sku', 'producto_rawer',
                'cantidad', 'pago', 'estado_pedido', 'estado_envio', 'fecha_entrega_tiendanube'
            ] if c in vh.columns]
            vh_show = vh[show_vh].rename(columns={
                'fecha_venta': 'Fecha venta', 'numero_orden': 'Comanda', 'cliente': 'Cliente',
                'deposito': 'Depósito', 'sku': 'SKU', 'producto_rawer': 'Producto',
                'cantidad': 'Cantidad', 'pago': 'Pago', 'estado_pedido': 'Estado pedido',
                'estado_envio': 'Estado envío', 'fecha_entrega_tiendanube': 'Fecha entrega',
            })
            st.dataframe(vh_show, use_container_width=True, hide_index=True)

    if today_deposit == "Todos" and (not entregas_hoy.empty or not ventas_hoy.empty):
        dep_rows = []
        for dep in DEPOSITS:
            de = entregas_hoy[entregas_hoy['deposito'].astype(str) == dep] if not entregas_hoy.empty else pd.DataFrame()
            dv = ventas_hoy[ventas_hoy['deposito'].astype(str) == dep] if not ventas_hoy.empty else pd.DataFrame()
            dep_rows.append({
                'Depósito': dep,
                'Comandas entrega hoy': int(de['numero_orden'].astype(str).nunique()) if not de.empty else 0,
                'Unidades pendientes entrega': float(pd.to_numeric(de.get('pendiente_entrega', pd.Series(dtype=float)), errors='coerce').fillna(0).sum()) if not de.empty else 0.0,
                'Ventas de hoy': int(dv['numero_orden'].astype(str).nunique()) if not dv.empty else 0,
                'Unidades vendidas hoy': float(pd.to_numeric(dv.get('cantidad', pd.Series(dtype=float)), errors='coerce').fillna(0).sum()) if not dv.empty else 0.0,
            })
        st.markdown("#### Resumen de hoy por depósito")
        st.dataframe(pd.DataFrame(dep_rows), use_container_width=True, hide_index=True)

    with st.expander("Mapa de ubicaciones Tiendanube → depósitos Rawer", expanded=False):
        st.caption("Prioridad de depósito: primero Ubicación Tiendanube (Rawer/Manjares/Tandil). Si no viene, Rawer Data puede usar location_id mapeado como respaldo.")
        map_df = tiendanube_location_map_df(False)
        if map_df.empty:
            st.info("Todavía no hay ubicaciones Tiendanube mapeadas.")
        else:
            st.dataframe(map_df.rename(columns={
                "tn_location_id": "location_id Tiendanube",
                "tn_location_name": "Nombre Tiendanube",
                "rawer_deposit": "Depósito Rawer",
                "active": "Activo",
            }), use_container_width=True, hide_index=True)
        mc1, mc2, mc3 = st.columns([1, 1.5, 1.2])
        with mc1:
            new_loc_id = st.text_input("location_id Tiendanube", key="tn_new_location_id")
        with mc2:
            new_loc_name = st.text_input("Nombre / referencia", key="tn_new_location_name")
        with mc3:
            new_dep = st.selectbox("Depósito Rawer", DEPOSITS, key="tn_new_location_deposit")
        if st.button("Guardar ubicación Tiendanube"):
            try:
                upsert_tiendanube_location_mapping(new_loc_id, new_loc_name, new_dep)
                st.success("Ubicación Tiendanube guardada con éxito.")
                st.rerun()
            except Exception as e:
                st.error(f"No se pudo guardar la ubicación: {e}")

    with st.expander("Configuración de conexión", expanded=False):
        current_store = get_setting("tiendanube_store_id", "")
        current_token = get_setting("tiendanube_access_token", "")
        store_id = st.text_input("Store ID / user_id de Tiendanube", value=current_store, help="Es el ID de tienda que entrega Tiendanube junto con el access token.")
        access_token = st.text_input("Access token", value=current_token, type="password", help="Token con permiso read_orders.")
        c1, c2 = st.columns(2)
        with c1:
            if st.button("Guardar configuración"):
                set_setting("tiendanube_store_id", store_id)
                set_setting("tiendanube_access_token", access_token)
                st.success("Configuración guardada con éxito.")
        with c2:
            if st.button("Probar conexión"):
                try:
                    test_orders = tiendanube_fetch_orders(store_id, access_token, status="any", payment_status="any", max_pages=1)
                    st.success(f"Conexión correcta. Respuesta recibida: {len(test_orders)} pedido(s) en la primera página.")
                except Exception as e:
                    st.error(f"No se pudo conectar: {e}")

    st.markdown("### Actualizar ventas")
    last_sync = get_setting("tiendanube_last_sync", "")
    c1, c2, c3, c4 = st.columns(4)
    with c1:
        from_date = st.date_input("Desde fecha", value=date.today() - timedelta(days=7))
    with c2:
        to_date = st.date_input("Hasta fecha", value=date.today())
    with c3:
        status = st.selectbox("Estado pedido", ["any", "open", "closed", "cancelled"], index=0)
    with c4:
        payment_status = st.selectbox("Estado pago", ["paid", "any", "pending", "authorized", "refunded", "voided", "abandoned"], index=0)

    sale_deposit = st.selectbox("Depósito por defecto para ventas importadas", DEPOSITS, index=0, help="Se usa cuando Tiendanube no informa un depósito claro. Después de buscar ventas podés editar el depósito por cada línea antes de guardar.")
    max_pages = st.number_input("Máximo de páginas a consultar", min_value=1, max_value=50, value=10, step=1, help="Cada página trae hasta 50 pedidos. Subilo solo si el rango tiene muchas ventas.")
    if last_sync:
        st.caption(f"Última actualización guardada: {last_sync}")

    if "tn_preview" not in st.session_state:
        st.session_state["tn_preview"] = pd.DataFrame()

    with st.expander("Importar ventas Tiendanube desde CSV", expanded=True):
        st.caption("Subí el CSV exportado desde Tiendanube. La app usa Estado del envío: 'No está empaquetado' y 'Listo para enviar' quedan como ventas pendientes de entrega. Ya no depende de Fecha de entrega.")
        tn_csv_file = st.file_uploader("CSV de ventas Tiendanube", type=["csv"], key="tn_sales_csv_import")
        csv_default_dep = st.selectbox("Depósito por defecto si el CSV no permite inferirlo", DEPOSITS, index=0, key="tn_csv_default_deposit")
        if tn_csv_file is not None:
            csv_lines, csv_err = parse_tiendanube_sales_csv(tn_csv_file, default_deposit=csv_default_dep)
            if csv_err:
                st.warning(csv_err)
            if csv_lines is not None and not csv_lines.empty:
                ok_csv = csv_lines[csv_lines["estado"].eq("OK")]
                pending_csv = ok_csv[ok_csv["pendiente_por_estado_envio"] == True] if "pendiente_por_estado_envio" in ok_csv.columns else pd.DataFrame()
                c_csv1, c_csv2, c_csv3 = st.columns(3)
                c_csv1.metric("Líneas válidas", len(ok_csv))
                c_csv2.metric("Pendientes por estado envío", len(pending_csv))
                c_csv3.metric("A revisar", len(csv_lines) - len(ok_csv))
                show_cols = [c for c in ["order_number", "order_created_at", "sale_deposit", "shipping_status", "pendiente_por_estado_envio", "sku", "product_name_tn", "product_name_rawer", "quantity", "payment_status", "order_status", "estado"] if c in csv_lines.columns]
                st.dataframe(csv_lines[show_cols], use_container_width=True, hide_index=True)
                if st.button("Confirmar importación CSV Tiendanube", type="primary", key="confirm_tn_csv_import"):
                    to_save_csv = csv_lines[csv_lines["estado"].eq("OK")].copy()
                    saved_csv = save_tiendanube_sales(to_save_csv, sale_deposit=csv_default_dep)
                    set_setting("tiendanube_last_sync", datetime.now().isoformat(timespec="seconds"))
                    st.success(f"Ventas Tiendanube CSV guardadas con éxito. Líneas nuevas registradas: {saved_csv}.")
                    st.rerun()

    if st.button("Buscar ventas nuevas en Tiendanube", type="primary"):
        store_id = get_setting("tiendanube_store_id", store_id if 'store_id' in locals() else "")
        access_token = get_setting("tiendanube_access_token", access_token if 'access_token' in locals() else "")
        try:
            created_at_min = f"{from_date.isoformat()}T00:00:00-03:00"
            created_at_max = f"{to_date.isoformat()}T23:59:59-03:00"
            orders = tiendanube_fetch_orders(
                store_id,
                access_token,
                created_at_min=created_at_min,
                created_at_max=created_at_max,
                status=status,
                payment_status=payment_status,
                max_pages=int(max_pages),
            )
            lines = tiendanube_orders_to_lines(orders)
            if lines.empty:
                st.session_state["tn_preview"] = pd.DataFrame()
                st.warning("No se encontraron ventas en ese período.")
            else:
                imported = imported_tiendanube_keys()
                if "sale_deposit" not in lines.columns:
                    lines["sale_deposit"] = PENDING_DEPOSIT
                lines["sale_deposit"] = lines["sale_deposit"].apply(lambda x: x if x in DEPOSITS else PENDING_DEPOSIT)
                lines["estado"] = lines.apply(lambda r: "Depósito pendiente" if (r.get("estado") == "OK" and r.get("sale_deposit") not in DEPOSITS) else r.get("estado"), axis=1)
                lines["ya_importado"] = lines.apply(lambda r: (str(r["order_id"]), str(r["sku"]), str(r["product_name_tn"])) in imported, axis=1)
                # Igual que el importador CSV, las líneas ya registradas se vuelven
                # a guardar mediante UPSERT. Esto permite actualizar Estado de envío,
                # depósito y cantidad sin duplicar la venta y hace que el stock
                # disponible responda a la sincronización automática.
                st.session_state["tn_preview"] = lines
                pendientes_api = int(lines.get("pendiente_por_estado_envio", pd.Series(dtype=bool)).fillna(False).astype(bool).sum()) if "pendiente_por_estado_envio" in lines.columns else 0
                st.success(f"Se leyeron {len(orders)} pedidos y {len(lines)} líneas de producto. Pendientes por estado de envío: {pendientes_api}.")
        except Exception as e:
            st.error(f"Error al consultar Tiendanube: {e}")

    preview = st.session_state.get("tn_preview", pd.DataFrame())
    if preview is not None and not preview.empty:
        ok = preview[(preview["estado"] == "OK") & (preview.get("sale_deposit", PENDING_DEPOSIT).isin(DEPOSITS))]
        no_rec = preview[(preview["estado"] != "OK") | (~preview.get("sale_deposit", PENDING_DEPOSIT).isin(DEPOSITS))]
        dup = preview[preview.get("ya_importado", False)]
        c1, c2, c3 = st.columns(3)
        c1.metric("Líneas válidas", len(ok))
        c2.metric("Ya registradas / se actualizan", len(dup))
        c3.metric("SKU a revisar", len(no_rec))

        if "sale_deposit" not in preview.columns:
            preview["sale_deposit"] = sale_deposit
        preview["sale_deposit"] = preview["sale_deposit"].apply(lambda x: x if x in DEPOSITS else PENDING_DEPOSIT)
        st.markdown("#### Revisar depósito antes de guardar")
        st.caption("El depósito de cada línea define de qué depósito se resta como venta pendiente. Si Tiendanube no informa una ubicación reconocida, elegí el depósito antes de guardar.")
        editable_cols = ["order_created_at", "order_number", "sale_deposit", "deposit_source", "tn_distribution_center", "tn_location_id", "tn_location_name", "delivery_date_tn", "sale_type", "combo_sku", "combo_name", "sku", "product_name_tn", "product_name_rawer", "quantity", "payment_status", "order_status", "shipping_status", "pendiente_por_estado_envio", "estado", "ya_importado"]
        editable_cols = [c for c in editable_cols if c in preview.columns]
        edited_preview = st.data_editor(
            preview[editable_cols].copy(),
            use_container_width=True,
            hide_index=True,
            disabled=[c for c in editable_cols if c != "sale_deposit"],
            column_config={
                "order_created_at": st.column_config.TextColumn("Fecha venta"),
                "order_number": st.column_config.TextColumn("Orden"),
                "sale_deposit": st.column_config.SelectboxColumn("Depósito", options=DEPOSIT_OPTIONS_WITH_PENDING, required=True),
                "deposit_source": st.column_config.TextColumn("Origen depósito"),
                "tn_distribution_center": st.column_config.TextColumn("Ubicación Tiendanube"),
                "tn_location_id": st.column_config.TextColumn("location_id TN"),
                "tn_location_name": st.column_config.TextColumn("Ubicación TN"),
                "delivery_date_tn": st.column_config.TextColumn("Fecha entrega TN"),
                "sale_type": st.column_config.TextColumn("Tipo"),
                "combo_sku": st.column_config.TextColumn("SKU combo"),
                "combo_name": st.column_config.TextColumn("Combo"),
                "sku": st.column_config.TextColumn("SKU individual"),
                "product_name_tn": st.column_config.TextColumn("Producto Tiendanube"),
                "product_name_rawer": st.column_config.TextColumn("Producto Rawer"),
                "quantity": st.column_config.NumberColumn("Cantidad"),
                "payment_status": st.column_config.TextColumn("Pago"),
                "order_status": st.column_config.TextColumn("Estado"),
                "shipping_status": st.column_config.TextColumn("Estado envío"),
                "pendiente_por_estado_envio": st.column_config.CheckboxColumn("Pendiente / descuenta disponible"),
                "estado": st.column_config.TextColumn("Lectura"),
                "ya_importado": st.column_config.CheckboxColumn("Ya importado"),
            },
            key="tn_preview_editor",
        )
        if "sale_deposit" in edited_preview.columns:
            preview.loc[:, "sale_deposit"] = edited_preview["sale_deposit"].values
            # Si la única observación era depósito pendiente y el usuario eligió un depósito válido, vuelve a quedar lista para guardar.
            pending_mask = preview["estado"].astype(str).eq("Depósito pendiente") & preview["sale_deposit"].isin(DEPOSITS)
            preview.loc[pending_mask, "estado"] = "OK"
            st.session_state["tn_preview"] = preview

        if len(no_rec) > 0:
            st.warning("Hay líneas a revisar: SKU no reconocido o depósito pendiente. No se guardan hasta corregirlas en el mapa de SKUs/combos o elegir un depósito válido.")

        if st.button("Guardar / actualizar ventas de Tiendanube"):
            to_save = preview[(preview["estado"] == "OK") & (preview.get("sale_deposit", PENDING_DEPOSIT).isin(DEPOSITS))].copy()
            saved = save_tiendanube_sales(to_save, sale_deposit=sale_deposit)
            set_setting("tiendanube_last_sync", datetime.now().isoformat(timespec="seconds"))
            st.session_state["tn_preview"] = pd.DataFrame()
            st.success(f"Ventas Tiendanube guardadas con éxito. Líneas nuevas registradas: {saved}.")
            st.rerun()

    st.markdown("### Ventas Tiendanube registradas")
    df = tiendanube_sales_df()
    if df.empty:
        st.caption("Todavía no hay ventas importadas desde Tiendanube.")
    else:
        col1, col2, col3 = st.columns(3)
        with col1:
            producto = st.text_input("Filtrar producto/SKU/orden", key="tn_filter_text")
        with col2:
            pago = st.selectbox("Filtrar pago", ["Todos"] + sorted([x for x in df["pago"].dropna().unique().tolist() if x]), key="tn_filter_pago")
        with col3:
            estado_p = st.selectbox("Filtrar estado entrega", ["Todos"] + sorted([x for x in df["estado_entrega_rawer"].dropna().unique().tolist() if x]), key="tn_filter_estado")
        out = df.copy()
        if producto:
            mask = out.apply(lambda r: producto.lower() in " ".join(map(str, r.values)).lower(), axis=1)
            out = out[mask]
        if pago != "Todos":
            out = out[out["pago"] == pago]
        if estado_p != "Todos":
            out = out[out["estado_entrega_rawer"] == estado_p]
        st.dataframe(out, use_container_width=True, hide_index=True)


def page_available_stock():
    hero("Stock disponible / Manjares", "Importá el Excel de Manjares para actualizar Stock Real y Stock Disponible de Buenos Aires / Manjares.")
    st.info("El stock de EcommApp/Tiendanube ya no se usa como fuente de stock. Para Manjares se usa el Excel de Manjares. Para Planta y Tandil, el disponible se calcula como Stock real - ventas pendientes de despacho.")
    stock_date = st.date_input("Fecha de importación / foto de stock", value=date.today())

    tab_manjares, tab_historial = st.tabs(["Importar Excel Manjares", "Historial Manjares"])

    with tab_manjares:
        st.markdown("### Importar stock desde Manjares")
        st.caption("Formato esperado: Excel exportado de Manjares con columnas Codigo, Stock Real y Stock Disponible. Al guardar, Rawer Data deja el Stock Real y el Stock Disponible de Buenos Aires / Manjares igual al Excel.")
        uploaded_manjares = st.file_uploader("Subir Excel exportado de Manjares", type=["xlsx", "xls"], key="manjares_stock_upload_v89")
        note_manjares = st.text_input("Observación importación Manjares", value="Importación Excel Manjares")
        if uploaded_manjares is not None:
            preview_m, manjares_wide, err_m = parse_manjares_stock_excel(uploaded_manjares)
            if err_m:
                st.error(err_m)
            else:
                total_filas = len(preview_m)
                filas_ok = len(preview_m[preview_m["estado"] == "OK"])
                filas_alerta = total_filas - filas_ok
                c1, c2, c3 = st.columns(3)
                c1.metric("Filas leídas", total_filas)
                c2.metric("Productos reconocidos", filas_ok)
                c3.metric("Filas no importadas", filas_alerta)

                st.markdown("#### Vista previa Manjares")
                show_m = manjares_wide[["producto", "stock_real_manjares", "stock_disponible_manjares"]].copy()
                show_m = show_m[(show_m["stock_real_manjares"] != 0) | (show_m["stock_disponible_manjares"] != 0)]
                show_m = show_m.rename(columns={
                    "producto": "Producto",
                    "stock_real_manjares": "Stock real Manjares",
                    "stock_disponible_manjares": "Stock disponible Manjares",
                })
                st.dataframe(show_m, use_container_width=True, hide_index=True)

                if filas_alerta > 0:
                    st.markdown("#### Códigos no importados")
                    st.caption("Estos códigos no están vinculados a productos de Rawer Data. No impactan stock hasta que los agreguemos al mapa.")
                    st.dataframe(
                        preview_m[preview_m["estado"] != "OK"][["codigo", "descripcion", "stock_real_manjares", "stock_disponible_manjares", "estado"]],
                        use_container_width=True,
                        hide_index=True,
                    )

                st.warning("Al guardar, Manjares se actualiza en modo reemplazo: Stock Real y Stock Disponible quedan igual al Excel. Se registra un ajuste de stock real solo por la diferencia necesaria.")
                if st.button("Guardar stock Manjares importado", type="primary", key="save_manjares_stock_v89"):
                    ajustes = save_manjares_stock_snapshot(stock_date, manjares_wide, note_manjares)
                    set_flash(f"Stock Manjares actualizado con éxito. Ajustes de stock real registrados: {ajustes}.")
                    st.rerun()

    with tab_historial:
        st.markdown("### Importaciones / cargas de stock Manjares")
        hist = available_snapshots_df()
        if hist.empty:
            st.info("Todavía no hay cargas de stock disponible.")
        else:
            # Mostrar solo Manjares y, cuando exista observación, solo registros Manjares.
            cols = list(hist.columns)
            f = hist.copy()
            if "Depósito" in f.columns:
                f = f[f["Depósito"].astype(str).eq("Buenos Aires / Manjares")]
            elif "deposito" in f.columns:
                f = f[f["deposito"].astype(str).eq("Buenos Aires / Manjares")]
            # Filtro defensivo por texto Manjares si la tabla trae observación.
            for obs_col in ["Observación", "observacion", "note", "Nota"]:
                if obs_col in f.columns:
                    mask = f[obs_col].astype(str).str.contains("manjares", case=False, na=False)
                    if mask.any():
                        f = f[mask]
                    break
            st.dataframe(f.head(500), use_container_width=True, hide_index=True)

def page_private_sales():
    hero("Ventas particulares", "Cargá ventas que no entran por Tiendanube, por ejemplo pedidos de petshops o mayoristas.")
    st.info("Estas ventas no modifican el stock real. Se restan del stock disponible calculado del depósito elegido hasta que cargues un despacho con la misma comanda/orden.")

    with st.expander("Importar ventas mayoristas desde Excel EcommApp", expanded=True):
        st.caption("Subí el reporte de presupuestos de EcommApp. Rawer Data importa solo productos válidos, excluye descuentos/borrados y evita duplicados.")
        cimp1, cimp2 = st.columns([2, 1])
        with cimp1:
            wholesale_file = st.file_uploader("Excel de presupuestos / ventas mayoristas", type=["xlsx"], key="ecommapp_wholesale_import_file")
        with cimp2:
            estado_filter = st.selectbox("Estado EcommApp", ["Todos", "Nuevo", "Facturado"], index=0, help="Filtro opcional sobre la columna Estado del Excel.")
        if wholesale_file is not None:
            preview_w, err_w = parse_ecommapp_wholesale_excel(wholesale_file, estado_filter)
            if err_w:
                st.error(err_w)
            else:
                total = len(preview_w)
                ok = int((preview_w["estado_importacion"] == "OK").sum()) if not preview_w.empty else 0
                no_imp = total - ok
                descuentos = int(preview_w["estado_importacion"].astype(str).str.contains("descuento", case=False, na=False).sum()) if not preview_w.empty else 0
                duplicados = int(preview_w["duplicado"].astype(bool).sum()) if not preview_w.empty and "duplicado" in preview_w.columns else 0
                m1, m2, m3, m4 = st.columns(4)
                m1.metric("Filas leídas", total)
                m2.metric("Líneas a importar", ok)
                m3.metric("No importadas", no_imp)
                m4.metric("Duplicadas", duplicados)

                if ok > 0:
                    resumen_dep = preview_w[preview_w["estado_importacion"] == "OK"].groupby("deposito", as_index=False)["cantidad"].sum().rename(columns={"deposito": "Depósito", "cantidad": "Unidades"})
                    st.markdown("#### Resumen válido por depósito")
                    st.dataframe(resumen_dep, use_container_width=True, hide_index=True)

                st.markdown("#### Vista previa")
                cols_prev = ["fecha_venta", "numero_comanda", "cliente", "deposito", "sku_original", "producto", "cantidad", "estado_ecommapp", "estado_importacion"]
                st.dataframe(
                    preview_w[cols_prev].rename(columns={
                        "fecha_venta": "Fecha", "numero_comanda": "N° Presupuesto", "cliente": "Cliente",
                        "deposito": "Depósito", "sku_original": "SKU", "producto": "Producto Rawer",
                        "cantidad": "Cantidad", "estado_ecommapp": "Estado", "estado_importacion": "Resultado",
                    }),
                    use_container_width=True,
                    hide_index=True,
                )
                st.warning("Al guardar, estas líneas quedan como ventas mayoristas pendientes. No descuentan stock real hasta que cargues el despacho físico.")
                if st.button("Guardar ventas mayoristas importadas", type="primary", disabled=ok == 0, key="save_ecommapp_wholesale_sales"):
                    saved, skipped = save_imported_ecommapp_wholesale(preview_w)
                    set_flash(f"Ventas mayoristas importadas con éxito. Líneas nuevas: {saved}. Duplicadas omitidas: {skipped}.")
                    st.rerun()

    products = get_products(True)[["id", "name"]].copy().sort_values("name")
    product_names = products["name"].tolist()
    if not product_names:
        st.warning("Primero cargá productos.")
        return

    with st.form("private_sale_form", clear_on_submit=True):
        c1, c2, c3 = st.columns([1, 1, 1])
        with c1:
            sale_date = st.date_input("Fecha de venta", value=date.today())
        with c2:
            order_number = st.text_input("N° comanda / orden", placeholder="Ej: PETSHOP-001")
        with c3:
            delivery_date = st.date_input("Fecha de entrega estimada", value=date.today())
        c4, c5 = st.columns([1, 2])
        with c4:
            sale_deposit = st.selectbox("Depósito del que se descuenta", DEPOSITS, index=0)
        with c5:
            customer_name = st.text_input("Cliente / petshop", placeholder="Ej: Petshop Centro")
        st.markdown("#### Productos vendidos")
        base_lines = pd.DataFrame([
            {"producto": product_names[0], "cantidad": 0.0},
            {"producto": product_names[0], "cantidad": 0.0},
            {"producto": product_names[0], "cantidad": 0.0},
        ])
        lines = st.data_editor(
            base_lines,
            num_rows="dynamic",
            use_container_width=True,
            hide_index=True,
            column_config={
                "producto": st.column_config.SelectboxColumn("Producto", options=product_names, required=True),
                "cantidad": st.column_config.NumberColumn("Cantidad", min_value=0.0, step=1.0, required=True),
            },
        )
        note = st.text_input("Observación", value="Venta particular / petshop")
        submitted = st.form_submit_button("Guardar venta particular", type="primary")
        if submitted:
            saved, msg = save_private_sale_lines(sale_date, order_number, customer_name, sale_deposit, delivery_date, lines, note)
            if saved > 0:
                st.success(msg)
            else:
                st.error(msg if msg else "No se guardaron líneas. Revisá que haya cantidades mayores a cero.")

    st.markdown("---")
    st.markdown("### Ventas particulares registradas")
    df = private_sales_df()
    if df.empty:
        st.caption("Todavía no hay ventas particulares cargadas.")
        return
    f1, f2, f3 = st.columns([1,1,2])
    with f1:
        dep_filter = st.selectbox("Filtrar depósito", ["Todos"] + DEPOSITS, key="private_sales_dep_filter")
    with f2:
        active_filter = st.selectbox("Estado", ["Activas", "Anuladas", "Todas"], key="private_sales_active_filter")
    with f3:
        q = st.text_input("Buscar", placeholder="comanda, cliente, producto", key="private_sales_search")
    view = df.copy()
    if dep_filter != "Todos":
        view = view[view["deposito"] == dep_filter]
    if active_filter == "Activas":
        view = view[view["anulado"].astype(int) == 0]
    elif active_filter == "Anuladas":
        view = view[view["anulado"].astype(int) == 1]
    if q:
        mask = view.apply(lambda r: q.lower() in " ".join(map(str, r.values)).lower(), axis=1)
        view = view[mask]
    st.dataframe(view, use_container_width=True, hide_index=True)


def page_pending():
    hero("Producción pendiente", "Productos producidos que todavía no impactaron el stock real por días de espera.")
    today = date.today().isoformat()
    df = read_sql(
        """
        SELECT m.movement_date AS fecha_produccion, m.effective_date AS fecha_impacto_stock,
               COALESCE(m.deposit, '') AS deposito,
               p.name AS producto, m.quantity AS cantidad, p.days_to_stock AS dias_para_stock, m.note AS observacion
        FROM movements m
        JOIN products p ON p.id = m.product_id
        WHERE m.movement_type='produccion' AND COALESCE(m.is_undone,0)=0 AND date(m.effective_date) > date(?)
        ORDER BY date(m.effective_date), COALESCE(m.deposit,''), p.name
        """,
        (today,),
    )
    st.dataframe(df, use_container_width=True, hide_index=True)

    st.markdown("### Producción que ya impacta hoy")
    ready = read_sql(
        """
        SELECT m.movement_date AS fecha_produccion, m.effective_date AS fecha_impacto_stock,
               COALESCE(m.deposit, '') AS deposito,
               p.name AS producto, m.quantity AS cantidad, p.days_to_stock AS dias_para_stock
        FROM movements m
        JOIN products p ON p.id = m.product_id
        WHERE m.movement_type='produccion' AND COALESCE(m.is_undone,0)=0 AND date(m.effective_date) <= date(?)
        ORDER BY date(m.effective_date) DESC, COALESCE(m.deposit,''), p.name
        LIMIT 200
        """,
        (today,),
    )
    st.dataframe(ready, use_container_width=True, hide_index=True)

def page_history():
    hero("Historial", "Todos los movimientos registrados, con filtros por tipo, fecha, depósito, producto o insumo.")
    product_df = movements_df()
    supply_df = supply_movements_df()

    rows = []
    if not product_df.empty:
        tmp = product_df.copy()
        type_map = {
            "produccion": "Producción",
            "despacho": "Despachos",
            "transferencia_salida": "Transferencia entre depósitos - salida",
            "transferencia_entrada": "Transferencia entre depósitos - entrada",
            "ajuste_positivo": "Ajuste positivo stock real",
            "ajuste_negativo": "Ajuste negativo stock real",
        }
        tmp["grupo"] = "Producto terminado"
        tmp["tipo_filtro"] = tmp["tipo"].map(type_map).fillna(tmp["tipo"])
        tmp["fecha"] = tmp["fecha_movimiento"]
        tmp["item"] = tmp["producto"]
        tmp["unidad"] = "unidades"
        tmp["batchs_origen"] = ""
        rows.append(tmp[["fecha", "fecha_impacto_stock", "deposito", "grupo", "tipo_filtro", "item", "cantidad", "unidad", "batchs_origen", "numero_comanda", "lote", "observacion", "origen", "cargado_el"]])
    if not supply_df.empty:
        tmp = supply_df.copy()
        type_map = {
            "ingreso": "Ingreso insumos",
            "consumo_batch_materia_prima": "Consumo MP por batch",
            "consumo_produccion": "Consumo insumos producción",
            "ajuste_positivo": "Ajuste positivo insumos",
            "ajuste_negativo": "Ajuste negativo insumos",
        }
        tmp["grupo"] = "Insumos"
        tmp["tipo_filtro"] = tmp["tipo"].map(type_map).fillna(tmp["tipo"])
        tmp["fecha_impacto_stock"] = tmp["fecha"]
        tmp["deposito"] = ""
        tmp["item"] = tmp["insumo"]
        tmp["numero_comanda"] = ""
        tmp["lote"] = ""
        if "batchs_origen" not in tmp.columns:
            tmp["batchs_origen"] = ""
        rows.append(tmp[["fecha", "fecha_impacto_stock", "deposito", "grupo", "tipo_filtro", "item", "cantidad", "unidad", "batchs_origen", "numero_comanda", "lote", "observacion", "origen", "cargado_el"]])

    if not rows:
        st.info("Todavía no hay movimientos cargados.")
        return

    df = pd.concat(rows, ignore_index=True)
    df["fecha_dt"] = pd.to_datetime(df["fecha"]).dt.date
    min_date = df["fecha_dt"].min()
    max_date = df["fecha_dt"].max()

    c1, c2, c3 = st.columns([1, 1, 2])
    with c1:
        start = st.date_input("Desde", value=min_date, key="hist_desde")
    with c2:
        end = st.date_input("Hasta", value=max(max_date, date.today()), key="hist_hasta")
    with c3:
        search = st.text_input("Buscar producto / insumo / comanda / lote", key="hist_search")

    c4, c5, c6 = st.columns([2, 2, 2])
    with c4:
        type_options = sorted(df["tipo_filtro"].dropna().unique().tolist())
        selected_types = st.multiselect("Filtrar tipo de movimiento", type_options, default=[])
    with c5:
        group_options = sorted(df["grupo"].dropna().unique().tolist())
        selected_groups = st.multiselect("Filtrar grupo", group_options, default=[])
    with c6:
        dep_options = sorted([x for x in df["deposito"].dropna().unique().tolist() if x])
        selected_deps = st.multiselect("Filtrar depósito", dep_options, default=[])

    f = df[(df["fecha_dt"] >= start) & (df["fecha_dt"] <= end)].copy()
    if selected_types:
        f = f[f["tipo_filtro"].isin(selected_types)]
    if selected_groups:
        f = f[f["grupo"].isin(selected_groups)]
    if selected_deps:
        f = f[f["deposito"].isin(selected_deps)]
    if search:
        mask = (
            f["item"].astype(str).str.contains(search, case=False, na=False)
            | f["numero_comanda"].astype(str).str.contains(search, case=False, na=False)
            | f["lote"].astype(str).str.contains(search, case=False, na=False)
            | f["batchs_origen"].astype(str).str.contains(search, case=False, na=False)
            | f["observacion"].astype(str).str.contains(search, case=False, na=False)
        )
        f = f[mask]

    view = f.drop(columns=["fecha_dt"]).rename(columns={
        "fecha": "Fecha movimiento",
        "fecha_impacto_stock": "Fecha impacto stock",
        "deposito": "Depósito",
        "grupo": "Grupo",
        "tipo_filtro": "Tipo",
        "item": "Producto / Insumo",
        "cantidad": "Cantidad",
        "unidad": "Unidad",
        "batchs_origen": "Batchs origen",
        "numero_comanda": "N° comanda",
        "lote": "Lote",
        "observacion": "Observación",
        "origen": "Origen",
        "cargado_el": "Cargado el",
    })
    st.markdown(f"### Movimientos encontrados: {len(view)}")
    st.dataframe(view, use_container_width=True, hide_index=True)

    st.markdown("---")
    st.markdown("### Modificar despacho cargado con error")
    st.caption("No se borra el historial: cada corrección queda registrada en un log interno de modificaciones.")
    desp = dispatch_movements_df()
    if desp.empty:
        st.caption("Todavía no hay despachos cargados para modificar.")
    else:
        d1, d2 = st.columns([2, 2])
        with d1:
            desp_search = st.text_input("Buscar despacho por comanda, producto o lote", key="edit_desp_search")
        with d2:
            dep_edit_filter = st.selectbox("Depósito", ["Todos"] + DEPOSITS, key="edit_desp_dep")
        desp_view = desp.copy()
        if dep_edit_filter != "Todos":
            desp_view = desp_view[desp_view["deposito"] == dep_edit_filter]
        if desp_search:
            mask = (
                desp_view["numero_comanda"].astype(str).str.contains(desp_search, case=False, na=False)
                | desp_view["producto"].astype(str).str.contains(desp_search, case=False, na=False)
                | desp_view["lote"].astype(str).str.contains(desp_search, case=False, na=False)
            )
            desp_view = desp_view[mask]
        st.dataframe(desp_view.head(100), use_container_width=True, hide_index=True)
        if not desp_view.empty:
            options = desp_view["id"].astype(int).tolist()
            selected_id = st.selectbox("Elegir ID de despacho a modificar", options, key="edit_desp_id")
            selected = desp.loc[desp["id"].astype(int) == int(selected_id)].iloc[0]
            products = get_products(True)[["id", "name"]].copy().sort_values("name")
            product_names = products["name"].tolist()
            default_product_idx = product_names.index(selected["producto"]) if selected["producto"] in product_names else 0
            e1, e2, e3 = st.columns([1, 1, 1])
            with e1:
                new_date = st.date_input("Fecha despacho", value=pd.to_datetime(selected["fecha"]).date(), key="edit_desp_date")
            with e2:
                new_deposit = st.selectbox("Depósito despacho", DEPOSITS, index=DEPOSITS.index(selected["deposito"]) if selected["deposito"] in DEPOSITS else 0, key="edit_desp_deposit")
            with e3:
                new_qty = st.number_input("Cantidad", min_value=0.0, step=1.0, value=float(selected["cantidad"] or 0), key="edit_desp_qty")
            e4, e5, e6 = st.columns([2, 1, 1])
            with e4:
                new_product = st.selectbox("Producto", product_names, index=default_product_idx, key="edit_desp_product")
            with e5:
                new_comanda = st.text_input("N° comanda / orden", value=str(selected["numero_comanda"] or ""), key="edit_desp_comanda")
            with e6:
                new_lote = st.text_input("Lote", value=str(selected["lote"] or ""), key="edit_desp_lote")
            new_note = st.text_input("Observación despacho", value=str(selected["observacion"] or ""), key="edit_desp_note")
            edit_reason = st.text_input("Motivo de la modificación", value="Corrección de carga de despacho", key="edit_desp_reason")
            if st.button("Guardar modificación de despacho", type="primary"):
                new_pid = int(products.loc[products["name"] == new_product, "id"].iloc[0])
                ok, msg = update_dispatch_movement(selected_id, new_date, new_deposit, new_pid, new_qty, new_comanda, new_lote, new_note, edit_reason)
                if ok:
                    set_flash(msg)
                    st.rerun()
                else:
                    st.error(msg)

        with st.expander("Ver log de modificaciones de despachos", expanded=False):
            log = dispatch_edit_log_df()
            st.dataframe(log.head(200), use_container_width=True, hide_index=True)



    st.markdown("---")
    st.markdown("### Deshacer movimientos")
    st.warning("Usá esta opción solo para corregir cargas erróneas. La app no borra el registro: lo marca como anulado y lo deja en el log de auditoría.")

    undo_tab1, undo_tab2, undo_tab3, undo_tab4, undo_tab5 = st.tabs([
        "Producto terminado", "Insumos", "Ventas Tiendanube", "Ventas particulares", "Log de anulaciones"
    ])

    with undo_tab1:
        prod_undo = active_product_movements_for_undo()
        if prod_undo.empty:
            st.caption("No hay movimientos activos de producto terminado para deshacer.")
        else:
            q = st.text_input("Buscar movimiento de producto", key="undo_prod_search")
            view_u = prod_undo.copy()
            if q:
                mask = view_u.apply(lambda r: q.lower() in " ".join(map(str, r.values)).lower(), axis=1)
                view_u = view_u[mask]
            st.dataframe(view_u.head(200), use_container_width=True, hide_index=True)
            if not view_u.empty:
                selected = st.selectbox("ID de movimiento de producto a deshacer", view_u["id"].astype(int).tolist(), key="undo_prod_id")
                reason = st.text_input("Motivo", value="Carga errónea / anulación manual", key="undo_prod_reason")
                st.caption("Impacto: si era producción, deja de sumar al stock real; si era despacho, deja de descontar; si era ajuste, se revierte del cálculo.")
                confirm = st.checkbox("Confirmo que quiero deshacer este movimiento", key="undo_prod_confirm")
                if st.button("Deshacer movimiento de producto", type="primary", disabled=not confirm):
                    ok, msg = undo_product_movement(selected, reason)
                    if ok:
                        set_flash(msg)
                        st.rerun()
                    else:
                        st.error(msg)

    with undo_tab2:
        sup_undo = active_supply_movements_for_undo()
        if sup_undo.empty:
            st.caption("No hay movimientos activos de insumos para deshacer.")
        else:
            q = st.text_input("Buscar movimiento de insumo", key="undo_sup_search")
            view_s = sup_undo.copy()
            if q:
                mask = view_s.apply(lambda r: q.lower() in " ".join(map(str, r.values)).lower(), axis=1)
                view_s = view_s[mask]
            st.dataframe(view_s.head(200), use_container_width=True, hide_index=True)
            if not view_s.empty:
                selected = st.selectbox("ID de movimiento de insumo a deshacer", view_s["id"].astype(int).tolist(), key="undo_sup_id")
                reason = st.text_input("Motivo", value="Carga errónea / anulación manual", key="undo_sup_reason")
                st.caption("Impacto: además de anular el movimiento, corrige el stock actual de insumos con el movimiento inverso.")
                confirm = st.checkbox("Confirmo que quiero deshacer este movimiento de insumo", key="undo_sup_confirm")
                if st.button("Deshacer movimiento de insumo", type="primary", disabled=not confirm):
                    ok, msg = undo_supply_movement(selected, reason)
                    if ok:
                        set_flash(msg)
                        st.rerun()
                    else:
                        st.error(msg)

    with undo_tab3:
        sales_undo = active_tiendanube_sales_for_undo()
        if sales_undo.empty:
            st.caption("No hay ventas Tiendanube activas para deshacer.")
        else:
            modo = st.radio("Qué querés deshacer", ["Una línea", "Una orden completa"], horizontal=True, key="undo_tn_mode")
            q = st.text_input("Buscar por orden, producto, SKU, cliente o depósito", key="undo_tn_search")
            view_t = sales_undo.copy()
            if q:
                mask = view_t.apply(lambda r: q.lower() in " ".join(map(str, r.values)).lower(), axis=1)
                view_t = view_t[mask]
            st.dataframe(view_t.head(300), use_container_width=True, hide_index=True)
            reason = st.text_input("Motivo", value="Venta importada/cargada por error", key="undo_tn_reason")
            if modo == "Una línea":
                if not view_t.empty:
                    selected = st.selectbox("ID de línea de venta a deshacer", view_t["id"].astype(int).tolist(), key="undo_tn_id")
                    st.caption("Impacto: esa línea deja de contar como venta pendiente y deja de afectar el stock disponible calculado.")
                    confirm = st.checkbox("Confirmo que quiero deshacer esta línea de venta", key="undo_tn_line_confirm")
                    if st.button("Deshacer línea Tiendanube", type="primary", disabled=not confirm):
                        ok, msg = undo_tiendanube_sale(selected, reason)
                        if ok:
                            set_flash(msg)
                            st.rerun()
                        else:
                            st.error(msg)
            else:
                orders = [x for x in view_t["numero_orden"].dropna().astype(str).unique().tolist() if x]
                if orders:
                    selected_order = st.selectbox("N° de orden/comanda a deshacer completa", orders, key="undo_tn_order")
                    st.caption("Impacto: se anulan todas las líneas activas de esa orden. No borra despachos; si también cargaste un despacho incorrecto, deshacelo en Producto terminado.")
                    confirm = st.checkbox("Confirmo que quiero deshacer esta orden completa", key="undo_tn_order_confirm")
                    if st.button("Deshacer orden Tiendanube completa", type="primary", disabled=not confirm):
                        ok, msg = undo_tiendanube_order(selected_order, reason)
                        if ok:
                            set_flash(msg)
                            st.rerun()
                        else:
                            st.error(msg)

    with undo_tab4:
        private_undo = active_private_sales_for_undo()
        if private_undo.empty:
            st.caption("No hay ventas particulares activas para deshacer.")
        else:
            modo = st.radio("Qué querés deshacer", ["Una línea", "Una comanda completa"], horizontal=True, key="undo_private_mode")
            q = st.text_input("Buscar venta particular", key="undo_private_search")
            view_p = private_undo.copy()
            if q:
                mask = view_p.apply(lambda r: q.lower() in " ".join(map(str, r.values)).lower(), axis=1)
                view_p = view_p[mask]
            st.dataframe(view_p.head(300), use_container_width=True, hide_index=True)
            reason = st.text_input("Motivo", value="Venta particular cargada por error", key="undo_private_reason")
            if modo == "Una línea":
                if not view_p.empty:
                    selected = st.selectbox("ID de línea de venta particular a deshacer", view_p["id"].astype(int).tolist(), key="undo_private_id")
                    st.caption("Impacto: esa línea deja de contar como venta pendiente y deja de afectar el stock disponible calculado.")
                    confirm = st.checkbox("Confirmo que quiero deshacer esta línea de venta particular", key="undo_private_line_confirm")
                    if st.button("Deshacer línea particular", type="primary", disabled=not confirm):
                        ok, msg = undo_private_sale(selected, reason)
                        if ok:
                            set_flash(msg)
                            st.rerun()
                        else:
                            st.error(msg)
            else:
                orders = [x for x in view_p["numero_comanda"].dropna().astype(str).unique().tolist() if x]
                if orders:
                    selected_order = st.selectbox("N° de comanda a deshacer completa", orders, key="undo_private_order")
                    confirm = st.checkbox("Confirmo que quiero deshacer esta comanda particular completa", key="undo_private_order_confirm")
                    if st.button("Deshacer comanda particular completa", type="primary", disabled=not confirm):
                        ok, msg = undo_private_order(selected_order, reason)
                        if ok:
                            set_flash(msg)
                            st.rerun()
                        else:
                            st.error(msg)

    with undo_tab5:
        log = undo_log_df()
        if log.empty:
            st.caption("Todavía no hay anulaciones registradas.")
        else:
            st.dataframe(log.head(300), use_container_width=True, hide_index=True)


def page_supply_stock():
    hero("Stock de insumos", "Visualizá y modificá stock de materia prima, bolsas, etiquetas, suplementos y otros insumos.")
    st.info("Esta pestaña modifica el stock actual de insumos. Cada cambio queda registrado como ajuste positivo o negativo en el historial de insumos.")
    df = current_supply_stock().rename(columns={"name": "insumo", "category": "categoria", "unit": "unidad"})
    if df.empty:
        st.warning("Todavía no hay insumos cargados.")
        return

    c1, c2, c3 = st.columns([2, 2, 1])
    with c1:
        search = st.text_input("Buscar insumo")
    with c2:
        categories = sorted(df["categoria"].dropna().unique().tolist())
        category_filter = st.multiselect("Filtrar categoría", categories, default=[])
    with c3:
        movement_date = st.date_input("Fecha ajuste", value=date.today())

    view = df.copy()
    if search:
        view = view[view["insumo"].astype(str).str.contains(search, case=False, na=False)]
    if category_filter:
        view = view[view["categoria"].isin(category_filter)]

    edited = st.data_editor(
        view,
        hide_index=True,
        use_container_width=True,
        column_config={
            "id": None,
            "insumo": st.column_config.TextColumn("Insumo", disabled=True),
            "categoria": st.column_config.TextColumn("Categoría", disabled=True),
            "unidad": st.column_config.TextColumn("Unidad", disabled=True),
            "stock_actual": st.column_config.NumberColumn("Stock actual", min_value=0.0, step=1.0),
            "actualizado_el": st.column_config.TextColumn("Actualizado", disabled=True),
        },
    )
    note = st.text_input("Observación del ajuste", value="Ajuste manual de stock de insumos")
    if st.button("Guardar cambios de stock de insumos", type="primary"):
        changed = set_supply_stock_with_adjustments(
            edited.rename(columns={"insumo": "name", "categoria": "category", "unidad": "unit"}),
            movement_date,
            note,
        )
        st.success(f"Stock de insumos actualizado. Cambios registrados: {changed}.")
        st.rerun()

    st.markdown("### Resumen por categoría")
    summary = df.groupby(["categoria", "unidad"], as_index=False).agg(
        items=("insumo", "count"),
        stock_total=("stock_actual", "sum"),
    ).rename(columns={"categoria": "Categoría", "unidad": "Unidad", "items": "Cantidad de insumos", "stock_total": "Stock total"})
    st.dataframe(summary, use_container_width=True, hide_index=True)

    st.markdown("### Últimos movimientos de insumos")
    movs = supply_movements_df().head(150)
    st.dataframe(movs, use_container_width=True, hide_index=True)

def page_traceability():
    hero("Trazabilidad", "Consultá despachos, lotes, comandas y transferencias entre depósitos de producto terminado.")
    tab_lote, tab_desp, tab_trans = st.tabs(["Lote terminado", "Despachos", "Transferencias entre depósitos"])

    with tab_lote:
        st.caption("Buscá un lote de producto terminado para reconstruir Producción → Batch MP → lotes de materia prima → Despachos.")
        qlote = st.text_input("Lote de producto terminado", key="trace_full_lote", placeholder="Ej: L250911")
        if qlote:
            prod = read_sql(
                """SELECT m.id AS movimiento_produccion, m.movement_date AS fecha_produccion, m.effective_date AS fecha_disponible,
                          p.name AS producto, m.quantity AS unidades_producidas, m.lote AS lote_terminado,
                          m.batch_mp_run_id, COALESCE(b.code,'') AS batch_mp, COALESCE(b.batch_count,0) AS batchs
                   FROM movements m JOIN products p ON p.id=m.product_id
                   LEFT JOIN batch_mp_runs b ON b.id=m.batch_mp_run_id
                   WHERE m.movement_type='produccion' AND COALESCE(m.is_undone,0)=0 AND m.lote LIKE ?
                   ORDER BY m.id DESC""", (f"%{qlote}%",)
            )
            if prod.empty:
                st.warning("No se encontró producción con ese lote.")
            else:
                st.markdown("#### Producción / lote terminado")
                st.dataframe(prod.drop(columns=["movimiento_produccion","batch_mp_run_id"]), use_container_width=True, hide_index=True)
                run_ids=[int(x) for x in prod["batch_mp_run_id"].dropna().tolist()]
                if run_ids:
                    items=pd.concat([batch_mp_run_items_df(rid) for rid in run_ids], ignore_index=True)
                    st.markdown("#### Materias primas utilizadas")
                    st.dataframe(items, use_container_width=True, hide_index=True)
                else:
                    st.info("Este lote de producción no tiene Batch MP vinculado (puede ser histórico anterior a esta función).")
                desp = read_sql(
                    """SELECT m.movement_date AS fecha_despacho, COALESCE(m.deposit,'') AS deposito,
                              COALESCE(m.numero_comanda,'') AS numero_comanda, p.name AS producto, m.quantity AS cantidad, m.lote
                       FROM movements m JOIN products p ON p.id=m.product_id
                       WHERE m.movement_type='despacho' AND COALESCE(m.is_undone,0)=0 AND m.lote LIKE ?
                       ORDER BY m.movement_date DESC, m.id DESC""", (f"%{qlote}%",)
                )
                st.markdown("#### Despachos de este lote")
                if desp.empty: st.caption("Todavía no hay despachos registrados para este lote.")
                else: st.dataframe(desp, use_container_width=True, hide_index=True)
                pid_trace = int(read_sql("SELECT product_id FROM movements WHERE id=?", (int(prod.iloc[0]["movimiento_produccion"]),)).iloc[0]["product_id"])
                stocklot=stock_by_lot_df(product_id=pid_trace)
                stocklot=stocklot[stocklot["lote"].str.contains(qlote,case=False,na=False)] if not stocklot.empty else stocklot
                if not stocklot.empty:
                    st.markdown("#### Stock actual trazable por lote")
                    st.dataframe(stocklot, use_container_width=True, hide_index=True)

    with tab_desp:
        df = read_sql(
            """
            SELECT m.movement_date AS fecha_despacho, COALESCE(m.deposit, '') AS deposito,
                   p.name AS producto, m.quantity AS cantidad,
                   COALESCE(m.numero_comanda, '') AS numero_comanda, COALESCE(m.lote, '') AS lote,
                   m.note AS observacion, m.created_at AS cargado_el
            FROM movements m
            JOIN products p ON p.id = m.product_id
            WHERE m.movement_type='despacho' AND COALESCE(m.is_undone,0) = 0
            ORDER BY date(m.movement_date) DESC, m.id DESC
            """
        )
        if df.empty:
            st.info("Todavía no hay despachos cargados.")
        else:
            c1, c2, c3, c4 = st.columns(4)
            with c1:
                deposito = st.multiselect("Filtrar depósito", DEPOSITS, default=[], key="trace_desp_deposito")
            with c2:
                producto = st.text_input("Filtrar producto", key="trace_desp_producto")
            with c3:
                comanda = st.text_input("Filtrar N° comanda", key="trace_desp_comanda")
            with c4:
                lote = st.text_input("Filtrar lote", key="trace_desp_lote")
            f = df.copy()
            if deposito:
                f = f[f["deposito"].isin(deposito)]
            if producto:
                f = f[f["producto"].str.contains(producto, case=False, na=False)]
            if comanda:
                f = f[f["numero_comanda"].str.contains(comanda, case=False, na=False)]
            if lote:
                f = f[f["lote"].str.contains(lote, case=False, na=False)]
            st.dataframe(f, use_container_width=True, hide_index=True)

    with tab_trans:
        st.caption("Cada transferencia se muestra en dos movimientos: salida del depósito origen y entrada al depósito destino. Ambos quedan vinculados por la misma referencia TRF.")
        tr = read_sql(
            """
            SELECT m.movement_date AS fecha, COALESCE(m.numero_comanda, '') AS referencia_transferencia,
                   CASE WHEN m.movement_type='transferencia_salida' THEN 'Salida origen' ELSE 'Entrada destino' END AS movimiento,
                   COALESCE(m.deposit, '') AS deposito,
                   p.name AS producto, m.quantity AS cantidad, COALESCE(m.lote, '') AS lote_referencia,
                   COALESCE(m.note, '') AS observacion, m.created_at AS cargado_el
            FROM movements m
            JOIN products p ON p.id = m.product_id
            WHERE m.movement_type IN ('transferencia_salida', 'transferencia_entrada')
              AND COALESCE(m.is_undone,0) = 0
            ORDER BY date(m.movement_date) DESC, referencia_transferencia DESC, p.name, movimiento DESC
            """
        )
        if tr.empty:
            st.info("Todavía no hay transferencias entre depósitos cargadas.")
        else:
            t1, t2, t3, t4 = st.columns(4)
            with t1:
                dep_t = st.multiselect("Filtrar depósito", DEPOSITS, default=[], key="trace_tr_deposito")
            with t2:
                prod_t = st.text_input("Filtrar producto", key="trace_tr_producto")
            with t3:
                ref_t = st.text_input("Filtrar referencia TRF", key="trace_tr_ref")
            with t4:
                lot_t = st.text_input("Filtrar lote / referencia", key="trace_tr_lote")
            ft = tr.copy()
            if dep_t:
                ft = ft[ft["deposito"].isin(dep_t)]
            if prod_t:
                ft = ft[ft["producto"].str.contains(prod_t, case=False, na=False)]
            if ref_t:
                ft = ft[ft["referencia_transferencia"].str.contains(ref_t, case=False, na=False)]
            if lot_t:
                ft = ft[ft["lote_referencia"].str.contains(lot_t, case=False, na=False)]
            st.dataframe(ft, use_container_width=True, hide_index=True)

            st.markdown("### Resumen de transferencias")
            resumen = ft.groupby(["fecha", "referencia_transferencia", "producto", "lote_referencia"], as_index=False).agg(
                cantidad=("cantidad", "max"),
                origen=("deposito", lambda x: " / ".join(sorted(set(x))))
            )
            resumen = resumen.rename(columns={"origen": "Depósitos involucrados", "cantidad": "Cantidad"})
            st.dataframe(resumen, use_container_width=True, hide_index=True)

def page_supplies():
    hero("Stock de insumos", "Cargá stock de materia prima, bolsas y etiquetas para planificar producción.")
    st.markdown("### Agregar insumo")
    c1, c2, c3 = st.columns([3, 2, 1])
    with c1:
        new_name = st.text_input("Nombre del insumo")
    with c2:
        new_cat = st.selectbox("Categoría", ["Materia prima", "Bolsa", "Etiqueta dieta", "Etiqueta caja", "Etiqueta jerky", "Etiqueta", "Suplemento", "Otro"])
    with c3:
        new_unit = st.text_input("Unidad", value="kg")
    if st.button("Agregar / actualizar insumo"):
        ok, msg = add_supply(new_name, new_cat, new_unit)
        if ok:
            st.success(msg)
            st.rerun()
        else:
            st.error(msg)

    st.info("Las etiquetas de dietas y de cajas están separadas por dieta y presentación. Ejemplo: ETIQUETA PV500 y ETIQUETA CAJA PV500.")

    st.markdown("### Stock actual de insumos")
    df = current_supply_stock().rename(columns={"name": "insumo", "category": "categoria", "unit": "unidad"})
    category_filter = st.multiselect("Filtrar categoría", sorted(df["categoria"].dropna().unique().tolist()), default=[])
    view = df.copy()
    if category_filter:
        view = view[view["categoria"].isin(category_filter)]
    edited = st.data_editor(
        view,
        hide_index=True,
        use_container_width=True,
        column_config={
            "id": None,
            "insumo": st.column_config.TextColumn("Insumo", disabled=True),
            "categoria": st.column_config.TextColumn("Categoría", disabled=True),
            "unidad": st.column_config.TextColumn("Unidad", disabled=True),
            "stock_actual": st.column_config.NumberColumn("Stock actual", min_value=0.0, step=1.0),
            "actualizado_el": st.column_config.TextColumn("Actualizado", disabled=True),
        },
    )
    if st.button("Guardar stock de insumos"):
        changed = set_supply_stock_with_adjustments(edited.rename(columns={"insumo": "name", "categoria": "category", "unidad": "unit"}), date.today(), "Ajuste manual desde pestaña Insumos")
        st.success(f"Stock de insumos guardado. Cambios registrados: {changed}.")
        st.rerun()

    st.markdown("### Ingresos diarios de insumos")
