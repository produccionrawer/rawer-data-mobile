def ensure_dirs():
    DATA_DIR.mkdir(parents=True, exist_ok=True)
    BACKUP_DIR.mkdir(parents=True, exist_ok=True)
    EXPORT_DIR.mkdir(parents=True, exist_ok=True)


def db_exists():
    return DB_PATH.exists()


def backup_db(reason="manual"):
    ensure_dirs()
    if not DB_PATH.exists():
        return None
    stamp = datetime.now().strftime("%Y%m%d_%H%M%S")
    safe_reason = re.sub(r"[^A-Za-z0-9_-]+", "_", str(reason).strip())[:30] or "backup"
    dest = BACKUP_DIR / f"rawer_data_backup_{stamp}_{safe_reason}.db"
    shutil.copy2(DB_PATH, dest)
    return dest


def automatic_daily_backup():
    ensure_dirs()
    if not DB_PATH.exists():
        return None
    today = date.today().strftime("%Y%m%d")
    existing = list(BACKUP_DIR.glob(f"rawer_data_backup_{today}_*_auto.db"))
    if existing:
        return existing[0]
    return backup_db("auto")


def migrate_database_to_base_dir(new_base_dir):
    new_base_dir = Path(new_base_dir).expanduser()
    new_data_dir = new_base_dir / "data"
    new_backup_dir = new_base_dir / "backups"
    new_data_dir.mkdir(parents=True, exist_ok=True)
    new_backup_dir.mkdir(parents=True, exist_ok=True)
    new_db = new_data_dir / "rawer_data.db"
    if DB_PATH.exists():
        # Backup local antes de migrar y copia hacia la nueva ubicación.
        backup_db("before_migrate")
        if new_db.exists():
            stamp = datetime.now().strftime("%Y%m%d_%H%M%S")
            shutil.copy2(new_db, new_backup_dir / f"rawer_data_backup_{stamp}_before_replace.db")
        shutil.copy2(DB_PATH, new_db)
    save_app_settings({"base_dir": str(new_base_dir)})
    return new_db


def get_conn():
    ensure_dirs()
    conn = sqlite3.connect(DB_PATH)
    conn.row_factory = sqlite3.Row
    return conn


def table_columns(conn, table):
    return [r[1] for r in conn.execute(f"PRAGMA table_info({table})").fetchall()]




def merge_supply_alias(conn, source_name, target_name):
    """Unifica dos insumos equivalentes sin borrar historial.

    Si existen ambos, mueve recetas, stock, movimientos, costos y precios por proveedor
    desde source_name hacia target_name y deja source_name inactivo. Si solo existe el
    source, lo renombra al target.
    """
    cur = conn.cursor()
    src = cur.execute("SELECT id, category, unit FROM supplies WHERE name = ?", (source_name,)).fetchone()
    tgt = cur.execute("SELECT id, category, unit FROM supplies WHERE name = ?", (target_name,)).fetchone()
    now = datetime.now().isoformat(timespec="seconds")
    if not src:
        return
    if not tgt:
        cur.execute("UPDATE supplies SET name = ?, active = 1 WHERE id = ?", (target_name, src["id"]))
        return
    src_id = int(src["id"])
    tgt_id = int(tgt["id"])
    if src_id == tgt_id:
        cur.execute("UPDATE supplies SET active = 1 WHERE id = ?", (tgt_id,))
        return

    # Recetas: si el producto ya tenia ambos insumos, sumar cantidades en el insumo destino.
    rows = cur.execute("SELECT product_id, quantity_per_batch FROM product_recipes WHERE supply_id = ?", (src_id,)).fetchall()
    for r in rows:
        existing = cur.execute(
            "SELECT quantity_per_batch FROM product_recipes WHERE product_id = ? AND supply_id = ?",
            (r["product_id"], tgt_id),
        ).fetchone()
        if existing:
            cur.execute(
                "UPDATE product_recipes SET quantity_per_batch = ? WHERE product_id = ? AND supply_id = ?",
                (float(existing["quantity_per_batch"] or 0) + float(r["quantity_per_batch"] or 0), r["product_id"], tgt_id),
            )
            cur.execute("DELETE FROM product_recipes WHERE product_id = ? AND supply_id = ?", (r["product_id"], src_id))
        else:
            cur.execute("UPDATE product_recipes SET supply_id = ? WHERE product_id = ? AND supply_id = ?", (tgt_id, r["product_id"], src_id))

    # Stock: sumar stock del alias al insumo destino.
    src_stock = cur.execute("SELECT quantity FROM supply_stock WHERE supply_id = ?", (src_id,)).fetchone()
    if src_stock:
        tgt_stock = cur.execute("SELECT quantity FROM supply_stock WHERE supply_id = ?", (tgt_id,)).fetchone()
        if tgt_stock:
            cur.execute(
                "UPDATE supply_stock SET quantity = ?, updated_at = ? WHERE supply_id = ?",
                (float(tgt_stock["quantity"] or 0) + float(src_stock["quantity"] or 0), now, tgt_id),
            )
            cur.execute("DELETE FROM supply_stock WHERE supply_id = ?", (src_id,))
        else:
            cur.execute("UPDATE supply_stock SET supply_id = ?, updated_at = ? WHERE supply_id = ?", (tgt_id, now, src_id))

    # Movimientos y costos: conservar historial apuntando al insumo unificado.
    cur.execute("UPDATE supply_movements SET supply_id = ? WHERE supply_id = ?", (tgt_id, src_id))
    cur.execute("UPDATE supply_costs SET supply_id = ? WHERE supply_id = ?", (tgt_id, src_id))

    # Precios por proveedor: respetar unicidad proveedor+insumo.
    price_rows = cur.execute("SELECT * FROM supplier_supply_prices WHERE supply_id = ?", (src_id,)).fetchall()
    for r in price_rows:
        existing = cur.execute(
            "SELECT id, updated_at FROM supplier_supply_prices WHERE supplier_id = ? AND supply_id = ?",
            (r["supplier_id"], tgt_id),
        ).fetchone()
        if existing:
            # Si el precio del alias es mas reciente, pisar el precio destino.
            if str(r["updated_at"] or "") >= str(existing["updated_at"] or ""):
                cur.execute(
                    """
                    UPDATE supplier_supply_prices
                    SET price_unit = ?, entry_day = ?, note = ?, active = ?, updated_at = ?
                    WHERE id = ?
                    """,
                    (r["price_unit"], r["entry_day"], r["note"], r["active"], r["updated_at"] or now, existing["id"]),
                )
            cur.execute("DELETE FROM supplier_supply_prices WHERE id = ?", (r["id"],))
        else:
            cur.execute("UPDATE supplier_supply_prices SET supply_id = ?, updated_at = ? WHERE id = ?", (tgt_id, now, r["id"]))

    # Mantener el alias inactivo para no perder referencia visual si quedo algo historico externo.
    cur.execute("UPDATE supplies SET active = 0, category = category, unit = unit WHERE id = ?", (src_id,))
    cur.execute("UPDATE supplies SET active = 1 WHERE id = ?", (tgt_id,))

def init_db():
    conn = get_conn()
    cur = conn.cursor()
    cur.execute(
        """
        CREATE TABLE IF NOT EXISTS products (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            name TEXT NOT NULL UNIQUE,
            days_to_stock INTEGER NOT NULL DEFAULT 0,
            active INTEGER NOT NULL DEFAULT 1,
            created_at TEXT NOT NULL
        )
        """
    )
    # migrate old DB if needed
    cols = table_columns(conn, "products")
    if "days_to_stock" not in cols:
        cur.execute("ALTER TABLE products ADD COLUMN days_to_stock INTEGER NOT NULL DEFAULT 0")
    if "active" not in cols:
        cur.execute("ALTER TABLE products ADD COLUMN active INTEGER NOT NULL DEFAULT 1")
    if "created_at" not in cols:
        cur.execute("ALTER TABLE products ADD COLUMN created_at TEXT")
        cur.execute("UPDATE products SET created_at = ? WHERE created_at IS NULL", (datetime.now().isoformat(timespec="seconds"),))

    cur.execute(
        """
        CREATE TABLE IF NOT EXISTS initial_stock (
            product_id INTEGER PRIMARY KEY,
            quantity REAL NOT NULL DEFAULT 0,
            updated_at TEXT NOT NULL,
            FOREIGN KEY(product_id) REFERENCES products(id)
        )
        """
    )
    cur.execute(
        """
        CREATE TABLE IF NOT EXISTS movements (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            movement_date TEXT NOT NULL,
            product_id INTEGER NOT NULL,
            movement_type TEXT NOT NULL,
            quantity REAL NOT NULL,
            effective_date TEXT,
            note TEXT,
            source TEXT NOT NULL DEFAULT 'manual',
            created_at TEXT NOT NULL,
            FOREIGN KEY(product_id) REFERENCES products(id)
        )
        """
    )
    cols = table_columns(conn, "movements")
    if "effective_date" not in cols:
        cur.execute("ALTER TABLE movements ADD COLUMN effective_date TEXT")
        cur.execute("UPDATE movements SET effective_date = movement_date WHERE effective_date IS NULL")
    if "numero_comanda" not in cols:
        cur.execute("ALTER TABLE movements ADD COLUMN numero_comanda TEXT")
    if "lote" not in cols:
        cur.execute("ALTER TABLE movements ADD COLUMN lote TEXT")
    if "deposit" not in cols:
        cur.execute("ALTER TABLE movements ADD COLUMN deposit TEXT")
        cur.execute("UPDATE movements SET deposit = ? WHERE deposit IS NULL OR deposit = ''", (DEFAULT_DEPOSIT,))
    if "is_undone" not in cols:
        cur.execute("ALTER TABLE movements ADD COLUMN is_undone INTEGER NOT NULL DEFAULT 0")
    if "undone_at" not in cols:
        cur.execute("ALTER TABLE movements ADD COLUMN undone_at TEXT")
    if "undo_reason" not in cols:
        cur.execute("ALTER TABLE movements ADD COLUMN undo_reason TEXT")

    cur.execute(
        """
        CREATE TABLE IF NOT EXISTS initial_stock_deposit (
            product_id INTEGER NOT NULL,
            deposit TEXT NOT NULL,
            quantity REAL NOT NULL DEFAULT 0,
            updated_at TEXT NOT NULL,
            PRIMARY KEY(product_id, deposit),
            FOREIGN KEY(product_id) REFERENCES products(id)
        )
        """
    )
    # Migrate old one-deposit stock to Planta if the new table is empty.
    try:
        count_new = cur.execute("SELECT COUNT(*) FROM initial_stock_deposit").fetchone()[0]
        if count_new == 0:
            old_rows = cur.execute("SELECT product_id, quantity, updated_at FROM initial_stock").fetchall()
            for r in old_rows:
                cur.execute(
                    "INSERT OR IGNORE INTO initial_stock_deposit(product_id, deposit, quantity, updated_at) VALUES (?, ?, ?, ?)",
                    (r[0], DEFAULT_DEPOSIT, r[1], r[2] or datetime.now().isoformat(timespec="seconds")),
                )
    except Exception:
        pass

    cur.execute(
        """
        CREATE TABLE IF NOT EXISTS available_stock_deposit (
            stock_date TEXT NOT NULL,
            product_id INTEGER NOT NULL,
            deposit TEXT NOT NULL,
            quantity REAL NOT NULL DEFAULT 0,
            note TEXT,
            created_at TEXT NOT NULL,
            updated_at TEXT NOT NULL,
            PRIMARY KEY(stock_date, product_id, deposit),
            FOREIGN KEY(product_id) REFERENCES products(id)
        )
        """
    )
    # Migrate old available stock snapshots to Planta if the new table is empty.
    try:
        count_av = cur.execute("SELECT COUNT(*) FROM available_stock_deposit").fetchone()[0]
        if count_av == 0:
            old_rows = cur.execute("SELECT stock_date, product_id, quantity, note, created_at, updated_at FROM available_stock_snapshots").fetchall()
            for r in old_rows:
                cur.execute(
                    "INSERT OR IGNORE INTO available_stock_deposit(stock_date, product_id, deposit, quantity, note, created_at, updated_at) VALUES (?, ?, ?, ?, ?, ?, ?)",
                    (r[0], r[1], DEFAULT_DEPOSIT, r[2], r[3], r[4], r[5]),
                )
    except Exception:
        pass

    cur.execute(
        """
        CREATE TABLE IF NOT EXISTS available_stock_snapshots (
            stock_date TEXT NOT NULL,
            product_id INTEGER NOT NULL,
            quantity REAL NOT NULL DEFAULT 0,
            note TEXT,
            created_at TEXT NOT NULL,
            updated_at TEXT NOT NULL,
            PRIMARY KEY(stock_date, product_id),
            FOREIGN KEY(product_id) REFERENCES products(id)
        )
        """
    )

    cur.execute(
        """
        CREATE TABLE IF NOT EXISTS supplies (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            name TEXT NOT NULL UNIQUE,
            category TEXT NOT NULL,
            unit TEXT NOT NULL,
            active INTEGER NOT NULL DEFAULT 1,
            created_at TEXT NOT NULL
        )
        """
    )
    cur.execute(
        """
        CREATE TABLE IF NOT EXISTS supply_stock (
            supply_id INTEGER PRIMARY KEY,
            quantity REAL NOT NULL DEFAULT 0,
            updated_at TEXT NOT NULL,
            FOREIGN KEY(supply_id) REFERENCES supplies(id)
        )
        """
    )
    cur.execute(
        """
        CREATE TABLE IF NOT EXISTS supply_movements (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            movement_date TEXT NOT NULL,
            supply_id INTEGER NOT NULL,
            movement_type TEXT NOT NULL,
            quantity REAL NOT NULL,
            note TEXT,
            source TEXT NOT NULL DEFAULT 'manual',
            created_at TEXT NOT NULL,
            FOREIGN KEY(supply_id) REFERENCES supplies(id)
        )
        """
    )
    supply_cols = table_columns(conn, "supply_movements")
    if "is_undone" not in supply_cols:
        cur.execute("ALTER TABLE supply_movements ADD COLUMN is_undone INTEGER NOT NULL DEFAULT 0")
    if "undone_at" not in supply_cols:
        cur.execute("ALTER TABLE supply_movements ADD COLUMN undone_at TEXT")
    if "undo_reason" not in supply_cols:
        cur.execute("ALTER TABLE supply_movements ADD COLUMN undo_reason TEXT")
    if "proveedor" not in supply_cols:
        cur.execute("ALTER TABLE supply_movements ADD COLUMN proveedor TEXT")
    if "lote_materia_prima" not in supply_cols:
        cur.execute("ALTER TABLE supply_movements ADD COLUMN lote_materia_prima TEXT")
    if "batch_mp_run_id" not in supply_cols:
        cur.execute("ALTER TABLE supply_movements ADD COLUMN batch_mp_run_id INTEGER")

    # Trazabilidad Batch MP -> produccion -> lote terminado.
    cur.execute(
        """
        CREATE TABLE IF NOT EXISTS batch_mp_runs (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            code TEXT UNIQUE,
            batch_date TEXT NOT NULL,
            product_id INTEGER NOT NULL,
            batch_count REAL NOT NULL,
            status TEXT NOT NULL DEFAULT 'Pendiente de produccion',
            note TEXT,
            linked_production_movement_id INTEGER,
            created_at TEXT NOT NULL,
            linked_at TEXT,
            FOREIGN KEY(product_id) REFERENCES products(id)
        )
        """
    )
    cur.execute(
        """
        CREATE TABLE IF NOT EXISTS batch_mp_run_items (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            batch_mp_run_id INTEGER NOT NULL,
            supply_id INTEGER NOT NULL,
            quantity REAL NOT NULL,
            lote_materia_prima TEXT,
            created_at TEXT NOT NULL,
            FOREIGN KEY(batch_mp_run_id) REFERENCES batch_mp_runs(id),
            FOREIGN KEY(supply_id) REFERENCES supplies(id)
        )
        """
    )
    cur.execute("CREATE INDEX IF NOT EXISTS idx_batch_mp_runs_date_product ON batch_mp_runs(batch_date, product_id, status)")
    cur.execute("CREATE INDEX IF NOT EXISTS idx_batch_mp_items_run ON batch_mp_run_items(batch_mp_run_id)")

    mov_cols = table_columns(conn, "movements")
    if "batch_mp_run_id" not in mov_cols:
        cur.execute("ALTER TABLE movements ADD COLUMN batch_mp_run_id INTEGER")
    # Índice para consultas de stock y trazabilidad por lote.
    cur.execute("CREATE INDEX IF NOT EXISTS idx_movements_lote_stock ON movements(product_id, lote, deposit, effective_date)")

    cur.execute(
        """
        CREATE TABLE IF NOT EXISTS product_recipes (
            product_id INTEGER NOT NULL,
            supply_id INTEGER NOT NULL,
            quantity_per_batch REAL NOT NULL,
            PRIMARY KEY(product_id, supply_id),
            FOREIGN KEY(product_id) REFERENCES products(id),
            FOREIGN KEY(supply_id) REFERENCES supplies(id)
        )
        """
    )
    cur.execute(
        """
        CREATE TABLE IF NOT EXISTS supply_costs (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            supply_id INTEGER NOT NULL,
            cost_date TEXT NOT NULL,
            cost_unit REAL NOT NULL DEFAULT 0,
            includes_tax INTEGER NOT NULL DEFAULT 1,
            supplier TEXT,
            note TEXT,
            created_at TEXT NOT NULL,
            FOREIGN KEY(supply_id) REFERENCES supplies(id)
        )
        """
    )
    cur.execute("CREATE INDEX IF NOT EXISTS idx_supply_costs_supply_date ON supply_costs(supply_id, cost_date)")

    cur.execute(
        """
        CREATE TABLE IF NOT EXISTS suppliers (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            name TEXT NOT NULL UNIQUE,
            notes TEXT,
            active INTEGER NOT NULL DEFAULT 1,
            created_at TEXT NOT NULL,
            updated_at TEXT NOT NULL
        )
        """
    )
    cur.execute(
        """
        CREATE TABLE IF NOT EXISTS supplier_supply_prices (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            supplier_id INTEGER NOT NULL,
            supply_id INTEGER NOT NULL,
            price_unit REAL NOT NULL DEFAULT 0,
            entry_day TEXT,
            note TEXT,
            active INTEGER NOT NULL DEFAULT 1,
            created_at TEXT NOT NULL,
            updated_at TEXT NOT NULL,
            UNIQUE(supplier_id, supply_id),
            FOREIGN KEY(supplier_id) REFERENCES suppliers(id),
            FOREIGN KEY(supply_id) REFERENCES supplies(id)
        )
        """
    )

    cur.execute(
        """
        CREATE TABLE IF NOT EXISTS app_settings (
            key TEXT PRIMARY KEY,
            value TEXT,
            updated_at TEXT NOT NULL
        )
        """
    )
    cur.execute(
        """
        CREATE TABLE IF NOT EXISTS tiendanube_sales (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            order_id TEXT NOT NULL,
            order_number TEXT,
            order_created_at TEXT,
            imported_at TEXT NOT NULL,
            sku TEXT,
            product_name_tn TEXT,
            product_id INTEGER,
            product_name_rawer TEXT,
            quantity REAL NOT NULL,
            payment_status TEXT,
            order_status TEXT,
            shipping_status TEXT,
            customer_name TEXT,
            customer_email TEXT,
            raw_json TEXT,
            UNIQUE(order_id, sku, product_name_tn)
        )
        """
    )
    # Migración ventas Tiendanube: columnas para ventas individuales y combos desglosados.
    try:
        existing_cols = [r[1] for r in cur.execute("PRAGMA table_info(tiendanube_sales)").fetchall()]
        for col_name, col_type in [
            ("sale_type", "TEXT"),
            ("combo_sku", "TEXT"),
            ("combo_name", "TEXT"),
            ("sale_deposit", "TEXT"),
            ("delivery_date_tn", "TEXT"),
            ("delivery_hint", "TEXT"),
            ("tn_location_id", "TEXT"),
            ("tn_location_name", "TEXT"),
            ("tn_distribution_center", "TEXT"),
            ("deposit_source", "TEXT"),
            ("is_undone", "INTEGER NOT NULL DEFAULT 0"),
            ("undone_at", "TEXT"),
            ("undo_reason", "TEXT"),
        ]:
            if col_name not in existing_cols:
                cur.execute(f"ALTER TABLE tiendanube_sales ADD COLUMN {col_name} {col_type}")
        cur.execute("UPDATE tiendanube_sales SET sale_deposit = ? WHERE sale_deposit IS NULL OR sale_deposit = ''", (DEFAULT_DEPOSIT,))
    except Exception:
        pass

    cur.execute(
        """
        CREATE TABLE IF NOT EXISTS combo_skus (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            combo_sku TEXT NOT NULL UNIQUE,
            combo_name TEXT NOT NULL,
            active INTEGER NOT NULL DEFAULT 1,
            created_at TEXT NOT NULL,
            updated_at TEXT NOT NULL
        )
        """
    )
    cur.execute(
        """
        CREATE TABLE IF NOT EXISTS combo_components (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            combo_id INTEGER NOT NULL,
            product_id INTEGER NOT NULL,
            component_sku TEXT,
            quantity_per_combo REAL NOT NULL DEFAULT 1,
            active INTEGER NOT NULL DEFAULT 1,
            created_at TEXT NOT NULL,
            updated_at TEXT NOT NULL,
            FOREIGN KEY(combo_id) REFERENCES combo_skus(id),
            FOREIGN KEY(product_id) REFERENCES products(id)
        )
        """
    )
    cur.execute("CREATE INDEX IF NOT EXISTS idx_combo_skus_sku ON combo_skus(combo_sku)")

    cur.execute(
        """
        CREATE TABLE IF NOT EXISTS tiendanube_location_map (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            tn_location_id TEXT NOT NULL UNIQUE,
            tn_location_name TEXT,
            rawer_deposit TEXT NOT NULL,
            active INTEGER NOT NULL DEFAULT 1,
            created_at TEXT NOT NULL,
            updated_at TEXT NOT NULL
        )
        """
    )
    cur.execute("CREATE INDEX IF NOT EXISTS idx_tn_location_map_location ON tiendanube_location_map(tn_location_id)")
    cur.execute("CREATE INDEX IF NOT EXISTS idx_combo_components_combo ON combo_components(combo_id)")


    cur.execute(
        """
        CREATE TABLE IF NOT EXISTS private_sales (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            sale_date TEXT NOT NULL,
            order_number TEXT NOT NULL,
            customer_name TEXT,
            sale_deposit TEXT NOT NULL,
            product_id INTEGER NOT NULL,
            product_name TEXT,
            quantity REAL NOT NULL,
            delivery_date TEXT,
            note TEXT,
            source TEXT NOT NULL DEFAULT 'venta_particular',
            is_undone INTEGER NOT NULL DEFAULT 0,
            undone_at TEXT,
            undo_reason TEXT,
            created_at TEXT NOT NULL,
            FOREIGN KEY(product_id) REFERENCES products(id)
        )
        """
    )
    private_cols = table_columns(conn, "private_sales")
    for col_name, col_type in [
        ("delivery_date", "TEXT"),
        ("note", "TEXT"),
        ("source", "TEXT NOT NULL DEFAULT 'venta_particular'"),
        ("is_undone", "INTEGER NOT NULL DEFAULT 0"),
        ("undone_at", "TEXT"),
        ("undo_reason", "TEXT"),
        # Columnas para importación mayorista desde EcommApp / presupuesto negocio físico.
        ("external_key", "TEXT"),
        ("original_sku", "TEXT"),
        ("ecommapp_estado", "TEXT"),
        ("ecommapp_estado_registro", "TEXT"),
        ("ecommapp_impacto_stock", "TEXT"),
        ("importe_total", "REAL"),
    ]:
        if col_name not in private_cols:
            cur.execute(f"ALTER TABLE private_sales ADD COLUMN {col_name} {col_type}")
    cur.execute("CREATE INDEX IF NOT EXISTS idx_private_sales_external_key ON private_sales(external_key)")
    cur.execute("CREATE INDEX IF NOT EXISTS idx_private_sales_order ON private_sales(order_number)")
    cur.execute("CREATE INDEX IF NOT EXISTS idx_private_sales_date ON private_sales(sale_date)")
    cur.execute("CREATE INDEX IF NOT EXISTS idx_private_sales_product ON private_sales(product_id)")

    cur.execute(
        """
        CREATE TABLE IF NOT EXISTS dispatch_edit_log (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            movement_id INTEGER NOT NULL,
            edited_at TEXT NOT NULL,
            edit_reason TEXT,
            old_values TEXT NOT NULL,
            new_values TEXT NOT NULL,
            FOREIGN KEY(movement_id) REFERENCES movements(id)
        )
        """
    )

    cur.execute("CREATE INDEX IF NOT EXISTS idx_tn_sales_order ON tiendanube_sales(order_id)")
    cur.execute("CREATE INDEX IF NOT EXISTS idx_tn_sales_date ON tiendanube_sales(order_created_at)")
    cur.execute("CREATE INDEX IF NOT EXISTS idx_mov_date ON movements(movement_date)")
    cur.execute("CREATE INDEX IF NOT EXISTS idx_mov_eff ON movements(effective_date)")
    cur.execute("CREATE INDEX IF NOT EXISTS idx_mov_product ON movements(product_id)")
    cur.execute("CREATE INDEX IF NOT EXISTS idx_avail_date ON available_stock_snapshots(stock_date)")
    cur.execute("CREATE INDEX IF NOT EXISTS idx_mov_deposit ON movements(deposit)")
    cur.execute("CREATE INDEX IF NOT EXISTS idx_avail_dep_date ON available_stock_deposit(stock_date, deposit)")
    cur.execute("CREATE INDEX IF NOT EXISTS idx_supply_mov_date ON supply_movements(movement_date)")
    cur.execute("CREATE INDEX IF NOT EXISTS idx_supply_mov_supply ON supply_movements(supply_id)")

    # Historial auditable de planificaciones semanales. Cada guardado crea una versión nueva.
    cur.execute(
        """
        CREATE TABLE IF NOT EXISTS weekly_planning_history (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            planning_date TEXT NOT NULL,
            week_start TEXT,
            note TEXT,
            diet_plan_json TEXT NOT NULL DEFAULT '[]',
            dehydrator_plan_json TEXT NOT NULL DEFAULT '[]',
            provider_order_json TEXT NOT NULL DEFAULT '[]',
            total_diet_batches REAL NOT NULL DEFAULT 0,
            total_dehydrator_units REAL NOT NULL DEFAULT 0,
            estimated_purchase_cost REAL NOT NULL DEFAULT 0,
            created_at TEXT NOT NULL
        )
        """
    )
    cur.execute("CREATE INDEX IF NOT EXISTS idx_weekly_planning_history_week ON weekly_planning_history(week_start, planning_date)")

    cur.execute(
        """
        CREATE TABLE IF NOT EXISTS app_meta (
            key TEXT PRIMARY KEY,
            value TEXT NOT NULL,
            updated_at TEXT NOT NULL
        )
        """
    )

    now = datetime.now().isoformat(timespec="seconds")
    for name, days in DEFAULT_PRODUCTS:
        cur.execute(
            "INSERT OR IGNORE INTO products(name, days_to_stock, active, created_at) VALUES (?, ?, 1, ?)",
            (name, days, now),
        )
        cur.execute("UPDATE products SET days_to_stock = ? WHERE name = ? AND (days_to_stock IS NULL OR days_to_stock = 0)", (days, name))

    for supply_name, category, unit in DEFAULT_SUPPLIES:
        cur.execute(
            "INSERT OR IGNORE INTO supplies(name, category, unit, active, created_at) VALUES (?, ?, ?, 1, ?)",
            (supply_name, category, unit, now),
        )

    product_ids = {r["name"]: r["id"] for r in cur.execute("SELECT id, name FROM products").fetchall()}
    supply_ids = {r["name"]: r["id"] for r in cur.execute("SELECT id, name FROM supplies").fetchall()}

    # Migración: unificar alias de insumos.
    # PICADA SUPREMA y SUPREMA PICADA son el mismo insumo.
    merge_supply_alias(conn, "PICADA SUPREMA", "SUPREMA PICADA")
    supply_ids = {r["name"]: r["id"] for r in cur.execute("SELECT id, name FROM supplies").fetchall()}

    # Migración: las etiquetas genéricas ya no se usan en recetas.
    # Ahora cada etiqueta de dieta y de caja queda separada por dieta/presentación.
    generic_label_names = ("ETIQUETA DIETA PERRO", "ETIQUETA DIETA GATO/TRANSICION", "ETIQUETA CAJA")
    generic_label_ids = [supply_ids[n] for n in generic_label_names if n in supply_ids]
    if generic_label_ids:
        placeholders = ",".join(["?"] * len(generic_label_ids))
        cur.execute(f"DELETE FROM product_recipes WHERE supply_id IN ({placeholders})", generic_label_ids)
        cur.execute(f"UPDATE supplies SET active = 0 WHERE id IN ({placeholders})", generic_label_ids)

    for product_name, recipe in BATCH_RECIPES.items():
        pid = product_ids.get(product_name)
        if not pid:
            continue
        for supply_name, qty in recipe.items():
            sid = supply_ids.get(supply_name)
            if not sid:
                continue
            # No pisar recetas modificadas por el usuario.
            # Las recetas base se cargan solo si ese producto/insumo todavia no existe.
            cur.execute(
                """
                INSERT OR IGNORE INTO product_recipes(product_id, supply_id, quantity_per_batch)
                VALUES (?, ?, ?)
                """,
                (pid, sid, float(qty)),
            )

    # Migración operativa: nuevas recetas de dietas perro/gato.
    # Se aplica una sola vez y reemplaza las composiciones anteriores de las dietas vigentes.
    migration_key = "recipes_dietas_nuevas_20260827_v1"
    already = cur.execute("SELECT value FROM app_meta WHERE key = ?", (migration_key,)).fetchone()
    if not already:
        cur.execute("UPDATE supplies SET unit = 'ml' WHERE name = 'ACEITE DE OLIVA'")
        cur.execute("UPDATE supplies SET unit = 'kg' WHERE name = 'NUTRILEVA'")
        cur.execute("UPDATE supplies SET unit = 'g' WHERE name = 'LINAZA'")
        # Desactivar presentaciones de perro que ya no se trabajan. No se borran para conservar historial.
        for inactive_product in ("PERRO VACA 715", "PERRO POLLO 715", "PERRO PESCADO 715"):
            cur.execute("UPDATE products SET active = 0 WHERE name = ?", (inactive_product,))
        for active_product in ("PERRO VACA 333", "PERRO VACA 500", "PERRO POLLO 333", "PERRO POLLO 500", "PERRO PESCADO 500", "GATO VACA", "GATO POLLO", "GATO PESCADO"):
            cur.execute("UPDATE products SET active = 1 WHERE name = ?", (active_product,))
        product_ids = {r["name"]: r["id"] for r in cur.execute("SELECT id, name FROM products").fetchall()}
        supply_ids = {r["name"]: r["id"] for r in cur.execute("SELECT id, name FROM supplies").fetchall()}
        for product_name in ("PERRO VACA 333", "PERRO VACA 500", "PERRO POLLO 333", "PERRO POLLO 500", "PERRO PESCADO 500", "GATO VACA", "GATO POLLO", "GATO PESCADO"):
            pid = product_ids.get(product_name)
            if not pid:
                continue
            cur.execute("DELETE FROM product_recipes WHERE product_id = ?", (pid,))
            for supply_name, qty in BATCH_RECIPES.get(product_name, {}).items():
                sid = supply_ids.get(supply_name)
                if sid:
                    cur.execute(
                        "INSERT INTO product_recipes(product_id, supply_id, quantity_per_batch) VALUES (?, ?, ?)",
                        (pid, sid, float(qty)),
                    )
        cur.execute(
            "INSERT OR REPLACE INTO app_meta(key, value, updated_at) VALUES (?, ?, ?)",
            (migration_key, "applied", now),
        )

    # Migración operativa: transición usa SUPREMA PICADA en lugar de PECHUGA.
    # Se aplica una sola vez y reemplaza la composición existente sin borrar historial.
    migration_key = "transicion_suprema_picada_20260903_v1"
    already = cur.execute("SELECT value FROM app_meta WHERE key = ?", (migration_key,)).fetchone()
    if not already:
        product_ids = {r["name"]: r["id"] for r in cur.execute("SELECT id, name FROM products").fetchall()}
        supply_ids = {r["name"]: r["id"] for r in cur.execute("SELECT id, name FROM supplies").fetchall()}
        pid = product_ids.get("TRANSICION")
        suprema_id = supply_ids.get("SUPREMA PICADA")
        pechuga_id = supply_ids.get("PECHUGA")
        if pid and suprema_id:
            qty_pechuga = 0.0
            if pechuga_id:
                row = cur.execute(
                    "SELECT quantity_per_batch FROM product_recipes WHERE product_id = ? AND supply_id = ?",
                    (pid, pechuga_id),
                ).fetchone()
                qty_pechuga = float(row["quantity_per_batch"] or 0) if row else 0.0
            row_sup = cur.execute(
                "SELECT quantity_per_batch FROM product_recipes WHERE product_id = ? AND supply_id = ?",
                (pid, suprema_id),
            ).fetchone()
            qty_suprema = float(row_sup["quantity_per_batch"] or 0) if row_sup else 0.0
            target_qty = qty_suprema if qty_suprema > 0 else (qty_pechuga if qty_pechuga > 0 else 17.34)
            cur.execute("DELETE FROM product_recipes WHERE product_id = ? AND supply_id IN (?, ?)", (pid, suprema_id, pechuga_id or -1))
            cur.execute(
                "INSERT INTO product_recipes(product_id, supply_id, quantity_per_batch) VALUES (?, ?, ?)",
                (pid, suprema_id, float(target_qty)),
            )
        cur.execute(
            "INSERT OR REPLACE INTO app_meta(key, value, updated_at) VALUES (?, ?, ?)",
            (migration_key, "applied", now),
        )

    # Tiendanube queda activo y persistente.
    # No se borran ventas, combos ni mapeos al abrir la app.
    conn.commit()
    conn.close()


def read_sql(query, params=()):
    conn = get_conn()
    df = pd.read_sql_query(query, conn, params=params)
    conn.close()
    return df


def get_products(active_only=True):
    where = "WHERE active = 1" if active_only else ""
    return read_sql(f"SELECT id, name, days_to_stock, active FROM products {where} ORDER BY name")


def product_name_to_id():
    df = get_products(False)
    return dict(zip(df["name"], df["id"]))


def get_supplies(active_only=True):
    where = "WHERE active = 1" if active_only else ""
    return read_sql(f"SELECT id, name, category, unit, active FROM supplies {where} ORDER BY category, name")


def current_supply_stock():
    return read_sql(
        """
        SELECT s.id, s.name, s.category, s.unit, COALESCE(ss.quantity,0) AS stock_actual, ss.updated_at AS actualizado_el
        FROM supplies s
        LEFT JOIN supply_stock ss ON ss.supply_id = s.id
        WHERE s.active = 1
        ORDER BY s.category, s.name
        """
    )



def latest_supply_costs_df():
    """Devuelve el costo actual de cada insumo, tomando el último costo cargado."""
    return read_sql(
        """
        SELECT s.id, s.name, s.category, s.unit,
               COALESCE(ss.quantity,0) AS stock_actual,
               COALESCE(c.cost_unit,0) AS costo_unitario,
               COALESCE(c.includes_tax,1) AS iva_incluido,
               COALESCE(c.supplier,'') AS proveedor,
               COALESCE(c.cost_date,'') AS fecha_costo,
               COALESCE(c.note,'') AS observacion_costo
        FROM supplies s
        LEFT JOIN supply_stock ss ON ss.supply_id = s.id
        LEFT JOIN supply_costs c ON c.id = (
            SELECT c2.id FROM supply_costs c2
            WHERE c2.supply_id = s.id
            ORDER BY date(c2.cost_date) DESC, c2.id DESC
            LIMIT 1
        )
        WHERE s.active = 1
        ORDER BY s.category, s.name
        """
    )


def save_supply_costs(cost_df, cost_date=None):
    """Guarda cambios de costo como historial. No pisa movimientos anteriores."""
    if cost_date is None:
        cost_date = date.today()
    cost_date_s = cost_date.isoformat() if hasattr(cost_date, "isoformat") else str(cost_date)
    current = latest_supply_costs_df().set_index("id")
    conn = get_conn()
    now = datetime.now().isoformat(timespec="seconds")
    saved = 0
    for _, row in cost_df.iterrows():
        sid = int(row["id"])
        new_cost = pd.to_numeric(row.get("costo_unitario", 0), errors="coerce")
        if pd.isna(new_cost):
            new_cost = 0
        new_cost = float(new_cost)
        proveedor = str(row.get("proveedor", "") or "").strip()
        obs = str(row.get("observacion_costo", "") or "").strip()
        iva = 1 if bool(row.get("iva_incluido", True)) else 0
        if sid in current.index:
            old = current.loc[sid]
            old_cost = float(old.get("costo_unitario") or 0)
            old_prov = str(old.get("proveedor") or "")
            old_obs = str(old.get("observacion_costo") or "")
            old_iva = int(old.get("iva_incluido") if pd.notna(old.get("iva_incluido")) else 1)
            changed = abs(new_cost - old_cost) > 0.000001 or proveedor != old_prov or obs != old_obs or iva != old_iva
        else:
            changed = new_cost > 0 or proveedor or obs
        if changed:
            conn.execute(
                """
                INSERT INTO supply_costs(supply_id, cost_date, cost_unit, includes_tax, supplier, note, created_at)
                VALUES (?, ?, ?, ?, ?, ?, ?)
                """,
                (sid, cost_date_s, new_cost, iva, proveedor, obs, now),
            )
            saved += 1
    conn.commit()
    conn.close()
    return saved


def supply_cost_history_df():
    return read_sql(
        """
        SELECT sc.id, sc.cost_date AS fecha, s.name AS insumo, s.category AS categoria, s.unit AS unidad,
               sc.cost_unit AS costo_unitario, sc.includes_tax AS iva_incluido,
               COALESCE(sc.supplier,'') AS proveedor, COALESCE(sc.note,'') AS observacion,
               sc.created_at AS cargado_el
        FROM supply_costs sc
        JOIN supplies s ON s.id = sc.supply_id
        ORDER BY date(sc.cost_date) DESC, sc.id DESC
        """
    )


def costed_supply_movements_df(start_date=None, end_date=None):
    """Movimientos de insumos valorizados con el costo vigente a la fecha del movimiento.
    Si no hay costo anterior a la fecha, usa el último costo cargado del insumo.
    """
    where = "WHERE COALESCE(sm.is_undone,0)=0"
    params = []
    if start_date is not None:
        where += " AND date(sm.movement_date) >= date(?)"
        params.append(start_date.isoformat() if hasattr(start_date, "isoformat") else str(start_date))
    if end_date is not None:
        where += " AND date(sm.movement_date) <= date(?)"
        params.append(end_date.isoformat() if hasattr(end_date, "isoformat") else str(end_date))
    mov = read_sql(
        f"""
        SELECT sm.id, sm.movement_date AS fecha, s.id AS supply_id, s.name AS insumo, s.category AS categoria,
               s.unit AS unidad, sm.movement_type AS tipo, sm.quantity AS cantidad,
               COALESCE(sm.proveedor,'') AS proveedor, COALESCE(sm.lote_materia_prima,'') AS lote_materia_prima,
               COALESCE(sm.note,'') AS observacion, sm.source AS origen
        FROM supply_movements sm
        JOIN supplies s ON s.id = sm.supply_id
        {where}
        ORDER BY date(sm.movement_date), sm.id
        """,
        tuple(params),
    )
    if mov.empty:
        return mov
    costs = read_sql(
        """
        SELECT supply_id, cost_date, cost_unit, includes_tax, COALESCE(supplier,'') AS proveedor
        FROM supply_costs
        ORDER BY supply_id, date(cost_date), id
        """
    )
    mov["costo_unitario"] = 0.0
    mov["costo_total"] = 0.0
    mov["proveedor_costo"] = ""
    mov["fecha_costo"] = ""
    if not costs.empty:
        costs["cost_date_dt"] = pd.to_datetime(costs["cost_date"], errors="coerce")
        mov_dates = pd.to_datetime(mov["fecha"], errors="coerce")
        for idx, row in mov.iterrows():
            sid = row["supply_id"]
            d = mov_dates.loc[idx]
            c = costs[costs["supply_id"] == sid].copy()
            if c.empty:
                continue
            valid = c[c["cost_date_dt"] <= d] if pd.notna(d) else pd.DataFrame()
            chosen = valid.iloc[-1] if not valid.empty else c.iloc[-1]
            unit_cost = float(chosen.get("cost_unit") or 0)
            mov.at[idx, "costo_unitario"] = unit_cost
            mov.at[idx, "costo_total"] = unit_cost * float(row.get("cantidad") or 0)
            mov.at[idx, "proveedor_costo"] = chosen.get("proveedor") or ""
            mov.at[idx, "fecha_costo"] = chosen.get("cost_date") or ""
    return mov


def cost_analysis_series(start_date, end_date, granularity, categories=None, movement_groups=None):
    df = costed_supply_movements_df(start_date, end_date)
    if df.empty:
        return df
    if categories:
        df = df[df["categoria"].isin(categories)]
    if movement_groups:
        df = df[df["grupo_costo"].isin(movement_groups)] if "grupo_costo" in df.columns else df
    return df


def classify_cost_movement(tipo):
    tipo = str(tipo or "")
    if tipo == "ingreso":
        return "Ingresos / compras"
    if tipo in ("consumo_batch_materia_prima", "consumo_produccion"):
        return "Consumo productivo"
    if tipo in ("ajuste_negativo",):
        return "Pérdidas / ajustes negativos"
    if tipo in ("ajuste_positivo",):
        return "Ajustes positivos"
    return "Otros"


def product_recipe_costs_df():
    """Costo teórico por batch según receta vigente y último costo de insumo."""
    recipes = read_sql(
        """
        SELECT p.id AS product_id, p.name AS producto, s.id AS supply_id, s.name AS insumo, s.category AS categoria, s.unit AS unidad,
               r.quantity_per_batch AS cantidad_por_batch
        FROM product_recipes r
        JOIN products p ON p.id = r.product_id
        JOIN supplies s ON s.id = r.supply_id
        WHERE p.active = 1 AND s.active = 1
        ORDER BY p.name, s.category, s.name
        """
    )
    if recipes.empty:
        return recipes
    costs = latest_supply_costs_df()[["id", "costo_unitario"]].rename(columns={"id": "supply_id"})
    out = recipes.merge(costs, on="supply_id", how="left")
    out["costo_unitario"] = pd.to_numeric(out["costo_unitario"], errors="coerce").fillna(0)
    out["costo_total"] = out["cantidad_por_batch"] * out["costo_unitario"]
    return out

def set_supply_stock(stock_df):
    conn = get_conn()
    now = datetime.now().isoformat(timespec="seconds")
    for _, row in stock_df.iterrows():
        qty = float(row.get("stock_actual") or 0)
        conn.execute(
            """
            INSERT INTO supply_stock(supply_id, quantity, updated_at)
            VALUES (?, ?, ?)
            ON CONFLICT(supply_id) DO UPDATE SET quantity=excluded.quantity, updated_at=excluded.updated_at
            """,
            (int(row["id"]), qty, now),
        )
    conn.commit()
    conn.close()


def set_supply_stock_with_adjustments(stock_df, movement_date=None, note="Ajuste manual de stock de insumos"):
    """Actualiza el stock de insumos y deja registrado el ajuste por diferencia."""
    if movement_date is None:
        movement_date = date.today()
    movement_date_s = movement_date.isoformat() if hasattr(movement_date, "isoformat") else str(movement_date)
    conn = get_conn()
    now = datetime.now().isoformat(timespec="seconds")
    current = {
        int(r["supply_id"]): float(r["quantity"] or 0)
        for r in conn.execute("SELECT supply_id, quantity FROM supply_stock").fetchall()
    }
    changed = 0
    for _, row in stock_df.iterrows():
        supply_id = int(row["id"])
        new_qty = float(row.get("stock_actual") or 0)
        old_qty = float(current.get(supply_id, 0))
        diff = new_qty - old_qty
        conn.execute(
            """
            INSERT INTO supply_stock(supply_id, quantity, updated_at)
            VALUES (?, ?, ?)
            ON CONFLICT(supply_id) DO UPDATE SET quantity=excluded.quantity, updated_at=excluded.updated_at
            """,
            (supply_id, new_qty, now),
        )
        if abs(diff) > 0.000001:
            movement_type = "ajuste_positivo" if diff > 0 else "ajuste_negativo"
            conn.execute(
                """
                INSERT INTO supply_movements(movement_date, supply_id, movement_type, quantity, note, source, created_at, proveedor, lote_materia_prima)
                VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?)
                """,
                (movement_date_s, supply_id, movement_type, abs(diff), note, "stock_insumos_manual", now, "", ""),
            )
            changed += 1
    conn.commit()
    conn.close()
    return changed



def supply_stock_sign(movement_type):
    """Devuelve +1/-1/0 segun como el movimiento de insumo impacta stock.
    Centralizar esta regla evita que algun tipo nuevo se descuente o sume mal.
    """
    t = str(movement_type or "").strip().lower()
    positive = {"ingreso", "ingreso_insumos", "ajuste_positivo", "ajuste_manual_positivo", "stock_inicial"}
    negative = {"ajuste_negativo", "ajuste_manual_negativo", "perdida", "merma"}
    if t in positive:
        return 1
    if t in negative or t.startswith("consumo"):
        return -1
    return 0


def product_stock_sign(movement_type):
    """Devuelve +1/-1/0 segun como el movimiento de producto terminado impacta stock real.
    Se usa tanto para calcular stock como para mostrar historial.
    """
    t = str(movement_type or "").strip().lower()
    positive = {"produccion", "ajuste_positivo", "ajuste_manual_positivo", "transferencia_entrada", "stock_inicial"}
    negative = {"despacho", "ajuste_negativo", "ajuste_manual_negativo", "transferencia_salida", "perdida", "merma"}
    if t in positive or t.startswith("produccion"):
        return 1
    if t in negative or t.startswith("despacho"):
        return -1
    return 0


def stock_impact_label(sign):
    if sign > 0:
        return "Incremento de stock"
    if sign < 0:
        return "Decremento de stock"
    return "Sin impacto directo"

def add_supply_movement(movement_date, supply_id, movement_type, quantity, note="", source="manual", proveedor="", lote_materia_prima="", batch_mp_run_id=None):
    quantity = float(quantity or 0)
    if quantity <= 0:
        return
    conn = get_conn()
    now = datetime.now().isoformat(timespec="seconds")
    conn.execute(
        """
        INSERT INTO supply_movements(movement_date, supply_id, movement_type, quantity, note, source, created_at, proveedor, lote_materia_prima, batch_mp_run_id)
        VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
        """,
        (
            movement_date.isoformat() if hasattr(movement_date, "isoformat") else movement_date,
            int(supply_id),
            movement_type,
            quantity,
            note,
            source,
            now,
            str(proveedor or "").strip(),
            str(lote_materia_prima or "").strip(),
            int(batch_mp_run_id) if batch_mp_run_id else None,
        ),
    )
    sign = supply_stock_sign(movement_type)
    conn.execute(
        """
        INSERT INTO supply_stock(supply_id, quantity, updated_at)
        VALUES (?, ?, ?)
        ON CONFLICT(supply_id) DO UPDATE SET
            quantity = supply_stock.quantity + excluded.quantity,
            updated_at = excluded.updated_at
        """,
        (int(supply_id), sign * quantity, now),
    )
    conn.commit()
    conn.close()


def save_supply_entries(movement_date, entries_df, note=""):
    for _, row in entries_df.iterrows():
        qty = float(row.get("cantidad") or 0)
        if qty <= 0:
            continue
        proveedor = str(row.get("proveedor") or "").strip()
        add_supply_movement(movement_date, int(row["id"]), "ingreso", qty, note, "carga_diaria", proveedor=proveedor)


def calculate_batch_materia_prima_consumption(plan_df):
    plan_df = plan_df.copy()
    if plan_df.empty:
        return pd.DataFrame(), pd.DataFrame()
    plan_df["batchs"] = pd.to_numeric(plan_df.get("batchs", 0), errors="coerce").fillna(0)
    selected = plan_df[plan_df["batchs"] > 0][["id", "producto", "batchs"]]
    if selected.empty:
        return pd.DataFrame(), pd.DataFrame()

    conn = get_conn()
    recipes = pd.read_sql_query(
        """
        SELECT r.product_id, s.id AS supply_id, s.name AS insumo, s.category AS categoria,
               s.unit AS unidad, r.quantity_per_batch, COALESCE(ss.quantity,0) AS stock_actual
        FROM product_recipes r
        JOIN supplies s ON s.id = r.supply_id
        LEFT JOIN supply_stock ss ON ss.supply_id = s.id
        WHERE s.category = 'Materia prima'
        """,
        conn,
    )
    conn.close()

    merged = recipes.merge(selected, left_on="product_id", right_on="id", how="inner")
    if merged.empty:
        return selected, pd.DataFrame()
    merged["cantidad_a_descontar"] = merged["quantity_per_batch"] * merged["batchs"]
    result = merged.groupby(["supply_id", "insumo", "categoria", "unidad"], as_index=False).agg(
        cantidad_a_descontar=("cantidad_a_descontar", "sum"),
        stock_actual=("stock_actual", "max"),
    )
    result["stock_estimado_despues"] = result["stock_actual"] - result["cantidad_a_descontar"]
    result["estado"] = result["stock_estimado_despues"].apply(lambda x: "OK" if x >= 0 else "Faltante")
    result = result.sort_values(["estado", "insumo"], ascending=[True, True])
    return selected, result


def _batch_code(run_id, movement_date):
    d = movement_date.isoformat() if hasattr(movement_date, "isoformat") else str(movement_date)
    return f"BMP-{d.replace('-', '')}-{int(run_id):04d}"


def pending_batch_runs_df(movement_date=None, product_id=None):
    sql = """
        SELECT b.id, b.code, b.batch_date, b.product_id, p.name AS producto,
               b.batch_count, b.status, COALESCE(b.note,'') AS observacion, b.created_at
        FROM batch_mp_runs b
        JOIN products p ON p.id=b.product_id
        WHERE b.status='Pendiente de produccion'
    """
    params=[]
    if movement_date is not None:
        sql += " AND date(b.batch_date)=date(?)"
        params.append(movement_date.isoformat() if hasattr(movement_date, 'isoformat') else str(movement_date))
    if product_id is not None:
        sql += " AND b.product_id=?"
        params.append(int(product_id))
    sql += " ORDER BY b.id"
    return read_sql(sql, tuple(params))


def batch_mp_run_items_df(run_id):
    return read_sql(
        """
        SELECT b.id AS batch_id, b.code AS batch_mp, b.batch_date AS fecha_batch,
               p.name AS producto, b.batch_count AS batchs,
               s.name AS materia_prima, i.quantity AS cantidad_consumida,
               s.unit AS unidad, COALESCE(i.lote_materia_prima,'') AS lote_materia_prima
        FROM batch_mp_runs b
        JOIN products p ON p.id=b.product_id
        JOIN batch_mp_run_items i ON i.batch_mp_run_id=b.id
        JOIN supplies s ON s.id=i.supply_id
        WHERE b.id=?
        ORDER BY s.name
        """, (int(run_id),)
    )


def save_batch_materia_prima_consumption(movement_date, plan_df, note="", lotes_df=None):
    plan_df = plan_df.copy()
    if plan_df.empty:
        return 0
    plan_df["batchs"] = pd.to_numeric(plan_df.get("batchs",0), errors="coerce").fillna(0)
    selected = plan_df[plan_df["batchs"]>0][["id","producto","batchs"]].copy()
    if selected.empty:
        return 0

    recipes = read_sql(
        """
        SELECT r.product_id, s.id AS supply_id, s.name AS insumo, s.unit AS unidad,
               r.quantity_per_batch
        FROM product_recipes r
        JOIN supplies s ON s.id=r.supply_id
        WHERE s.category='Materia prima'
        ORDER BY r.product_id, s.name
        """
    )
    lot_map={}
    if lotes_df is not None and not getattr(lotes_df, 'empty', True):
        for _, lr in lotes_df.iterrows():
            try:
                key=(int(lr.get('product_id')), int(lr.get('supply_id')))
                lot_map[key]=str(lr.get('lote_materia_prima') or '').strip()
            except Exception:
                continue

    now=datetime.now().isoformat(timespec='seconds')
    count=0
    conn=get_conn()
    try:
        for _, pr in selected.iterrows():
            pid=int(pr['id']); batchs=float(pr['batchs']); product_name=str(pr['producto'])
            cur=conn.execute(
                "INSERT INTO batch_mp_runs(code,batch_date,product_id,batch_count,status,note,created_at) VALUES (NULL,?,?,?,?,?,?)",
                (movement_date.isoformat() if hasattr(movement_date,'isoformat') else str(movement_date), pid, batchs, 'Pendiente de produccion', str(note or ''), now)
            )
            run_id=cur.lastrowid
            code=_batch_code(run_id,movement_date)
            conn.execute("UPDATE batch_mp_runs SET code=? WHERE id=?",(code,run_id))
            rec=recipes[recipes['product_id']==pid]
            for _, rr in rec.iterrows():
                sid=int(rr['supply_id']); qty=float(rr['quantity_per_batch'])*batchs
                if qty<=0: continue
                lot=lot_map.get((pid,sid),'')
                conn.execute(
                    "INSERT INTO batch_mp_run_items(batch_mp_run_id,supply_id,quantity,lote_materia_prima,created_at) VALUES (?,?,?,?,?)",
                    (run_id,sid,qty,lot,now)
                )
                # Guardar movimiento con el mismo identificador de batch para auditoria.
                base_note=f"{code} | {product_name} x{batchs:g} batch. {note}".strip()
                conn.execute(
                    """INSERT INTO supply_movements(movement_date,supply_id,movement_type,quantity,note,source,created_at,proveedor,lote_materia_prima,batch_mp_run_id)
                       VALUES (?,?,?,?,?,?,?,?,?,?)""",
                    (movement_date.isoformat() if hasattr(movement_date,'isoformat') else str(movement_date), sid, 'consumo_batch_materia_prima', qty, base_note, 'batchs_diarios', now, '', lot, run_id)
                )
                # supply_stock mantiene la misma logica previa: consumo resta stock.
                conn.execute(
                    """INSERT INTO supply_stock(supply_id,quantity,updated_at) VALUES (?,?,?)
                       ON CONFLICT(supply_id) DO UPDATE SET quantity=supply_stock.quantity + excluded.quantity, updated_at=excluded.updated_at""",
                    (sid, -qty, now)
                )
                count += 1
        conn.commit()
    finally:
        conn.close()
    return count

def save_unit_production_supply_consumption(movement_date, product_name, produced_qty, note=""):
    """Descuenta insumos por unidad producida: bolsas y etiquetas, incluyendo etiquetas de jerkys."""
    produced_qty = float(produced_qty or 0)
    if produced_qty <= 0:
        return 0
    recipe = UNIT_PRODUCTION_SUPPLIES.get(product_name, {})
    if not recipe:
        return 0
    supplies = get_supplies(False)
    supply_ids = dict(zip(supplies["name"], supplies["id"]))
    count = 0
    base_note = f"Consumo por producción diaria: {product_name} x{produced_qty:g} unidades. {note}".strip()
    for supply_name, per_unit in recipe.items():
        sid = supply_ids.get(supply_name)
        qty = float(per_unit) * produced_qty
        if sid is None or qty <= 0:
            continue
        add_supply_movement(movement_date, int(sid), "consumo_produccion", qty, base_note, "produccion_diaria")
        count += 1
    return count


def save_daily_production_with_supplies(movement_date, df, note="", deposit=DEFAULT_DEPOSIT, batch_link_map=None):
    """Guarda producción, packaging y vínculo confirmado con un Batch MP pendiente."""
    mapping = product_name_to_id()
    products = get_products(False).set_index("name")
    product_movements = 0
    supply_movements = 0
    batch_link_map = batch_link_map or {}
    for _, row in df.iterrows():
        qty = float(row.get("cantidad") or 0)
        if qty <= 0:
            continue
        name = row["producto"]
        pid = mapping[name]
        days = int(products.loc[name, "days_to_stock"])
        eff = movement_date + timedelta(days=days)
        lote = str(row.get("lote") or "").strip()
        run_id = batch_link_map.get(int(pid))
        batch_txt = ""
        if run_id:
            rr = read_sql("SELECT code FROM batch_mp_runs WHERE id=? AND status='Pendiente de produccion'", (int(run_id),))
            if not rr.empty:
                batch_txt = f" Batch MP vinculado: {rr.iloc[0]['code']}."
            else:
                run_id = None
        mov_note = f"Produccion diaria. Se suma al stock en {days} dia(s).{batch_txt} {note}".strip()
        movement_id = add_movement(movement_date, pid, "produccion", qty, eff, mov_note, "manual", lote=lote, deposit=deposit, batch_mp_run_id=run_id)
        if run_id and movement_id:
            conn=get_conn()
            conn.execute(
                "UPDATE batch_mp_runs SET status='Asignado', linked_production_movement_id=?, linked_at=? WHERE id=? AND status='Pendiente de produccion'",
                (int(movement_id), datetime.now().isoformat(timespec='seconds'), int(run_id))
            )
            conn.commit(); conn.close()
        product_movements += 1
        supply_movements += save_unit_production_supply_consumption(movement_date, name, qty, note)
    return product_movements, supply_movements


def stock_by_lot_df(as_of=None, product_id=None, deposit=None):
    """Stock trazable por lote. Solo incluye movimientos con lote informado."""
    if as_of is None:
        as_of = date.today()
    sql = """
        SELECT m.product_id, p.name AS producto, COALESCE(m.deposit, ?) AS deposito,
               TRIM(COALESCE(m.lote,'')) AS lote, m.movement_type, m.quantity
        FROM movements m JOIN products p ON p.id=m.product_id
        WHERE COALESCE(m.is_undone,0)=0
          AND date(COALESCE(m.effective_date,m.movement_date))<=date(?)
          AND TRIM(COALESCE(m.lote,''))<>''
    """
    params = [DEFAULT_DEPOSIT, as_of.isoformat() if hasattr(as_of, 'isoformat') else str(as_of)]
    if product_id is not None:
        sql += " AND m.product_id=?"; params.append(int(product_id))
    if deposit is not None:
        sql += " AND COALESCE(m.deposit,?)=?"; params.extend([DEFAULT_DEPOSIT, str(deposit)])
    df = read_sql(sql, tuple(params))
    if df.empty:
        return pd.DataFrame(columns=['product_id','producto','deposito','lote','stock_lote'])
    df['signo'] = df['movement_type'].apply(product_stock_sign)
    df['impacto'] = pd.to_numeric(df['quantity'], errors='coerce').fillna(0) * df['signo']
    out = df.groupby(['product_id','producto','deposito','lote'], as_index=False)['impacto'].sum().rename(columns={'impacto':'stock_lote'})
    return out.sort_values(['producto','lote'])


def lot_stock_detail_df(as_of=None, product_id=None, deposit=None):
    """Detalle operativo del stock terminado por lote y depósito.

    La cantidad producida y la fecha de producción se conservan a nivel global del lote,
    mientras que entradas/salidas y stock actual se calculan por depósito.
    """
    if as_of is None:
        as_of = date.today()
    as_of_s = as_of.isoformat() if hasattr(as_of, 'isoformat') else str(as_of)
    sql = """
        SELECT m.id, m.product_id, p.name AS producto, COALESCE(m.deposit, ?) AS deposito,
               TRIM(COALESCE(m.lote,'')) AS lote, m.movement_type, m.quantity,
               m.movement_date, COALESCE(m.effective_date,m.movement_date) AS effective_date,
               m.batch_mp_run_id
        FROM movements m
        JOIN products p ON p.id=m.product_id
        WHERE COALESCE(m.is_undone,0)=0
          AND date(COALESCE(m.effective_date,m.movement_date))<=date(?)
          AND TRIM(COALESCE(m.lote,''))<>''
    """
    params = [DEFAULT_DEPOSIT, as_of_s]
    if product_id is not None:
        sql += " AND m.product_id=?"; params.append(int(product_id))
    if deposit is not None:
        sql += " AND COALESCE(m.deposit,?)=?"; params.extend([DEFAULT_DEPOSIT, str(deposit)])
    df = read_sql(sql, tuple(params))
    cols = ['product_id','sku','producto','deposito','lote','fecha_produccion','produccion_inicial','entradas_lote','despachado','transferencias_salida','otras_salidas','stock_actual','batch_mp','estado']
    if df.empty:
        return pd.DataFrame(columns=cols)

    df['quantity'] = pd.to_numeric(df['quantity'], errors='coerce').fillna(0.0)
    df['signo'] = df['movement_type'].apply(product_stock_sign)
    df['impacto'] = df['quantity'] * df['signo']
    df['entrada'] = df.apply(lambda r: r['quantity'] if product_stock_sign(r['movement_type']) > 0 else 0.0, axis=1)
    df['despachado_qty'] = df.apply(lambda r: r['quantity'] if str(r['movement_type']).lower().startswith('despacho') else 0.0, axis=1)
    df['transfer_salida_qty'] = df.apply(lambda r: r['quantity'] if r['movement_type'] == 'transferencia_salida' else 0.0, axis=1)
    df['otra_salida_qty'] = df.apply(lambda r: r['quantity'] if (product_stock_sign(r['movement_type']) < 0 and not str(r['movement_type']).lower().startswith('despacho') and r['movement_type'] != 'transferencia_salida') else 0.0, axis=1)

    gcols = ['product_id','producto','deposito','lote']
    out = df.groupby(gcols, as_index=False).agg(
        entradas_lote=('entrada','sum'),
        despachado=('despachado_qty','sum'),
        transferencias_salida=('transfer_salida_qty','sum'),
        otras_salidas=('otra_salida_qty','sum'),
        stock_actual=('impacto','sum'),
    )

    # Origen global del lote: primera producción y total producido, aunque luego se transfiera.
    origins = read_sql(
        """
        SELECT m.product_id, TRIM(COALESCE(m.lote,'')) AS lote,
               MIN(m.movement_date) AS fecha_produccion,
               SUM(CASE WHEN m.movement_type='produccion' THEN m.quantity ELSE 0 END) AS produccion_inicial,
               GROUP_CONCAT(DISTINCT COALESCE(b.code,'')) AS batch_mp
        FROM movements m
        LEFT JOIN batch_mp_runs b ON b.id=m.batch_mp_run_id
        WHERE COALESCE(m.is_undone,0)=0
          AND TRIM(COALESCE(m.lote,''))<>''
          AND m.movement_type='produccion'
          AND date(COALESCE(m.effective_date,m.movement_date))<=date(?)
        GROUP BY m.product_id, TRIM(COALESCE(m.lote,''))
        """,
        (as_of_s,),
    )
    if not origins.empty:
        out = out.merge(origins, on=['product_id','lote'], how='left')
    else:
        out['fecha_produccion'] = ''
        out['produccion_inicial'] = 0.0
        out['batch_mp'] = ''
    out['fecha_produccion'] = out.get('fecha_produccion', '').fillna('')
    out['produccion_inicial'] = pd.to_numeric(out.get('produccion_inicial', 0), errors='coerce').fillna(0.0)
    out['batch_mp'] = out.get('batch_mp', '').fillna('').astype(str).str.strip(',')
    out['sku'] = out['producto'].apply(default_sku_for_product)

    def lot_status(r):
        stock = float(r.get('stock_actual') or 0)
        produced = float(r.get('produccion_inicial') or 0)
        if stock <= 0.000001:
            return 'Agotado'
        threshold = max(1.0, produced * 0.20) if produced > 0 else 1.0
        if stock <= threshold:
            return 'Bajo stock'
        return 'Disponible'
    out['estado'] = out.apply(lot_status, axis=1)
    return out[cols].sort_values(['producto','fecha_produccion','lote','deposito'], na_position='last')


def lot_stock_reconciliation_df(as_of=None):
    """Compara stock real por SKU/depósito contra la suma de lotes trazables."""
    if as_of is None:
        as_of = date.today()
    real = current_real_stock(as_of)[['id','name','deposit','stock_real']].rename(columns={'id':'product_id','name':'producto','deposit':'deposito'})
    lots = stock_by_lot_df(as_of)
    if lots.empty:
        trace = pd.DataFrame(columns=['product_id','deposito','stock_trazable_lotes'])
    else:
        trace = lots.groupby(['product_id','deposito'], as_index=False)['stock_lote'].sum().rename(columns={'stock_lote':'stock_trazable_lotes'})
    out = real.merge(trace, on=['product_id','deposito'], how='left')
    out['stock_trazable_lotes'] = pd.to_numeric(out['stock_trazable_lotes'], errors='coerce').fillna(0.0)
    out['stock_real'] = pd.to_numeric(out['stock_real'], errors='coerce').fillna(0.0)
    out['diferencia_sin_lote'] = out['stock_real'] - out['stock_trazable_lotes']
    out['estado'] = out['diferencia_sin_lote'].apply(lambda x: 'OK' if abs(float(x)) <= 0.000001 else 'Diferencia / stock sin lote')
    return out


def _normalize_dispatch_lot(value):
    txt = str(value or '').strip()
    if normalize_text(txt) in {'SIN LOTE', 'SIN LOTE / STOCK NO TRAZABLE', 'STOCK NO TRAZABLE'}:
        return ''
    return txt


def tiendanube_dispatch_order_lot_lines(order_number, deposit, as_of=None):
    """Expande una comanda pendiente por lotes disponibles y propone FIFO.

    Si existe stock real anterior a la trazabilidad, lo muestra como SIN LOTE / STOCK NO TRAZABLE.
    """
    if as_of is None:
        as_of = date.today()
    base = tiendanube_dispatch_order_lines(order_number, deposit)
    columns = ['product_id','sku','producto','pedido','despachado','pendiente','fecha_produccion','lote','stock_lote','trazabilidad','despachar_ahora']
    if base.empty:
        return pd.DataFrame(columns=columns)
    lot_detail = lot_stock_detail_df(as_of=as_of, deposit=deposit)
    rec = lot_stock_reconciliation_df(as_of)
    rec = rec[rec['deposito'] == deposit]
    rows = []
    for r in base.itertuples():
        pending = max(float(r.pendiente), 0.0)
        if pending <= 0:
            continue
        remaining = pending
        p_lots = lot_detail[(lot_detail['product_id'] == int(r.product_id)) & (pd.to_numeric(lot_detail['stock_actual'], errors='coerce').fillna(0) > 0)].copy()
        if not p_lots.empty:
            p_lots['_sort_date'] = pd.to_datetime(p_lots['fecha_produccion'], errors='coerce')
            p_lots = p_lots.sort_values(['_sort_date','lote'], na_position='last')
            for lr in p_lots.itertuples():
                available = max(float(lr.stock_actual), 0.0)
                suggested = min(remaining, available)
                rows.append({
                    'product_id': int(r.product_id), 'sku': r.sku, 'producto': r.producto,
                    'pedido': float(r.pedido), 'despachado': float(r.despachado), 'pendiente': pending,
                    'fecha_produccion': str(lr.fecha_produccion or ''), 'lote': str(lr.lote),
                    'stock_lote': available, 'trazabilidad': 'Lote trazable', 'despachar_ahora': suggested,
                })
                remaining = max(remaining - suggested, 0.0)
        rec_row = rec[rec['product_id'] == int(r.product_id)]
        untraced = max(float(rec_row['diferencia_sin_lote'].iloc[0]), 0.0) if not rec_row.empty else 0.0
        # Solo agrega fila sin lote si hace falta completar la comanda o si no hay lotes disponibles.
        if remaining > 0 or p_lots.empty:
            suggested = min(remaining, untraced)
            rows.append({
                'product_id': int(r.product_id), 'sku': r.sku, 'producto': r.producto,
                'pedido': float(r.pedido), 'despachado': float(r.despachado), 'pendiente': pending,
                'fecha_produccion': '', 'lote': 'SIN LOTE / STOCK NO TRAZABLE',
                'stock_lote': untraced, 'trazabilidad': 'Stock anterior/sin lote', 'despachar_ahora': suggested,
            })
    return pd.DataFrame(rows, columns=columns)

def supply_movements_df():
    df = read_sql(
        """
        SELECT sm.id, sm.movement_date AS fecha, s.name AS insumo, s.category AS categoria,
               s.unit AS unidad, sm.movement_type AS tipo, sm.quantity AS cantidad,
               COALESCE(sm.proveedor, '') AS proveedor, COALESCE(sm.lote_materia_prima, '') AS lote_materia_prima,
               COALESCE(sm.note, '') AS observacion, sm.source AS origen, sm.created_at AS cargado_el,
               COALESCE(sm.is_undone,0) AS anulado, COALESCE(sm.undone_at,'') AS anulado_el, COALESCE(sm.undo_reason,'') AS motivo_anulacion
        FROM supply_movements sm
        JOIN supplies s ON s.id = sm.supply_id
        ORDER BY date(sm.movement_date) DESC, sm.id DESC
        """
    )
    if df.empty:
        return df
    df["signo_stock"] = pd.to_numeric(df["tipo"].apply(supply_stock_sign), errors="coerce").fillna(0).astype(float)
    df["impacto_stock"] = df["signo_stock"].apply(stock_impact_label)
    df["cantidad_num"] = pd.to_numeric(df.get("cantidad", 0), errors="coerce").fillna(0).astype(float)
    df["cantidad_con_signo"] = df.apply(lambda r: abs(float(r.get("cantidad_num") or 0)) * float(r.get("signo_stock") or 0) if float(r.get("signo_stock") or 0) != 0 else float(r.get("cantidad_num") or 0), axis=1)

    def batch_origin(row):
        if str(row.get("tipo") or "") != "consumo_batch_materia_prima":
            return ""
        obs = str(row.get("observacion") or "")
        marker = "Consumo materia prima por batchs:"
        if marker in obs:
            txt = obs.split(marker, 1)[1].strip()
            # La observación puede tener texto adicional después de un punto.
            return txt.split(".", 1)[0].strip()
        return obs

    df["batchs_origen"] = df.apply(batch_origin, axis=1)
    preferred = [
        "id", "fecha", "insumo", "categoria", "unidad", "tipo", "impacto_stock",
        "cantidad", "cantidad_con_signo", "proveedor", "lote_materia_prima", "batchs_origen", "observacion", "origen", "cargado_el",
        "anulado", "anulado_el", "motivo_anulacion"
    ]
    return df[[c for c in preferred if c in df.columns]]


def add_supply(name, category, unit):
    name = (name or "").strip().upper()
    category = (category or "Materia prima").strip()
    unit = (unit or "kg").strip()
    if not name:
        return False, "Ingresá un nombre de insumo."
    conn = get_conn()
    try:
        conn.execute(
            "INSERT INTO supplies(name, category, unit, active, created_at) VALUES (?, ?, ?, 1, ?)",
            (name, category, unit, datetime.now().isoformat(timespec="seconds")),
        )
        conn.commit()
        return True, f"Insumo agregado: {name}"
    except sqlite3.IntegrityError:
        conn.execute("UPDATE supplies SET category = ?, unit = ?, active = 1 WHERE name = ?", (category, unit, name))
        conn.commit()
        return True, f"Insumo reactivado/actualizado: {name}"
    finally:
        conn.close()


def recipe_products():
    return read_sql(
        """
        SELECT DISTINCT p.id, p.name
        FROM products p
        JOIN product_recipes r ON r.product_id = p.id
        WHERE p.active = 1
        ORDER BY p.name
        """
    )


def recipes_df():
    return read_sql(
        """
        SELECT p.name AS producto, s.name AS insumo, s.category AS categoria, s.unit AS unidad,
               r.quantity_per_batch AS cantidad_por_batch
        FROM product_recipes r
        JOIN products p ON p.id = r.product_id
        JOIN supplies s ON s.id = r.supply_id
        ORDER BY p.name, s.category, s.name
        """
    )


def recipe_detail_df(product_id):
    """Devuelve todos los insumos activos con la cantidad actual por batch para un producto."""
    conn = get_conn()
    df = pd.read_sql_query(
        """
        SELECT s.id AS supply_id, s.name AS insumo, s.category AS categoria, s.unit AS unidad,
               COALESCE(r.quantity_per_batch, 0) AS cantidad_por_batch
        FROM supplies s
        LEFT JOIN product_recipes r ON r.supply_id = s.id AND r.product_id = ?
        WHERE s.active = 1
        ORDER BY s.category, s.name
        """,
        conn,
        params=(int(product_id),),
    )
    conn.close()
    return df


def save_product_recipe(product_id, recipe_df):
    """Reemplaza la composicion del batch para un producto. Solo guarda cantidades mayores a cero."""
    conn = get_conn()
    cur = conn.cursor()
    cur.execute("DELETE FROM product_recipes WHERE product_id = ?", (int(product_id),))
    saved = 0
    for _, row in recipe_df.iterrows():
        qty = pd.to_numeric(row.get("cantidad_por_batch", 0), errors="coerce")
        if pd.isna(qty) or float(qty) <= 0:
            continue
        cur.execute(
            """
            INSERT INTO product_recipes(product_id, supply_id, quantity_per_batch)
            VALUES (?, ?, ?)
            """,
            (int(product_id), int(row["supply_id"]), float(qty)),
        )
        saved += 1
    conn.commit()
    conn.close()
    return saved


def add_or_update_recipe_component(product_id, supply_id, quantity_per_batch):
    qty = float(quantity_per_batch or 0)
    if qty <= 0:
        return False, "La cantidad debe ser mayor a cero."
    conn = get_conn()
    conn.execute(
        """
        INSERT INTO product_recipes(product_id, supply_id, quantity_per_batch)
        VALUES (?, ?, ?)
        ON CONFLICT(product_id, supply_id) DO UPDATE SET quantity_per_batch=excluded.quantity_per_batch
        """,
        (int(product_id), int(supply_id), qty),
    )
    conn.commit()
    conn.close()
    return True, "Insumo agregado/actualizado en la receta."


def delete_recipe_component(product_id, supply_id):
    conn = get_conn()
    cur = conn.cursor()
    cur.execute("DELETE FROM product_recipes WHERE product_id = ? AND supply_id = ?", (int(product_id), int(supply_id)))
    deleted = cur.rowcount
    conn.commit()
    conn.close()
    if deleted:
        return True, "Insumo eliminado de la receta."
    return False, "Ese insumo no estaba cargado en la receta."


def clear_product_recipe(product_id):
    conn = get_conn()
    cur = conn.cursor()
    cur.execute("DELETE FROM product_recipes WHERE product_id = ?", (int(product_id),))
    deleted = cur.rowcount
    conn.commit()
    conn.close()
    return deleted


def deactivate_product(product_id):
    conn = get_conn()
    cur = conn.cursor()
    cur.execute("UPDATE products SET active = 0 WHERE id = ?", (int(product_id),))
    conn.commit()
    conn.close()
    return True, "Batch/producto desactivado. No se borra historial."


def calculate_purchase_plan(plan_df):
    COVERAGE_EXTRA = 0.05
    plan_df = plan_df.copy()
    if plan_df.empty:
        return pd.DataFrame(), pd.DataFrame()
    plan_df["batchs"] = pd.to_numeric(plan_df.get("batchs", 0), errors="coerce").fillna(0)
    selected = plan_df[plan_df["batchs"] > 0][["id", "producto", "batchs"]]
    if selected.empty:
        return pd.DataFrame(), pd.DataFrame()

    conn = get_conn()
    recipes = pd.read_sql_query(
        """
        SELECT r.product_id, s.id AS supply_id, s.name AS insumo, s.category AS categoria, s.unit AS unidad,
               r.quantity_per_batch, COALESCE(ss.quantity,0) AS stock_actual
        FROM product_recipes r
        JOIN supplies s ON s.id = r.supply_id
        LEFT JOIN supply_stock ss ON ss.supply_id = s.id
        """,
        conn,
    )
    conn.close()
    merged = recipes.merge(selected, left_on="product_id", right_on="id", how="inner")
    if merged.empty:
        return selected, pd.DataFrame()
    merged["necesario_base"] = merged["quantity_per_batch"] * merged["batchs"]
    result = merged.groupby(["supply_id", "insumo", "categoria", "unidad"], as_index=False).agg(
        necesario_base=("necesario_base", "sum"),
        stock_actual=("stock_actual", "max"),
    )
    result["extra_5"] = result["necesario_base"] * COVERAGE_EXTRA
    result["necesario_total"] = result["necesario_base"] + result["extra_5"]
    result["comprar"] = (result["necesario_total"] - result["stock_actual"]).clip(lower=0)
    result["estado"] = result["comprar"].apply(lambda x: "OK" if x <= 0 else "Comprar")
    result = result[["insumo", "categoria", "unidad", "necesario_base", "extra_5", "necesario_total", "stock_actual", "comprar", "estado"]].sort_values(["estado", "categoria", "insumo"], ascending=[False, True, True])
    return selected, result



def df_to_excel_bytes(sheets: dict):
    """Exporta uno o varios DataFrames a un Excel en memoria."""
    wb = Workbook()
    first = True
    for sheet_name, df in sheets.items():
        if first:
            ws = wb.active
            ws.title = str(sheet_name)[:31] or "Hoja1"
            first = False
        else:
            ws = wb.create_sheet(str(sheet_name)[:31] or "Hoja")
        if df is None:
            df = pd.DataFrame()
        write_df(ws, df.copy())
    bio = BytesIO()
    wb.save(bio)
    return bio.getvalue()

def purchase_plan_excel_bytes(selected_plan, purchase_df):
    wb = Workbook()
    ws = wb.active
    ws.title = "Pedido de compra"
    out = purchase_df[purchase_df["comprar"] > 0].copy()
    if out.empty:
        out = purchase_df.copy()
    write_df(ws, out)
    ws2 = wb.create_sheet("Plan produccion")
    write_df(ws2, selected_plan.rename(columns={"producto":"Producto", "batchs":"Batchs"}))
    ws3 = wb.create_sheet("Resumen insumos")
    write_df(ws3, purchase_df)
    bio = BytesIO()
    wb.save(bio)
    return bio.getvalue()


def add_product(name, days_to_stock=0):
    name = (name or "").strip().upper()
    if not name:
        return False, "Ingresá un nombre de producto."
    conn = get_conn()
    try:
        conn.execute(
            "INSERT INTO products(name, days_to_stock, active, created_at) VALUES (?, ?, 1, ?)",
            (name, int(days_to_stock), datetime.now().isoformat(timespec="seconds")),
        )
        conn.commit()
        return True, f"Producto agregado: {name}"
    except sqlite3.IntegrityError:
        conn.execute("UPDATE products SET active = 1, days_to_stock = ? WHERE name = ?", (int(days_to_stock), name))
        conn.commit()
        return True, f"Producto reactivado/actualizado: {name}"
    finally:
        conn.close()


def update_product_settings(settings_df):
    conn = get_conn()
    for _, row in settings_df.iterrows():
        conn.execute(
            "UPDATE products SET days_to_stock = ?, active = ? WHERE id = ?",
            (int(row["days_to_stock"]), 1 if bool(row["active"]) else 0, int(row["id"])),
        )
    conn.commit()
    conn.close()



def set_initial_stock(stock_df):
    conn = get_conn()
    now = datetime.now().isoformat(timespec="seconds")
    for _, row in stock_df.iterrows():
        product_id = int(row["id"])
        for deposit in DEPOSITS:
            qty = float(row.get(deposit) or 0)
            conn.execute(
                """
                INSERT INTO initial_stock_deposit(product_id, deposit, quantity, updated_at)
                VALUES (?, ?, ?, ?)
                ON CONFLICT(product_id, deposit) DO UPDATE SET quantity=excluded.quantity, updated_at=excluded.updated_at
                """,
                (product_id, deposit, qty, now),
            )
    conn.commit()
    conn.close()


def save_available_snapshot(stock_date, stock_df, note=""):
    conn = get_conn()
    now = datetime.now().isoformat(timespec="seconds")
    for _, row in stock_df.iterrows():
        product_id = int(row["id"])
        for deposit in DEPOSITS:
            qty = float(row.get(deposit) or 0)
            conn.execute(
                """
                INSERT INTO available_stock_deposit(stock_date, product_id, deposit, quantity, note, created_at, updated_at)
                VALUES (?, ?, ?, ?, ?, ?, ?)
                ON CONFLICT(stock_date, product_id, deposit) DO UPDATE SET
                    quantity=excluded.quantity,
                    note=excluded.note,
                    updated_at=excluded.updated_at
                """,
                (stock_date.isoformat(), product_id, deposit, qty, note, now, now),
            )
    conn.commit()
    conn.close()


def add_movement(movement_date, product_id, movement_type, quantity, effective_date=None, note="", source="manual", numero_comanda="", lote="", deposit=DEFAULT_DEPOSIT, batch_mp_run_id=None):
    quantity = float(quantity or 0)
    if quantity <= 0:
        return
    if effective_date is None:
        effective_date = movement_date
    if deposit not in DEPOSITS:
        deposit = DEFAULT_DEPOSIT
    conn = get_conn()
    conn.execute(
        """
        INSERT INTO movements(movement_date, product_id, movement_type, quantity, effective_date, note, source, numero_comanda, lote, deposit, created_at, batch_mp_run_id)
        VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
        """,
        (
            movement_date.isoformat() if hasattr(movement_date, "isoformat") else movement_date,
            int(product_id),
            movement_type,
            quantity,
            effective_date.isoformat() if hasattr(effective_date, "isoformat") else effective_date,
            note,
            source,
            numero_comanda,
            lote,
            deposit,
            datetime.now().isoformat(timespec="seconds"),
            int(batch_mp_run_id) if batch_mp_run_id else None,
        ),
    )
    movement_id = conn.execute("SELECT last_insert_rowid()").fetchone()[0]
    conn.commit()
    conn.close()
    return int(movement_id)




def save_stock_transfer(movement_date, product_id, quantity, origin_deposit, destination_deposit, lote="", note=""):
    """Registra una transferencia de producto terminado entre depósitos.
    Crea dos movimientos vinculados por una referencia: salida del origen y entrada del destino.
    Solo impacta stock real de producto terminado; no mueve insumos ni stock disponible cargado.
    """
    qty = float(quantity or 0)
    if qty <= 0:
        return None
    if origin_deposit == destination_deposit:
        return None
    if origin_deposit not in DEPOSITS or destination_deposit not in DEPOSITS:
        return None
    ref = f"TRF-{datetime.now().strftime('%Y%m%d%H%M%S')}"
    base_note = f"Transferencia {ref}: {origin_deposit} -> {destination_deposit}. {note}".strip()
    add_movement(
        movement_date,
        product_id,
        "transferencia_salida",
        qty,
        movement_date,
        base_note,
        "transferencia",
        numero_comanda=ref,
        lote=lote,
        deposit=origin_deposit,
    )
    add_movement(
        movement_date,
        product_id,
        "transferencia_entrada",
        qty,
        movement_date,
        base_note,
        "transferencia",
        numero_comanda=ref,
        lote=lote,
        deposit=destination_deposit,
    )
    return ref

def save_daily_movements(movement_date, df, movement_type, note="", deposit=DEFAULT_DEPOSIT):
    mapping = product_name_to_id()
    products = get_products(False).set_index("name")
    for _, row in df.iterrows():
        qty = float(row.get("cantidad") or 0)
        if qty <= 0:
            continue
        name = row["producto"]
        pid = mapping[name]
        if movement_type == "produccion":
            days = int(products.loc[name, "days_to_stock"])
            eff = movement_date + timedelta(days=days)
            mov_note = f"Produccion diaria. Se suma al stock en {days} dia(s). {note}".strip()
        else:
            eff = movement_date
            mov_note = note
        numero_comanda = str(row.get("numero_comanda", "") or "").strip()
        lote = str(row.get("lote", "") or "").strip()
        add_movement(movement_date, pid, movement_type, qty, eff, mov_note, "manual", numero_comanda, lote, deposit)


def current_real_stock(as_of=None):
    if as_of is None:
        as_of = date.today()
    as_of_s = as_of.isoformat()
    products = get_products(True)[["id", "name", "days_to_stock"]]
    base = products.assign(_k=1).merge(pd.DataFrame({"deposit": DEPOSITS, "_k": 1}), on="_k").drop(columns="_k")

    init = read_sql("SELECT product_id AS id, deposit, quantity AS stock_inicial FROM initial_stock_deposit")
    df = base.merge(init, on=["id", "deposit"], how="left")
    df["stock_inicial"] = df["stock_inicial"].fillna(0)

    mov = read_sql(
        """
        SELECT product_id AS id, COALESCE(deposit, ?) AS deposit, movement_type, quantity, effective_date
        FROM movements
        WHERE COALESCE(is_undone,0) = 0
        """,
        (DEFAULT_DEPOSIT,),
    )
    if mov.empty:
        for col in ["produccion_disponible", "despachos", "transferencias_entrada", "transferencias_salida", "ajuste_positivo", "ajuste_negativo", "produccion_pendiente"]:
            df[col] = 0.0
    else:
        mov["effective_date"] = pd.to_datetime(mov["effective_date"]).dt.date
        for mt, col, future in [
            ("produccion", "produccion_disponible", False),
            ("despacho", "despachos", False),
            ("transferencia_entrada", "transferencias_entrada", False),
            ("transferencia_salida", "transferencias_salida", False),
            ("ajuste_positivo", "ajuste_positivo", False),
            ("ajuste_negativo", "ajuste_negativo", False),
            ("produccion", "produccion_pendiente", True),
        ]:
            if future:
                part = mov[(mov["movement_type"] == mt) & (mov["effective_date"] > as_of)]
            else:
                part = mov[(mov["movement_type"] == mt) & (mov["effective_date"] <= as_of)]
            grouped = part.groupby(["id", "deposit"], as_index=False)["quantity"].sum().rename(columns={"quantity": col})
            df = df.merge(grouped, on=["id", "deposit"], how="left")
            df[col] = df[col].fillna(0)
    # Stock real definitivo por libro de movimientos:
    # toma todos los movimientos efectivos hasta la fecha y aplica una regla central de signo.
    # Esto evita errores si aparece un tipo nuevo como despacho_manjares o ajuste_manual.
    if not mov.empty:
        mov_eff = mov[mov["effective_date"] <= as_of].copy()
        mov_eff["signo_stock"] = pd.to_numeric(mov_eff["movement_type"].apply(product_stock_sign), errors="coerce").fillna(0).astype(float)
        mov_eff["quantity_num"] = pd.to_numeric(mov_eff["quantity"], errors="coerce").fillna(0).astype(float)
        mov_eff["cantidad_con_signo"] = mov_eff["quantity_num"] * mov_eff["signo_stock"]
        ledger = mov_eff.groupby(["id", "deposit"], as_index=False)["cantidad_con_signo"].sum().rename(columns={"cantidad_con_signo": "movimientos_stock"})
        df = df.merge(ledger, on=["id", "deposit"], how="left")
        df["movimientos_stock"] = df["movimientos_stock"].fillna(0)
    else:
        df["movimientos_stock"] = 0.0
    df["stock_real"] = df["stock_inicial"] + df["movimientos_stock"]
    return df.sort_values(["deposit", "name"])


def latest_available_stock(as_of=None):
    """Stock disponible importado que se usa como fuente oficial.

    Regla vigente Rawer Data:
    - NO se usa más el stock de EcommApp/Tiendanube como foto de stock.
    - Para Buenos Aires / Manjares, el stock disponible oficial sale del Excel de Manjares.
    - Para Planta y Tandil, el stock disponible se calcula en dashboard_df como:
      stock real - ventas pendientes de despacho.

    Por eso esta función solo devuelve snapshots de Manjares cuya observación indique
    importación/carga de Manjares. Cualquier snapshot viejo de EcommApp queda ignorado.
    """
    if as_of is None:
        as_of = date.today()
    products = get_products(True)[["id", "name"]]
    base = products.assign(_k=1).merge(pd.DataFrame({"deposit": DEPOSITS, "_k": 1}), on="_k").drop(columns="_k")
    snaps = read_sql(
        """
        SELECT product_id AS id, deposit, stock_date, quantity AS stock_disponible, updated_at, COALESCE(note,'') AS note
        FROM available_stock_deposit
        WHERE date(stock_date) <= date(?)
          AND deposit = 'Buenos Aires / Manjares'
          AND lower(COALESCE(note,'')) LIKE '%manjares%'
        ORDER BY date(stock_date), updated_at
        """,
        (as_of.isoformat(),),
    )
    if snaps.empty:
        base["stock_disponible"] = 0.0
        base["fecha_stock_disponible"] = None
        return base.sort_values(["deposit", "name"])
    snaps = snaps.drop_duplicates(["id", "deposit"], keep="last")
    snaps = snaps.rename(columns={"stock_date": "fecha_stock_disponible"})
    out = base.merge(snaps[["id", "deposit", "stock_disponible", "fecha_stock_disponible"]], on=["id", "deposit"], how="left")
    out["stock_disponible"] = pd.to_numeric(out["stock_disponible"], errors="coerce").fillna(0)
    return out.sort_values(["deposit", "name"])



def is_tiendanube_shipping_pending(value):
    """Estado de envío de Tiendanube que representa venta todavía no entregada.

    Regla Rawer: si dice "No está empaquetado" o "Listo para enviar",
    se considera vendido pendiente de entrega. No descuenta stock real;
    descuenta stock disponible calculado hasta que se cargue el despacho.
    """
    txt = normalize_text(value)
    if not txt:
        return False
    pending_labels = [
        "NO ESTA EMPAQUETADO",
        "LISTO PARA ENVIAR",
        "READY TO SHIP",
        "READY_TO_SHIP",
        "UNPACKED",
        "UNSHIPPED",
        "UNFULFILLED",
        "NOT PACKED",
        "NOT SHIPPED",
    ]
    return any(lbl in txt for lbl in pending_labels)

def pending_tiendanube_sales(as_of=None):
    """Ventas Tiendanube pendientes de despacho, agrupadas por producto y depósito.
    Estas ventas no modifican el stock real físico, pero sí reducen el stock disponible calculado.
    Cuando se carga un despacho con el mismo número de orden/comanda, producto y depósito, deja de quedar pendiente.
    """
    if as_of is None:
        as_of = date.today()
    sales = read_sql(
        """
        SELECT product_id AS id, COALESCE(sale_deposit, '') AS deposit,
               COALESCE(order_number, '') AS order_number,
               COALESCE(shipping_status, '') AS shipping_status,
               quantity
        FROM tiendanube_sales
        WHERE COALESCE(is_undone,0) = 0
          AND product_id IS NOT NULL
          AND COALESCE(sale_deposit, '') IN ('Planta Mar del Plata', 'Buenos Aires / Manjares', 'Tandil')
          AND date(COALESCE(order_created_at, imported_at)) <= date(?)
        """,
        (as_of.isoformat(),),
    )
    if sales.empty:
        return pd.DataFrame(columns=["id", "deposit", "vendido_tn", "despachado_tn", "vendido_pendiente_entrega"])
    # Desde v9.4, Tiendanube resta del stock disponible calculado solo si el
    # estado de envío indica que todavía no salió: "No está empaquetado" o
    # "Listo para enviar". Ya no depende de fecha de entrega.
    sales = sales[sales["shipping_status"].apply(is_tiendanube_shipping_pending)].copy()
    if sales.empty:
        return pd.DataFrame(columns=["id", "deposit", "vendido_tn", "despachado_tn", "vendido_pendiente_entrega"])
    disp = read_sql(
        """
        SELECT product_id AS id, COALESCE(deposit, '') AS deposit,
               COALESCE(numero_comanda, '') AS order_number,
               SUM(quantity) AS despachado
        FROM movements
        WHERE movement_type = 'despacho'
          AND COALESCE(is_undone,0) = 0
          AND date(effective_date) <= date(?)
        GROUP BY product_id, COALESCE(deposit, ''), COALESCE(numero_comanda, '')
        """,
        (as_of.isoformat(),),
    )
    grouped_sales = sales.groupby(["id", "deposit", "order_number"], as_index=False)["quantity"].sum().rename(columns={"quantity": "vendido_tn"})
    if disp.empty:
        grouped_sales["despachado_tn"] = 0.0
    else:
        grouped_sales = grouped_sales.merge(disp, on=["id", "deposit", "order_number"], how="left")
        grouped_sales["despachado_tn"] = grouped_sales["despachado"].fillna(0.0)
        grouped_sales = grouped_sales.drop(columns=["despachado"])
    grouped_sales["vendido_pendiente_entrega"] = (grouped_sales["vendido_tn"] - grouped_sales["despachado_tn"]).clip(lower=0)
    out = grouped_sales.groupby(["id", "deposit"], as_index=False)[["vendido_tn", "despachado_tn", "vendido_pendiente_entrega"]].sum()
    return out



def pending_private_sales(as_of=None):
    """Ventas particulares/manuales pendientes de despacho, agrupadas por producto y depósito.
    No modifican stock real físico. Reducen el stock disponible calculado hasta que se cargue
    un despacho con el mismo número de comanda/orden, producto y depósito.
    """
    if as_of is None:
        as_of = date.today()
    sales = read_sql(
        """
        SELECT product_id AS id, COALESCE(sale_deposit, '') AS deposit,
               COALESCE(order_number, '') AS order_number,
               quantity
        FROM private_sales
        WHERE COALESCE(is_undone,0) = 0
          AND product_id IS NOT NULL
          AND COALESCE(sale_deposit, '') IN ('Planta Mar del Plata', 'Buenos Aires / Manjares', 'Tandil')
          AND date(sale_date) <= date(?)
        """,
        (as_of.isoformat(),),
    )
    if sales.empty:
        return pd.DataFrame(columns=["id", "deposit", "vendido_particular", "despachado_particular", "particular_pendiente_entrega"])
    disp = read_sql(
        """
        SELECT product_id AS id, COALESCE(deposit, '') AS deposit,
               COALESCE(numero_comanda, '') AS order_number,
               SUM(quantity) AS despachado
        FROM movements
        WHERE movement_type = 'despacho'
          AND COALESCE(is_undone,0) = 0
          AND date(effective_date) <= date(?)
        GROUP BY product_id, COALESCE(deposit, ''), COALESCE(numero_comanda, '')
        """,
        (as_of.isoformat(),),
    )
    grouped_sales = sales.groupby(["id", "deposit", "order_number"], as_index=False)["quantity"].sum().rename(columns={"quantity": "vendido_particular"})
    if disp.empty:
        grouped_sales["despachado_particular"] = 0.0
    else:
        grouped_sales = grouped_sales.merge(disp, on=["id", "deposit", "order_number"], how="left")
        grouped_sales["despachado_particular"] = grouped_sales["despachado"].fillna(0.0)
        grouped_sales = grouped_sales.drop(columns=["despachado"])
    grouped_sales["particular_pendiente_entrega"] = (grouped_sales["vendido_particular"] - grouped_sales["despachado_particular"]).clip(lower=0)
    out = grouped_sales.groupby(["id", "deposit"], as_index=False)[["vendido_particular", "despachado_particular", "particular_pendiente_entrega"]].sum()
    return out



def ecommapp_deposit_to_rawer(value):
    raw = normalize_text(value)
    if not raw:
        return PENDING_DEPOSIT
    if raw in ECOMM_DEPOSIT_MAP:
        return ECOMM_DEPOSIT_MAP[raw]
    # Fallbacks tolerantes por si EcommApp cambia el texto exacto.
    if "MANJARES" in raw or "BUENOS AIRES" in raw:
        return "Buenos Aires / Manjares"
    if "TANDIL" in raw:
        return "Tandil"
    if "FABRICA" in raw or "MAR DEL PLATA" in raw or "MDP" in raw:
        return "Planta Mar del Plata"
    return PENDING_DEPOSIT


def product_from_ecommapp_sku_or_concept(sku, concept):
    sku_raw = str(sku or "").strip()
    if not sku_raw or normalize_text(sku_raw) == "OFFLINE_DISCOUNT":
        return None
    # Match exact and case-insensitive against the EcommApp/Tiendanube map.
    if sku_raw in ECOMM_SKU_PRODUCT_MAP:
        return ECOMM_SKU_PRODUCT_MAP[sku_raw]
    sku_norm = normalize_key(sku_raw).replace(" ", "")
    for k, v in ECOMM_SKU_PRODUCT_MAP.items():
        if normalize_key(k).replace(" ", "") == sku_norm:
            return v
    # Some exports can use Manjares-style codes or only clear product descriptions.
    name = manjares_product_name_from_code_or_description(sku_raw, concept)
    if name:
        return name
    return infer_manjares_product_from_description(concept)


def ecommapp_wholesale_existing_keys():
    df = read_sql(
        """
        SELECT COALESCE(external_key,'') AS external_key,
               sale_date, order_number, sale_deposit, product_id, quantity,
               COALESCE(source,'') AS source
        FROM private_sales
        WHERE COALESCE(is_undone,0)=0
        """
    )
    exact = set(df["external_key"].astype(str)) if not df.empty and "external_key" in df.columns else set()
    fallback = set()
    if not df.empty:
        for _, r in df.iterrows():
            fallback.add((
                str(r.get("sale_date", ""))[:10],
                str(r.get("order_number", "")).strip(),
                str(r.get("sale_deposit", "")).strip(),
                int(r.get("product_id") or 0),
                round(float(r.get("quantity") or 0), 6),
                str(r.get("source", "")).strip(),
            ))
    return exact, fallback


def parse_ecommapp_wholesale_excel(uploaded_file, estado_filter="Todos"):
    """Parsea Excel de presupuestos EcommApp para importar ventas mayoristas.

    No modifica stock real. Devuelve una vista previa con estado de importación.
    """
    try:
        raw = pd.read_excel(uploaded_file, sheet_name=0)
    except Exception as e:
        return pd.DataFrame(), f"No pude leer el Excel: {e}"

    fecha_col = find_csv_column(raw.columns, ["Fecha del Presupuesto", "Fecha"])
    order_col = find_csv_column(raw.columns, ["Nº Presupuesto", "N° Presupuesto", "Numero Presupuesto", "Presupuesto"])
    sku_col = find_csv_column(raw.columns, ["Código / SKU", "Codigo / SKU", "SKU", "Código"])
    concept_col = find_csv_column(raw.columns, ["Concepto", "Producto", "Descripcion", "Descripción"])
    qty_col = find_csv_column(raw.columns, ["Cantidad", "Unidades"])
    deposit_col = find_csv_column(raw.columns, ["Deposito", "Depósito"])
    estado_col = find_csv_column(raw.columns, ["Estado"])
    estado_reg_col = find_csv_column(raw.columns, ["Estado_registro", "Estado registro"])
    impacto_col = find_csv_column(raw.columns, ["Impacto stock", "Impacta stock"])
    nombre_col = find_csv_column(raw.columns, ["nombre", "Nombre"])
    apellido_col = find_csv_column(raw.columns, ["apellido", "Apellido"])
    importe_col = find_csv_column(raw.columns, ["Importe total ($)", "Importe total", "Importe ($)"])

    required = [(fecha_col, "Fecha del Presupuesto"), (order_col, "Nº Presupuesto"), (sku_col, "Código / SKU"), (concept_col, "Concepto"), (qty_col, "Cantidad"), (deposit_col, "Deposito")]
    missing = [label for col, label in required if col is None]
    if missing:
        return pd.DataFrame(), "Faltan columnas requeridas: " + ", ".join(missing)

    product_ids = product_name_to_id()
    exact_existing, fallback_existing = ecommapp_wholesale_existing_keys()
    rows = []
    estado_filter_norm = normalize_text(estado_filter)
    for idx, row in raw.iterrows():
        sku = str(row.get(sku_col, "") or "").strip()
        concept = str(row.get(concept_col, "") or "").strip()
        order_raw = row.get(order_col, "")
        try:
            if pd.notna(order_raw) and float(order_raw).is_integer():
                order_number = str(int(float(order_raw)))
            else:
                order_number = str(order_raw or "").strip()
        except Exception:
            order_number = str(order_raw or "").strip()
        qty = pd.to_numeric(row.get(qty_col, 0), errors="coerce")
        qty = 0.0 if pd.isna(qty) else float(qty)
        fecha = pd.to_datetime(row.get(fecha_col), errors="coerce")
        sale_date_s = fecha.date().isoformat() if pd.notna(fecha) else ""
        delivery_date_s = sale_date_s
        estado = str(row.get(estado_col, "") or "").strip() if estado_col else ""
        estado_reg = str(row.get(estado_reg_col, "") or "").strip() if estado_reg_col else ""
        impacto = str(row.get(impacto_col, "") or "").strip() if impacto_col else ""
        deposito_original = str(row.get(deposit_col, "") or "").strip()
        deposit = ecommapp_deposit_to_rawer(deposito_original)
        nombre = str(row.get(nombre_col, "") or "").strip() if nombre_col else ""
        apellido = str(row.get(apellido_col, "") or "").strip() if apellido_col else ""
        customer = " ".join([x for x in [nombre, apellido] if x]).strip()
        importe = pd.to_numeric(row.get(importe_col, 0), errors="coerce") if importe_col else 0
        importe = 0.0 if pd.isna(importe) else float(importe)
        product_name = product_from_ecommapp_sku_or_concept(sku, concept)
        product_id = product_ids.get(product_name) if product_name else None
        external_key = "|".join([sale_date_s, order_number, normalize_key(sku), normalize_key(concept), str(round(qty, 6)), deposit])
        fallback_key = (sale_date_s, order_number, deposit, int(product_id or 0), round(qty, 6), "ecommapp_mayorista")

        reasons = []
        if not sale_date_s:
            reasons.append("fecha inválida")
        if not order_number:
            reasons.append("falta Nº Presupuesto")
        if normalize_text(sku) == "OFFLINE_DISCOUNT":
            reasons.append("descuento")
        if estado_reg_col and normalize_text(estado_reg) != "EMITIDO":
            reasons.append("registro no emitido")
        if impacto_col and normalize_text(impacto) not in ("SI", "SÍ", "YES"):
            reasons.append("sin impacto stock")
        if estado_filter_norm not in ("TODOS", "") and normalize_text(estado) != estado_filter_norm:
            reasons.append(f"estado distinto de {estado_filter}")
        if qty <= 0:
            reasons.append("cantidad <= 0")
        if deposit == PENDING_DEPOSIT:
            reasons.append("depósito no reconocido")
        if not product_id:
            reasons.append("producto no reconocido")
        duplicate = bool(external_key in exact_existing or fallback_key in fallback_existing)
        if duplicate:
            reasons.append("ya importado")
        status = "OK" if not reasons else "NO IMPORTAR: " + "; ".join(reasons)
        rows.append({
            "fila_excel": int(idx) + 2,
            "fecha_venta": sale_date_s,
            "numero_comanda": order_number,
            "cliente": customer,
            "deposito": deposit,
            "deposito_original": deposito_original,
            "sku_original": sku,
            "concepto": concept,
            "producto": product_name or "",
            "product_id": int(product_id or 0),
            "cantidad": qty,
            "fecha_entrega": delivery_date_s,
            "estado_ecommapp": estado,
            "estado_registro": estado_reg,
            "impacto_stock": impacto,
            "importe_total": importe,
            "external_key": external_key,
            "estado_importacion": status,
            "duplicado": duplicate,
        })
    return pd.DataFrame(rows), None


def save_imported_ecommapp_wholesale(preview_df):
    if preview_df is None or preview_df.empty:
        return 0, 0
    valid = preview_df[preview_df["estado_importacion"].astype(str).eq("OK")].copy()
    if valid.empty:
        return 0, 0
    exact_existing, fallback_existing = ecommapp_wholesale_existing_keys()
    conn = get_conn()
    now = datetime.now().isoformat(timespec="seconds")
    saved = 0
    skipped = 0
    for _, r in valid.iterrows():
        external_key = str(r.get("external_key", "") or "")
        fallback_key = (
            str(r.get("fecha_venta", ""))[:10],
            str(r.get("numero_comanda", "")).strip(),
            str(r.get("deposito", "")).strip(),
            int(r.get("product_id") or 0),
            round(float(r.get("cantidad") or 0), 6),
            "ecommapp_mayorista",
        )
        if external_key in exact_existing or fallback_key in fallback_existing:
            skipped += 1
            continue
        conn.execute(
            """
            INSERT INTO private_sales(
                sale_date, order_number, customer_name, sale_deposit, product_id, product_name,
                quantity, delivery_date, note, source, created_at, external_key, original_sku,
                ecommapp_estado, ecommapp_estado_registro, ecommapp_impacto_stock, importe_total
            ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, 'ecommapp_mayorista', ?, ?, ?, ?, ?, ?, ?)
            """,
            (
                str(r.get("fecha_venta", ""))[:10],
                str(r.get("numero_comanda", "")).strip(),
                str(r.get("cliente", "") or "").strip(),
                str(r.get("deposito", "") or DEFAULT_DEPOSIT).strip(),
                int(r.get("product_id") or 0),
                str(r.get("producto", "") or "").strip(),
                float(r.get("cantidad") or 0),
                str(r.get("fecha_entrega", "") or "")[:10],
                "Importado desde Excel mayorista EcommApp",
                now,
                external_key,
                str(r.get("sku_original", "") or "").strip(),
                str(r.get("estado_ecommapp", "") or "").strip(),
                str(r.get("estado_registro", "") or "").strip(),
                str(r.get("impacto_stock", "") or "").strip(),
                float(r.get("importe_total") or 0),
            ),
        )
        exact_existing.add(external_key)
        fallback_existing.add(fallback_key)
        saved += 1
    conn.commit()
    conn.close()
    return saved, skipped

def save_private_sale_lines(sale_date, order_number, customer_name, sale_deposit, delivery_date, lines_df, note=""):
    order_number = str(order_number or "").strip()
    if not order_number:
        return 0, "Falta número de comanda/orden."
    if sale_deposit not in DEPOSITS:
        return 0, "Depósito inválido."
    product_map = product_name_to_id()
    now = datetime.now().isoformat(timespec="seconds")
    sale_date_s = sale_date.isoformat() if hasattr(sale_date, "isoformat") else str(sale_date)
    delivery_date_s = delivery_date.isoformat() if hasattr(delivery_date, "isoformat") else str(delivery_date or "")
    conn = get_conn()
    saved = 0
    for _, row in lines_df.iterrows():
        product_name = str(row.get("producto") or "").strip()
        qty = float(row.get("cantidad") or 0)
        if not product_name or qty <= 0:
            continue
        pid = product_map.get(product_name)
        if not pid:
            continue
        conn.execute(
            """
            INSERT INTO private_sales(sale_date, order_number, customer_name, sale_deposit, product_id, product_name, quantity, delivery_date, note, source, created_at)
            VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, 'venta_particular', ?)
            """,
            (sale_date_s, order_number, str(customer_name or "").strip(), sale_deposit, int(pid), product_name, qty, delivery_date_s, str(note or "").strip(), now),
        )
        saved += 1
    conn.commit()
    conn.close()
    return saved, f"Venta particular {order_number} guardada con éxito. Líneas: {saved}."


def private_sales_df():
    return read_sql(
        """
        SELECT ps.id, ps.sale_date AS fecha_venta, ps.order_number AS numero_comanda,
               COALESCE(ps.customer_name,'') AS cliente,
               COALESCE(ps.sale_deposit,'') AS deposito,
               p.name AS producto,
               ps.quantity AS cantidad,
               COALESCE(ps.delivery_date,'') AS fecha_entrega,
               COALESCE(ps.note,'') AS observacion,
               COALESCE(ps.source,'venta_particular') AS origen,
               COALESCE(ps.original_sku,'') AS sku_original,
               COALESCE(ps.ecommapp_estado,'') AS estado_ecommapp,
               COALESCE(ps.external_key,'') AS clave_importacion,
               COALESCE(ps.is_undone,0) AS anulado,
               COALESCE(ps.undone_at,'') AS anulado_el,
               COALESCE(ps.undo_reason,'') AS motivo_anulacion,
               ps.created_at AS cargado_el
        FROM private_sales ps
        JOIN products p ON p.id = ps.product_id
        ORDER BY date(ps.sale_date) DESC, ps.id DESC
