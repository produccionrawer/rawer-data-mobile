APP_NAME = "Rawer Data"
DEFAULT_BASE_DIR = Path.home() / "Documents" / "Rawer Data"
LOCAL_CONFIG_DIR = DEFAULT_BASE_DIR / "config"
CONFIG_FILE = LOCAL_CONFIG_DIR / "settings.json"


def load_app_settings():
    try:
        if CONFIG_FILE.exists():
            data = json.loads(CONFIG_FILE.read_text(encoding="utf-8"))
            return data if isinstance(data, dict) else {}
    except Exception:
        pass
    return {}


def save_app_settings(settings):
    LOCAL_CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    CONFIG_FILE.write_text(json.dumps(settings, ensure_ascii=False, indent=2), encoding="utf-8")


def resolve_base_dir():
    settings = load_app_settings()
    raw = settings.get("base_dir")
    if raw:
        try:
            return Path(raw).expanduser()
        except Exception:
            return DEFAULT_BASE_DIR
    return DEFAULT_BASE_DIR


BASE_DIR = resolve_base_dir()
