def active_tiendanube_sales_for_undo():
    return read_sql(
        """
        SELECT s.id, s.order_created_at AS fecha_venta, s.order_number AS numero_orden,
               COALESCE(s.sale_deposit,'') AS deposito, COALESCE(s.sku,'') AS sku,
               COALESCE(s.product_name_rawer, s.product_name_tn, '') AS producto,
               s.quantity AS cantidad, COALESCE(s.sale_type,'Individual') AS tipo_venta,
               COALESCE(s.combo_sku,'') AS combo_sku, COALESCE(s.customer_name,'') AS cliente,
               s.imported_at AS importado_el
        FROM tiendanube_sales s
        WHERE COALESCE(s.is_undone,0)=0
        ORDER BY datetime(s.order_created_at) DESC, s.id DESC
        """
    )

def export_excel_bytes():
    wb = Workbook()
    ws = wb.active
    ws.title = "Stock actual"
    dfs = {
        "Stock actual": dashboard_df(date.today()),
        "Stock por lote": lot_stock_detail_df(date.today()),
        "Control lotes": lot_stock_reconciliation_df(date.today()),
        "Movimientos": movements_df(),
        "Stock disponible": available_snapshots_df(),
        "Productos": get_products(False),
        "Stock inicial": read_sql(
            """
            SELECT d.deposit AS deposito, p.name AS producto, COALESCE(d.quantity,0) AS stock_inicial, d.updated_at AS actualizado_el
            FROM initial_stock_deposit d JOIN products p ON p.id = d.product_id
            ORDER BY d.deposit, p.name
            """
        ),
        "Stock insumos": current_supply_stock(),
        "Costos insumos": latest_supply_costs_df(),
        "Historial costos": supply_cost_history_df(),
        "Movimientos insumos valorizados": costed_supply_movements_df(),
        "Ingresos insumos": supply_movements_df(),
        "Recetas batchs": recipes_df(),
        "Costo por batch": product_recipe_costs_df(),
        "Ventas Tiendanube": tiendanube_sales_df(),
        "Ventas particulares": private_sales_df(),
        "Combos Tiendanube": read_sql("""
            SELECT cs.combo_sku, cs.combo_name, p.name AS producto_individual,
                   COALESCE(cc.component_sku,'') AS sku_individual,
                   cc.quantity_per_combo, cs.active AS combo_activo, cc.active AS componente_activo
            FROM combo_skus cs
            LEFT JOIN combo_components cc ON cc.combo_id = cs.id
            LEFT JOIN products p ON p.id = cc.product_id
            ORDER BY cs.combo_sku, p.name
        """),
    }
    first = True
    for sheet_name, df in dfs.items():
        if first:
            ws = wb.active
            ws.title = sheet_name[:31]
            first = False
        else:
            ws = wb.create_sheet(sheet_name[:31])
        write_df(ws, df)
    bio = BytesIO()
    wb.save(bio)
    return bio.getvalue()


def write_df(ws, df):
    header_fill = PatternFill("solid", fgColor="9F0F12")
    header_font = Font(color="FFFFFF", bold=True)
    thin = Side(style="thin", color="DDDDDD")
    border = Border(top=thin, bottom=thin, left=thin, right=thin)
    for c_idx, col in enumerate(df.columns, start=1):
        cell = ws.cell(row=1, column=c_idx, value=col)
        cell.fill = header_fill
        cell.font = header_font
        cell.border = border
        cell.alignment = Alignment(horizontal="center")
    for r_idx, row in enumerate(df.itertuples(index=False), start=2):
        for c_idx, val in enumerate(row, start=1):
            cell = ws.cell(row=r_idx, column=c_idx, value=val)
            cell.border = border
    for col_idx, col in enumerate(df.columns, start=1):
        max_len = max([len(str(col))] + [len(str(v)) for v in df[col].head(500).fillna("").tolist()])
        ws.column_dimensions[get_column_letter(col_idx)].width = min(max(max_len + 2, 12), 40)
    ws.freeze_panes = "A2"
    if df.shape[0] >= 0 and df.shape[1] > 0:
        ws.auto_filter.ref = ws.dimensions


